[{"data":1,"prerenderedAt":316},["ShallowReactive",2],{"blog:2022-07-05-social-marketing-hiring":3,"blog:neighbors:2022-07-05-social-marketing-hiring":285},{"id":4,"title":5,"author":6,"body":7,"categories":272,"date":273,"description":274,"draft":275,"extension":276,"meta":277,"navigation":278,"path":279,"seo":280,"stem":281,"tags":282,"thumbnail":17,"__hash__":284},"blog\u002Fblog\u002F2022\u002F2022-07-05-social-marketing-hiring.md","【六角學院徵才 - 高雄】網路活動企劃",[],{"type":8,"value":9,"toc":251},"minimark",[10,18,23,26,34,38,41,68,71,74,86,89,93,104,107,133,136,150,154,157,160,163,166,189,192,206,209,226,229,234,237],[11,12,13],"p",{},[14,15],"img",{"alt":16,"src":17},"首圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F07%2Funknown.png?alt=media&token=9593ecee-2496-4116-8433-27ce438eecf9",[19,20,22],"h2",{"id":21},"職缺名稱網路活動企劃","職缺名稱：網路活動企劃",[19,24,25],{"id":25},"公司簡介",[11,27,28,29,33],{},"六角學院為線上課程教育單位，我們的使命為",[30,31,32],"b",{},"讓世界各地的學員，能透過線上學習，擁有更好的職涯發展機會","。",[19,35,37],{"id":36},"為什麼我們要尋找一位網路活動企劃","為什麼我們要尋找一位「網路活動企劃」？",[11,39,40],{},"六角共同創辦人廖洧杰與王志誠，在 2013 年成立高雄前端社群時，就已發現社群的豐沛能量，能夠帶領大家走得更遠。\n所以從創院到現在，都持續在經營學員社群，在這幾年的耕耘下，我們做到了以下事情：",[42,43,44,45,44,50,44,53],"ul",{},"\n  ",[46,47,49],"li",{"style":48},"font-size: 18px;","當學員在學習或遇到人生瓶頸，都會在社團上發問，有相同經歷的學長姐都願意給予解答",[46,51,52],{"style":48},"學長姐在職場上有好的發展，並在社群上張貼公司職缺，形成正向循環的社群人脈網",[46,54,55,56,62,63,67],{"style":48},"舉辦各種網路活動，促進凝聚學員社群向心力。例如 ",[57,58,61],"a",{"href":59,"target":60},"https:\u002F\u002Fwww.facebook.com\u002Fgroups\u002F173311386703334","_blank","The F2E"," 程式練功活動，期間達成月 PV 40 萬成就。",[57,64,66],{"href":65,"target":60},"https:\u002F\u002Fshawnlin0201.github.io\u002Fhexschool-2020-challenge-blog-list\u002F?fbclid=IwAR1nYy4Yc6mUiyNr1FSJOdNg-wHZDERmUO8v_ah6D69H8q_A0UuRUP_u8DY","全馬鐵人寫文活動","，超過千篇的技術心得文。",[11,69,70],{},"目前皆由共同創辦人和一位社群營運在著手此部分，由於我們照顧的學生量已超乎預期，所以希望找到認同我們理念的你\u002F妳，來協助救救我們，希望藉由您的力量，活絡六角學員社群發展。",[19,72,73],{"id":73},"工作內容",[75,76,44,77,44,80,44,83],"ol",{},[46,78,79],{"style":48},"協助規劃 \u002F 執行行銷活動",[46,81,82],{"style":48},"網路活動企劃相關工作，貼文撰寫、活動預熱等等",[46,84,85],{"style":48},"簡易影片剪輯、製圖",[19,87,88],{"id":88},"條件要求",[90,91,92],"h3",{"id":92},"必備條件",[75,94,44,95,44,98,44,101],{},[46,96,97],{"style":48},"對於網頁開發有興趣，願意學習開發的相關知識",[46,99,100],{"style":48},"良好的溝通能力，具備高度耐心與同理心",[46,102,103],{"style":48},"樂於分享，喜歡追迷因",[90,105,106],{"id":106},"加分條件",[75,108,44,109,44,112,44,115,44,118,44,121,44,124,44,127,44,130],{},[46,110,111],{"style":48},"具備網路資訊敏銳度，喜歡最新軟體服務及 3C 資訊尤佳",[46,113,114],{"style":48},"資訊、軟體相關背景",[46,116,117],{"style":48},"具備相關社群工作經驗",[46,119,120],{"style":48},"經營 FB、IG 粉絲團經驗",[46,122,123],{"style":48},"有基礎影片剪輯能力",[46,125,126],{"style":48},"文案寫作經驗",[46,128,129],{"style":48},"具平面 & 多媒體編輯設計能力",[46,131,132],{"style":48},"有經營個人內容品牌（Facebook、IG、抖音等）",[19,134,135],{"id":135},"預期的工作情境",[75,137,44,138,44,141,44,144,44,147],{},[46,139,140],{"style":48},"依照自身職涯期望，與共同創辦人訂定個人未來技能樹發展，藉此擬定每季的工作內容",[46,142,143],{"style":48},"網路活動規劃，並與團隊成員集思廣益，設計出助於學員發展的相關活動",[46,145,146],{"style":48},"回覆粉專、Line@ 學員，並將常見問題，設計 chatbot 流程自動化，提升回覆效率",[46,148,149],{"style":48},"尋找時事熱點趨勢，並搭配品牌調性設計社群貼文（包含且不限於：Facebook、Youtube、Instagram、LINE）",[19,151,153],{"id":152},"薪資月薪","薪資(月薪)",[11,155,156],{},"30,000~45,000，保障 13 個月，能力好可議。",[19,158,159],{"id":159},"公司分紅與獎金",[11,161,162],{},"依照公司獲利與表現進行分配，平均約為額外一個月獎金。",[19,164,165],{"id":165},"福利與工作制度",[42,167,44,168,44,171,44,174,44,177,44,180,44,183,44,186],{},[46,169,170],{"style":48},"每天工作 8 小時，早上 9:00 - 9:30 可彈性上班",[46,172,173],{"style":48},"每週週三、五進行遠端工作",[46,175,176],{"style":48},"提供 Macbook 及外接螢幕提升工作效率",[46,178,179],{"style":48},"每年一次的員工旅遊",[46,181,182],{"style":48},"不定期聚餐",[46,184,185],{"style":48},"外訓課程申請、並鼓勵與補助參與技術研討會",[46,187,188],{"style":48},"年資兩年員工，提供健檢補助",[19,190,191],{"id":191},"工作環境與團隊介紹",[42,193,44,194,44,197,44,200,44,203],{},[46,195,196],{"style":48},"除了兩位共同創辦人外，開發團隊有 3 位前端、2 位 UI、1 位後端、1 位行政會計、1 位社群營運",[46,198,199],{"style":48},"團隊成員皆熱愛分享與學習，超過一半成員參與過技術研討會與擔任志工",[46,201,202],{"style":48},"雙月其中一週舉辦小團康活動",[46,204,205],{"style":48},"團隊導入 SCRUM 工作法",[19,207,208],{"id":208},"目前團隊用的社群服務與網路社群工具",[42,210,44,211,44,214,44,217,44,220,44,223],{},[46,212,213],{"style":48},"社交服務：FB 粉絲團、學員社團、Discord",[46,215,216],{"style":48},"CRM 服務：Mailchimp、Line@ chatbot",[46,218,219],{"style":48},"數位廣告投放：FB、Google",[46,221,222],{"style":48},"SEO ：ahrefs、品牌內容經營",[46,224,225],{"style":48},"影音平台：YouTube、bilibili",[19,227,228],{"id":228},"工作地點",[42,230,44,231],{},[46,232,233],{"style":48},"高雄市鹽埕區",[19,235,236],{"id":236},"聯絡與面試方式",[42,238,44,239,44,242,44,245,44,248],{},[46,240,241],{"style":48},"請寄信至 \u003Cservice@hexschool.com>，之後此職缺將釋出於 104 平台，並暑假期間陸續進行面試",[46,243,244],{"style":48},"信件標題請設定為：【應徵 網路活動企劃】OOO (OOO 為您的姓名)",[46,246,247],{"style":48},"履歷附件還請用 PDF 提供",[46,249,250],{"style":48},"收到履歷後，若您是潛在合適人選，我們會透過 Email 與您約時間進行現場面試",{"title":252,"searchDepth":253,"depth":253,"links":254},"",2,[255,256,257,258,259,264,265,266,267,268,269,270,271],{"id":21,"depth":253,"text":22},{"id":25,"depth":253,"text":25},{"id":36,"depth":253,"text":37},{"id":73,"depth":253,"text":73},{"id":88,"depth":253,"text":88,"children":260},[261,263],{"id":92,"depth":262,"text":92},3,{"id":106,"depth":262,"text":106},{"id":135,"depth":253,"text":135},{"id":152,"depth":253,"text":153},{"id":159,"depth":253,"text":159},{"id":165,"depth":253,"text":165},{"id":191,"depth":253,"text":191},{"id":208,"depth":253,"text":208},{"id":228,"depth":253,"text":228},{"id":236,"depth":253,"text":236},null,"2022-07-05","六角學院 是一所線上程式開發學習單位，目前已累積超過 30,000 名學員，讓更多人藉由線上學習在職涯規劃上有更多的選擇是我們的使命，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2022\u002F2022-07-05-social-marketing-hiring",{"title":5,"description":274},"blog\u002F2022\u002F2022-07-05-social-marketing-hiring",[283],"jobs","rpgxagoUhFLoH98GAQ1LN1CF4FjZ1MlocJmDBRptzSU",{"prev":286,"next":289,"related":292,"tags":305},{"title":287,"link":288},"【現在就走！前進企業帶你看】成為 Kdan 人必看 Q&A！新人剛進工作會有前輩帶領嗎？","\u002Fblog\u002F2022-07-11-kdan-mobile-interview",{"title":290,"li