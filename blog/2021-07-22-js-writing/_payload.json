[{"data":1,"prerenderedAt":405},["ShallowReactive",2],{"blog:2021-07-22-js-writing":3,"blog:neighbors:2021-07-22-js-writing":374},{"id":4,"title":5,"author":6,"body":8,"categories":362,"date":363,"description":26,"draft":364,"extension":365,"meta":366,"navigation":367,"path":368,"seo":369,"stem":370,"tags":371,"thumbnail":17,"__hash__":373},"blog\u002Fblog\u002F2021\u002F2021-07-22-js-writing.md","六角筆記王：寫作吧！用文字喚醒你的前端魂！",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":344},"minimark",[11,18,21,24,27,35,39,42,55,65,68,73,111,117,121,124,147,150,181,188,191,204,207,210,213,231,234,242,245,256,259,276,279,293,296,302,308,318,324,330,336],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F07%2Fy3wfuZN.png?alt=media&token=a7771490-6adc-4531-b5bf-4eb76edc879c",[12,19,20],{},"在前端的學習路途上，你是否常常因為程式邏輯複雜、常常卡關，而感到很沮喪？",[12,22,23],{},"明明看了很多課程、書籍，等到開發實作時，才發現根本什麼也沒記住，感覺自己的努力白費了？",[12,25,26],{},"六角筆記王，專門設計給開發人員的筆記寫作大賽，提供對前端開發有興趣的朋友一個發光發熱的舞台，鼓勵大家運用刻意寫作技巧，記錄學習開發日常，用文字寫出你的前端硬實力。",[12,28,29,30,34],{},"參與此活動能快速提升文字與程式開發邏輯，不僅能累積作品集，更有機會獲得",[31,32,33],"b",{},"小米智能家電","等大獎！立即報名，用寫作喚醒你的前端魂！",[36,37,38],"h2",{"id":38},"活動資格",[12,40,41],{},"本活動積極鼓勵「任何」想要用寫作加速工程師職涯的朋友，尤其適合：",[43,44,45,49,52],"ol",{},[46,47,48],"li",{},"沒有寫筆記習慣，想要趁機養成習慣的你",[46,50,51],{},"原本就有在寫筆記，想要加速累積作品的你",[46,53,54],{},"想要藉由此次活動，開啟程式學習的你",[12,56,57,58,64],{},"如果你還沒有任何程式學習的經驗，也歡迎你參考六角學院所提供的",[59,60,63],"a",{"href":61,"target":62},"https:\u002F\u002Fwww.hexschool.com\u002F","blank","課程","，搭配參與此活動效果更佳。",[36,66,67],{"id":67},"活動筆記格式",[69,70,72],"h3",{"id":71},"一-筆記格式","(一) 筆記格式",[43,74,75,85,103,108],{},[46,76,77,78,84],{},"使用 HackMD 平台並使用書本模式撰寫筆記，附",[59,79,83],{"href":80,"rel":81},"https:\u002F\u002Fvocus.cc\u002Farticle\u002F60f65a69fd897800016e89d0",[82],"nofollow","教學文章","。",[46,86,87,88,91,92,97,98,84],{},"累積",[31,89,90],{},"五篇（含）以上筆記","內容，每一篇內容需含有至少一個以上知識點，提供",[59,93,96],{"href":94,"rel":95},"https:\u002F\u002Fhackmd.io\u002F@YmcMgo-NSKOqgTGAjl_5tg\u002FSkjXdP8R_\u002F%2FdHCLNHm1QNK9_jCMQQuP_A",[82],"寫作範例","與 ",[59,99,102],{"href":100,"rel":101},"https:\u002F\u002Fhackmd.io\u002F@YmcMgo-NSKOqgTGAjl_5tg\u002Fryar-vGOd\u002F%2FNdGKchTeRBqbkTMiQ2HSmw",[82],"BS5 教學手冊",[46,104,105],{},[31,106,107],{},"若為程式開發筆記，必須含有程式碼範例。",[46,109,110],{},"此次活動必須使用 HackMD 模式進行撰寫，為評選公平性，如果想要使用自己平台（Medium、Blog、粉專）之文章，也必須重新整理至 HackMD 筆記中，並書本模式撰寫。",[12,112,113,114],{},"書本模式截圖如下，左側選單需含 5 篇文章：\n",[15,115],{"alt":72,"src":116},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F07%2FGiYDZCT.png?alt=media&token=513ddefe-285d-4b5d-9949-df1242af8fb6",[69,118,120],{"id":119},"二-筆記內容","(二) 筆記內容：",[12,122,123],{},"為鼓勵前端生態正向成長，此次六角筆記王活動不限任何主題，筆記內容方向參考如下：",[43,125,126,129,132,135,138,141,144],{},[46,127,128],{},"HTML、CSS 技術。",[46,130,131],{},"JavaScript 技術。",[46,133,134],{},"程式框架、套件等學習資源。",[46,136,137],{},"面試心得、面試訣竅。",[46,139,140],{},"軟體開發軟實力。",[46,142,143],{},"職場應對技巧。",[46,145,146],{},"其他，可自由發揮有關軟題學習的日常。",[36,148,149],{"id":149},"報名流程",[43,151,152,167,178],{},[46,153,154,155,160,161,166],{},"填寫",[59,156,159],{"href":157,"rel":158},"https:\u002F\u002Fdocs.google.com\u002Fforms\u002Fd\u002Fe\u002F1FAIpQLScLhNyx9PTindSAX4lmmLeEW-Ck6s5Gv23wFuMzV27iTXdPsw\u002Fviewform",[82],"報名表單","，並加入專屬 ",[59,162,165],{"href":163,"rel":164},"https:\u002F\u002Fdiscord.gg\u002FEzgYqZCrRP",[82],"Discord"," 社群。",[46,168,169,170,173],{},"進入「自助領取身份組」頻道點表情領取「六角筆記王」身份組即完成報名（重新整理 Discord 即可看到「六角筆記王」的頻道）",[171,172],"br",{},[59,174,177],{"href":175,"rel":176},"https:\u002F\u002Fdiscord.com\u002Fchannels\u002F801807326054055996\u002F873193266101776426\u002F874496692924350524",[82],"領取流程說明",[46,179,180],{},"進入六角筆記王專屬頻道進行自我介紹即完成報名手續。",[12,182,183,184],{},"自我介紹範本：\n",[185,186,187],"code",{},"大家好，我是小明，一位是網頁設計師，想要透過這一次六角筆記王的活動來精進自己的寫作及前端技能。",[36,189,190],{"id":190},"投稿流程",[43,192,193,201],{},[46,194,195,196,200],{},"使用 HackMD 書本模式撰寫筆記，完成筆記後，可至 ",[59,197,199],{"href":157,"rel":198},[82],"Google 表單","中提交筆記。",[46,202,203],{},"填完表單，投稿就完成囉！",[12,205,206],{},"（注意：活動報名及筆記提交為同一表單，報名時還不需要提交筆記，此表單可以多次提交。）",[36,208,209],{"id":209},"活動獎項",[12,211,212],{},"依據內容充實性 (40%)、主題專業 (30%)、內容主題切合度 (20%)、文章發布時間 (10%) 評選出：",[214,215,216,219,222,225],"ul",{},[46,217,218],{},"六角筆記王獎：小米小愛音箱 Art（1名）",[46,220,221],{},"筆記小達人獎：米家無線吸塵器 mini（2名）",[46,223,224],{},"勤學不懈獎 ：小米手環（7名）",[46,226,227,230],{},[31,228,229],{},"參加獎","：若符合投稿門檻，達 5 篇文章，將贈送一堂 JS 直播教學，時間與主題為 9\u002F15 20:00 JS 百題斬，並透過 mail 發送直播網址",[36,232,233],{"id":233},"報名時間",[214,235,236,239],{},[46,237,238],{},"報名開始時間：2021\u002F07\u002F26(一) 00:00",[46,240,241],{},"報名截止時間：2021\u002F08\u002F15(日) 23:59",[36,243,244],{"id":244},"活動時程",[214,246,247,250,253],{},[46,248,249],{},"活動開始時間：2021\u002F07\u002F26(一) 00:00",[46,251,252],{},"活動截止時間：2021\u002F09\u002F12(日) 23:59",[46,254,255],{},"得獎結果預計於 2021\u002F09\u002F21(二) 公布",[36,257,258],{"id":258},"活動規範",[43,260,261,264,267,270,273],{},[46,262,263],{},"參賽者文章內容不得有謾罵、汙言穢語之內容，若經主辦單位判定嚴重者將取消參賽資格。",[46,265,266],{},"參賽者需提交與軟體開發相關之內容，若發表內容無關或不符合主題，主辦單位將有權取消參賽資格。",[46,268,269],{},"如發現有任何抄襲、複製貼上、盜用且未加以改寫、引用之內容，主辦方有權取消參賽資格。",[46,271,272],{},"參賽者同意主辦單位有轉貼、分享文章的權利。",[46,274,275],{},"刪除文章者將取消完賽與得獎資格。",[36,277,278],{"id":278},"領獎須知",[43,280,281,284,287,290],{},[46,282,283],{},"獲獎結果依主辦單位公佈為主，不得異議。",[46,285,286],{},"獲獎結果主辦單位會主動聯繫得獎者。若於公佈參賽結果超過一個月無法取得連繫，則視為自動棄權，不具得獎資格。",[46,288,289],{},"依所得稅法規定，機會中獎之獎項價值若超過 NT$1,000，所得將列入個人年度綜合所得稅申報，若獎品價值總額超過 NT$20,000，必須代扣 10% 中獎獎金稅額，本公司統一於活動年之隔年寄發扣繳憑單給中獎人，以利中獎人申報之用。若中獎人不願先行繳納本項稅金，視同放棄中獎資格；扣繳稅款未超過 NT$2,000，免扣繳。若得獎者經主辦單位通知拒絕繳納代扣稅額，視為得獎者放棄得獎權益且不得有議。另依個人資料保護法，參加本活動者視為瞭解及同意活動之需要進行蒐集、處理及利用其個人資料。",[46,291,292],{},"本活動得獎者需設籍於台灣、金門、澎湖、馬祖地區者。",[36,294,295],{"id":295},"常見問答",[12,297,298,301],{},[31,299,300],{},"Q: 我可以投五篇以上的筆記嗎？","\nA: 可以，筆記的數量、連續性也會列入評列標準。",[12,303,304,307],{},[31,305,306],{},"Q: 一個人可以領幾次獎？","\nA: 不論筆記篇量，一個人最多只有一次領獎資格。",[12,309,310,313,314],{},[31,311,312],{},"Q: 主辦單位要怎麼確認我有投稿？","\nA: 您寫完文章後，請直接到報名表單來進行投稿即可。\n",[59,315,317],{"href":157,"rel":316},[82],"報名與投稿表單連結",[12,319,320,323],{},[31,321,322],{},"Q: 我填完表單，文章可以再編輯嗎？","\nA: 可以喔！我們會在報名結束後才開始審文章，這過程當中如果有要修改的地方都沒有問題。",[12,325,326,329],{},[31,327,328],{},"Q: 之前寫過的文章可以投稿嗎？","\nA: 都可以投稿喲！筆記的評選標準主要以架構、知識完整度作為評選標準！",[12,331,332,335],{},[31,333,334],{},"Q: 如果我正在準備面試，可以寫文章嗎？","\nA: 可以喔！無論你是已經面試過，或是你還在準備當中，都可以把你準備的經驗分享出來。",[12,337,338,339],{},"若有其他問題，歡迎私訊",[59,340,343],{"href":341,"rel":342},"https:\u002F\u002Fwww.facebook.com\u002Fhexschool",[82],"六角粉專",{"title":345,"searchDepth":346,"depth":346,"links":347},"",2,[348,349,354,355,356,357,358,359,360,361],{"id":38,"depth":346,"text":38},{"id":67,"depth":346,"text":67,"children":350},[351,353],{"id":71,"depth":352,"text":72},3,{"id":119,"depth":352,"text":120},{"id":149,"depth":346,"text":149},{"id":190,"depth":346,"text":190},{"id":209,"depth":346,"text":209},{"id":233,"depth":346,"text":233},{"id":244,"depth":346,"text":244},{"id":258,"depth":346,"text":258},{"id":278,"depth":346,"text":278},{"id":295,"depth":346,"text":295},null,"2021-07-22",false,"md",{},true,"\u002Fblog\u002F2021\u002F2021-07-22-js-writing",{"title":5,"description":26},"blog\u002F2021\u002F2021-07-22-js-writing",[372],"event","HfS5eNipuIXODn5q6fou6Jkyd0MuOOYCZ8_me-4hv-g",{"prev":375,"next":378,"related":381,"tags":394},{"title":376,"link":377},"2021 年 JS、Vue  前端培訓班說明會","\u002Fblog\u002F2021-08-20-js-vue-intro-seminar",{"title":379,"link":380},"Vue 3 新手夏令營 (活動已結束)","\u002Fblog\u002F2021-07-07-vue3-summer-camp",[382,385,388,391],{"title":383,"link":384},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":386,"link":387},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":389,"link":390},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":392,"link":393},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[395,396,397,398,399,372,400,401,402,403,404],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292536]