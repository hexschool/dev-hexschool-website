[{"data":1,"prerenderedAt":1237},["ShallowReactive",2],{"blog:2022-06-23-software-engineer-salary":3,"blog:neighbors:2022-06-23-software-engineer-salary":1212},{"id":4,"title":5,"author":6,"body":8,"categories":1200,"date":1201,"description":21,"draft":1202,"extension":1203,"meta":1204,"navigation":1205,"path":1206,"seo":1207,"stem":1208,"tags":1209,"thumbnail":18,"__hash__":1211},"blog\u002Fblog\u002F2022\u002F2022-06-23-software-engineer-salary.md","軟體工程師薪水",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":1182},"minimark",[11,19,22,26,29,113,116,119,122,127,130,210,297,301,304,312,315,326,329,397,476,480,483,551,629,633,636,647,650,653,721,800,804,810,816,884,963,967,973,983,988,1056,1135,1139,1142,1152,1155,1158,1161,1168,1179],[12,13,14],"p",{},[15,16],"img",{"alt":17,"src":18},"首圖 - 軟體工程師薪水","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fengineer-salary%2FUntitled.png?alt=media&token=6db8da0a-15b5-4c51-b8a0-648572cc28d9",[12,20,21],{},"2022 軟體工程師進入了 “大缺工” 的時代（本篇不探討大缺工的原因），也越來越多人關注這個領域，雖然大缺工是一時的，但整個軟體大環境是蓬勃發展的準沒錯。本文將以「長期薪資」的數據推論，給予未來或是目前剛加入軟體工程師領域的各位做參考。",[23,24,25],"h2",{"id":25},"本篇所參考的資料",[12,27,28],{},"主要搜集國內外的求職網站，並以年薪為計算，參考的網站包含：",[30,31,32,33],"div",{},"\n  ",[34,35,37,38,37,58,32],"table",{"style":36},"white-space: nowrap;","\n    ",[39,40,41,42,37],"thead",{},"\n      ",[43,44,45,46,45,49,45,52,45,55,41],"tr",{},"\n        ",[47,48],"th",{},[47,50,51],{},"薪資幣值",[47,53,54],{},"年薪\u002F月薪",[47,56,57],{},"資料量",[59,60,41,61,41,76,41,88,41,100,37],"tbody",{},[43,62,45,63,45,67,45,70,45,73,41],{},[64,65,66],"td",{},"Glassdoor",[64,68,69],{},"USD",[64,71,72],{},"年薪",[64,74,75],{},"足夠",[43,77,45,78,45,81,45,83,45,85,41],{},[64,79,80],{},"Indeed",[64,82,69],{},[64,84,72],{},[64,86,87],{},"足以參考，但缺少關鍵職位",[43,89,45,90,45,93,45,96,45,98,41],{},[64,91,92],{},"104",[64,94,95],{},"TWD",[64,97,72],{},[64,99,75],{},[43,101,45,102,45,105,45,107,45,110,41],{},[64,103,104],{},"1111",[64,106,95],{},[64,108,109],{},"月薪",[64,111,112],{},"面向受限制",[12,114,115],{},"因為每個網站所統計的數據、幣值都不大相同，以國外的 Indeed 與 Glassdoor 為例，同樣均是前端工程師年薪可以差距至一萬美元。所以資料來源會選擇最多、最廣的為優先，盡可能用不同面向呈現軟體工程師的比較薪資。",[12,117,118],{},"另外，國外會有區分 Junior、Senior 的工程師職位，年資與技能深度關聯性較低一些；國內求職網站的資料量限制，則會改為使用「年資」來作為資料表的顯示，取代 Junior 與 Senior 的字眼，雖說如此，台灣的年資約是 5 ~ 10 年符合國外資深工程師的成長幅度。",[23,120,121],{"id":121},"各職位的薪資比較",[123,124,126],"h3",{"id":125},"後端工程師-穩定","後端工程師 - 穩定",[12,128,129],{},"後端工程師算是軟體工程師相對中庸的一個職務，在此的中庸並不是代表能力，而是在職缺市場中職務數是較多，起薪有一定的保證，且在長期發展也有一定需求的職務。\n以下表來說，後端工程師海外的 Senior 與 Junior 的平均薪資就有 35% 左右的差距，相對於其它職務並不是最高，也不至於成長過低。而台灣市場的 5 ~ 10 年年資也可得到 33% 的接近結果。",[30,131,32,132],{},[34,133,37,134,37,148,32],{"style":36},[39,135,41,136,37],{},[43,137,45,138,45,142,45,145,41],{},[47,139,141],{"style":140},"min-width: 120px; width: 120px","平台",[47,143,144],{},"職稱 \u002F 年資",[47,146,147],{"style":140},"薪資",[59,149,41,150,41,166,41,177,41,188,41,199,37],{},[43,151,45,152,45,159,45,163,41],{},[64,153,154,155,158],{},"Glassddor",[156,157],"br",{},"（USD）",[64,160,162],{"style":161},"background-color: #8fb1c28a","Junior Back-end",[64,164,165],{"style":161},"98,551",[43,167,45,168,45,170,45,174,41],{},[64,169],{},[64,171,173],{"style":172},"background-color: #319df2ab;","Back-end",[64,175,176],{"style":172},"108,707",[43,178,45,179,45,181,45,185,41],{},[64,180],{},[64,182,184],{"style":183},"background-color: #319df270;","Back-end 相對 Junior Back-end  成長幅度",[64,186,187],{"style":183},"10.31%",[43,189,45,190,45,192,45,196,41],{},[64,191],{},[64,193,195],{"style":194},"background-color: #3fcc99cc;","Senior Back-end",[64,197,198],{"style":194},"133,128",[43,200,45,201,45,203,45,207,41],{},[64,202],{},[64,204,206],{"style":205},"background-color: #8df2a694;","Senior Back-end 相對 Junior Back-end 成長幅度",[64,208,209],{"style":205},"35.09%",[30,211,32,212],{},[34,213,37,214,37,225,32],{"style":36},[39,215,41,216,37],{},[43,217,45,218,45,220,45,223,41],{},[47,219,141],{"style":140},[47,221,222],{},"年資",[47,224,147],{"style":140},[59,226,41,227,41,237,41,247,41,257,41,267,41,277,41,287,37],{},[43,228,45,229,45,231,45,234,41],{},[64,230,92],{},[64,232,233],{"style":161},"1 年以下",[64,235,236],{"style":161},"66.7 萬",[43,238,45,239,45,241,45,244,41],{},[64,240],{},[64,242,243],{"style":172},"1 ~ 3 年",[64,245,246],{"style":172},"72.5 萬",[43,248,45,249,45,251,45,254,41],{},[64,250],{},[64,252,253],{"style":172},"3 ~ 5 年",[64,255,256],{"style":172},"80.6 萬",[43,258,45,259,45,261,45,264,41],{},[64,260],{},[64,262,263],{"style":183},"3 ~ 5 年 相對 1 年 成長幅度",[64,265,266],{"style":183},"20.84%",[43,268,45,269,45,271,45,274,41],{},[64,270],{},[64,272,273],{"style":194},"5 ~ 10 年",[64,275,276],{"style":194},"88.7 萬",[43,278,45,279,45,281,45,284,41],{},[64,280],{},[64,282,283],{"style":194},"10 年",[64,285,286],{"style":194},"102.4 萬",[43,288,45,289,45,291,45,294,41],{},[64,290],{},[64,292,293],{"style":205},"10 年 相對 1 年 成長幅度",[64,295,296],{"style":205},"53.52%",[123,298,300],{"id":299},"前端工程師-高成長","前端工程師 - 高成長",[12,302,303],{},"相對其它工程師來說，前端工程師易學難精，因此有許多不同領域的人一起投入這個領域，所以在幾大開發類型的工程師來說起薪是偏低的。",[12,305,306,307,311],{},"海外市場的前端工程師 ",[308,309,310],"b",{},"Senior 與 Junior 的平均薪資就有高達 50% 左右的差距，Senior 薪資甚至超越後端工程師","，在國內的 5 ~ 10 年資也是高達 40% 的薪資落差，這兩者的數據均是超過所有的工程師職位，顯得資淺與資深在此職務上的市場需求差異。",[12,313,314],{},"會有這麼大的差異在於：",[316,317,32,318,32,323],"ul",{},[319,320,322],"li",{"style":321},"font-size: 18px;","資深與資淺的能力差異過大",[319,324,325],{"style":321},"許多不同領域加入前端，但能持續精進至資深的人數有限",[12,327,328],{},"所以對於不同領域加入前端的開發者來說，持續精進能力是必要的，才能真正的進入「資深工程師」的甜美薪資。",[30,330,32,331],{},[34,332,37,333,37,343,32],{"style":36},[39,334,41,335,37],{},[43,336,45,337,45,339,45,341,41],{},[47,338,141],{"style":140},[47,340,144],{},[47,342,147],{"style":140},[59,344,41,345,41,357,41,367,41,377,41,387,37],{},[43,346,45,347,45,351,45,354,41],{},[64,348,154,349,158],{},[156,350],{},[64,352,353],{"style":161},"Junior Front-end",[64,355,356],{"style":161},"88,082",[43,358,45,359,45,361,45,364,41],{},[64,360],{},[64,362,363],{"style":172},"Front-end",[64,365,366],{"style":172},"101,606",[43,368,45,369,45,371,45,374,41],{},[64,370],{},[64,372,373],{"style":183},"Front-end 相對 Junior Front-end 成長幅度",[64,375,376],{"style":183},"15.35%",[43,378,45,379,45,381,45,384,41],{},[64,380],{},[64,382,383],{"style":194},"Senior Front-end",[64,385,386],{"style":194},"135,997",[43,388,45,389,45,391,45,394,41],{},[64,390],{},[64,392,393],{"style":205},"Senior Front-end 相對 Junior Front-end 成長幅度",[64,395,396],{"style":205},"54.40%",[30,398,32,399],{},[34,400,37,401,37,411,32],{"style":36},[39,402,41,403,37],{},[43,404,45,405,45,407,45,409,41],{},[47,406,141],{"style":140},[47,408,222],{},[47,410,147],{"style":140},[59,412,41,413,41,422,41,431,41,440,41,449,41,458,41,467,37],{},[43,414,45,415,45,417,45,419,41],{},[64,416,92],{},[64,418,233],{"style":161},[64,420,421],{"style":161},"57.7 萬",[43,423,45,424,45,426,45,428,41],{},[64,425],{},[64,427,243],{"style":172},[64,429,430],{"style":172},"69.9 萬",[43,432,45,433,45,435,45,437,41],{},[64,434],{},[64,436,253],{"style":172},[64,438,439],{"style":172},"77 萬",[43,441,45,442,45,444,45,446,41],{},[64,443],{},[64,445,263],{"style":183},[64,447,448],{"style":183},"33.45%",[43,450,45,451,45,453,45,455,41],{},[64,452],{},[64,454,273],{"style":194},[64,456,457],{"style":194},"81.3 萬",[43,459,45,460,45,462,45,464,41],{},[64,461],{},[64,463,283],{"style":194},[64,465,466],{"style":194},"98.6 萬",[43,468,45,469,45,471,45,473,41],{},[64,470],{},[64,472,293],{"style":205},[64,474,475],{"style":205},"70.88%",[123,477,479],{"id":478},"全端工程師-萬能型","全端工程師 - 萬能型",[12,481,482],{},"與前兩者來說，全端工程師的薪資成長是最不明顯的，但在起薪及最高薪均是勝過於前兩者。\n全端工程師同時需要掌握前後端的能力，所以起薪及最高薪均超過前後端是理所當然的，而其實「全端工程師」這個職務並非從頭到尾都是全端工程師，無論是前端、後端都可以在工作的幾年後轉換跑道作為全端工程師。",[30,484,32,485],{},[34,486,37,487,37,497,32],{"style":36},[39,488,41,489,37],{},[43,490,45,491,45,493,45,495,41],{},[47,492,141],{"style":140},[47,494,144],{},[47,496,147],{"style":140},[59,498,41,499,41,511,41,521,41,531,41,541,37],{},[43,500,45,501,45,505,45,508,41],{},[64,502,154,503,158],{},[156,504],{},[64,506,507],{"style":161},"Junior Full-stack",[64,509,510],{"style":161},"103,212",[43,512,45,513,45,515,45,518,41],{},[64,514],{},[64,516,517],{"style":172},"Full-stack",[64,519,520],{"style":172},"113,377",[43,522,45,523,45,525,45,528,41],{},[64,524],{},[64,526,527],{"style":183},"Full-stack 相對 Junior Full-stack 成長幅度",[64,529,530],{"style":183},"9.85%",[43,532,45,533,45,535,45,538,41],{},[64,534],{},[64,536,537],{"style":194},"Senior Full-stack",[64,539,540],{"style":194},"137,976",[43,542,45,543,45,545,45,548,41],{},[64,544],{},[64,546,547],{"style":205},"Senior Full-stack 相對 Junior Full-stack 成長幅度",[64,549,550],{"style":205},"33.68%",[30,552,32,553],{},[34,554,37,555,37,565,32],{"style":36},[39,556,41,557,37],{},[43,558,45,559,45,561,45,563,41],{},[47,560,141],{"style":140},[47,562,222],{},[47,564,147],{"style":140},[59,566,41,567,41,576,41,585,41,594,41,603,41,611,41,620,37],{},[43,568,45,569,45,571,45,573,41],{},[64,570,92],{},[64,572,233],{"style":161},[64,574,575],{"style":161},"68.2 萬",[43,577,45,578,45,580,45,582,41],{},[64,579],{},[64,581,243],{"style":172},[64,583,584],{"style":172},"71.6 萬",[43,586,45,587,45,589,45,591,41],{},[64,588],{},[64,590,253],{"style":172},[64,592,593],{"style":172},"81.5 萬",[43,595,45,596,45,598,45,600,41],{},[64,597],{},[64,599,263],{"style":183},[64,601,602],{"style":183},"19.50%",[43,604,45,605,45,607,45,609,41],{},[64,606],{},[64,608,273],{"style":194},[64,610,276],{"style":194},[43,612,45,613,45,615,45,617,41],{},[64,614],{},[64,616,283],{"style":194},[64,618,619],{"style":194},"108.4 萬",[43,621,45,622,45,624,45,626,41],{},[64,623],{},[64,625,293],{"style":205},[64,627,628],{"style":205},"58.94%",[123,630,632],{"id":631},"開發維運工程師-市場大小決定薪資","開發維運工程師 - 市場大小決定薪資",[12,634,635],{},"開發維運工程師在國內外落差有點大，這是一個相當專業的領域，台灣搜尋的資料結果可能有誤，我推測的原因如下：",[316,637,32,638,32,641,32,644],{},[319,639,640],{"style":321},"系統將一般開發工程師、維運工程師統一計算至開發維運工程師",[319,642,643],{"style":321},"職務上是作為 開發或維運 工程師，實質上與一般工程師無異，只是用了這個名字",[319,645,646],{"style":321},"台灣的市場相對沒有那麼大，因此 DevOps 的需求沒有國外那麼吃重，因此也較難給予更高的薪資",[12,648,649],{},"雖說如此，台灣依然有公司願意撥出很高的薪資在「開發維運上」，而且就沒有經驗的 DevOps 開發者來說，許多公司也願意給予超過有年資的薪資，代表台灣市場也是越來越重視這個領域。",[12,651,652],{},"身為一個「就算沒睜眼也都在燒公司錢」的職務，國外的起薪就是所有工程師最高的，也期望台灣此職位未來能持續往此目標邁進。",[30,654,32,655],{},[34,656,37,657,37,667,32],{"style":36},[39,658,41,659,37],{},[43,660,45,661,45,663,45,665,41],{},[47,662,141],{"style":140},[47,664,144],{},[47,666,147],{"style":140},[59,668,41,669,41,681,41,691,41,701,41,711,37],{},[43,670,45,671,45,675,45,678,41],{},[64,672,154,673,158],{},[156,674],{},[64,676,677],{"style":161},"Junior DevOps",[64,679,680],{"style":161},"115,441",[43,682,45,683,45,685,45,688,41],{},[64,684],{},[64,686,687],{"style":172},"DevOps",[64,689,690],{"style":172},"122,498",[43,692,45,693,45,695,45,698,41],{},[64,694],{},[64,696,697],{"style":183},"DevOps 相對 Junior DevOps 成長幅度",[64,699,700],{"style":183},"6.11%",[43,702,45,703,45,705,45,708,41],{},[64,704],{},[64,706,707],{"style":194},"Senior DevOps",[64,709,710],{"style":194},"141,234",[43,712,45,713,45,715,45,718,41],{},[64,714],{},[64,716,717],{"style":205},"Senior DevOps 相對 Junior DevOps 成長幅度",[64,719,720],{"style":205},"22.34%",[30,722,32,723],{},[34,724,37,725,37,735,32],{"style":36},[39,726,41,727,37],{},[43,728,45,729,45,731,45,733,41],{},[47,730,141],{"style":140},[47,732,222],{},[47,734,147],{"style":140},[59,736,41,737,41,746,41,755,41,764,41,773,41,782,41,791,37],{},[43,738,45,739,45,741,45,743,41],{},[64,740,92],{},[64,742,233],{"style":161},[64,744,745],{"style":161},"65.7 萬",[43,747,45,748,45,750,45,752,41],{},[64,749],{},[64,751,243],{"style":172},[64,753,754],{"style":172},"55.8 萬",[43,756,45,757,45,759,45,761,41],{},[64,758],{},[64,760,253],{"style":172},[64,762,763],{"style":172},"57 萬",[43,765,45,766,45,768,45,770,41],{},[64,767],{},[64,769,263],{"style":183},[64,771,772],{"style":183},"-13.24%",[43,774,45,775,45,777,45,779,41],{},[64,776],{},[64,778,273],{"style":194},[64,780,781],{"style":194},"62.1 萬",[43,783,45,784,45,786,45,788,41],{},[64,785],{},[64,787,283],{"style":194},[64,789,790],{"style":194},"64.9 萬",[43,792,45,793,45,795,45,797,41],{},[64,794],{},[64,796,293],{"style":205},[64,798,799],{"style":205},"-1.22%",[123,801,803],{"id":802},"行動應用工程師-高起薪","行動應用工程師 - 高起薪",[805,806,807],"blockquote",{},[12,808,809],{},"說明：因為台灣的 “行動應用工程師” 數據不足，所以改用 iOS 開發工程師做搜尋",[12,811,812,813,815],{},"行動應用工程師是一個起薪偏高，但在長期的成長幅度偏低的工程師，海外市場的 Junior 高於全端工程師；台灣市場亦是如此。不過在 Senior 及台灣的高年資薪資卻是低於前後端工程師。",[156,814],{},"\n就數據上來說，海外的 Senior 與 Junior 差異約 15%（後端工程師的一半），台灣市場的 5 ~ 10 年開發者也約是新進開發者的 9.3%，可以顯示行動應用工程師進入職場有很大的優勢，但就長期來說薪資較不會有明顯的成長。這點的可能性在於相對於其他領域工程師，行動應用工程師的 ”廣度有限“，以至於新人與資深開發者沒有較大的區隔。",[30,817,32,818],{},[34,819,37,820,37,830,32],{"style":36},[39,821,41,822,37],{},[43,823,45,824,45,826,45,828,41],{},[47,825,141],{"style":140},[47,827,144],{},[47,829,147],{"style":140},[59,831,41,832,41,844,41,854,41,864,41,874,37],{},[43,833,45,834,45,838,45,841,41],{},[64,835,154,836,158],{},[156,837],{},[64,839,840],{"style":161},"Junior Mobile Application",[64,842,843],{"style":161},"109,634",[43,845,45,846,45,848,45,851,41],{},[64,847],{},[64,849,850],{"style":172},"Mobile Application",[64,852,853],{"style":172},"112,173",[43,855,45,856,45,858,45,861,41],{},[64,857],{},[64,859,860],{"style":183},"Mobile Application 相對 Junior Mobile Application 成長幅度",[64,862,863],{"style":183},"2.32%",[43,865,45,866,45,868,45,871,41],{},[64,867],{},[64,869,870],{"style":194},"Senior Mobile Application",[64,872,873],{"style":194},"126,595",[43,875,45,876,45,878,45,881,41],{},[64,877],{},[64,879,880],{"style":205},"Senior Mobile Application 相對 Junior Mobile Application 成長幅度",[64,882,883],{"style":205},"15.47%",[30,885,32,886],{},[34,887,37,888,37,898,32],{"style":36},[39,889,41,890,37],{},[43,891,45,892,45,894,45,896,41],{},[47,893,141],{"style":140},[47,895,222],{},[47,897,147],{"style":140},[59,899,41,900,41,909,41,918,41,927,41,936,41,945,41,954,37],{},[43,901,45,902,45,904,45,906,41],{},[64,903,92],{},[64,905,233],{"style":161},[64,907,908],{"style":161},"73.1 萬",[43,910,45,911,45,913,45,915,41],{},[64,912],{},[64,914,243],{"style":172},[64,916,917],{"style":172},"70 萬",[43,919,45,920,45,922,45,924,41],{},[64,921],{},[64,923,253],{"style":172},[64,925,926],{"style":172},"76.2 萬",[43,928,45,929,45,931,45,933,41],{},[64,930],{},[64,932,263],{"style":183},[64,934,935],{"style":183},"4.24%",[43,937,45,938,45,940,45,942,41],{},[64,939],{},[64,941,273],{"style":194},[64,943,944],{"style":194},"79.9 萬",[43,946,45,947,45,949,45,951,41],{},[64,948],{},[64,950,283],{"style":194},[64,952,953],{"style":194},"90 萬",[43,955,45,956,45,958,45,960,41],{},[64,957],{},[64,959,293],{"style":205},[64,961,962],{"style":205},"23.12%",[123,964,966],{"id":965},"產品測試工程師-被嚴重誤解的職位","產品測試工程師 - 被嚴重誤解的職位",[12,968,969,970],{},"就數據上來說，產品測試工程師看起來薪資是最低的，主要原因是這個職位有許多並非真正的「開發者」，可能具有基本的程式經驗，但可能沒有撰寫過完整的產品；雖美其名稱為「工程師」，但本質是按照文件操作的操作員。\n而真正的產品測試工程師，具有一定的開發經歷（能從測試結果反推可能的問題點），且對於產品的最終上線目標有一定掌握度（了解用戶的行為以及關鍵的測試點），同時還要能夠撰寫自動化、高併發等技術性測試。\n以下圖來說，可以看到同為資深工程師，兩者真正的天花板是完全不同等級的，資深產品測試的薪資可以到 595k USD；而資深前端為 347k USD，所以說 QA 本身是被誤解最深的職位是毋庸置疑的。\n",[15,971],{"src":972,"alt":966},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fengineer-salary%2FUntitled 1.png?alt=media&token=68a13a98-7cea-461c-858d-d0ba8fa929fe",[12,974,975,979],{},[976,977,978],"small",{},"在 Glassdoor 網站上可以看到，Senior QA 的薪資可能的最高值達到 595k",[15,980],{"src":981,"alt":982},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fengineer-salary%2FUntitled 2.png?alt=media&token=9777d532-de27-4e26-993e-890b48f5a8f0","產品測試工程師 - 被嚴重誤解的職位（2）",[12,984,985],{},[976,986,987],{},"在 Glassdoor 網站上的 Senior Frontend Developer 的薪資",[30,989,32,990],{},[34,991,37,992,37,1002,32],{"style":36},[39,993,41,994,37],{},[43,995,45,996,45,998,45,1000,41],{},[47,997,141],{"style":140},[47,999,144],{},[47,1001,147],{"style":140},[59,1003,41,1004,41,1016,41,1026,41,1036,41,1046,37],{},[43,1005,45,1006,45,1010,45,1013,41],{},[64,1007,154,1008,158],{},[156,1009],{},[64,1011,1012],{"style":161},"Junior QA",[64,1014,1015],{"style":161},"75,513",[43,1017,45,1018,45,1020,45,1023,41],{},[64,1019],{},[64,1021,1022],{"style":172},"QA",[64,1024,1025],{"style":172},"89,362",[43,1027,45,1028,45,1030,45,1033,41],{},[64,1029],{},[64,1031,1032],{"style":183},"QA 相對 Junior QA 成長幅度",[64,1034,1035],{"style":183},"18.34%",[43,1037,45,1038,45,1040,45,1043,41],{},[64,1039],{},[64,1041,1042],{"style":194},"Senior QA",[64,1044,1045],{"style":194},"111,908",[43,1047,45,1048,45,1050,45,1053,41],{},[64,1049],{},[64,1051,1052],{"style":205},"Senior QA 相對 Junior QA 成長幅度",[64,1054,1055],{"style":205},"48.20%",[30,1057,32,1058],{},[34,1059,37,1060,37,1070,32],{"style":36},[39,1061,41,1062,37],{},[43,1063,45,1064,45,1066,45,1068,41],{},[47,1065,141],{"style":140},[47,1067,222],{},[47,1069,147],{"style":140},[59,1071,41,1072,41,1081,41,1090,41,1099,41,1108,41,1117,41,1126,37],{},[43,1073,45,1074,45,1076,45,1078,41],{},[64,1075,92],{},[64,1077,233],{"style":161},[64,1079,1080],{"style":161},"60.5 萬",[43,1082,45,1083,45,1085,45,1087,41],{},[64,1084],{},[64,1086,243],{"style":172},[64,1088,1089],{"style":172},"61.5 萬",[43,1091,45,1092,45,1094,45,1096,41],{},[64,1093],{},[64,1095,253],{"style":172},[64,1097,1098],{"style":172},"68.6 萬",[43,1100,45,1101,45,1103,45,1105,41],{},[64,1102],{},[64,1104,263],{"style":183},[64,1106,1107],{"style":183},"13.39%",[43,1109,45,1110,45,1112,45,1114,41],{},[64,1111],{},[64,1113,273],{"style":194},[64,1115,1116],{"style":194},"74.7 萬",[43,1118,45,1119,45,1121,45,1123,41],{},[64,1120],{},[64,1122,283],{"style":194},[64,1124,1125],{"style":194},"85.3 萬",[43,1127,45,1128,45,1130,45,1132,41],{},[64,1129],{},[64,1131,293],{"style":205},[64,1133,1134],{"style":205},"40.99%",[23,1136,1138],{"id":1137},"工作兩年後如何獲得更高的薪資","工作兩年後，如何獲得更高的薪資",[12,1140,1141],{},"雖然每個工作的起薪及成長幅度不同，不過就長期來說有幾個基本面向是不變的：",[1143,1144,32,1146,32,1149],"ol",{"style":1145},"list-style-position: inside;",[319,1147,1148],{"style":321},"提升技術廣度",[319,1150,1151],{"style":321},"不要十年如一日，持續接觸不同環境",[123,1153,1154],{"id":1154},"技術廣度",[12,1156,1157],{},"在上面所提到的職位，可以看到有高成長性（最高薪及起薪落差大）及資深最高薪資的職位，相對於其它職位最大的不同在於 “廣度” 的不同，以全端工程師來說，就同時兼顧了前後端語言，並且需要具備一定能力的 DevOps、測試等知識，所以自然來說薪資也會更高。\n那是否每個人都需要直接切入「全端工程師」呢？那倒也未必，就以前端工程師來說，會建議不必限縮自己的學習領域，在具備一定的 JavaScript 能力以後，就可以持續的學習後端、雲服務等不同知識。以前端掌握後端知識來說，就算工作上不需要經手後端開發，但相較於純前端的開發者也會有更強的溝通能力，對於需求也會有更好的掌握能力。",[123,1159,1151],{"id":1160},"不要十年如一日持續接觸不同環境",[12,1162,1163,1164,1167],{},"雖然台灣許多職位會以年資來決定薪資，而國外在職稱上就會有所區別，如：Junior、Senior，但其實台灣一直也是有這樣的職稱差異，主要在專門的資訊公司、新創都會加上「資深」的字眼來做區隔，而不是一昧的使用年資。\n真正的",[308,1165,1166],{},"資深開發者","在工作上來說，並不是只有專注在自己的工作，而是除了技術本身以外還能協助團隊及公司，因此資深開發者不會用 “年資” 來呈現深度，會具備以下的能力來應對不同事物：",[1143,1169,32,1170,32,1173,32,1176],{"style":1145},[319,1171,1172],{"style":321},"更強的技術能力",[319,1174,1175],{"style":321},"獨立解決問題的能力",[319,1177,1178],{"style":321},"輔導新人的能力",[12,1180,1181],{},"對於公司來說，能夠解決越多問題的人才就是好人才，哪怕只是一個新人到職，你只要能夠讓磨合期從三個月濃縮至兩週，都是非常有價值的行為，而這些都是屬於開發者在技術上的「軟技能」，只有持續精進技術搭配軟技能，才有可能成為真正的資深工程師。",{"title":1183,"searchDepth":1184,"depth":1184,"links":1185},"",2,[1186,1187,1196],{"id":25,"depth":1184,"text":25},{"id":121,"depth":1184,"text":121,"children":1188},[1189,1191,1192,1193,1194,1195],{"id":125,"depth":1190,"text":126},3,{"id":299,"depth":1190,"text":300},{"id":478,"depth":1190,"text":479},{"id":631,"depth":1190,"text":632},{"id":802,"depth":1190,"text":803},{"id":965,"depth":1190,"text":966},{"id":1137,"depth":1184,"text":1138,"children":1197},[1198,1199],{"id":1154,"depth":1190,"text":1154},{"id":1160,"depth":1190,"text":1151},null,"2022-06-23",false,"md",{},true,"\u002Fblog\u002F2022\u002F2022-06-23-software-engineer-salary",{"title":5,"description":21},"blog\u002F2022\u002F2022-06-23-software-engineer-salary",[1210],"software engineer","2T7DEDoPWigz56jpYdmxiVnk8xc_6egfxd8WNOhNs8c",{"prev":1213,"next":1216,"related":1219,"tags":1226},{"title":1214,"link":1215},"React 新手讀書會","\u002Fblog\u002F2022-06-27-react-study-circle",{"title":1217,"link":1218},"【全職爸爸轉前端】把握任何能讓自己變強的機會或是方式！內附小彩蛋","\u002Fblog\u002F2022-06-10-tim-full-time-learning",[1220,1223],{"title":1221,"link":1222},"軟體工程師有年齡、學歷、背景限制嗎？","\u002Fblog\u002F2022-07-25-software-engineer-restrict",{"title":1224,"link":1225},"軟體工程師有哪些類別","\u002Fblog\u002F2022-05-30-software-engineer-category",[1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1210],"UI design","course","css","css3","enterprise","event","interview","javascript","jobs","skilltree",1790064291723]