[{"data":1,"prerenderedAt":364},["ShallowReactive",2],{"blog:2019-11-05-remote-jobs-third":3,"blog:neighbors:2019-11-05-remote-jobs-third":333},{"id":4,"title":5,"author":6,"body":8,"categories":320,"date":321,"description":322,"draft":323,"extension":324,"meta":325,"navigation":326,"path":327,"seo":328,"stem":329,"tags":330,"thumbnail":17,"__hash__":332},"blog\u002Fblog\u002F2019\u002F2019-11-05-remote-jobs-third.md","【學員專屬徵才 - 第三波遠端助教】無工作經驗者優先錄取",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":305},"minimark",[11,18,31,34,38,47,50,54,57,60,67,70,73,79,88,91,94,97,117,120,131,134,163,167,183,186,218,221,229,232,235,263,266,269],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F11%2Fhex-hire-TA-fb-3rd.png?alt=media&token=0fb5d150-3401-4380-80f5-8154dd74cd31",[19,20,21,25,28],"ul",{},[22,23,24],"li",{},"你想要轉職工程師，但怕全職投入，卻沒有收入養活自己？",[22,26,27],{},"你想要成為工程師，但是對自己的技能沒有信心？",[22,29,30],{},"你希望學會程式後，也希望有機會一展長才？",[12,32,33],{},"如果以上列表，你的答案是 Yes，同時又是六角學員的話，我們要的就是你！",[35,36,37],"h2",{"id":37},"徵才職缺與門檻",[19,39,40],{},[22,41,42,46],{},[43,44,45],"strong",{},"網頁開發助教"," - 需有完成 CSS、JQ、RWD、BS4、JS 入門-學徒的試煉 最終作業，並 CSS 與 RWD 皆有達到優的成績。",[12,48,49],{},"另外，我們會提供一個問題表單給您，以確保您對課程內容是否有足夠的理解。",[35,51,53],{"id":52},"門檻-qa","門檻 Q&A",[12,55,56],{},"Q：我如果只有註冊 RWD > BS4，沒註冊 CSS 與 jQ ，但也相當熟悉可以申請嗎？\nA：不行，必須四門課都有註冊，且做完最終作業，才可申請。",[12,58,59],{},"Q：我如果只有完成 CSS, jQ, RWD, BS4，但沒有完成 JS 入門-學徒的試煉 可以申請嗎？\nA：不行，必須五門課都有做完最終作業，才可申請。",[12,61,62,63,66],{},"Q：如果我 CSS、RWD 其中一個作業沒有達優，是否就不能申請這一波申請？\nA：",[43,64,65],{},"只要你有在 11\u002F20 前提交作業便可申請，申請期限是到 12\u002F8","，但若沒獲得優選則不符合門檻*。*您可以等下波我們徵召前，提供修改後的作業，以達到優的成績後再行申請。",[12,68,69],{},"Q：如果我 CSS、RWD 成績是 A，但有給老師再次檢視，且老師也回信給我說改得都 ok，只差沒給我更新過後的「優」評價的話，可以申請嗎？\nA：可以，申請時提供 email 給我們確認即可。",[35,71,72],{"id":72},"評選機制",[12,74,75,78],{},[43,76,77],{},"所有符合上述門檻的學員，皆不會落選，此評選機制完全不看您的學歷","，但有優先順序，我們會依照以下機制，將條件優先提供給最需要這份工作的學員。",[80,81,82,85],"ol",{},[22,83,84],{},"全職準備且沒有工作收入者，優先入選",[22,86,87],{},"完全沒有程式工作經驗者，優先入選",[12,89,90],{},"若您尚未被選上，也會提供排隊編號給您，待前面學員工作結束後，便會透過 email 提供到職通知。",[12,92,93],{},"PS：此評選機制是希望真正有意成為工程師的學員可以透過此機制，能夠提早獲得程式工作經驗，有足夠的信心以協接業界。",[35,95,96],{"id":96},"這份工作的優點",[19,98,99,105,111],{},[22,100,101,104],{},[43,102,103],{},"知識再吸收","：藉由教學講解，能夠有效幫助自己的知識能夠重新收納整理，讓觀念更加穩固",[22,106,107,110],{},[43,108,109],{},"信心建立","：讓您藉由知識傳承，讓自己技術能夠再往上一個層次，並有足夠的信心挑戰更好的工作機會。",[22,112,113,116],{},[43,114,115],{},"工作彈性","：一週可以隨意選擇時數來工作，時間自主性高。",[35,118,119],{"id":119},"工作內容",[19,121,122,125,128],{},[22,123,124],{},"回覆學員程式問題",[22,126,127],{},"批改學員程式碼 (小節作業、最終作業)",[22,129,130],{},"協助評估課程流暢度，讓課程更臻完善。",[35,132,133],{"id":133},"工作時間",[19,135,136,144],{},[22,137,138,139],{},"每位應徵者工作長度如下",[19,140,141],{},[22,142,143],{},"網頁開發助教：3 個月",[22,145,146,147],{},"工作時段，有兩個時段可以挑選",[19,148,149,157],{},[22,150,151,152,156],{},"週一",[153,154,155],"del",{},"週五的早上 09:00","11:00 ，六日請任選一天(時段相同)，總計六天",[22,158,151,159,162],{},[153,160,161],{},"週五的下午 13:00","15:00，六日請任選一天(時段相同)，總計六天",[35,164,166],{"id":165},"舉例","舉例：",[19,168,169,176],{},[22,170,171,172,175],{},"小明：有 14 小時實習時間，時段為週一",[153,173,174],{},"週日的下午 3","5 點",[22,177,178,179,182],{},"小花：有 10 小時實習時間：時段為週一",[153,180,181],{},"五的早上 9","11 點",[35,184,185],{"id":185},"工作流程",[19,187,188,194,200,206,212],{},[22,189,190,193],{},[43,191,192],{},"前期教育訓練","：將會提供教育訓練影片，不論在回覆口吻、書寫習慣、聚焦問題上，六角皆有一套 SOP ，以幫助助教快速了解其流程。",[22,195,196,199],{},[43,197,198],{},"模擬演練","：每一位遠端助教在初期都會配置一位助教長，初期在回覆問題前，都必須獲得助教長審核過後，才可代表六角助教回覆。藉由此機制，幫助學員能夠在此工作上能逐漸掌握訣竅。",[22,201,202,205],{},[43,203,204],{},"獨當一面","：我們會有不定期的審核機制，若審核成功，往後您就可獨立運作來回覆學員問題。",[22,207,208,211],{},[43,209,210],{},"知識傳承","：當您對工作業務駕輕就熟後，就能升級為助教長，成為未來新人的教練，以進行教育傳承。",[22,213,214,217],{},[43,215,216],{},"協助就業","：我們正在規劃官網提供學員履歷刊登服務，將會讓畢業的遠端助教優先進行人才曝光，協助企業媒合。",[35,219,220],{"id":220},"薪水福利",[19,222,223,226],{},[22,224,225],{},"150\u002Fhr",[22,227,228],{},"無勞健保，此工作內容為執行業務、非常態性工作，故視為勞務外包。",[35,230,231],{"id":231},"應徵辦法",[12,233,234],{},"請依照以下兩步驟進行申請：",[80,236,237,251],{},[22,238,239,242,243,250],{},[43,240,241],{},"能力判定","：我們挑出了些學員問題，請您盡量試著回覆該問題內容，在 excel 上填寫你的答案後，再將 Google excel 表單提供給我們檢視，",[244,245,249],"a",{"href":246,"rel":247},"https:\u002F\u002Fdocs.google.com\u002Fspreadsheets\u002Fd\u002F1pt2K92O396tjNLUhipKkeqe8iy7q7zHgV7JA9AK5fOw\u002Fedit#gid=1902149847",[248],"nofollow","網頁開發問題表單","。",[22,252,253,256,257,262],{},[43,254,255],{},"申請表單","：請填寫此",[244,258,261],{"href":259,"rel":260},"https:\u002F\u002Fforms.gle\u002FMXAsDYtVxwS5HTAU7",[248],"表單","進行應徵流程，12\u002F8 晚上 23:59 分停止收件。將會等此批助教都畢業後才會進行下一波徵召。",[12,264,265],{},"同時會在停止收件後，陸許審核發錄取通知信給第一波助教名單。",[35,267,268],{"id":268},"遠端助教工作心得",[19,270,271,278,285,292,299],{},[22,272,273],{},[244,274,277],{"href":275,"rel":276},"https:\u002F\u002Fayugioh2003.github.io\u002F2019\u002F07\u002Fhexschool-TA-experience\u002F",[248],"小麥 - 兩個月來擔任六角遠端切版助教的心得",[22,279,280],{},[244,281,284],{"href":282,"rel":283},"https:\u002F\u002Fkiwitiger.github.io\u002F2019\u002F11\u002F04\u002Fassistant20191104\u002F?fbclid=IwAR2t-UKCW0rVebZOf2KQpSZaPbJtthoSiDqPLHJ4Me6C-ZsTnPFGITxgsvE",[248],"Stacey - 擔任六角學院遠端網頁排版助教的那段日子",[22,286,287],{},[244,288,291],{"href":289,"rel":290},"https:\u002F\u002Fpvt5r486.github.io\u002Fnote\u002F20190524\u002F3138494786\u002F",[248],"宇軒 - 擔任六角遠端助教的那一段日子",[22,293,294],{},[244,295,298],{"href":296,"rel":297},"https:\u002F\u002Fmedium.com\u002F@boy80314\u002F0-%E5%89%8D%E7%AB%AF%E5%8A%A9%E6%95%99%E5%BF%83%E8%B7%AF%E6%AD%B7%E7%A8%8B-f6ae02543738",[248],"RTING LOU - 前端助教心路歷程",[22,300,301],{},[244,302,304],{"href":289,"rel":303},[248],"英鳴 - 擔任六角學院遠端助教的這 3 個月",{"title":306,"searchDepth":307,"depth":307,"links":308},"",2,[309,310,311,312,313,314,315,316,317,318,319],{"id":37,"depth":307,"text":37},{"id":52,"depth":307,"text":53},{"id":72,"depth":307,"text":72},{"id":96,"depth":307,"text":96},{"id":119,"depth":307,"text":119},{"id":133,"depth":307,"text":133},{"id":165,"depth":307,"text":166},{"id":185,"depth":307,"text":185},{"id":220,"depth":307,"text":220},{"id":231,"depth":307,"text":231},{"id":268,"depth":307,"text":268},null,"2019-11-05","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2019\u002F2019-11-05-remote-jobs-third",{"title":5,"description":322},"blog\u002F2019\u002F2019-11-05-remote-jobs-third",[331],"jobs","JvqBB5Q_geOadMn7zxal5MdhS-gX0Rj1ffbBRpBRFLo",{"prev":334,"next":337,"related":340,"tags":353},{"title":335,"link":336},"w3HexSchool 鼠年全馬鐵人挑戰","\u002Fblog\u002F2019-11-14-w3hexschool-2020-challenge",{"title":338,"link":339},"【大神來六角】十月直播主題：遠端接案","\u002Fblog\u002F2019-09-24-god-and-hexschool",[341,344,347,350],{"title":342,"link":343},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":345,"link":346},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":348,"link":349},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":351,"link":352},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[354,355,356,357,358,359,360,361,331,362,363],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064292179]