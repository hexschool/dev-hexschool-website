[{"data":1,"prerenderedAt":239},["ShallowReactive",2],{"blog:2020-03-24-21days-keybr-game":3,"blog:neighbors:2020-03-24-21days-keybr-game":208},{"id":4,"title":5,"author":6,"body":8,"categories":195,"date":196,"description":197,"draft":198,"extension":199,"meta":200,"navigation":201,"path":202,"seo":203,"stem":204,"tags":205,"thumbnail":17,"__hash__":207},"blog\u002Fblog\u002F2020\u002F2020-03-24-21days-keybr-game.md","21 天英打鍛鍊武道大會",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":183},"minimark",[11,18,21,29,34,74,78,95,98,103,106,110,113,116,120,127,133,139,149,155,165,177],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F03%2F21days.png?alt=media&token=0d60500b-1c6f-4dca-8d20-e9d1dc01b90a",[12,19,20],{},"你常因為技術單字拼錯，害你 Debug 了一個下午嗎？\n你開始學程式，才進而接觸英打嗎？",[12,22,23,24,28],{},"那就來參加 ",[25,26,27],"strong",{},"21 天英打武道大會","！藉由天天鍛鍊、天天堅持，讓自己成為英打神人！",[30,31,33],"h2",{"id":32},"參賽報名三步驟","參賽報名三步驟：",[35,36,37,49,62,71],"ol",{},[38,39,40,41,48],"li",{},"填寫 ",[42,43,47],"a",{"href":44,"rel":45},"https:\u002F\u002Fhexschool.tw\u002Fkeybr",[46],"nofollow","Google 表單"," 申請報名",[38,50,51,52,57,58,61],{},"3\u002F30 開賽，每天到 ",[42,53,56],{"href":54,"rel":55},"http:\u002F\u002Fkeybr.com\u002F",[46],"keybr.com"," 進行鍛鍊，結束後 ",[42,59,47],{"href":44,"rel":60},[46],"回報英打成績",[38,63,64,65,70],{},"加入 ",[42,66,69],{"href":67,"rel":68},"https:\u002F\u002Fjoin.slack.com\u002Ft\u002Fhexschool-share\u002Fshared_invite\u002Fzt-8g5xq352-jtm2jdeov04XaYPL73TYMQ",[46],"Slack 鍛鍊頻道","，頻道名稱為「21 天英打鍛鍊武道大會」",[38,72,73],{},"4\u002F19 完賽，紀錄各玩家排名",[30,75,77],{"id":76},"keybrcom-教學操作","keybr.com 教學操作",[79,80,81,88],"ul",{},[38,82,83],{},[42,84,87],{"href":85,"rel":86},"https:\u002F\u002Fmedium.com\u002F@gonsakon\u002F%E9%AB%98%E6%95%88%E7%B7%B4%E8%8B%B1%E6%89%93%E7%A5%9E%E5%99%A8-keybr-com-3cad9325a5e6",[46],"高效練英打神器 — keybr.com",[38,89,90],{},[42,91,94],{"href":92,"rel":93},"https:\u002F\u002Fsamtsai.org\u002F2016\u002F11\u002F03\u002F122-typing-practice-keybr\u002F",[46],"免費的線上英打練習—Keybr.com",[30,96,97],{"id":97},"獎項",[99,100,102],"h3",{"id":101},"鐵人進步獎-持續-21-天並提升至少-15-wpm-即可獲獎","鐵人進步獎 - 持續 21 天並提升至少 15 wpm 即可獲獎",[12,104,105],{},"從 3\u002F30 第一天開始計算初始成績，持續 21 天後看您計算了多少 wpm。\n以下為範例：\n小明 3\u002F30 wpm 成績為 40 wpm，過 21 天後，wpm 成長到 65，一共進步 25 wpm，具備獲獎資格",[99,107,109],{"id":108},"鐵人神速獎-持續-21-天取成績最高前-20-名","鐵人神速獎 - 持續 21 天，取成績最高前 20 名",[12,111,112],{},"持續 21 天鍛鍊，看誰的 wpm 成績最高便為勝者：\n以下為範例：\n小君過 21 天後，wpm 成長到 65\n小葉過 21 天後，wpm 成長到 75",[12,114,115],{},"勝者為小葉，因為他速度最快",[30,117,119],{"id":118},"常見-qa","常見 QA",[12,121,122,126],{},[123,124,125],"b",{},"Q：為什麼有這活動？","\nA：鑑於我們常觀察到學員們很常單字拼錯，查問題查了一整天，才發現是自己單字拼錯的困擾，為了提升學員整體英打準確率，才開辦此活動。還有就是最近新冠肺炎搞得大家烏煙瘴氣，還是辦些練功活動來充實自己比較平衡。",[12,128,129,132],{},[123,130,131],{},"Q：練英打可以提升程式技能嗎？背單字可以嗎？","\nA：練習英打主要是提升你「26 個字母位置輸入熟練度」，目前編輯器都很強大，只要輸入前幾個字就會有單字提示，為了要讓您能專注程式邏輯思考，練英打也能讓您更有信心在程式輸入上，避免頻頻擔心英文輸入錯誤而懷疑人生。",[12,134,135,138],{},[123,136,137],{},"Q：什麼是 WPM？","\nA：wpm 是單詞每分鐘（英語：Words per minute，縮寫 wpm），每 5 個字元就是 1wpm。",[12,140,141,144,145,148],{},[123,142,143],{},"Q：我有興趣參加，一天大概要練習多久呢？","\nA：5~25 分鐘左右尤佳，你沒看錯，這是 ",[42,146,56],{"href":54,"rel":147},[46]," 所建議的時間。只要每天少少的鍛鍊，就能穩健提升 wpm 速度。",[12,150,151,154],{},[123,152,153],{},"Q： 一定要持續 21 天嗎？","\nA：是的，要獲得獎項的話，前提是要完成 21 天，天天鍛鍊天天堅持",[12,156,157,164],{},[123,158,159,160,163],{},"Q：",[42,161,56],{"href":54,"rel":162},[46]," 跟其他服務差異在哪？","\nA：它能夠記憶您不熟的按鍵，並適當提供對應的單字來大量練習，進而產生「肌肉記憶」，讓您藉由各種菜單訓練，來提升英打能力。例如它偵測到您對 Q、T、Y 按鍵不熟，或者一兩個單字切換不順時，就會提供對應單字讓您持續練習。",[12,166,167,170,171,176],{},[123,168,169],{},"Q：真的有效嗎？有沒有真人案例？","\nA：這服務由六角校長洧杰老師親身嘗試過，確實有效，短短 10 天就從原本 35.9 wpm 提升到 47wpm。附上",[42,172,175],{"href":173,"rel":174},"https:\u002F\u002Fwww.keybr.com\u002Fprofile\u002F2426hm7",[46],"成績單連結","。",[12,178,179,182],{},[123,180,181],{},"Q：獲獎會有獎品嗎？","\nA：我們會在六角部落格上張貼獲獎排行榜，您的大名也會刊登在上頭，未來舉辦第二、三屆時，您的大名也會留存在排行榜上。",{"title":184,"searchDepth":185,"depth":185,"links":186},"",2,[187,188,189,194],{"id":32,"depth":185,"text":33},{"id":76,"depth":185,"text":77},{"id":97,"depth":185,"text":97,"children":190},[191,193],{"id":101,"depth":192,"text":102},3,{"id":108,"depth":192,"text":109},{"id":118,"depth":185,"text":119},null,"2020-03-24","你常因為技術單字拼錯，害你 Debug 了一個下午嗎？你開始學程式，才進而接觸英打嗎？那就來參加 21 天英打武道大會！藉由天天鍛鍊、天天堅持，讓自己成為英打神人！",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-03-24-21days-keybr-game",{"title":5,"description":197},"blog\u002F2020\u002F2020-03-24-21days-keybr-game",[206],"event","_DwCxhNV_LNzH1juDB0PVi5YNGWvFW_mREr5ZBU1lVo",{"prev":209,"next":212,"related":215,"tags":228},{"title":210,"link":211},"【徵才】社群行銷實習生(已徵得)","\u002Fblog\u002F2020-04-13-social-marketing-internship",{"title":213,"link":214},"【徵才】前端學期助教","\u002Fblog\u002F2020-03-18-frontend-assistant",[216,219,222,225],{"title":217,"link":218},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":220,"link":221},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":223,"link":224},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":226,"link":227},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[229,230,231,232,233,206,234,235,236,237,238],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292363]