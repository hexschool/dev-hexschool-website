[{"data":1,"prerenderedAt":386},["ShallowReactive",2],{"blog:2020-05-28-remote-jobs-fifth":3,"blog:neighbors:2020-05-28-remote-jobs-fifth":355},{"id":4,"title":5,"author":6,"body":8,"categories":342,"date":343,"description":344,"draft":345,"extension":346,"meta":347,"navigation":348,"path":349,"seo":350,"stem":351,"tags":352,"thumbnail":17,"__hash__":354},"blog\u002Fblog\u002F2020\u002F2020-05-28-remote-jobs-fifth.md","【學員專屬徵才 - 第五波遠端助教】無工作經驗者優先錄取",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":327},"minimark",[11,18,31,34,38,41,68,71,75,78,81,88,91,94,100,108,111,114,117,137,140,151,154,186,190,198,201,233,236,244,247,250,284,287,290],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F05%2Fhex-hire-TA-fb-5th.png?alt=media&token=ea6a9e07-0388-44b6-8d0f-55ac4a5b2697",[19,20,21,25,28],"ul",{},[22,23,24],"li",{},"你想要轉職工程師，但怕全職投入，卻沒有收入養活自己？",[22,26,27],{},"你想要成為工程師，但是對自己的技能沒有信心？",[22,29,30],{},"你希望學會程式後，也希望有機會一展長才？",[12,32,33],{},"如果以上列表，你的答案是 Yes，同時又是六角學員的話，我們要的就是你！",[35,36,37],"h2",{"id":37},"徵才職缺與門檻",[12,39,40],{},"此次應徵的職缺如下：",[42,43,44,58],"ol",{},[22,45,46,50],{},[47,48,49],"strong",{},"HTML 課程助教",[19,51,52,55],{},[22,53,54],{},"需有完成 HTML 課程單頁最終作業並有達到優的成績。",[22,56,57],{},"完成 flex 時光屋、多頁式網頁作業繳交。",[22,59,60,63],{},[47,61,62],{},"網頁排版助教",[19,64,65],{},[22,66,67],{},"需有完成 CSS、JQ、RWD、BS4最終作業，並 CSS 與 RWD 皆有達到優的成績。",[12,69,70],{},"另外，我們會提供一個問題表單給您，以確保您對課程內容是否有足夠的理解。",[35,72,74],{"id":73},"門檻-qa","門檻 Q&A",[12,76,77],{},"Q：我想報名 HTML 課程助教，但我只有做其中一個最終作業也可以申請嗎？\nA：不行，必須三個 HTML 作業都完成才可申請。",[12,79,80],{},"Q：我如果只有註冊 RWD > BS4，沒註冊 CSS 與 jQ ，但也相當熟悉可以申請嗎？\nA：不行，必須四門課都有註冊，且做完最終作業，才可申請。",[12,82,83,84,87],{},"Q：如果我 CSS、RWD 其中一個作業沒有達優，是否就不能申請這一波申請？\nA：",[47,85,86],{},"只要你有在 6\u002F21 前提交作業便可申請，申請期限是到 7\u002F5","，但若沒獲得優選則不符合門檻*。*您可以等下波我們徵召前，提供修改後的作業，以達到優的成績後再行申請。",[12,89,90],{},"Q：如果我 CSS、RWD 成績是 A，但有給老師再次檢視，且老師也回信給我說改得都 ok，只差沒給我更新過後的「優」評價的話，可以申請嗎？\nA：可以，申請時提供 email 給我們確認即可。",[35,92,93],{"id":93},"評選機制",[12,95,96,99],{},[47,97,98],{},"所有符合上述門檻的學員，皆不會落選，此評選機制完全不看您的學歷","，但有優先順序，我們會依照以下機制，將條件優先提供給最需要這份工作的學員。",[42,101,102,105],{},[22,103,104],{},"全職準備且沒有工作收入者，優先入選",[22,106,107],{},"完全沒有程式工作經驗者，優先入選",[12,109,110],{},"若您尚未被選上，也會提供排隊編號給您，待前面學員工作結束後，便會透過 email 提供到職通知。",[12,112,113],{},"PS：此評選機制是希望真正有意成為工程師的學員可以透過此機制，能夠提早獲得程式工作經驗，有足夠的信心以協接業界。",[35,115,116],{"id":116},"這份工作的優點",[19,118,119,125,131],{},[22,120,121,124],{},[47,122,123],{},"知識再吸收","：藉由教學講解，能夠有效幫助自己的知識能夠重新收納整理，讓觀念更加穩固",[22,126,127,130],{},[47,128,129],{},"信心建立","：讓您藉由知識傳承，讓自己技術能夠再往上一個層次，並有足夠的信心挑戰更好的工作機會。",[22,132,133,136],{},[47,134,135],{},"工作彈性","：一週可以隨意選擇時數來工作，時間自主性高。",[35,138,139],{"id":139},"工作內容",[19,141,142,145,148],{},[22,143,144],{},"回覆學員程式問題",[22,146,147],{},"批改學員程式碼 (小節作業、最終作業)",[22,149,150],{},"協助評估課程流暢度，讓課程更臻完善。",[35,152,153],{"id":153},"工作時間",[19,155,156,167],{},[22,157,158,159],{},"每位應徵者工作長度如下",[19,160,161,164],{},[22,162,163],{},"HTML 課程助教：3 個月",[22,165,166],{},"網頁排版助教：3 個月",[22,168,169,170],{},"工作時段，有兩個時段可以挑選",[19,171,172,180],{},[22,173,174,175,179],{},"週一",[176,177,178],"del",{},"週五的早上 09:00","11:00 ，六日請任選一天(時段相同)，總計六天",[22,181,174,182,185],{},[176,183,184],{},"週五的下午 13:00","15:00，六日請任選一天(時段相同)，總計六天",[35,187,189],{"id":188},"舉例","舉例：",[19,191,192,195],{},[22,193,194],{},"小明：有 12 小時實習時間，時段為週一到週五的下午 1~3 點，週日的早上 9-11 點",[22,196,197],{},"小花：有 12 小時實習時間：時段為週一到週五的早上 9~11 點，週六的早上 9-11 點",[35,199,200],{"id":200},"工作流程",[19,202,203,209,215,221,227],{},[22,204,205,208],{},[47,206,207],{},"前期教育訓練","：將會提供教育訓練影片，不論在回覆口吻、書寫習慣、聚焦問題上，六角皆有一套 SOP ，以幫助助教快速了解其流程。",[22,210,211,214],{},[47,212,213],{},"模擬演練","：每一位遠端助教在初期都會配置一位助教長，初期在回覆問題前，都必須獲得助教長審核過後，才可代表六角助教回覆。藉由此機制，幫助學員能夠在此工作上能逐漸掌握訣竅。",[22,216,217,220],{},[47,218,219],{},"獨當一面","：我們會有不定期的審核機制，若審核成功，往後您就可獨立運作來回覆學員問題。",[22,222,223,226],{},[47,224,225],{},"知識傳承","：當您對工作業務駕輕就熟後，就能升級為助教長，成為未來新人的教練，以進行教育傳承。",[22,228,229,232],{},[47,230,231],{},"協助就業","：我們正在規劃官網提供學員履歷刊登服務，將會讓畢業的遠端助教優先進行人才曝光，協助企業媒合。",[35,234,235],{"id":235},"薪水福利",[19,237,238,241],{},[22,239,240],{},"158\u002Fhr",[22,242,243],{},"無勞健保，此工作內容為執行業務、非常態性工作，故視為勞務外包。",[35,245,246],{"id":246},"應徵辦法",[12,248,249],{},"請依照以下兩步驟進行申請：",[42,251,252,272],{},[22,253,254,257,258,265,266,271],{},[47,255,256],{},"能力判定","：我們挑出了些學員問題，請您盡量試著回覆該問題內容，在 excel 上填寫你的答案後，再將 Google excel 表單提供給我們檢視。",[259,260,264],"a",{"href":261,"rel":262},"https:\u002F\u002Fdocs.google.com\u002Fspreadsheets\u002Fd\u002F1pt2K92O396tjNLUhipKkeqe8iy7q7zHgV7JA9AK5fOw\u002Fedit#gid=946083624",[263],"nofollow","網頁排版問題表單","、",[259,267,270],{"href":268,"rel":269},"https:\u002F\u002Fdocs.google.com\u002Fspreadsheets\u002Fd\u002F1pt2K92O396tjNLUhipKkeqe8iy7q7zHgV7JA9AK5fOw\u002Fedit#gid=1902149847",[263],"HTML 課程問題表單","。",[22,273,274,277,278,283],{},[47,275,276],{},"申請表單","：請填寫此",[259,279,282],{"href":280,"rel":281},"https:\u002F\u002Fforms.gle\u002FMXAsDYtVxwS5HTAU7",[263],"表單","進行應徵流程，7\u002F5 晚上 23:59 分停止收件。將會等此批助教都畢業後才會進行下一波徵召。",[12,285,286],{},"同時會在停止收件後，陸續審核發錄取通知信給第五波助教名單。",[35,288,289],{"id":289},"遠端助教工作心得",[19,291,292,299,306,313,320],{},[22,293,294],{},[259,295,298],{"href":296,"rel":297},"https:\u002F\u002Fayugioh2003.github.io\u002F2019\u002F07\u002Fhexschool-TA-experience\u002F",[263],"小麥 - 兩個月來擔任六角遠端切版助教的心得",[22,300,301],{},[259,302,305],{"href":303,"rel":304},"https:\u002F\u002Fmedium.com\u002F@boy80314\u002F0-%E5%89%8D%E7%AB%AF%E5%8A%A9%E6%95%99%E5%BF%83%E8%B7%AF%E6%AD%B7%E7%A8%8B-f6ae02543738",[263],"RTING LOU - 前端助教心路歷程",[22,307,308],{},[259,309,312],{"href":310,"rel":311},"https:\u002F\u002Fpvt5r486.github.io\u002Fnote\u002F20190524\u002F3138494786\u002F",[263],"宇軒 - 擔任六角遠端助教的那一段日子",[22,314,315],{},[259,316,319],{"href":317,"rel":318},"https:\u002F\u002Fmedium.com\u002F@bryanchu10\u002F%E5%85%AD%E8%A7%92%E5%AD%B8%E9%99%A2%E7%B6%B2%E9%A0%81%E6%8E%92%E7%89%88%E5%8A%A9%E6%95%99%E4%B9%8B%E6%97%85-89c82f6ac26b",[263],"冠穎 - 六角學院網頁排版助教之旅",[22,321,322],{},[259,323,326],{"href":324,"rel":325},"https:\u002F\u002Fmedium.com\u002Fjust-article\u002F%E5%85%AD%E8%A7%92%E5%AD%B8%E9%99%A2-js-%E9%81%A0%E7%AB%AF%E5%8A%A9%E6%95%99%E5%BF%83%E5%BE%97-16831a00df59",[263],"Yuko - 六角學院 JS 遠端助教心得",{"title":328,"searchDepth":329,"depth":329,"links":330},"",2,[331,332,333,334,335,336,337,338,339,340,341],{"id":37,"depth":329,"text":37},{"id":73,"depth":329,"text":74},{"id":93,"depth":329,"text":93},{"id":116,"depth":329,"text":116},{"id":139,"depth":329,"text":139},{"id":153,"depth":329,"text":153},{"id":188,"depth":329,"text":189},{"id":200,"depth":329,"text":200},{"id":235,"depth":329,"text":235},{"id":246,"depth":329,"text":246},{"id":289,"depth":329,"text":289},null,"2020-05-28","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-05-28-remote-jobs-fifth",{"title":5,"description":344},"blog\u002F2020\u002F2020-05-28-remote-jobs-fifth",[353],"jobs","i6e8Myd37IW8Gdzx0Z8vkPPAUKZ9ykIPVE0Kmrd2NoM",{"prev":356,"next":359,"related":362,"tags":375},{"title":357,"link":358},"【振學活動】 - 繳作業抽商品卡","\u002Fblog\u002F2020-09-22-learning-activity",{"title":360,"link":361},"【徵才】社群行銷實習生(已徵得)","\u002Fblog\u002F2020-04-13-social-marketing-internship",[363,366,369,372],{"title":364,"link":365},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":367,"link":368},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":370,"link":371},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":373,"link":374},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[376,377,378,379,380,381,382,383,353,384,385],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064292142]