[{"data":1,"prerenderedAt":359},["ShallowReactive",2],{"blog:2020-04-15-js-course-intro":3,"blog:neighbors:2020-04-15-js-course-intro":329},{"id":4,"title":5,"author":6,"body":8,"categories":317,"date":318,"description":20,"draft":319,"extension":320,"meta":321,"navigation":322,"path":323,"seo":324,"stem":325,"tags":326,"thumbnail":17,"__hash__":328},"blog\u002Fblog\u002F2020\u002F2020-04-15-js-course-intro.md","JavaScript 組合包介紹",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":300},"minimark",[11,18,21,26,42,45,65,69,72,86,90,98,102,105,116,119,122,130,133,142,145,148,168,172,177,185,189,192,221,230,238,242,253,257,261,264,267,281,284,289,296],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F04%2Fjs-intro-og.png?alt=media&token=24d4f29b-0126-4073-95c7-239a39b5fd8c",[12,19,20],{},"我們是六角學院，到了現在已經培育出許多網頁開發者並成功進入業界，「JavaScript 組合」特別推薦給想深入了解 JS 觀念與應用的開發者。",[22,23,25],"h2",{"id":24},"誰適合這組合","誰適合這組合？",[27,28,29,33,36,39],"ul",{},[30,31,32],"li",{},"具有基礎的網頁開發經驗的網頁設計師",[30,34,35],{},"預期更深入學習前端開發的工程師",[30,37,38],{},"有接觸過 jQuery，但對於 JS 尚不熟悉者",[30,40,41],{},"想要累積作品，但前端技術掌握尚不熟悉者",[12,43,44],{},"如果你對於自己的 JavaScript 能力還不是很清楚，可以參考以下考題：",[27,46,47,57],{},[30,48,49,56],{},[50,51,55],"a",{"href":52,"rel":53},"https:\u002F\u002Fgoo.gl\u002Fforms\u002F0y7mnpYhQL4DAE283",[54],"nofollow","基礎 JS 試題","：標準為 90 分",[30,58,59,64],{},[50,60,63],{"href":61,"rel":62},"https:\u002F\u002Fforms.gle\u002FcXTPwSp3ehX9J2Kc7",[54],"核心 JS 試題","：總題數 40，標準為 35 題正確",[22,66,68],{"id":67},"這組合使用什麼工具","這組合使用什麼工具？",[12,70,71],{},"本課程皆是使用 VSCode 進行開發，講義及範例也都附在課程內，不需要額外購買。",[73,74,78,79,78,83],"figure",{"className":75},[76,77],"post-figure","post-figure--w75","\n  ",[15,80],{"src":81,"alt":82},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2Feditor-and-broswer.png?alt=media&token=3b02771d-72fa-425a-9ee1-60c263f81b08","只要有瀏覽器與編輯器就可以了！",[84,85,82],"figcaption",{},[22,87,89],{"id":88},"這組合合適的職缺","這組合合適的職缺？",[27,91,92,95],{},[30,93,94],{},"前端設計師",[30,96,97],{},"前端工程師",[22,99,101],{"id":100},"這組合課程如何做學習","這組合課程如何做學習？",[12,103,104],{},"組合包內包含不同的課程內容，「JavaScript 組合包」包含以下課程：",[27,106,107,110,113],{},[30,108,109],{},"JavaScript 前端修練全攻略",[30,111,112],{},"JavaScript - 核心篇",[30,114,115],{},"Vue 3 實戰影音課程",[12,117,118],{},"為了確保學習狀況，每個課程皆有多個章節及作業，請遵循課程內容，完成各章節作業，並且課程最後都有最終作業，完成這些最終作業將具有求職的最佳作品！",[12,120,121],{},"學習的過程中一定會遇到許多的問題，課程平台下方均有問答工具：",[27,123,124,127],{},[30,125,126],{},"我們助教都非常熱心，請盡可能地提出你的問題，助教將會盡快回覆你的問題！",[30,128,129],{},"章節或最終作業如果遇到問題，你的問題或許其他人也有遇過，可在問答區中尋找其它同學的開發過程，挑戰並完成它吧。",[12,131,132],{},"補充：六角學院具有強大的助教系統，至今已經具有超過萬筆的問答紀錄，每日都有二三十份新的問題提出，所以請別吝嗇提出你的問題～",[73,134,78,136,78,140],{"className":135},[76],[15,137],{"src":138,"alt":139},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2Fweb-many-qus-lastest.png?alt=media&token=f29c71ac-7bd5-4ef4-a91d-ae408ff598be","超過萬筆，有問必答！",[84,141,139],{},[22,143,144],{"id":144},"這組合課程可以學到什麼程度",[12,146,147],{},"本組合包含多個課程，依序可掌握以下技能：",[27,149,150,153,156,159,162,165],{},[30,151,152],{},"基礎 JavaScript 觀念",[30,154,155],{},"JavaScript 對於 DOM 的操作",[30,157,158],{},"AJAX 行為",[30,160,161],{},"掌握所有 JavaScript 核心觀念（This、原型鍊、建構式、閉包、常用 ES6 語法等）",[30,163,164],{},"學習並掌握 Vue 框架",[30,166,167],{},"使用 Vue 框架完成電子商務類型的網站",[22,169,171],{"id":170},"這組合課程會有什麼成品","這組合課程會有什麼成品？",[173,174,176],"h3",{"id":175},"js-課程","JS 課程",[27,178,179,182],{},[30,180,181],{},"Todo List",[30,183,184],{},"蔬菜比價網",[173,186,188],{"id":187},"vue-課程","Vue 課程",[12,190,191],{},"學員作品參考：",[27,193,194,201,208,211,214],{},[30,195,196],{},[50,197,200],{"href":198,"rel":199},"https:\u002F\u002Fvii120.github.io\u002Fvue-ec-shop\u002Fdist\u002F#\u002F",[54],"Weird Store",[30,202,203],{},[50,204,207],{"href":205,"rel":206},"https:\u002F\u002Fchaoyuping.github.io\u002Fplantstore\u002F#\u002F",[54],"哇栽",[30,209,210],{},"Food Market",[30,212,213],{},"旅遊電商",[30,215,216],{},[50,217,220],{"href":218,"rel":219},"https:\u002F\u002Fnccuian.github.io\u002Fvue-store\u002Fdist\u002F#\u002F",[54],"IAN Store",[73,222,78,224,78,228],{"className":223},[76,77],[15,225],{"src":226,"alt":227},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F04%2Fjs_vue_work.png?alt=media&token=edbcfc19-6c50-4e8d-bb4f-99ea1795cf62","達到業界水準的學員作品",[84,229,227],{},[231,232],"blog-link-button",{"align":233,"href":234,"icon":235,"icon-end":235,"label":236,":mirror-icon-end":237},"center-75","https:\u002F\u002Fworks.hexschool.io\u002F#\u002F","handPointRight","我想看更多學長姊作品","true",[22,239,241],{"id":240},"接下來還可以投入哪個方向","接下來還可以投入哪個方向？",[27,243,244,247,250],{},[30,245,246],{},"投入不同的 JavaScript 框架運用，增加職場競爭力",[30,248,249],{},"學習 Node.js，掌握前後端開發技能",[30,251,252],{},"學習 UI ，培養美感設計出具有價值的網頁",[22,254,256],{"id":255},"報名這組合課程包含哪些服務","報名這組合課程，包含哪些服務？",[15,258],{"src":259,"alt":260},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2Fweb-compare.png?alt=media&token=f90c873c-16ba-40e4-b400-5adaa6c5ae90","實體課程、其他線上課程與六角學院比較表：無限次觀看的教學內容、更新也無需另外付費、完善的助教與講師回覆系統、每週參加的線上問答、輔導就業及職缺推薦，六角學院五項皆勝",[12,262,263],{},"大多線上課程僅有提供教學影音，並無提供完善的助教、講師回覆系統，因此在學習上有任何問題都無從發問，甚至發問後一個月才收到講師簡短的回覆，來回的過程中將浪費許多寶貴時間，且無法真正的掌握技能。",[12,265,266],{},"六角學院除了提供影音課程外，完善的學習輔助系統，確保你的每一分投入都發揮最大的效益！",[27,268,269,272,275,278],{},[30,270,271],{},"影音課程保證觀看期限一年：六角每多營運一年，你就獲得多一年的觀看期，課程更新也無需另外付費",[30,273,274],{},"完善的助教、講師回覆系統，確保學習狀況",[30,276,277],{},"免費參加每週的大神來六角或線上問答",[30,279,280],{},"完成所有最終作業可免費職缺推薦",[22,282,283],{"id":283},"上過此組合的回饋",[285,286],"blog-testimonial-carousel",{":items":287,"label":288},"[{\"name\":\"林小星\",\"text\":\"很多觀念在之前自已摸索時，常常因為看起來很像而誤解了用法，看完後對執行的原理又有更加深的理解和印象！\"},{\"name\":\"陳冠翰\",\"text\":\"有基本 JS 觀念，想要在更進階學習的，這門課很推薦\"},{\"name\":\"奕濡\",\"text\":\"完整的解說 Vue 強大之處以及應用，非常推薦\"},{\"name\":\"Dory\",\"text\":\"太棒了，重新建立起過去的錯誤學習方式。\"},{\"name\":\"John\",\"text\":\"講師教得很仔細，對入門者來說很有幫助，只要跟著學、一邊做，一定能學會！\"},{\"name\":\"yihao\",\"text\":\"課程講解的很詳盡，課程問題也很盡心盡力為學員回覆，很有耐心~ 受益良多\"},{\"name\":\"薛德豪\",\"text\":\"有基本 JS 觀念，想要在更進階學習的，這門課很推薦\"},{\"name\":\"建良\",\"text\":\"這堂課目前上到第 5 節，已經對 JavaScript 有了全新的認識，不但能了解你看不到的 JavaScript 底層運作的原理，老師也會示範許多時常被誤解的陷阱題，收穫良多!\"}]","學員回饋",[231,290],{"align":291,"href":292,"icon":293,"icon-end":293,"label":294,":pulse":237,":wide":237,"size":295},"center","https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002F","gem","我想學會 JS 和框架","lg",[297,298,299],"style",{},"\n.post-figure {\n  margin: 16px 0;\n}\n\n.post-figure--w75 {\n  width: 75%;\n}\n\n.post-figure--w50 {\n  width: 50%;\n}\n\n.post-figure img {\n  box-shadow: 5px 5px 10px lightgray;\n}\n",{"title":301,"searchDepth":302,"depth":302,"links":303},"",2,[304,305,306,307,308,309,314,315,316],{"id":24,"depth":302,"text":25},{"id":67,"depth":302,"text":68},{"id":88,"depth":302,"text":89},{"id":100,"depth":302,"text":101},{"id":144,"depth":302,"text":144},{"id":170,"depth":302,"text":171,"children":310},[311,313],{"id":175,"depth":312,"text":176},3,{"id":187,"depth":312,"text":188},{"id":240,"depth":302,"text":241},{"id":255,"depth":302,"text":256},{"id":283,"depth":302,"text":283},null,"2020-04-15",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-04-15-js-course-intro",{"title":5,"description":20},"blog\u002F2020\u002F2020-04-15-js-course-intro",[327],"course","zUGLe1VRWGsmJX2aUDgO-QqwELoGmHGvnsmCk93ZB38",{"prev":330,"next":333,"related":336,"tags":348},{"title":331,"link":332},"【學員專屬徵才 - 第五波遠端助教】無工作經驗者優先錄取","\u002Fblog\u002F2020-05-28-remote-jobs-fifth",{"title":334,"link":335},"【徵才】社群行銷實習生(已徵得)","\u002Fblog\u002F2020-04-13-social-marketing-internship",[337,340,343,345],{"title":338,"link":339},"JavaScript 程式解題組合包","\u002Fblog\u002F2022-04-15-js-solving-combined",{"title":341,"link":342},"【4月開班】Node.js 後端工程師養成直播班","\u002Fblog\u002F2022-02-17-node-training-intro",{"title":5,"link":344},"\u002Fblog\u002F2022-01-14-js-course-intro",{"tit