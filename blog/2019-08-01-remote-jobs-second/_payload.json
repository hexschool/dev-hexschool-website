[{"data":1,"prerenderedAt":363},["ShallowReactive",2],{"blog:2019-08-01-remote-jobs-second":3,"blog:neighbors:2019-08-01-remote-jobs-second":332},{"id":4,"title":5,"author":6,"body":8,"categories":319,"date":320,"description":321,"draft":322,"extension":323,"meta":324,"navigation":325,"path":326,"seo":327,"stem":328,"tags":329,"thumbnail":17,"__hash__":331},"blog\u002Fblog\u002F2019\u002F2019-08-01-remote-jobs-second.md","【學員專屬徵才 - 第二波遠端助教】無工作經驗者優先錄取",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":304},"minimark",[11,18,31,34,38,53,56,60,63,70,73,76,82,91,94,97,100,120,123,134,137,169,173,189,192,224,227,235,238,241,275,278,281],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F06%2Fhex-hire-TA-fb-2nd.png?alt=media&token=3f129f0c-0476-4195-b665-86b0be05b480",[19,20,21,25,28],"ul",{},[22,23,24],"li",{},"你想要轉職工程師，但怕全職投入，卻沒有收入養活自己？",[22,26,27],{},"你想要成為工程師，但是對自己的技能沒有信心？",[22,29,30],{},"你希望學會程式後，也希望有機會一展長才？",[12,32,33],{},"如果以上列表，你的答案是 Yes，同時又是六角學員的話，我們要的就是你！",[35,36,37],"h2",{"id":37},"徵才職缺與門檻",[19,39,40,47],{},[22,41,42,46],{},[43,44,45],"strong",{},"網頁排版助教"," - 需有完成 CSS、JQ、RWD、BS4 最終作業，並 CSS 與 RWD 皆有達到優的成績。",[22,48,49,52],{},[43,50,51],{},"JS 助教"," - 需有完成 JS、Vue 最終作業",[12,54,55],{},"另外，我們會提供一個問題表單給您，以確保您對課程內容是否有足夠的理解。",[35,57,59],{"id":58},"門檻-qa","門檻 Q&A",[12,61,62],{},"Q：我如果只有註冊 RWD > BS4，沒註冊 CSS 與 jQ ，但也相當熟悉可以申請嗎？\nA：不行，必須四門課都有註冊，且做完最終作業，才可申請。",[12,64,65,66,69],{},"Q：申請JS 或網頁排版助教，如果我 CSS、RWD 其中一個作業沒有達優，是否就不能申請這一波申請？\nA：",[43,67,68],{},"只要你有在 8\u002F14 前提交作業便可申請，申請期限是到 9\u002F1","，但若沒獲得優選則不符合門檻*。*您可以等下波我們徵召前，提供修改後的作業，以達到優的成績後再行申請。",[12,71,72],{},"Q：如果我 CSS、RWD 成績是 A，但有給老師再次檢視，且老師也回信給我說改得都 ok，只差沒給我更新過後的「優」評價的話，可以申請嗎？\nA：可以，申請時提供 email 給我們確認即可。",[35,74,75],{"id":75},"評選機制",[12,77,78,81],{},[43,79,80],{},"所有符合上述門檻的學員，皆不會落選，此評選機制完全不看您的學歷","，但有優先順序，我們會依照以下機制，將條件優先提供給最需要這份工作的學員。",[83,84,85,88],"ol",{},[22,86,87],{},"全職準備且沒有工作收入者，優先入選",[22,89,90],{},"完全沒有程式工作經驗者，優先入選",[12,92,93],{},"若您尚未被選上，也會提供排隊編號給您，待前面學員工作結束後，便會透過 email 提供到職通知。",[12,95,96],{},"PS：此評選機制是希望真正有意成為工程師的學員可以透過此機制，能夠提早獲得程式工作經驗，有足夠的信心以協接業界。",[35,98,99],{"id":99},"這份工作的優點",[19,101,102,108,114],{},[22,103,104,107],{},[43,105,106],{},"知識再吸收","：藉由教學講解，能夠有效幫助自己的知識能夠重新收納整理，讓觀念更加穩固",[22,109,110,113],{},[43,111,112],{},"信心建立","：讓您藉由知識傳承，讓自己技術能夠再往上一個層次，並有足夠的信心挑戰更好的工作機會。",[22,115,116,119],{},[43,117,118],{},"工作彈性","：一週可以隨意選擇時數來工作，時間自主性高。",[35,121,122],{"id":122},"工作內容",[19,124,125,128,131],{},[22,126,127],{},"回覆學員程式問題",[22,129,130],{},"批改學員程式碼 (小節作業、最終作業)",[22,132,133],{},"協助評估課程流暢度，讓課程更臻完善。",[35,135,136],{"id":136},"工作時間",[19,138,139,150],{},[22,140,141,142],{},"每位應徵者工作長度如下\n",[19,143,144,147],{},[22,145,146],{},"網頁排版助教：3 個月",[22,148,149],{},"JS助教：3 個月",[22,151,152,153],{},"工作時段，有兩個時段可以挑選\n",[19,154,155,163],{},[22,156,157,158,162],{},"週一",[159,160,161],"del",{},"週五的早上 09:00","11:00 ，六日請任選一天(時段相同)，總計六天",[22,164,157,165,168],{},[159,166,167],{},"週五的下午 13:00","15:00，六日請任選一天(時段相同)，總計六天",[35,170,172],{"id":171},"舉例","舉例：",[19,174,175,182],{},[22,176,177,178,181],{},"小明：有 14 小時實習時間，時段為週一",[159,179,180],{},"週日的下午 3","5 點",[22,183,184,185,188],{},"小花：有 10 小時實習時間：時段為週一",[159,186,187],{},"五的早上 9","11 點",[35,190,191],{"id":191},"工作流程",[19,193,194,200,206,212,218],{},[22,195,196,199],{},[43,197,198],{},"前期教育訓練","：將會提供教育訓練影片，不論在回覆口吻、書寫習慣、聚焦問題上，六角皆有一套 SOP ，以幫助助教快速了解其流程。",[22,201,202,205],{},[43,203,204],{},"模擬演練","：每一位遠端助教在初期都會配置一位助教長，初期在回覆問題前，都必須獲得助教長審核過後，才可代表六角助教回覆。藉由此機制，幫助學員能夠在此工作上能逐漸掌握訣竅。",[22,207,208,211],{},[43,209,210],{},"獨當一面","：我們會有不定期的審核機制，若審核成功，往後您就可獨立運作來回覆學員問題。",[22,213,214,217],{},[43,215,216],{},"知識傳承","：當您對工作業務駕輕就熟後，就能升級為助教長，成為未來新人的教練，以進行教育傳承。",[22,219,220,223],{},[43,221,222],{},"協助就業","：我們正在規劃官網提供學員履歷刊登服務，將會讓畢業的遠端助教優先進行人才曝光，協助企業媒合。",[35,225,226],{"id":226},"薪水福利",[19,228,229,232],{},[22,230,231],{},"150\u002Fhr",[22,233,234],{},"無勞健保，此工作內容為執行業務、非常態性工作，故視為勞務外包。",[35,236,237],{"id":237},"應徵辦法",[12,239,240],{},"請依照以下兩步驟進行申請：",[83,242,243,263],{},[22,244,245,248,249,256,257,262],{},[43,246,247],{},"能力判定","：我們挑出了些學員問題，請您盡量試著回覆該問題內容，在 excel 上填寫你的答案後，再將 Google excel 表單提供給我們檢視，",[250,251,255],"a",{"href":252,"rel":253},"https:\u002F\u002Fdocs.google.com\u002Fspreadsheets\u002Fd\u002F1pt2K92O396tjNLUhipKkeqe8iy7q7zHgV7JA9AK5fOw\u002Fedit#gid=1982676966",[254],"nofollow","網頁排版問題表單","、",[250,258,261],{"href":259,"rel":260},"https:\u002F\u002Fdocs.google.com\u002Fspreadsheets\u002Fd\u002F1pt2K92O396tjNLUhipKkeqe8iy7q7zHgV7JA9AK5fOw\u002Fedit#gid=0",[254],"JS 問題表單","。",[22,264,265,268,269,274],{},[43,266,267],{},"申請表單","：請填寫此",[250,270,273],{"href":271,"rel":272},"https:\u002F\u002Fforms.gle\u002FH2SbXMxsQjWpqEuYA",[254],"表單","進行應徵流程，9\u002F1 晚上 23:59 分停止收件。將會等此批助教都畢業後才會進行下一波徵召。",[12,276,277],{},"同時會在停止收件後，陸許審核發錄取通知信給第一波助教名單。",[35,279,280],{"id":280},"遠端助教工作心得",[19,282,283,290,297],{},[22,284,285],{},[250,286,289],{"href":287,"rel":288},"https:\u002F\u002Fayugioh2003.github.io\u002F2019\u002F07\u002Fhexschool-TA-experience\u002F",[254],"小麥 - 兩個月來擔任六角遠端切版助教的心得",[22,291,292],{},[250,293,296],{"href":294,"rel":295},"https:\u002F\u002Fmedium.com\u002F@boy80314\u002F0-%E5%89%8D%E7%AB%AF%E5%8A%A9%E6%95%99%E5%BF%83%E8%B7%AF%E6%AD%B7%E7%A8%8B-f6ae02543738",[254],"RTING LOU - 前端助教心路歷程",[22,298,299],{},[250,300,303],{"href":301,"rel":302},"https:\u002F\u002Fpvt5r486.github.io\u002Fnote\u002F20190524\u002F3138494786\u002F",[254],"宇軒 - 擔任六角遠端助教的那一段日子",{"title":305,"searchDepth":306,"depth":306,"links":307},"",2,[308,309,310,311,312,313,314,315,316,317,318],{"id":37,"depth":306,"text":37},{"id":58,"depth":306,"text":59},{"id":75,"depth":306,"text":75},{"id":99,"depth":306,"text":99},{"id":122,"depth":306,"text":122},{"id":136,"depth":306,"text":136},{"id":171,"depth":306,"text":172},{"id":191,"depth":306,"text":191},{"id":226,"depth":306,"text":226},{"id":237,"depth":306,"text":237},{"id":280,"depth":306,"text":280},null,"2019-08-01","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2019\u002F2019-08-01-remote-jobs-second",{"title":5,"description":321},"blog\u002F2019\u002F2019-08-01-remote-jobs-second",[330],"jobs","TQY7euDsQTA1ay2GzUeq6Z57svpgFyZQC3Fwa6ieryQ",{"prev":333,"next":336,"related":339,"tags":352},{"title":334,"link":335},"我們還有很長一段路要走，不要怕！有六角的夥伴們陪你 - Yukon","\u002Fblog\u002F2019-08-08-interview",{"title":337,"link":338},"【大神來六角】七月直播主題：資料庫","\u002Fblog\u002F2019-06-21-god-and-hexschool",[340,343,346,349],{"title":341,"link":342},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":344,"link":345},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":347,"link":348},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":350,"link":351},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[353,354,355,356,357,358,359,360,330,361,362],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064292202]