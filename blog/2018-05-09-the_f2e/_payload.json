[{"data":1,"prerenderedAt":396},["ShallowReactive",2],{"blog:2018-05-09-the_f2e":3,"blog:neighbors:2018-05-09-the_f2e":369},{"id":4,"title":5,"author":6,"body":8,"categories":356,"date":357,"description":358,"draft":359,"extension":360,"meta":361,"navigation":362,"path":363,"seo":364,"stem":365,"tags":366,"thumbnail":17,"__hash__":368},"blog\u002Fblog\u002F2018\u002F2018-05-09-the_f2e.md","The F2E - 前端修練精神時光屋",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":333},"minimark",[11,18,21,24,28,41,45,49,69,72,75,122,127,130,133,138,144,148,154,157,160,163,167,190,194,276,279,290,293,296,301,304,308,311,315,318,322,325],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F05%2FTheF2E_banner.png?alt=media&token=4e663e89-554e-4bed-83ac-000fddabd8ab",[12,19,20],{},"你想變強嗎？\n你想獲得力量嗎？\n你想透過前端改變你的生活，但找不到地方修練嗎？",[12,22,23],{},"如果你的答案是「Yes」那麼你來對地方了！",[25,26,27],"h2",{"id":27},"修練內容",[29,30,31,35,38],"ol",{},[32,33,34],"li",{},"一週挑戰一個修練主題，總計九週，可挑選「前端工程師」、「前端設計師」的挑戰方向",[32,36,37],{},"每道修練主題的最低通過門檻是「至少要完成 CSS 網頁排版」",[32,39,40],{},"在期限內將成果上傳到雲端空間 (CODEPEN、Github、JSBIN) 後，再登記在 Google 表單上",[15,42],{"src":43,"width":44,"alt":27},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F05%2FTheF2E_topic.png?alt=media&token=2c32f07c-ce6d-41d2-a7a6-efc38211aa12","50%",[25,46,48],{"id":47},"在-the-f2e-會獲得什麼資源","在 The F2E 會獲得什麼資源？",[50,51,52,63,66],"ul",{},[32,53,54,55],{},"資源授權：本活動的所有授權都是 CC0 格式，方便挑戰者重製成自己的 side project 與作品，授權範圍含：\n",[50,56,57,60],{},[32,58,59],{},"user story (使用者故事)",[32,61,62],{},"mockup (設計稿)",[32,64,65],{},"協助就業：若挑戰週數到達六週以上，並通過業界前端審核品質標準，六角學院將會提供求職資源，協助挑戰者媒合就業",[32,67,68],{},"團結力量大：可觀看其他挑戰者的程式碼，進以觸類旁通，瞭解程式邏輯寫法。並能加入FB 交流社團，六角學院們的老師也會加入。",[25,70,71],{"id":71},"報名與參賽方式",[12,73,74],{},"請依照下列三步驟進行報名",[50,76,77,84,104,110],{},[32,78,79,83],{},[80,81,82],"strong",{},"報名時間","：5\u002F13(日)~7\u002F29(日)，正式開賽時間為 6\u002F4 (一)",[32,85,86,89,90,97,98,103],{},[80,87,88],{},"報名方式","：填寫此",[91,92,96],"a",{"href":93,"rel":94},"https:\u002F\u002Fgoo.gl\u002Fforms\u002Fx2N1iluIvRfu9AHr2",[95],"nofollow","報名表單","，加入 ",[91,99,102],{"href":100,"rel":101},"https:\u002F\u002Fwww.facebook.com\u002Fgroups\u002F173311386703334\u002F",[95],"The F2E FB 社團","。",[32,105,106,109],{},[80,107,108],{},"開賽規則","：每週一中午 12 點公布新題目，隔週週一中午 12 點前將作品上傳到 (CODEPEN、JSBIN、Github Pages)。",[32,111,112,115,116,121],{},[80,113,114],{},"發文登記","：開賽後的每週登錄作品請上傳至此",[91,117,120],{"href":118,"rel":119},"https:\u002F\u002Fgoo.gl\u002Fforms\u002FufHCDuBmobghw4Ny1",[95],"表單","，當週才算挑戰成功。",[12,123,124],{},[15,125],{"alt":71,"src":126},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F05%2FTheF2E_rule.png?alt=media&token=e432a154-b361-44a2-a97d-33eab5bf614d",[25,128,129],{"id":129},"技能樹選擇",[12,131,132],{},"請依照自己想投入的部分，額外選擇下面兩條修練方向。",[134,135,137],"h3",{"id":136},"a前端設計師","a.前端設計師",[12,139,140,143],{},[80,141,142],{},"設計 UI 介面","：每道修練主題我們都會提供 user story (使用者故事)，你可以依此使用 Sketch、Illustrator 來設計 mockup，並同時開發網頁介面，以加強自己對 Web UI 的掌握度。",[134,145,147],{"id":146},"b前端工程師","b.前端工程師",[12,149,150,153],{},[80,151,152],{},"JS開發 & 介接 API","：在開發中大型介面時，一個網頁上可能會有許多第三方介接的資料，例如後端的 RESTful API、Google Map、BaaS 等等，您可以思考我們所提供的修練主題，試著導入服務進去。",[25,155,156],{"id":156},"修練方向",[12,158,159],{},"你可以依照我們提供的修練主題，主動練習自己想投入的新技術。為了確保每週都能挑戰功能，會建議70%用自己會的技術，30%使用剛學會的新技術，以避免挑戰曲線不會過高。",[12,161,162],{},"以 CSS、JavaScript 為例，你可投入：",[134,164,166],{"id":165},"css","CSS",[50,168,169,172,175,178,181,184,187],{},[32,170,171],{},"會使用 float 排版時，可以嘗試使用 flexbox、grid 排版",[32,173,174],{},"思考響應式排版的實做方式，並在 iPad、mobile 有極好的使用者體驗",[32,176,177],{},"transition、animation、transform 動畫效果，提升網頁動線",[32,179,180],{},"能使用 CSS 實做出來的效果，就不要使用 JavaScript",[32,182,183],{},"預處理器 (SCSS、LESS) 與 PostCSS",[32,185,186],{},"CSS 框架 (Bootstrap、pure)",[32,188,189],{},"設計模式 (SMACSS、OOCSS、BEM、MVCSS)",[134,191,193],{"id":192},"javascript","JavaScript",[50,195,196,216,222,228,234,240,246,252,258,264,270],{},[32,197,198,201,202],{},[80,199,200],{},"JS 基礎","：使用一個你不曾用過的 JS 技巧，例如\n",[50,203,204,207,210,213],{},[32,205,206],{},"array map 、filter、reduce",[32,208,209],{},"閉包、遞迴、物件導向",[32,211,212],{},"JSON 資料、字串處理",[32,214,215],{},"正規表達式 (Regular Expression)",[32,217,218,221],{},[80,219,220],{},"模組管理","：使用任務管理工具 (grunt、gulp)、模組打包工具 (webpack)",[32,223,224,227],{},[80,225,226],{},"ECMAScript","：ES 6、7 、8，並使用 Babel 兼容網頁瀏覽器。",[32,229,230,233],{},[80,231,232],{},"HTML5 API","：Localstorage、Geolocation、File API",[32,235,236,239],{},[80,237,238],{},"介接第三方服務 API","： social login、weater、open data、自建 API",[32,241,242,245],{},[80,243,244],{},"導入 SPA 框架","： Vue、React、Angular",[32,247,248,251],{},[80,249,250],{},"工具框架","：lodash、Underscore",[32,253,254,257],{},[80,255,256],{},"應用程式服務","：瀏覽器插件 (chrome extension)、桌面應用程式 (electron)、APP (ionic、react native)",[32,259,260,263],{},[80,261,262],{},"2、3D 動畫開發","：使用 SVG、canvas、WebGL 設計動畫效果，例如 D3.js、three.js",[32,265,266,269],{},[80,267,268],{},"Node.js","：NPM 、後端框架 (koa、express)、API 設計、測試(Mocha、Nightwatch)",[32,271,272,275],{},[80,273,274],{},"程式檢查","：ESLint、JSHint",[25,277,278],{"id":278},"獎勵機制",[50,280,281,284,287],{},[32,282,283],{},"完成三道關卡：授予銅級數位勳章，並記錄在戰績榜上",[32,285,286],{},"完成六道關卡：授予銀級數位勳章，並記錄在戰績榜上，六角學院將主動提供前端就業資源。",[32,288,289],{},"完成九道關卡：授予金級數位勳章，並記錄在戰績榜上，六角學院將主動提供前端就業資源，實體完賽獎狀。",[25,291,292],{"id":292},"前端直播客分享",[12,294,295],{},"本次活動同時邀請到許多有在經營前端直播的資深開發者，藉此促進交流，大幅升級自己的腦袋！",[12,297,298],{},[15,299],{"alt":292,"src":300},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F05%2F%E8%9E%A2%E5%B9%95%E5%BF%AB%E7%85%A7%202018-05-13%20%E4%B8%8B%E5%8D%889.32.11.png?alt=media&token=a3786e70-fa62-4f63-a536-f2937f560579",[25,302,303],{"id":303},"常見問答",[134,305,307],{"id":306},"q如果某一週不小心挑戰失敗是否能再繼續挑戰後面關卡","Q：如果某一週不小心挑戰失敗，是否能再繼續挑戰後面關卡？",[12,309,310],{},"可以，儘管那週挑戰失敗，之後您仍可以挑選喜歡的關卡進行挑戰，並在該關卡期限內繳交作品。",[134,312,314],{"id":313},"q假使選擇前端設計師是代表每週都要自己設計-ui-外還必須開發網頁前端","Q：假使選擇「前端設計師」，是代表每週都要自己設計 UI 外，還必須開發網頁前端？",[12,316,317],{},"不用，每道修練主題的最低通過門檻是「至少要完成 CSS 網頁排版」，您可以挑選喜歡的主題，依照 user story 來設計 UI 即可。",[134,319,321],{"id":320},"q為什麼報名時間到-729而-64-正式開賽","Q：為什麼報名時間到 7\u002F29，而 6\u002F4 正式開賽？",[12,323,324],{},"6\u002F4 正式開始第一週的挑戰題目，就算沒跟到第一週，參加之後的比賽，而 7\u002F29 正是最後一週的挑戰賽。",[12,326,327,328],{},"活動最新消息將會公佈在 ",[91,329,332],{"href":330,"rel":331},"https:\u002F\u002Fgithub.com\u002Fhexschool\u002FTheF2E\u002Fblob\u002Fmaster\u002FREADME.md",[95],"六角學院 Github",{"title":334,"searchDepth":335,"depth":335,"links":336},"",2,[337,338,339,340,345,349,350,351],{"id":27,"depth":335,"text":27},{"id":47,"depth":335,"text":48},{"id":71,"depth":335,"text":71},{"id":129,"depth":335,"text":129,"children":341},[342,344],{"id":136,"depth":343,"text":137},3,{"id":146,"depth":343,"text":147},{"id":156,"depth":335,"text":156,"children":346},[347,348],{"id":165,"depth":343,"text":166},{"id":192,"depth":343,"text":193},{"id":278,"depth":335,"text":278},{"id":292,"depth":335,"text":292},{"id":303,"depth":335,"text":303,"children":352},[353,354,355],{"id":306,"depth":343,"text":307},{"id":313,"depth":343,"text":314},{"id":320,"depth":343,"text":321},null,"2018-05-09","你想變強嗎？你想獲得力量嗎？你想透過前端改變你的生活，但找不到地方修練嗎？如果你的答案是「Yes」那麼你來對地方了！",false,"md",{},true,"\u002Fblog\u002F2018\u002F2018-05-09-the_f2e",{"title":5,"description":358},"blog\u002F2018\u002F2018-05-09-the_f2e",[367],"skilltree","87AnRX54SBASF8SUx_Oa3iL1NO5kALlE-cURbWMrcv4",{"prev":370,"next":373,"related":376,"tags":387},{"title":371,"link":372},"專精一職，涉略所有，才能有無限可能 - Simon","\u002Fblog\u002F2018-06-15-interview",{"title":374,"link":375},"2018 前端開發者學習地圖！","\u002Fblog\u002F2018-04-16-skill_tree",[377,380,383,384],{"title":378,"link":379},"2022 前端開發者學習地圖","\u002Fblog\u002F2022-04-18-frontend-study-map",{"title":381,"link":382},"The F2E - 第二屆 前端 & UI 修練精神時光屋","\u002Fblog\u002F2019-06-14-the_f2e",{"title":374,"link":375},{"title":385,"link":386},"2017 前端開發者技能樹！","\u002Fblog\u002F2017-06-12-skill_tree",[388,389,165,390,391,392,393,192,394,367,395],"UI design","course","css3","enterprise","event","interview","jobs","software engineer",1790064292230]