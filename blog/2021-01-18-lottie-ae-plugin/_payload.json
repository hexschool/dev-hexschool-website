[{"data":1,"prerenderedAt":448},["ShallowReactive",2],{"blog:2021-01-18-lottie-ae-plugin":3,"blog:neighbors:2021-01-18-lottie-ae-plugin":427},{"id":4,"title":5,"author":6,"body":8,"categories":413,"date":414,"description":415,"draft":416,"extension":417,"meta":418,"navigation":419,"path":420,"seo":421,"stem":422,"tags":423,"thumbnail":425,"__hash__":426},"blog\u002Fblog\u002F2021\u002F2021-01-18-lottie-ae-plugin.md","Lottie：讓 AE 動畫完美呈現於數位產品上",[7],"六角學院",{"type":9,"value":10,"toc":396},"minimark",[11,18,22,25,38,50,53,64,67,70,76,79,83,86,89,94,105,114,118,121,127,133,136,139,142,151,157,159,163,166,175,179,182,185,188,197,209,212,230,234,240,249,252,267,270,273,277,280,286,289,294,296,301,304,307,310,316,319,322,328,331,334,337,343,346,352,355,358,366,369],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2F_2.png?alt=media&token=1747fb68-2538-4e39-8110-83f745bfc338",[19,20,21],"h2",{"id":21},"前言",[12,23,24],{},"上次介紹完了如何在網頁上建立能互動的 3D 物件，這次就來聊聊自己更常接觸的 2D 動畫。在公司裡面常會有需要製作活動或是課程的銷售頁（Landing Page），有時會有將平面素材套用動畫的需求，自己用過三種方式：",[26,27,28,32,35],"ol",{},[29,30,31],"li",{},"跟工程師溝通希望的動態之後，提供平面素材請工程師撰寫 SVG 動畫的程式碼來操控。",[29,33,34],{},"將 Adobe After Effect（後簡稱 AE）製作的動畫轉換成影片或是 GIF 檔。",[29,36,37],{},"透過 Adobe Animate 完成動態後匯出成 Canvas 嵌入到網頁。",[39,40,41,42,41,47],"figure",{},"\n  ",[15,43],{"src":44,"alt":45,"style":46},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2Fezgif.com-gif-maker_(5).gif?alt=media&token=6b6482f0-4479-44d3-b0ca-845a24124fba","這個是請工程師做的簡單 SVG 動畫","margin-left: auto; margin-right: auto;",[48,49,45],"figcaption",{},[12,51,52],{},"但這些方式都各自有一些缺點：",[26,54,55,58,61],{},[29,56,57],{},"跟工程師討論動畫時，有時需要先用 AE 等動畫軟體做出模擬、或是來回溝通調整想要的 SVG 動畫型態，會有一些時間與溝通成本",[29,59,60],{},"影片或 GIF 檔的檔案都滿大的，會影響網頁載入的效能",[29,62,63],{},"使用 Adobe Animate 匯出來的檔案，其程式碼不太乾淨，導致在維護以及調整上不太便利。",[12,65,66],{},"而 Lottie 能夠解決上面所有的問題。",[12,68,69],{},"先說結論：",[71,72,73],"blockquote",{},[12,74,75],{},"Lottie 雖然在使用上有一些限制，但只要遵循相關的規範就能夠快速地在網頁、手機等不同系統上呈現完全相同的動畫呈現，還能夠進行互動操控。",[77,78],"hr",{},[19,80,82],{"id":81},"lottie-是什麼","Lottie 是什麼",[12,84,85],{},"Lottie 是 Airbnb 推出的函式庫（Library），可以運用在 iOS、Android、網頁，甚至是 MacOS、Windows 等作業系統，它能透過外掛將 AE 做的動畫匯出成 JSON 檔，工程師只要將這份 JSON 檔嵌入程式碼中，動畫就成功匯入了，是不是超簡單！",[12,87,88],{},"這邊列出三點我覺得 Lottie 好用的特點：",[90,91,93],"h3",{"id":92},"一鍵轉檔完美呈現","一鍵轉檔，完美呈現",[12,95,96,97,104],{},"只要一次轉檔，就能在多種裝置系統上擁有相同的呈現效果，精簡了許多的流程與溝通成本。且若是發現有一些小地方需要調整，也能透過 ",[98,99,103],"a",{"href":100,"rel":101},"https:\u002F\u002Flottiefiles.com",[102],"nofollow","LottieFiles"," 的線上編輯器或甚至可以直接在程式碼裡面修改，像是尺寸、影格數、播放速度、顏色等等，連圖層都可以選擇隱藏，在編輯上非常方便。",[39,106,107,108,41,112],{},"\n    ",[15,109],{"src":110,"alt":111,"style":46},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled.png?alt=media&token=a27ef95b-abaf-4739-a902-188ccc9108d3","LottieFiles 的線上編輯器",[48,113,111],{},[90,115,117],{"id":116},"更小的檔案更高的效能","更小的檔案，更高的效能",[12,119,120],{},"以常用的 GIF 檔來比較，相同的動畫使用 Lottie 能夠能夠使用更小的檔案尺寸來達到更高的品質，除了運算的效能變高，整體的體驗也會更吸睛。官方用了動物來形容各種檔案大小：如果 PNG 是暴龍，GIF 就是大象，而 Lottie 則是小狗（笑）。",[39,122,107,123],{},[15,124],{"src":125,"alt":126},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2Fezgif.com-gif-maker_(2).gif?alt=media&token=0b6c8742-5c3d-434a-b5f3-eefca1944070","效能比較",[39,128,107,129],{},[15,130],{"src":131,"alt":132},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled%201.png?alt=media&token=800d66ed-ccdb-4b42-8020-8800b29c0323","用動物來比喻",[90,134,135],{"id":135},"讓動畫可以互動操控",[12,137,138],{},"互動效果是我覺得 Lottie 很實用的功能，Lottie 除了可以將做好的動畫直接顯示在網頁上，他也可以透過一些行為來觸發動畫。",[12,140,141],{},"譬如你可讓 Lottie 動畫設定成跟著滾動（Scroll）、游標懸停（Hover）、游標移動（Cursor）來播放，還可以設定你的動畫想要播放是哪個區段（e.g. 動畫原長三秒，可以只播放 2-3 秒），讓動畫在頁面不單單只能 Loop，更是能透過互動來產生更豐富的呈現。",[12,143,144,145,150],{},"詳細的說明與範例可以到",[98,146,149],{"href":147,"rel":148},"https:\u002F\u002Flottiefiles.com\u002Finteractivity",[102],"官方網站","來玩玩看。",[39,152,107,153],{},[15,154],{"src":155,"alt":156,"style":46},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2Fezgif.com-gif-maker.gif?alt=media&token=4284234d-3aa0-42a9-84ec-b4a5e01fc7b8","lottie intereative",[77,158],{},[19,160,162],{"id":161},"怎麼開始使用-lottie","怎麼開始使用 Lottie",[12,164,165],{},"最近剛好用 Lottie 做了一個小東西，順便就來解釋 Lottie 從製作到匯出上面需要注意的地方有哪些。這是一個當學員在假日要新增課程問題前，會跳出一個彈出視窗提醒學員助教很辛苦的小動畫（笑）",[39,167,107,168,107,173],{},[15,169],{"src":170,"alt":171,"style":172},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2Fezgif.com-gif-maker_(3).gif?alt=media&token=18db5d5e-145d-457b-bfe8-5147f93383b1","只有假日的時候才會出現的 Modal","margin-left: auto; margin-right: auto; width: 100%;",[48,174,171],{},[90,176,178],{"id":177},"用-ae-製作動畫","①  用 Ae 製作動畫",[12,180,181],{},"AE 做動畫時有一個重點需要知道：Lottie 並不支援 AE 所有的動畫效果。",[12,183,184],{},"更精確地來說，是 Layer Style（e.g. Inner Shadow）、Effects（e.g. Blend it）等效果全部都不支援（除非在匯出時將每個影格轉成圖片，但這樣檔案就會肥大很多），而比較基本的 Shape Layer 的效果就可以完整呈現。",[12,186,187],{},"不同系統也會有些許的支援差異（像是 Expression 表達式只支援網頁使用），因此在進 AE 製作動畫前建議先確定好需要使用的系統有哪些。",[12,189,190,191,196],{},"詳細的支援說明可以參照官方的",[98,192,195],{"href":193,"rel":194},"https:\u002F\u002Fairbnb.io\u002Flottie\u002F#\u002Fsupported-features",[102],"這張表格","。",[39,198,107,199,107,203],{},[15,200],{"src":201,"alt":202,"style":46},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled%202.png?alt=media&token=56cd0144-872a-4a69-bab6-926feb4eeca0","官方的表格",[48,204,205,206,208],{},"效果支援的部分截圖（",[98,207,193],{"href":193},"）",[12,210,211],{},"製作的時候可以注意一些小細節，讓動畫比較不會出錯也能增加運算上的效能：",[213,214,215,218,221,224,227],"ul",{},[29,216,217],{},"完全避免 Effect 跟 Layer Style 等尚未支援的效果",[29,219,220],{},"盡量精簡 Shape Layer 的物件節點",[29,222,223],{},"盡量少使用 Path 來建立關鍵影格動畫",[29,225,226],{},"盡量少使用會建立大量關鍵影格的效果（e.g. Wiggle、Autotrace）",[29,228,229],{},"讓 Alpha Matte 和 Mask 等遮色片範圍越小越好",[90,231,233],{"id":232},"安裝-ae-外掛-bodymovin","② 安裝 AE 外掛 Bodymovin",[12,235,236],{},[15,237],{"alt":238,"src":239},"Bodymovin","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FBodymovin_-_Lottie_-_aescripts__aeplugins_-_aescripts.com.png?alt=media&token=40b0d39a-8d85-4363-a2ba-ce41b7356e6d",[12,241,242,243,248],{},"這是一個免費外掛，",[98,244,247],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fairbnb\u002Flottie-web",[102],"官方提供了六種方式安裝","，我自己是使用官方推薦的方式：",[12,250,251],{},"從 aescripts + aeplugins 下載，並搭配管理的 App 來即時更新：",[213,253,254,260],{},[29,255,256],{},[98,257,238],{"href":258,"rel":259},"http:\u002F\u002Faescripts.com\u002Fbodymovin\u002F",[102],[29,261,262],{},[98,263,266],{"href":264,"rel":265},"https:\u002F\u002Faescripts.com\u002Flearn\u002Faescripts-aeplugins-manager-app\u002F",[102],"aescripts + aeplugins 管理 App",[12,268,269],{},"這個方法需要註冊 aescripts + aeplugins 的免費會員，但這個網站上面有販售很多 AE 的腳本跟外掛，所以個人覺得先註冊起來是ＯＫ的。而在將 Bodymovin 加入購物車時，記得先將價格調整為 0 元，這樣就可以免費獲得這個外掛了。",[12,271,272],{},"使用這個安裝方式有個最大的優點：就是當 Bodymovin 有更新的話，可以直接透過管理 App 即時更新，非常方便。",[90,274,276],{"id":275},"匯出成-json-給工程師","③ 匯出成 JSON 給工程師",[12,278,279],{},"要匯出動畫時，只要從 Window > Extensions > Bodymovin 找到該外掛，點擊後出現的視窗裡面就可以進行匯出的細節設定，可以根據你的需求來選擇適合的選項，這邊先以使用到網頁上的前提來進行解說（但基本上不會差多少）。",[12,281,282],{},[283,284,285],"strong",{},"設定要匯出的 Composition",[12,287,288],{},"Bodymovin 會將你 Project 裡面所有的 Composition 都列進來，你可以選擇你想要匯出的是哪一個 （點選每列最前方的 Selected Button），接著我在這邊卡了很久，不知道要怎麼才能成功匯出，後來才終於發現要先設定你的 Composition 匯出後要儲存的位址（也就是點選每列最後方的三個綠色小點）才能夠順利匯出。",[12,290,291],{},[15,292],{"alt":285,"src":293},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled%203.png?alt=media&token=3288aa5d-3769-4612-9db4-5233472549e2",[77,295],{},[12,297,298],{},[283,299,300],{},"設定匯出細節",[12,302,303],{},"點擊 Setting 的齒輪 icon 後，就可以來調整匯出時的一些細節設定，可以分成三個部分來看：",[12,305,306],{},"最上方的五個選項是比較基本的物件設定，基本上只要勾選 Glyphs 就可以，這個選項會將字型直接轉成外框物件。",[12,308,309],{},"如果你的動畫裡面有包含點陣圖的話，才需要點開 Assets 來調整（e.g. 壓縮圖片尺寸）。",[12,311,312],{},[15,313],{"alt":314,"src":315},"點開 Assets 來調整","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled%204.png?alt=media&token=41d649e2-773c-4b2d-9b60-8a13f163a328",[12,317,318],{},"中段的選項是關於匯出的設定，基本上也只要勾選 Standard 就好（譬如它下方的 Split 是可以根據秒數切分成多個檔案，但這個應該平常用不太到）。",[12,320,321],{},"如果適用於網頁上使用，也可以考慮勾選 Demo，它會多匯出一個 html 檔讓你可以在本地端預覽最後的成果，可以做為之後套用時的對照使用。",[12,323,324],{},[15,325],{"alt":326,"src":327},"勾選 Demo","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled%205.png?alt=media&token=8192db32-45eb-4579-85f3-d6774469ae35",[12,329,330],{},"最下面的三個選項則是一些額外的設定，關於表達式、進階匯出設定、以及聲音等，基本上如果沒有用到相關的功能就不需要特別設定。",[12,332,333],{},"像是如果今天是要匯出給手機系統也能使用的 Lottie 檔案的話，就可以勾選第一個 Convert expressions to keyframe，這樣就能夠將表達式的動畫轉換成關鍵影格，因為在手機系統上還沒有支援表達式的效果。",[12,335,336],{},"平常會建議勾選的是在進階匯出設定裡的 Trim unused keyframes and layers，它會移除掉工作區域外的圖層和關鍵影格，藉此可以精簡化最後匯出的檔案。",[12,338,339],{},[15,340],{"alt":341,"src":342},"勾選畫面","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled%206.png?alt=media&token=e023e907-3f84-4f81-a59b-3e5b4dc6adef",[12,344,345],{},"最後匯出前也建議可以先點擊左上角的 Preview 來預覽匯出後的成品會長怎樣，如果發現跟 AE 裡面做的有一些差異的話，可能就是用到了不支援的效果，在匯出之前可以趕快回去調整一下。",[12,347,348],{},[15,349],{"alt":350,"src":351},"Preview 畫面","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2FUntitled%207.png?alt=media&token=b561a659-f5ee-4a05-b884-82b9292c8f9c",[19,353,354],{"id":354},"結語",[12,356,357],{},"經過這次嘗試之後， Lottie 應該會加入有動畫需求的專案製作流程裡，比較簡單的動態直接交給工程師做 SVG 動畫（e.g. 簡單位移），而比較複雜的動態就使用 Lottie 來交付（e.g. 主視覺動畫）。",[39,359,107,360,107,363],{},[15,361],{"src":362,"alt":202,"style":46},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2Fezgif.com-gif-maker_(4).gif?alt=media&token=c416f6ab-0f20-4636-b3a3-74be21ada0ad",[48,364,365],{},"最後附上 AE 新手我做的土炮小動畫",[12,367,368],{},"我覺得 Lottie 之後應該會變得越來越好用，雖然不能使用 Effect 等效果可能會需要用比較土炮的方式去刻出原本預期的動畫效果，但隨著其他協定的加入，讓支援的效果、平台等都變得越來越多元（在比較早期的版本是連 Pre-comp 都不支援），更別說 Lottie 的檔案更小、效能更高、還能用於互動操作，這些優點讓我對於 Lottie 未來的發展還是十分期待的。",[12,370,371],{},[98,372,379,380,384,385,379,392,395],{"href":373,"target":374,"className":375,"style":378},"https:\u002F\u002Fhex.school\u002F1PrJX","_blank",[376,377],"btn-ui-training","btn-ui-notice","border-radius: 0.5rem;"," ",[381,382,383],"span",{}," ⚡ ⚡ ⚡ ⚡ "," ⚡ ",[381,386,387,388,391],{}," 點我預約 UI 設計",[381,389,390],{},"觀念必修","直播班 (2021)",[381,393,394],{},"⚡ ⚡ ⚡ ⚡ "," ⚡  ",{"title":397,"searchDepth":398,"depth":398,"links":399},"",2,[400,401,407,412],{"id":21,"depth":398,"text":21},{"id":81,"depth":398,"text":82,"children":402},[403,405,406],{"id":92,"depth":404,"text":93},3,{"id":116,"depth":404,"text":117},{"id":135,"depth":404,"text":135},{"id":161,"depth":398,"text":162,"children":408},[409,410,411],{"id":177,"depth":404,"text":178},{"id":232,"depth":404,"text":233},{"id":275,"depth":404,"text":276},{"id":354,"depth":398,"text":354},null,"2021-01-18","Lottie 能一鍵從 After Effects 匯出可以互動跟編輯的動畫檔案，效能與品質更遠遠優於 GIF 檔",false,"md",{},true,"\u002Fblog\u002F2021\u002F2021-01-18-lottie-ae-plugin",{"title":5,"description":415},"blog\u002F2021\u002F2021-01-18-lottie-ae-plugin",[424],"UI design","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F01%2Flottie%2Flottie-cover.png?alt=media&token=e1da7571-92b9-4af0-b471-b9521c7709fd","h4RxHnNemTlonet_LTOxca2cgfmGyCHb0IJqz_yD-bE",{"prev":428,"next":431,"related":434,"tags":437},{"title":429,"link":430},"2020 年度回顧：Awwwards 與 Codepen 精選專案介紹","\u002Fblog\u002F2021-02-02-2020-annual-awwwards-codepen-project",{"title":432,"link":433},"Spline：輕鬆建出能在網頁互動的 3D 模型","\u002Fblog\u002F2020-12-21-spline-tool-intro",[435,436],{"title":429,"link":430},{"title":432,"link":433},[424,438,439,440,441,442,443,444,445,446,447],"course","css","css3","enterprise","event","interview","javascript","jobs","skilltree","software engineer",1790064292064]