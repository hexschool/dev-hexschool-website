[{"data":1,"prerenderedAt":519},["ShallowReactive",2],{"blog:2019-06-14-the_f2e":3,"blog:neighbors:2019-06-14-the_f2e":490},{"id":4,"title":5,"author":6,"body":8,"categories":477,"date":478,"description":479,"draft":480,"extension":481,"meta":482,"navigation":483,"path":484,"seo":485,"stem":486,"tags":487,"thumbnail":17,"__hash__":489},"blog\u002Fblog\u002F2019\u002F2019-06-14-the_f2e.md","The F2E - 第二屆 前端 & UI 修練精神時光屋",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":438},"minimark",[11,18,21,24,29,37,48,51,58,62,66,83,86,89,122,127,130,133,138,144,148,154,157,160,163,167,190,194,276,279,290,293,296,299,303,306,310,313,321,324,328,331,335,339,353,357,366,370,373,377,380,384,388,391,395,398,402,405,409,412,416,424],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F06%2FF2E-2nd-1200x628.png?alt=media&token=3e297d87-8c3a-492a-8759-89af4ecd4c90",[12,19,20],{},"你想變強嗎？\n你想獲得力量嗎？\n你想透過前端改變你的生活，但找不到地方修練嗎？",[12,22,23],{},"如果你的答案是「Yes」那麼你來對地方了！",[25,26,28],"h2",{"id":27},"六角學院-x-adobe-xd-taiwan-聯名活動","六角學院 x Adobe Xd Taiwan 聯名活動",[12,30,31,32,36],{},"本活動特別感謝 ",[33,34,35],"strong",{},"Adobe Xd Taiwan"," 社群一同參與。",[12,38,39],{},[40,41,44],"a",{"href":42,"target":43},"https:\u002F\u002Fwww.facebook.com\u002Fgroups\u002Fadobexdd\u002F","_blank",[15,45],{"src":46,"width":47,"alt":28},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F06%2Fxd-%E7%A4%BE%E7%BE%A4.png?alt=media&token=1dc0cc2c-1f99-4901-8413-e5d61626f1c3",200,[25,49,50],{"id":50},"修練內容",[52,53,54],"ol",{},[55,56,57],"li",{},"一週挑戰一個修練主題，總計九週，可挑選「前端工程師」、「UI 設計師」的挑戰方向",[15,59],{"src":60,"width":61,"alt":50},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F05%2FTheF2E_topic.png?alt=media&token=2c32f07c-ce6d-41d2-a7a6-efc38211aa12","50%",[25,63,65],{"id":64},"在-the-f2e-會獲得什麼資源","在 The F2E 會獲得什麼資源？",[67,68,69],"ul",{},[55,70,71,72],{},"資源授權：本活動的所有授權都是 CC0 格式，方便挑戰者重製成自己的 side project 與作品，授權範圍含：\n",[67,73,74,77,80],{},[55,75,76],{},"User story (使用者故事)",[55,78,79],{},"Functional Map (功能架構規劃)",[55,81,82],{},"Mockup (設計稿)",[25,84,85],{"id":85},"報名與參賽方式",[12,87,88],{},"請依照下列三步驟進行報名",[67,90,91,97,110,116],{},[55,92,93,96],{},[33,94,95],{},"報名時間","：6\u002F14(五)~7\u002F7(五)，正式開賽時間為 7\u002F8 (一)",[55,98,99,102,103,109],{},[33,100,101],{},"報名方式","：到",[40,104,108],{"href":105,"rel":106},"https:\u002F\u002Fchallenge.thef2e.com",[107],"nofollow","此平台報名","。",[55,111,112,115],{},[33,113,114],{},"開賽規則","：每週一中午 12 點公布新題目，隔週一中午 12 點前將作品投稿到平台。",[55,117,118,121],{},[33,119,120],{},"發文登記","：開賽後的每週登錄作品請投稿到 The F2E 平台，當週才算挑戰成功。",[12,123,124],{},[15,125],{"alt":85,"src":126},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F05%2FTheF2E_rule.png?alt=media&token=e432a154-b361-44a2-a97d-33eab5bf614d",[25,128,129],{"id":129},"技能樹選擇",[12,131,132],{},"請依照自己想投入的部分，額外選擇下面兩條修練方向。",[134,135,137],"h3",{"id":136},"aui-設計師","A.UI 設計師",[12,139,140,143],{},[33,141,142],{},"設計 UI 介面","：每道修練主題我們都會提供 User story (使用者故事)，你可以依此使用 UI 繪圖軟體來設計 Mockup，以加強自己對 Web UI 的掌握度。",[134,145,147],{"id":146},"b前端工程師","B.前端工程師",[12,149,150,153],{},[33,151,152],{},"JS開發 & 介接 API","：在開發中大型介面時，一個網頁上可能會有許多第三方介接的資料，例如後端的 RESTful API、Google Map、BaaS 等等，您可以思考我們所提供的修練主題，試著導入服務進去。",[25,155,156],{"id":156},"前端工程師修練方向",[12,158,159],{},"你可以依照我們提供的修練主題，主動練習自己想投入的新技術。為了確保每週都能挑戰功能，會建議 70% 用自己會的技術，30% 使用剛學會的新技術，以避免挑戰曲線不會過高。",[12,161,162],{},"以 CSS、JavaScript 為例，你可投入：",[134,164,166],{"id":165},"css","CSS",[67,168,169,172,175,178,181,184,187],{},[55,170,171],{},"會使用 float 排版時，可以嘗試使用 flexbox、grid 排版",[55,173,174],{},"思考響應式排版的實做方式，並在 iPad、mobile 有極好的使用者體驗",[55,176,177],{},"transition、animation、transform 動畫效果，提升網頁動線",[55,179,180],{},"能使用 CSS 實做出來的效果，就不要使用 JavaScript",[55,182,183],{},"預處理器 (SCSS、LESS) 與 PostCSS",[55,185,186],{},"CSS 框架 (Bootstrap、Pure)",[55,188,189],{},"設計模式 (SMACSS、OOCSS、BEM、MVCSS)",[134,191,193],{"id":192},"javascript","JavaScript",[67,195,196,216,222,228,234,240,246,252,258,264,270],{},[55,197,198,201,202],{},[33,199,200],{},"JS 基礎","：使用一個你不曾用過的 JS 技巧，例如\n",[67,203,204,207,210,213],{},[55,205,206],{},"array map 、filter、reduce",[55,208,209],{},"閉包、遞迴、物件導向",[55,211,212],{},"JSON 資料、字串處理",[55,214,215],{},"正規表達式 (Regular Expression)",[55,217,218,221],{},[33,219,220],{},"模組管理","：使用任務管理工具 (grunt、gulp)、模組打包工具 (webpack)",[55,223,224,227],{},[33,225,226],{},"ECMAScript","：ES 6、7 、8，並使用 Babel 兼容網頁瀏覽器。",[55,229,230,233],{},[33,231,232],{},"HTML5 API","：LocalStorage、Geolocation、File API",[55,235,236,239],{},[33,237,238],{},"介接第三方服務 API","： social login、weater、open data、自建 API",[55,241,242,245],{},[33,243,244],{},"導入 SPA 框架","： Vue、React、Angular",[55,247,248,251],{},[33,249,250],{},"工具框架","：lodash、Underscore",[55,253,254,257],{},[33,255,256],{},"應用程式服務","：瀏覽器插件 (chrome extension)、桌面應用程式 (electron)、APP (ionic、react native)",[55,259,260,263],{},[33,261,262],{},"2、3D 動畫開發","：使用 SVG、canvas、WebGL 設計動畫效果，例如 D3.js、three.js",[55,265,266,269],{},[33,267,268],{},"Node.js","：NPM 、後端框架 (koa、express)、API 設計、測試(Mocha、Nightwatch)",[55,271,272,275],{},[33,273,274],{},"程式檢查","：ESLint、JSHint",[25,277,278],{"id":278},"獎勵機制",[67,280,281,284,287],{},[55,282,283],{},"完成三道關卡：授予銅級數位勳章，並記錄在戰績榜上。",[55,285,286],{},"完成六道關卡：授予銀級數位勳章，並記錄在戰績榜上。",[55,288,289],{},"完成九道關卡：授予金級數位勳章，並記錄在戰績榜上。",[25,291,292],{"id":292},"前端直播客分享",[12,294,295],{},"本次活動同時邀請到許多有在經營前端直播的資深開發者，藉此促進交流，大幅升級自己的腦袋！",[25,297,298],{"id":298},"常見問答",[134,300,302],{"id":301},"q如果某一週不小心挑戰失敗是否能再繼續挑戰後面關卡","Q：如果某一週不小心挑戰失敗，是否能再繼續挑戰後面關卡？",[12,304,305],{},"A：可以，儘管那週挑戰失敗，之後您仍可以挑選喜歡的關卡進行挑戰，並在該關卡期限內繳交作品。",[134,307,309],{"id":308},"q大家都好強我怕我做的東西沒有達到過關門檻不敢登錄作品","Q：大家都好強，我怕我做的東西沒有達到過關門檻，不敢登錄作品",[12,311,312],{},"A：這個活動並非競爭性質，每個參賽者都是你的隊友，最大的敵人是你自己，因為你必須定期練功前端開發，讓自己能夠順利完賽。",[134,314,316,317],{"id":315},"q我不確定自己做的版型有沒有符合過關門檻要寫到什麼程度才有到過關門檻","Q：我不確定自己做的版型有沒有符合過關門檻，",[318,319,320],"em",{},"要寫到什麼程度才有到過關門檻？",[12,322,323],{},"A：主辦單位其實不會去審核大家的程式碼，只要你認為當週你有針對主題有做到一定程度，就算是半完成品也請大方投稿，不用擔心。",[134,325,327],{"id":326},"q我已經寫到一半了但時間快來不及可以先投稿嗎","Q：我已經寫到一半了，但時間快來不及，可以先投稿嗎？",[12,329,330],{},"A：可以，有投稿表示你還會持續努力在這次活動上。",[25,332,334],{"id":333},"ui-設計師常見問題","【UI 設計師常見問題】",[134,336,338],{"id":337},"q到時投稿到平台是提供什麼呢我也不像是工程師可以有-codepen-上傳","Q：到時投稿到平台是提供什麼呢？我也不像是工程師可以有 CODEPEN 上傳。",[12,340,341,342,347,348,352],{},"A：其中投稿的欄位裡面會有一個「",[40,343,346],{"href":344,"rel":345},"https:\u002F\u002Fxd.adobe.com\u002Fspec\u002F934efdb7-a7e4-47d5-572e-efece0914f62-e57f\u002F?fbclid=IwAR33R3WYRRNmN8tmmpKf4q43z6F6ftDbpx3eNbG1eJe1rC2BDxbyS0D5nTc",[107],"線上標示文件","」，像是 Adobe XD 便有提供該服務(",[40,349,351],{"href":344,"rel":350},[107],"範例連結",")，屆時提供標示文件後，便可讓其他前端工程師採用你的設計稿來開發。",[134,354,356],{"id":355},"q一定要上傳線上標示文件嗎","Q：一定要上傳「線上標示文件」嗎？",[12,358,359,360,365],{},"A：是的，因為這樣才有辦法讓其他前端工程師，能採用您的設計稿，將您的設計稿實作出網頁格式。如果您是使用 Sketch，也可使用 ",[40,361,364],{"href":362,"rel":363},"https:\u002F\u002Fgithub.com\u002Futom\u002Fsketch-measure",[107],"Sketch Measure"," 編譯出來後，壓縮 ZIP 到雲端空間 (Dropbox、Google Drive)。",[134,367,369],{"id":368},"q不能使用-psillustrator-設計嗎","Q：不能使用 PS、Illustrator 設計嗎？",[12,371,372],{},"A：只要您能找到 PS 或 Illustrator 產出線上標示文件的方式就可以，因為前端工程師大部分皆比較少具有繪圖軟體，所以用線上標示文件將會減少許工程師協作上的溝通時間。",[134,374,376],{"id":375},"q當每週一題目出來後我有一些設計進度也可以先投稿嗎","Q：當每週一題目出來後，我有一些設計進度也可以先投稿嗎？",[12,378,379],{},"A：可以，團隊在協作過程中，一定也會先出些進度提供前端切版，有進度時您也可以先投稿，讓前端工程師可以先接手，之後再透過 FB 社團來溝通進度即可。",[25,381,383],{"id":382},"前端工程師常見問題","【前端工程師常見問題】",[134,385,387],{"id":386},"q我可以不依照設計稿自己做版面嗎因為我想多練習-js後端","Q：我可以不依照設計稿，自己做版面嗎？因為我想多練習 JS\u002F後端",[12,389,390],{},"A：可以，The F2E 活動是希望讓大家人人有功練，所以依照你自己想投入的方向練功即可。CSS 也可以用框架，例如 Bootstrap。",[134,392,394],{"id":393},"q前端介面一定要長得一模一樣嗎","Q：前端介面一定要長得一模一樣嗎？",[12,396,397],{},"A：不用，依照自己的想法來開發也可以",[134,399,401],{"id":400},"q有現成的網頁靜態頁面嗎我想只練習-js後端就好","Q：有現成的網頁靜態頁面嗎？我想只練習 JS\u002F後端就好",[12,403,404],{},"A：這段我們不會提供，畢竟每個人習慣的 Coding style 又不一樣，產出的 HTML、CSS 並非是自己習慣的 Layout 反而會更花時間。",[134,406,408],{"id":407},"q那我只想要練習-jshtmlcss-我用陽春版不依照設計稿開發可以嗎","Q：那我只想要練習 JS，HTML\u002FCSS 我用陽春版，不依照設計稿開發可以嗎？",[12,410,411],{},"A：可以，你可以當做我們就是出一個主題，你依照那主題當作參考方向來開發即可。",[134,413,415],{"id":414},"協力廠商-monospace","協力廠商 MonoSpace",[12,417,418],{},[40,419,421],{"href":420,"target":43},"https:\u002F\u002Fwww.facebook.com\u002Fmonospace.tw\u002F",[15,422],{"src":423,"width":47,"alt":415},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F06%2Fmonospace.png?alt=media&token=3dd5eb6b-e5b3-4613-9764-d902cfbc2b61",[425,426,428,429],"div",{"style":427},"text-align: center;","\n  ",[40,430,434],{"href":105,"className":431,"title":433},[432],"btn-radius","THE F2E 立即挑戰",[435,436,437],"span",{}," 立即挑戰 ",{"title":439,"searchDepth":440,"depth":440,"links":441},"",2,[442,443,444,445,446,451,455,456,457,464,470],{"id":27,"depth":440,"text":28},{"id":50,"depth":440,"text":50},{"id":64,"depth":440,"text":65},{"id":85,"depth":440,"text":85},{"id":129,"depth":440,"text":129,"children":447},[448,450],{"id":136,"depth":449,"text":137},3,{"id":146,"depth":449,"text":147},{"id":156,"depth":440,"text":156,"children":452},[453,454],{"id":165,"depth":449,"text":166},{"id":192,"depth":449,"text":193},{"id":278,"depth":440,"text":278},{"id":292,"depth":440,"text":292},{"id":298,"depth":440,"text":298,"children":458},[459,460,461,463],{"id":301,"depth":449,"text":302},{"id":308,"depth":449,"text":309},{"id":315,"depth":449,"text":462},"Q：我不確定自己做的版型有沒有符合過關門檻，要寫到什麼程度才有到過關門檻？",{"id":326,"depth":449,"text":327},{"id":333,"depth":440,"text":334,"children":465},[466,467,468,469],{"id":337,"depth":449,"text":338},{"id":355,"depth":449,"text":356},{"id":368,"depth":449,"text":369},{"id":375,"depth":449,"text":376},{"id":382,"depth":440,"text":383,"children":471},[472,473,474,475,476],{"id":386,"depth":449,"text":387},{"id":393,"depth":449,"text":394},{"id":400,"depth":449,"text":401},{"id":407,"depth":449,"text":408},{"id":414,"depth":449,"text":415},null,"2019-06-14","你想變強嗎？你想獲得力量嗎？你想透過前端改變你的生活，但找不到地方修練嗎？如果你的答案是「Yes」那麼你來對地方了！",false,"md",{},true,"\u002Fblog\u002F2019\u002F2019-06-14-the_f2e",{"title":5,"description":479},"blog\u002F2019\u002F2019-06-14-the_f2e",[488],"skilltree","d4LKxbGQEik9zj1EAFuGm2KdbkzTXuo1tTcTDro_cVk",{"prev":491,"next":494,"related":497,"tags":510},{"title":492,"link":493},"【大神來六角】七月直播主題：資料庫","\u002Fblog\u002F2019-06-21-god-and-hexschool",{"title":495,"link":496},"【大神來六角】六月直播主題：檔案傳輸","\u002Fblog\u002F2019-05-22-god-and-hexschool",[498,501,504,507],{"title":499,"link":500},"2022 前端開發者學習地圖","\u002Fblog\u002F2022-04-18-frontend-study-map",{"title":502,"link":503},"The F2E - 前端修練精神時光屋","\u002Fblog\u002F2018-05-09-the_f2e",{"title":505,"link":506},"2018 前端開發者學習地圖！","\u002Fblog\u002F2018-04-16-skill_tree",{"title":508,"link":509},"2017 前端開發者技能樹！","\u002Fblog\u002F2017-06-12-skill_tree",[511,512,165,513,514,515,516,192,517,488,518],"UI design","course","css3","enterprise","event","interview","jobs","software engineer",1790064292223]