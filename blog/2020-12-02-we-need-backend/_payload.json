[{"data":1,"prerenderedAt":266},["ShallowReactive",2],{"blog:2020-12-02-we-need-backend":3,"blog:neighbors:2020-12-02-we-need-backend":237},{"id":4,"title":5,"author":6,"body":8,"categories":224,"date":225,"description":226,"draft":227,"extension":228,"meta":229,"navigation":230,"path":231,"seo":232,"stem":233,"tags":234,"thumbnail":17,"__hash__":236},"blog\u002Fblog\u002F2020\u002F2020-12-02-we-need-backend.md","【徵才】Node.js 後端工程師",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":204},"minimark",[11,18,23,26,29,32,35,38,51,54,57,61,72,75,81,84,95,99,102,105,108,111,131,134,151,154,174,177,182,185],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F12%2Fhiring-backend.png?alt=media&token=44b1a76f-4c6a-4d43-b7f8-bfe9e40cc67c",[19,20,22],"h2",{"id":21},"職缺名稱","職缺名稱：",[12,24,25],{},"Node.js 後端工程師",[19,27,28],{"id":28},"公司簡介",[12,30,31],{},"六角學院為線上課程教育單位，我們的使命為讓世界各地的學員，能透過線上學習，擁有更好的職涯發展機會。",[19,33,34],{"id":34},"產品介紹",[12,36,37],{},"我們的產品可歸為以下三類，年平均成長超過 30% 以上：",[39,40,41,45,48],"ol",{},[42,43,44],"li",{},"影音課程：目前我們的影音課程皆放在 Teachable、Udemy、Hahow 上，並藉由 API 整合到自家的輔助學員平台，統一回覆學員問答",[42,46,47],{},"直播課程系統：每梯上課學員平均為 300 人，搭配系統設計，優化教育流程",[42,49,50],{},"輔助學習平台：裡頭有任務系統、面試心得牆、支援各課程的教材系統，讓學員獲得階段性的資源。",[12,52,53],{},"而 2 跟 3 點則是主要開發團隊在著手的項目，也是為什麼我們要聘請 Node.js 開發者的原因，我們期待您的加入，讓我們的學員能夠享受到更好的教學平台服務品質。",[19,55,56],{"id":56},"條件要求",[58,59,60],"h3",{"id":60},"必備條件",[39,62,63,66,69],{},[42,64,65],{},"熟悉 Node.js 及建立 RESTful API 開發經驗",[42,67,68],{},"需至少瞭解其中一項資料庫 (MySQL \u002F PostgreSQL \u002F MongoDB) 安裝、設計、效能調整",[42,70,71],{},"瞭解 Git \u002F GitHub，懂得分支操作、衝突解決及 Pull Requests",[58,73,74],{"id":74},"加分條件",[76,77,78],"ul",{},[42,79,80],{},"熟悉任一雲服務經驗 (AWS、GCP、Heroku、Linode)。",[19,82,83],{"id":83},"主要工作內容",[39,85,86,89,92],{},[42,87,88],{},"資料庫架構規劃",[42,90,91],{},"網站 API 開發",[42,93,94],{},"第三方服務串接與開發",[19,96,98],{"id":97},"薪資月薪","薪資(月薪)：",[12,100,101],{},"45,000~60,000，保障 13 個月，能力好可議。",[19,103,104],{"id":104},"公司分紅與獎金",[12,106,107],{},"依照公司獲利與表現進行分配，至少 1.5 個月。",[19,109,110],{"id":110},"福利與工作制度",[76,112,113,116,119,122,125,128],{},[42,114,115],{},"每天工作 8 小時，早上 9:00 - 9:30 可彈性上班",[42,117,118],{},"2021 將嘗試遠端工作，每雙週週三下午進行遠端工作。",[42,120,121],{},"提供 Mac、電腦 24+ 吋螢幕提昇工作效率",[42,123,124],{},"每年一次的員工旅遊",[42,126,127],{},"不定期聚餐",[42,129,130],{},"外訓課程申請、並鼓勵與補助參與技術研討會",[19,132,133],{"id":133},"工作環境與團隊介紹",[76,135,136,139,142,145,148],{},[42,137,138],{},"開發團隊由 3 位前端、2 位 UI，目前暫由 co-founder 協助 Node.js 後端開發",[42,140,141],{},"開發流程為 co-founder 釋出 wireframe 線稿圖，進行前期需求收斂，並尊重開發的時程評估，並定期交付成果。",[42,143,144],{},"我們目前既有平台為 80% PHP、20% Node.js，預期 2021 年陸續重構成 Node.js 架構",[42,146,147],{},"團隊成員皆熱愛分享與學習，超過一半成員參與過技術研討會與擔任志工",[42,149,150],{},"2021 年將陸續導入測試、CI\u002FCD，以提升平台穩定性",[19,152,153],{"id":153},"目前團隊用的技能樹與工具",[76,155,156,159,162,165,168,171],{},[42,157,158],{},"前端：Vue3、Vite、BS4&5、SCSS、SPA",[42,160,161],{},"後端：Node.js(Express)、PHP(Laravel)",[42,163,164],{},"版控：GitHub Flow、發 PR 進行 Code Review",[42,166,167],{},"雲服務：AWS EC2、S3、RDS、GCP Firebase",[42,169,170],{},"技術工具：Postman、Slack",[42,172,173],{},"Issue 指派：Notion",[19,175,176],{"id":176},"工作地點",[76,178,179],{},[42,180,181],{},"高雄市鹽埕區",[19,183,184],{"id":184},"聯絡與面試方式",[76,186,187,195,198,201],{},[42,188,189,190],{},"請寄信至 ",[191,192,194],"a",{"href":193},"mailto:service@hexschool.com","service@hexschool.com",[42,196,197],{},"信件標題請設定為：【應徵 Node.js 後端工程師】OOO (OOO 為您的姓名)",[42,199,200],{},"履歷附件還請用 PDF 提供",[42,202,203],{},"收到履歷後，若您是潛在合適人選，我們會透過 Email 與您約時間進行現場面試",{"title":205,"searchDepth":206,"depth":206,"links":207},"",2,[208,209,210,211,216,217,218,219,220,221,222,223],{"id":21,"depth":206,"text":22},{"id":28,"depth":206,"text":28},{"id":34,"depth":206,"text":34},{"id":56,"depth":206,"text":56,"children":212},[213,215],{"id":60,"depth":214,"text":60},3,{"id":74,"depth":214,"text":74},{"id":83,"depth":206,"text":83},{"id":97,"depth":206,"text":98},{"id":104,"depth":206,"text":104},{"id":110,"depth":206,"text":110},{"id":133,"dep