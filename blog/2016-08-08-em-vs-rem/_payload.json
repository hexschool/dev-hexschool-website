[{"data":1,"prerenderedAt":464},["ShallowReactive",2],{"blog:2016-08-08-em-vs-rem":3,"blog:neighbors:2016-08-08-em-vs-rem":449},{"id":4,"title":5,"author":6,"body":8,"categories":434,"date":436,"description":437,"draft":438,"extension":439,"meta":440,"navigation":441,"path":442,"seo":443,"stem":444,"tags":445,"thumbnail":17,"__hash__":448},"blog\u002Fblog\u002F2016\u002F2016-08-08-em-vs-rem.md","實際展示 EM 與 REM 的差異",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":422},"minimark",[11,18,23,30,56,70,91,95,109,122,144,157,184,188,204,237,267,276,334,342,345,354,359,367,370,377,381,386,392,399,404,418],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2016%2F08%2Frem-vs-em.jpg?alt=media&token=fe7fc081-f8e5-44cf-b57f-9fb91db57535",[19,20,22],"h2",{"id":21},"px","PX",[12,24,25,26,29],{},"一般來說，我們會使用 ",[27,28,21],"code",{}," 來作為網頁設計的單位，除了它精確度較高以外，對於許多網頁設計師來說也是相當容易入門的單位。",[31,32,35,36,35,41,35,46,35,51],"div",{"className":33},[34],"demo","\n  ",[31,37,40],{"className":38},[39],"f12px","font-size:12px",[31,42,45],{"className":43},[44],"f13px","font-size:13px",[31,47,50],{"className":48},[49],"f14px","font-size:14px",[31,52,55],{"className":53},[54],"f15px","font-size:15px",[12,57,58,60,61,65,66,69],{},[27,59,21],{}," 的特性是屬於 ",[62,63,64],"strong",{},"絕對數值","，他不受外圍的單位影響，只要固定是 ",[27,67,68],{},"12px","，就會以 12 像素呈現。以下方的範例來說，他並不會受到外圍文字大小所影響，內部的文字大小還是依據 CSS 設定所呈現。",[31,71,35,73],{"className":72},[34],[31,74,77,78,81,82,81,85,81,88,35],{"className":75},[76],"fLarge","font-size: large\n    ",[31,79,40],{"className":80},[39],"\n    ",[31,83,45],{"className":84},[44],[31,86,50],{"className":87},[49],[31,89,55],{"className":90},[54],[19,92,94],{"id":93},"em","EM",[12,96,97,98,100,101,104,105,108],{},"另一個常見的文字單位是 ",[27,99,93],{},"， em 是相對的的數值單位，它會受到外圍的文字大小所影響，而 ",[27,102,103],{},"1em"," 即是 1 的文字大小， ",[27,106,107],{},"1.5em"," 也就是 1.5 倍的文字大小。",[12,110,111,112,115,116,118,119,121],{},"以下方的範例可以發現，如果外圍是以 ",[27,113,114],{},"15px","，內層的文字第一層 ",[27,117,103],{}," 等同於 ",[27,120,114],{},"，隨後的依比例放大。",[31,123,35,125],{"className":124},[34],[31,126,128,129,81,134,81,139,35],{"className":127},[54],"font-size: 15px\n    ",[31,130,133],{"className":131},[132],"fem","font-size: 1em",[31,135,138],{"className":136},[137],"f2em","font-size: 1.2em",[31,140,143],{"className":141},[142],"f4em","font-size: 1.4em",[12,145,146,147,149,150,153,154,156],{},"接下來改成使用 em 來做實驗，外層的文字大小直接從 1.4em 開始，可以看到內層的 ",[27,148,103],{}," 文字大小等同於外層 ",[27,151,152],{},"1.4em","，隨後的逐漸放大。如果在加入一層在內部，文字就會以 1.4 * 1.4 的倍數再放大，這是 ",[27,155,93],{}," 的相對比例單位的特性，是優點也是缺點，如果無法掌握就容易失控。",[31,158,35,160],{"className":159},[34],[31,161,163,164,81,167,81,170,81,173,35],{"className":162},[142],"font-size: 1.4em\n    ",[31,165,133],{"className":166},[132],[31,168,138],{"className":169},[137],[31,171,143],{"className":172},[142],[31,174,176,177,180,181,81],{"className":175},[142],"font-size: 1.4em\n      ",[31,178,133],{"className":179},[132],"\n      ",[31,182,143],{"className":183},[142],[19,185,187],{"id":186},"rem","REM",[12,189,190,192,193,195,196,199,200,203],{},[27,191,186],{}," 也是相對的文字尺寸，和 ",[27,194,93],{}," 使用方法接近，不同的是他僅相對於 ",[27,197,198],{},"root"," 層級的文字大小(網頁中的 ",[27,201,202],{},"html",")。",[12,205,206,207,210,211,213,214,216,217,220,221,223,224,226,227,229,230,232,233,236],{},"以這個範例來說，此網站的文字大小是 ",[27,208,209],{},"16px","，",[27,212,186],{},"的尺寸就是以 ",[27,215,209],{}," 為基準，故下方的 ",[27,218,219],{},"1rem"," 會與 ",[27,222,209],{}," 相同尺寸。所以無論外層是否有其他文字大小，皆不會影響 ",[27,225,186],{}," 的尺寸，唯一會影響 ",[27,228,186],{}," 比例的只有 ",[62,231,202],{}," 的文字大小(可以打開 ",[93,234,235],{},"開發者工具"," 試試看喔)。",[31,238,35,240],{"className":239},[34],[31,241,243,244,81,249,81,254,81,259,81,264,35],{"className":242},[142],"\n    font-size: 1.4em\n    ",[31,245,248],{"className":246},[247],"frem","font-size: 1rem",[31,250,253],{"className":251},[252],"f16px","font-size: 16px",[31,255,258],{"className":256},[257],"f2rem","font-size: 1.2rem",[31,260,263],{"className":261},[262],"f4rem","font-size: 1.4rem",[31,265,143],{"className":266},[142],[12,268,269,270,272,273,275],{},"使用 ",[27,271,186],{}," 時，可以先了解瀏覽器的限制， ",[27,274,186],{}," 是不支援 IE8 以前的瀏覽器的喔。",[277,278,279,280],"table",{},"\n ",[281,282,35,283,35,306,279],"tbody",{},[284,285,286,287,286,291,286,294,286,297,286,300,286,303,35],"tr",{},"\n   ",[288,289,290],"th",{},"Feature",[288,292,293],{},"Chrome",[288,295,296],{},"Firefox (Gecko)",[288,298,299],{},"Internet Explorer",[288,301,302],{},"Opera",[288,304,305],{},"Safari",[284,307,286,308,286,313,286,316,286,325,286,328,286,331,35],{},[309,310,311],"td",{},[27,312,186],{},[309,314,315],{},"4 (532.3)",[309,317,318,324],{},[319,320,323],"a",{"href":321,"title":322},"\u002Fen-US\u002FFirefox\u002FReleases\u002F3.6","Released on 2010-01-21.","3.6"," (1.9.2)",[309,326,327],{},"9.0",[309,329,330],{},"11.6",[309,332,333],{},"4.1",[12,335,336,337],{},"*來源：",[319,338,339],{"href":339,"rel":340},"https:\u002F\u002Fdeveloper.mozilla.org\u002Fen-US\u002Fdocs\u002FWeb\u002FCSS\u002Flength",[341],"nofollow",[19,343,344],{"id":344},"實作上該如何選擇",[12,346,347,348,350,351,353],{},"而就實作上，",[62,349,186],{}," 與 ",[62,352,93],{}," 該如何抉擇呢？",[355,356,358],"h3",{"id":357},"選擇-em","選擇 em",[12,360,361,363,364,366],{},[27,362,93],{}," 的文字大小基準取決於父層的文字大小，所以建議使用在限制區域的內容、元件等等，就文字大小切換的效果來說，",[27,365,93],{}," 可以輕易的從父層改變進而影響內容文字的大小。",[12,368,369],{},"以下方的範例來說，可以直接點選文字大小切換內文，而不需要使用太多的 CSS 樣式。",[371,372],"code-pen",{"height":373,"id":374,"title":375,"user":376},265,"JKZNod","文字大小切換","Wcc723",[355,378,380],{"id":379},"選擇-rem","選擇 rem",[12,382,383,385],{},[27,384,186],{}," 的文字基準取決於最外層的 html 文字大小，很適合用在整體的尺寸大小切換，以 RWD 響應式網頁來說，可以依據不同的尺寸，統一切換整體網頁的文字大小。",[12,387,388,389,391],{},"以 Bootstrap 4 來說，許多元件都是以 ",[27,390,186],{}," 作為單位，所以只要改寫 HTML 的 font-size，就能一口氣修改全部元件的尺寸，下方的範例大家可以到直接到 codepen 上拉拉看，會發現不同的瀏覽器大小，元件尺寸也會跟著更動喔。",[12,393,394,395],{},"CodePen 連結：",[319,396,397],{"href":397,"rel":398},"https:\u002F\u002Fcodepen.io\u002FWcc723\u002Fpen\u002FJKZkxE",[341],[371,400],{"height":373,"id":401,"title":402,"user":376,"tab":403},"JKZkxE","rem vs bootstrap","html,result",[12,405,406,407,350,409,411,412,417],{},"相信看到這，大家對於 ",[62,408,93],{},[62,410,186],{}," 有更多的了解，如果還有不明白的地方，歡迎到我們",[319,413,416],{"href":414,"rel":415},"https:\u002F\u002Fwww.facebook.com\u002Fhexschool\u002F",[341],"六角學院粉絲團","留言喔～",[419,420,421],"style",{},"\n.demo {\n  margin-bottom: 1rem;\n  text-align: center;\n}\n\n\u002F* 巢狀每一層都要有框線，相對字級的差異才示範得出來 *\u002F\n.demo div {\n  margin: 4px;\n  border: 1px solid #ccc;\n  padding: 4px;\n}\n.demo div:hover { border-color: red; }\n\n.f12px { font-size: 12px; }\n.f13px { font-size: 13px; }\n.f14px { font-size: 14px; }\n.f15px { font-size: 15px; }\n.f16px { font-size: 16px; }\n.fLarge { font-size: large; }\n\n.fem { font-size: 1em; }\n.f2em { font-size: 1.2em; }\n.f4em { font-size: 1.4em; }\n\n.frem { font-size: 1rem; }\n.f2rem { font-size: 1.2rem; }\n.f4rem { font-size: 1.4rem; }\n",{"title":423,"searchDepth":424,"depth":424,"links":425},"",2,[426,427,428,429],{"id":21,"depth":424,"text":22},{"id":93,"depth":424,"text":94},{"id":186,"depth":424,"text":187},{"id":344,"depth":424,"text":344,"children":430},[431,433],{"id":357,"depth":432,"text":358},3,{"id":379,"depth":432,"text":380},[435],"CSS","2016-01-02","EM 與 REM 的差異究竟在哪，還有這些單位與 px 之間究竟該如何選擇，這篇文章透過實際展示帶你了解這些差異。",false,"md",{},true,"\u002Fblog\u002F2016\u002F2016-08-08-em-vs-rem",{"title":5,"description":437},"blog\u002F2016\u002F2016-08-08-em-vs-rem",[446,447],"css","css3","V3w47dHd7rVmuU9QcfzNQSQivHyra-woodUNzbaT_RQ",{"prev":450,"next":-1,"related":453,"tags":454},{"title":451,"link":452},"前端素人 葉振賢：「不要妄自菲薄，面對失敗是人生中重要的一環」","\u002Fblog\u002F2016-08-25-interview",[],[455,456,446,447,457,458,459,460,461,462,463],"UI design","course","enterprise","event","interview","javascript","jobs","skilltree","software engineer",1790064292028]