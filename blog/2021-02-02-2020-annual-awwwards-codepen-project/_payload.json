[{"data":1,"prerenderedAt":350},["ShallowReactive",2],{"blog:2021-02-02-2020-annual-awwwards-codepen-project":3,"blog:neighbors:2021-02-02-2020-annual-awwwards-codepen-project":327},{"id":4,"title":5,"author":6,"body":8,"categories":314,"date":315,"description":316,"draft":317,"extension":318,"meta":319,"navigation":320,"path":321,"seo":322,"stem":323,"tags":324,"thumbnail":17,"__hash__":326},"blog\u002Fblog\u002F2021\u002F2021-02-02-2020-annual-awwwards-codepen-project.md","2020 年度回顧：Awwwards 與 Codepen 精選專案介紹",[7],"六角學院",{"type":9,"value":10,"toc":298},"minimark",[11,18,22,25,28,39,54,57,60,63,72,75,85,95,98,105,107,116,126,129,135,137,146,155,158,164,166,169,178,189,192,200,203,208,211,213,217,229,232,235,238,246,248,251,257,259,262,265,268,271],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2Fcover-awwwards.png?alt=media&token=6e6695a8-5f64-4fa7-b1d3-860bf1b340be",[19,20,21],"h2",{"id":21},"前言",[12,23,24],{},"進入了 2021 年，許多人都會開始回顧去年度做了什麼，以規劃今年的目標。身為網頁設計師，就從平常會瀏覽的兩個網站：Awwwards 跟 Codepen 來介紹幾個喜歡的專案，並分享一些自己的看法。",[26,27],"hr",{},[19,29,31,38],{"id":30},"annual-awwwards年度票選",[32,33,37],"a",{"href":34,"rel":35},"https:\u002F\u002Fannual.awwwards.com\u002F",[36],"nofollow","Annual Awwwards"," 年度票選",[40,41,42,43,48,49],"figure",{},"\n    ",[15,44],{"src":45,"alt":46,"style":47},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_M1q3orRD9YIYoUOytVTv-g.png?alt=media&token=f642d248-45c3-4412-a344-892172d9eaf9","awwwards 網站","width: 100%;","\n  ",[50,51,52],"figcaption",{},[32,53,34],{"href":34},[12,55,56],{},"相信在網頁設計圈裡面的人對於 Awwwards 不陌生，Awwwards 上可以投稿自己的網頁專案，並經由會員投票票選出優秀的作品，也會舉辦頒獎典禮或是設計研討會。",[12,58,59],{},"我很喜歡逛 Awwwards，可以看看目前網頁能夠做到什麼樣的效果，也能夠檢視目前的一些網頁設計趨勢。",[12,61,62],{},"而到了年初，Awwwards 會票選出去年的年度網站（Site of the year），除此之外還有 Agency、Studio、Independent、Developer、E-commerce、Mobile 等幾種分類的獎項，今年因為疫情的關係取消了實體的頒獎典禮，改採取線上的形式舉辦。",[40,64,42,65,48,69],{},[15,66],{"src":67,"alt":68,"style":47},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_1aKDtEaUKqFX3L2tJnfsqA.gif?alt=media&token=9f7d6a69-2283-48f4-975f-57951e0b6c2d","awwwards 投票的網站也做得超棒",[50,70,71],{},"投票的網站也做得超棒",[12,73,74],{},"入圍 Site of the year 的網站共有 40 個，要從裡面選出一個最喜歡的實在有點困難，於是我選出了三個自己都很喜歡的網站分享給大家：",[76,77,79,80],"h3",{"id":78},"pioneercorn-revolutionized","① ",[32,81,84],{"href":82,"rel":83},"https:\u002F\u002Fgo.pioneer.com\u002Fcornrevolution#result",[36],"Pioneer — Corn Revolutionized",[40,86,42,87,48,91],{},[15,88],{"src":89,"alt":90,"style":47},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_8d1lZQiHXi0GN29WyHeFMg.png?alt=media&token=678cc677-b3a9-473d-bd89-a42040ca4d64","Pioneer — Corn Revolutionized 網站",[50,92,93],{},[32,94,82],{"href":82},[12,96,97],{},"Pioneer 是一間美國的農業公司，特別鑽研玉米相關的基改種植，這個網站是一個單頁式循環網頁，標題在 Hover 時會有粒子連結的透視感，很符合基因改造的形象（點擊時還會擴散），整體網頁將 3D 模型結合頁面滾動來呈現，與 3D 模型的互動也很流暢（切換時有設定一些延遲讓體驗更順暢）。",[40,99,42,100],{},[15,101],{"src":102,"alt":103,"style":104},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_tFpmXCzsT_lo0EHtBuihxA.gif?alt=media&token=5699e361-f5d2-496f-a1bb-a99be9ff95d5","① Pioneer — Corn Revolutionized","margin-left: auto; margin-right: auto;",[26,106],{},[76,108,110,111],{"id":109},"the-year-ofgreta","② ",[32,112,115],{"href":113,"rel":114},"https:\u002F\u002Ftheyearofgreta.com\u002F",[36],"The Year of Greta",[40,117,48,118,48,121],{},[15,119],{"src":120,"alt":113,"style":47},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_DvOqyrRJCZLTEUKBxsPYrA.png?alt=media&token=32799d0b-1935-4b72-8d79-e35990902913",[50,122,123],{},[32,124,113],{"href":125},"https:\u002F\u002Ftheyearofgreta.com",[12,127,128],{},"Greta Thunberg 是位來自瑞典的環保少女，這個網站整理了她從隻身一人為氣候罷課，到能夠引領全球氣候運動的過 程紀錄，網站中間擺上根 據她登上 Times 封面人物照片而建的 3D 模型，隨著滾動或是拖曳來讓過往的紀錄在身邊周旋著，這種呈現方式讓時間軸變得十分立體。唯一覺得比較可惜的地方是有些紀錄在點擊後是開啟新分頁，會讓瀏覽的體驗有個明顯的斷點。",[40,130,48,131],{},[15,132],{"src":133,"alt":134,"style":104},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_WxCIJcZxuhrNTZU6-005dQ.gif?alt=media&token=d85bb3ea-df80-44cb-b3ca-7dbc75ffc22b","② The Year of Greta",[26,136],{},[76,138,140,141],{"id":139},"letter","③ ",[32,142,145],{"href":143,"rel":144},"https:\u002F\u002Fletter.co\u002F",[36],"Letter",[40,147,48,148,48,151],{},[15,149],{"src":150,"alt":143,"style":47},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_zRgdxy9rx8TfWr1UmpmjHw.png?alt=media&token=21184816-d7f1-422d-b00b-c4a5f36a9091",[50,152,153],{},[32,154,143],{"href":143},[12,156,157],{},"Letter 是一個新型態的銀行平台，這個單頁式的網頁看起來都使用 3D 模型作為主要視覺，但很巧妙地配合操控方式將逐格照片與影片播放的型態交錯使用，只有最下面的轉換區塊才是真的可以操控的 3D 模型。大部分的技術都沒有使用得過於困難，卻能達到滿豐富的動態體驗，是我覺得做得很棒的地方。",[40,159,42,160],{},[15,161],{"src":162,"alt":163,"style":104},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_Z6DG7U2_cv8bbhGByDDk2A.gif?alt=media&token=56ed531a-4110-4ddf-af82-ecec4c1b39cb","③ Letter",[26,165],{},[12,167,168],{},"加碼介紹前年最喜歡的網站，也是 2019 的 Site of the year 之一：",[76,170,172,173],{"id":171},"bruno-simon-portfolio","★ ",[32,174,177],{"href":175,"rel":176},"https:\u002F\u002Fbruno-simon.com\u002F",[36],"Bruno Simon Portfolio",[40,179,48,180,48,184],{},[15,181],{"src":182,"alt":183,"style":47},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_8gnScg0uxtsfWItsDcr6oQ.png?alt=media&token=f6a179cc-b735-4471-a61b-499d323bfe1b","bruno-simon 網站",[50,185,186],{},[32,187,188],{"href":188},"https:\u002F\u002Fbruno-simon.com",[12,190,191],{},"Bruno Simon 將個人的作品集網站轉化成車子的遊樂場，你可以操控車子在網頁中四處奔馳。裡面規劃了一些互動的遊樂場像是飛車跳台、保齡球等等。",[40,193,48,194,48,197],{},[15,195],{"src":196,"alt":183,"style":104},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_NjLGAPfukXziD7AbJu5uhA.gif?alt=media&token=6e2107b9-c31a-4ade-a23c-9fc49e6351fd",[50,198,199],{},"好想看它變成天竺鼠車車",[12,201,202],{},"最驚豔的是他把過往專案做成像是看板一樣，要控制車子到對應的方格才能開啟，跟一般的網頁的操作體驗完全不同。",[40,204,48,205],{},[15,206],{"src":207,"alt":183,"style":104},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_JN2KKEESDaZ2XwS2Nh5MoA.gif?alt=media&token=8791a509-146a-43ac-95ec-278a0e49d17c",[12,209,210],{},"雖然會花更多時間在進行瀏覽或是開啟連結這種滑鼠輕鬆就能做到的事情，但車子賦予的遊戲性卻是讓人玩心大發，反而可能會增加使用者在探索這個網頁的意願，很推薦大家進去玩玩看！",[26,212],{},[19,214,216],{"id":215},"codepen-百大人氣專案","Codepen 百大人氣專案",[40,218,219,220,48,224],{},"\n   ",[15,221],{"src":222,"alt":223,"style":47},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F02%2Fawwwards%2F1_W_UuMqdfTVIgJt4BHFxCUA.png?alt=media&token=8f6946da-fed4-498a-bdbd-43366aef3aa9","CodePen 百大人氣專案",[50,225,226],{},[32,227,228],{"href":228},"https:\u002F\u002Fcodepen.io\u002F2020\u002Fpopular\u002Fpens",[12,230,231],{},"這邊順便再介紹另一個平台 Codepen，它最近也彙整了去年最多人按愛心的前一百個人氣專案。",[12,233,234],{},"Codepen 是一個程式碼交流平台，你可以在上面測試一些小功能或是整個頁面，也可以去探索其他人是怎麼撰寫出類似的功能等等，如果我想要在網頁上使用動態效果或功能時，除了用介面繪圖軟體做出 Prototype 之外，我會在 Codepen 上尋找類似呈現的範例，可以在討論時增加工程師的理解，也能夠減少工程師探索的時間，增進專案的製作速度。",[12,236,237],{},"像是公司官網有用到的打字機效果當初也有到 Codepen 上找範例：",[239,240],"code-pen",{"height":241,"id":242,"tab":243,"title":244,"user":245},265,"GRoOxbM","css,result","CSS Typing Effect","denic",[26,247],{},[12,249,250],{},"在百大人氣專案裡面通常都是些程式碼品質很好的小功能＆頁面，或是效果十分令人驚豔的一些程式作品。自己覺得最酷的是這個可以拖曳互動的卡片，將卡片內部的鬼影遮掩得很棒，卡片內部的空間感非常立體。",[239,252],{"height":241,"id":253,"tab":254,"title":255,"user":256},"pobevYW","js,result","Ghost Card","pizza3",[26,258],{},[19,260,261],{"id":261},"小結",[12,263,264],{},"透過這些年度的專案，可以大概窺探出目前的技術運用可以玩出什麼花樣，但適不適合運用在自己的網站上面還是必須經過評估，我覺得不一定要一直追趕在最新穎的技術或潮流趨勢，但可以從趨勢中去分析哪些方法可以更靈活運用。",[12,266,267],{},"譬如因為 5G 的出現上網路載入速度越來越快，在網頁上渲染 3D 模型、或是原本很吃運算效能的技術在執行上可能會越來越容易等等。",[12,269,270],{},"找到適合專案的呈現方式才是最重要的。",[12,272,273],{},[32,274,281,282,286,287,281,294,297],{"href":275,"target":276,"className":277,"style":280},"https:\u002F\u002Fhex.school\u002F1PrJX","_blank",[278,279],"btn-ui-training","btn-ui-notice","border-radius: 0.5rem;"," ",[283,284,285],"span",{}," ⚡ ⚡ ⚡ ⚡ "," ⚡ ",[283,288,289,290,293],{}," 點我預約 UI 設計",[283,291,292],{},"觀念必修","直播班 (2021)",[283,295,296],{},"⚡ ⚡ ⚡ ⚡ "," ⚡  ",{"title":299,"searchDepth":300,"depth":300,"links":301},"",2,[302,303,312,313],{"id":21,"depth":300,"text":21},{"id":30,"depth":300,"text":304,"children":305},"Annual Awwwards 年度票選",[306,308,309,310],{"id":78,"depth":307,"text":103},3,{"id":109,"depth":307,"text":134},{"id":139,"depth":307,"text":163},{"id":171,"depth":307,"text":311},"★ Bruno Simon Portfolio",{"id":215,"depth":300,"text":216},{"id":261,"depth":300,"text":261},null,"2021-02-02","Awwwards 每年年初都會開放票選去年的年度網頁，而 Codepen 也整理出去年的前百個人氣專案，文章挑選了幾個有趣的專案來做介紹",false,"md",{},true,"\u002Fblog\u002F2021\u002F2021-02-02-2020-annual-awwwards-codepen-project",{"title":5,"description":316},"blog\u002F2021\u002F2021-02-02-2020-annual-awwwards-codepen-project",[325],"UI design","CsbJ5xmXlFsM4xilOzDe-pKhW08knQ5DR4_UTUE_EtM",{"prev":328,"next":331,"related":334,"tags":339},{"title":329,"link":330},"HexSchool 哞職順利｜徵文活動","\u002Fblog\u002F2021-03-08-ox-year-call-for-papers",{"title":332,"link":333},"Lottie：讓 AE 動畫完美呈現於數位產品上","\u002Fblog\u002F2021-01-18-lottie-ae-plugin",[335,336],{"title":332,"link":333},{"title":337,"link":338},"Spline：輕鬆建出能在網頁互動的 3D 模型","\u002Fblog\u002F2020-12-21-spline-tool-intro",[325,340,341,342,343,344,345,346,347,348,349],"course","css","css3","enterprise","event","interview","javascript","jobs","skilltree","software engineer",1790064292051]