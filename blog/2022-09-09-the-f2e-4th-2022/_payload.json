[{"data":1,"prerenderedAt":669},["ShallowReactive",2],{"blog:2022-09-09-the-f2e-4th-2022":3,"blog:neighbors:2022-09-09-the-f2e-4th-2022":642},{"id":4,"title":5,"author":6,"body":7,"categories":630,"date":631,"description":632,"draft":633,"extension":634,"meta":635,"navigation":516,"path":636,"seo":637,"stem":638,"tags":639,"thumbnail":17,"__hash__":641},"blog\u002Fblog\u002F2022\u002F2022-09-09-the-f2e-4th-2022.md","The F2E 4th 前端 & UI 修煉精神時光屋",[],{"type":8,"value":9,"toc":600},"minimark",[10,18,21,24,27,30,33,36,40,52,55,58,64,68,83,98,101,104,109,115,119,125,129,132,144,153,156,182,193,196,199,208,211,214,218,241,245,322,325,336,339,342,457,465,468,476,479,482,490,494,497,500,506,510,518,521,524,527,530,533,537,549,557,565,568,571,575,578,581,584,587,591,594,597],[11,12,13],"p",{},[14,15],"img",{"alt":16,"src":17},"首圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F09%2F08%2Fthe_t2f_og.png?alt=media&token=3cb815d0-6da6-4fc4-81dc-d93d5c8667e2",[11,19,20],{},"嗨！各位前端、UI 設計好手們\n不只影片動態，網頁也要動起來！動態網頁第一眼就是比較吸眼球，在使用者體驗上感覺也豐富許多\n在日常生活中，以下哪一個狀況你的感受最深？",[11,22,23],{},"A：\n哇～好炫砲的網頁動畫啊，只能羨慕到吃手手 ٩(ŏ﹏ŏ、)۶",[11,25,26],{},"B：\n老闆說：「這個網頁動畫感覺不錯，你可以做出來吧？」\n我只能尷尬又不失禮貌的微笑 (o´罒`o)",[11,28,29],{},"C：\n總算下定決心來研究網頁動畫了！但…該從哪裡開始？ (|||ﾟдﾟ)\n✄———\n無論是以上哪個情況，都好尷尬\n其實想變強，沒有想像中的難！",[11,31,32],{},"歡迎你參加 The F2E 第四屆 前端 & UI 修煉精神時光屋\nUI 設計師畫出來，前端工程師動起來\n「互動式網頁設計」，好手們一同來接力",[11,34,35],{},"完成屬於自己的動態網頁！",[37,38,39],"h2",{"id":39},"修煉主題",[11,41,42,43,47,48,51],{},"魔法正悄悄展開，預計 10\u002F13 於活動頁公開企業主題\n六角學院首次與",[44,45,46],"b",{},"版塊設計、凱鈿科技、鈦坦科技","三大企業聯手出題，修煉內容",[44,49,50],{},"從網頁動畫、軟體設計到遊戲設計","都有，三週精實修煉，實力 up up up ！",[37,53,54],{"id":54},"修煉內容",[11,56,57],{},"一週挑戰一個修練主題，總計三週，可挑選「前端工程師」、「UI 設計師」、「團體組」的挑戰方向",[11,59,60],{},[14,61],{"alt":62,"src":63},"三週主題圖片","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F09%2F08%2Ft3.png?alt=media&token=083b6815-c969-4980-bb66-09ed7acb0ccd",[37,65,67],{"id":66},"在-the-f2e-會獲得什麼資源","在 The F2E 會獲得什麼資源？",[11,69,70,71,77,78,82],{},"資源授權：本活動的授權大部分都是 ",[72,73,76],"a",{"href":74,"target":75},"https:\u002F\u002Fcreativecommons.org\u002Fpublicdomain\u002Fzero\u002F1.0\u002Fdeed.zh_TW","_blank","CC0","、",[72,79,81],{"href":80,"target":75},"https:\u002F\u002Fcreativecommons.org\u002Flicenses\u002Fby\u002F3.0\u002Ftw\u002F","CC BY"," 格式，方便挑戰者重製成自己的 side project 與作品，授權範圍含：",[84,85,86,87,86,92,86,95],"ul",{},"\n  ",[88,89,91],"li",{"style":90},"font-size: 18px;","User story（使用者故事）",[88,93,94],{"style":90},"Functional Map（功能架構規劃）",[88,96,97],{"style":90},"Mockup（設計稿）",[37,99,100],{"id":100},"報名組別",[11,102,103],{},"請依照自己想投入的部分，額外選擇下面三條修練方向",[105,106,108],"h3",{"id":107},"a-個人組-ui","A. 個人組 - UI",[11,110,111,114],{},[44,112,113],{},"設計 UI 介面","：每道修練主題我們都會提供 User story（使用者故事），你可以依此使用 UI 繪圖軟體來設計 Mockup，以加強自己對 Web UI 的掌握度。",[105,116,118],{"id":117},"b-個人組-前端工程師","B. 個人組 - 前端工程師",[11,120,121,124],{},[44,122,123],{},"前端動畫設計","：在開發 Web 介面時，一個網頁上可能會設計許多動態互動效果， 例如 SVG animaion、canvas、CSS3 animation 等等，您可以思考我們所提供的修練主題，試著導入互動效果進去。",[105,126,128],{"id":127},"c-團體組","C. 團體組",[11,130,131],{},"欲報名團體組，請符合以下條件：",[133,134,86,135,86,138,86,141],"ol",{},[88,136,137],{"style":90},"最少 2 人，最多限制為 4 人",[88,139,140],{"style":90},"建議至少 1 位前端工程師與 1 位 UI 設計師，但非強制，全部都為工程師也可以，但仍需要由組內成員完成 UI 設計稿。",[88,142,143],{"style":90},"UI 設計稿與程式開發需由組內成員共同完成。",[11,145,146,149],{},[44,147,148],{},"注意：一個帳號不可同時報團體組跟個人組",[14,150],{"alt":151,"src":152},"報名流程圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F09%2F08%2Ft4.png?alt=media&token=cf4040a6-4267-46e4-9662-f55ada34f028",[37,154,155],{"id":155},"報名與參賽方式",[11,157,158,161,162,170,173,174,177,178,181],{},[44,159,160],{},"報名時間","：10\u002F13（四）11:00 AM ~ 11\u002F6（日）23:59 PM\n",[44,163,164,165,169],{},"報名方式：10\u002F13(四) 當天，請重新來到此頁面，即可透過",[72,166,168],{"href":167,"target":75},"https:\u002F\u002F2022.thef2e.com\u002F","連結","，前往全新的 The F2E 平台報名",[44,171,172],{},"開賽規則","：每週一中午 12 點開放新題目投稿，隔週一中午 12 點前將作品投稿到平台\n",[44,175,176],{},"投稿作品","：開賽後的每週登錄作品請投稿到 The F2E 平台，當週才算挑戰成功\n",[44,179,180],{},"競賽時程","：活動採用 UI、前端接力合作，前端工程師可採用 UI 設計師的設計稿，一同產出完整作品！",[84,183,86,184,86,187,86,190],{},[88,185,186],{"style":90},"UI 、團體組開賽時間：10\u002F31（一）",[88,188,189],{"style":90},"前端組開賽時間：11\u002F7（一）",[88,191,192],{"style":90},"截止登錄作品：11\u002F28（一）",[11,194,195],{},"Q：為什麼 UI 跟團體組的開賽時間，比前端組提前一週？\nA：因為必須由 UI 設計師花一週時間設計完後，再交棒給前端組認領 UI 設計稿，並實做出來",[11,197,198],{},"Q：可以更換報名組別嗎？\nA：不行，不能更換報名組別（團體組跟個人組），但報名日截止前（11\u002F6）可以更改團體身份",[11,200,201,204,205],{},[44,202,203],{},"額外競賽","：三大企業提供企業獎，獎金及數位獎狀等著你！\n",[14,206],{"alt":203,"src":207},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F09%2F08%2Ft1.png?alt=media&token=8ff3406a-3114-408c-84b2-33e587231db9",[37,209,210],{"id":210},"前端工程師修練方向",[11,212,213],{},"你可以依照我們提供的修練主題，主動練習自己想投入的新技術，\n為了確保每週都能挑戰功能，會建議 70% 用自己會的技術，30% 使用剛學會的新技術，以避免挑戰曲線不會過高。\n以 CSS、JavaScript 為例，你可投入：",[105,215,217],{"id":216},"css","CSS",[84,219,86,220,86,223,86,226,86,229,86,232,86,235,86,238],{},[88,221,222],{"style":90},"會使用 float 排版時，可以嘗試使用 flexbox、grid 排版",[88,224,225],{"style":90},"思考響應式排版的實做方式，並在 iPad、mobile 有極好的使用者體驗",[88,227,228],{"style":90},"transition、animation、transform 動畫效果，提升網頁動線",[88,230,231],{"style":90},"能使用 CSS 實做出來的效果，就不要使用 JavaScript",[88,233,234],{"style":90},"預處理器（SCSS、LESS）與 PostCSS",[88,236,237],{"style":90},"CSS 框架（Bootstrap、Pure）",[88,239,240],{"style":90},"設計模式（SMACSS、OOCSS、BEM、MVCSS）",[105,242,244],{"id":243},"javascript","JavaScript",[84,246,86,247,86,253,86,268,86,274,86,280,86,286,86,292,86,298,86,304,86,310,86,316],{},[88,248,249,252],{"style":90},[44,250,251],{},"JS 基礎","：使用一個你不曾用過的 JS 技巧，例如",[84,254,255,256,255,259,255,262,255,265,86],{},"\n    ",[88,257,258],{"style":90},"array map 、filter、reduce",[88,260,261],{"style":90},"閉包、遞迴、物件導向",[88,263,264],{"style":90},"JSON 資料、字串處理",[88,266,267],{"style":90},"正規表達式（Regular Expression）",[88,269,270,273],{"style":90},[44,271,272],{},"模組管理","：使用任務管理工具（grunt、gulp）、模組打包工具（webpack）",[88,275,276,279],{"style":90},[44,277,278],{},"ECMAScript","：ES 6、7 、8，並使用 Babel 兼容網頁瀏覽器。",[88,281,282,285],{"style":90},[44,283,284],{},"HTML5 API","：LocalStorage、Geolocation、File API",[88,287,288,291],{"style":90},[44,289,290],{},"介接第三方服務 API","：social login、weater、open data、自建 API",[88,293,294,297],{"style":90},[44,295,296],{},"導入 SPA 框架","：Vue、React、Angular",[88,299,300,303],{"style":90},[44,301,302],{},"工具框架","：lodash、Underscore",[88,305,306,309],{"style":90},[44,307,308],{},"2、3D 動畫開發","：使用 SVG、canvas、WebGL 設計動畫效果，例如 D3.js、three.js",[88,311,312,315],{"style":90},[44,313,314],{},"Node.js","：NPM 、後端框架（koa、express）、API 設計、測試（Mocha、Nightwatch）",[88,317,318,321],{"style":90},[44,319,320],{},"程式檢查","：ESLint、JSHint",[37,323,324],{"id":324},"獎勵機制",[84,326,86,327,86,330,86,333],{},[88,328,329],{"style":90},"完成一道關卡：授予銅級數位勳章，並記錄在戰績榜上。",[88,331,332],{"style":90},"完成二道關卡：授予銀級數位勳章，並記錄在戰績榜上。",[88,334,335],{"style":90},"完成三道關卡：授予金級數位勳章，並記錄在戰績榜上。",[37,337,338],{"id":338},"評審獎項",[11,340,341],{},"三大企業來襲，本活動將針對三大主題分別頒獎金及數位獎狀 ，並邀請評審來審核獎項",[343,344,86,345],"div",{},[346,347,255,349,86],"table",{"style":348},"white-space: nowrap;",[350,351,352,353,352,373,352,390,352,414,352,439,255],"tbody",{},"\n      ",[354,355,357,358,357,362,357,365,357,368,357,371,352],"tr",{"style":356},"background-color: #8fb1c28a;","\n        ",[359,360,361],"td",{},"主題",[359,363,364],{},"The F2E 活動網站設計",[359,366,367],{},"今晚，我想來點點簽",[359,369,370],{},"Scrum 新手村",[359,372],{},[354,374,357,375,357,378,357,381,357,384,357,387,352],{},[359,376,377],{},"贊助企業",[359,379,380],{},"版塊設計",[359,382,383],{},"凱鈿行動科技",[359,385,386],{},"鈦坦科技",[359,388,389],{},"獎品、獎金",[354,391,357,393,357,396,357,403,357,407,357,411,352],{"style":392},"background-color: #7cbad88a;",[359,394,395],{},"初選佳作獎",[359,397,398,399,402],{},"個人組 10 名、",[400,401],"br",{},"團體組 10 組",[359,404,398,405,402],{},[400,406],{},[359,408,398,409,402],{},[400,410],{},[359,412,413],{},"一式數位獎狀",[354,415,357,417,357,420,357,426,357,430,357,434,352],{"style":416},"background-color: #7cbad8c7;",[359,418,419],{},"個人組企業獎",[359,421,422,423,425],{},"UI 設計、前端",[400,424],{},"各 1 名，共 2 名",[359,427,422,428,425],{},[400,429],{},[359,431,422,432,425],{},[400,433],{},[359,435,436,437,413],{},"每位獎金 NTD 3,000 及",[400,438],{},[354,440,357,442,357,445,357,448,357,450,357,452,352],{"style":441},"background-color: #7cbad8;",[359,443,444],{},"團體組企業獎",[359,446,447],{},"1 組",[359,449,447],{},[359,451,447],{},[359,453,454,455,413],{},"每組獎金 NTD 10,000 及",[400,456],{},[84,458,86,459,86,462],{},[88,460,461],{"style":90},"一個人限領一個獎項",[88,463,464],{"style":90},"如未達標準，則從缺",[11,466,467],{},"詳細參賽得獎規定：",[133,469,86,470,86,473],{},[88,471,472],{"style":90},"比賽結果將於 111\u002F12\u002F23（五）公佈得獎名單，並公告於「活動官網」同時主辦單位也會透過 Email 聯絡得獎者。",[88,474,475],{"style":90},"依中華民國稅法規定，中獎金額在新台幣 1,000（含）元以上者，所得將併入中獎人個人綜合所得稅申報，請中獎人配合繳交身分證影印本作為申報依據，中獎金額超過 NT$20,000 元，中獎人應依稅法先行繳交相當於獎品價值 10% 機會中獎之稅金；非中華民國國境內居住之國人（即在中華民國境內居住未達 183 天之本國人及外國人）不論得獎者所得之金額，須就中獎所得扣繳 20% 機會中獎稅，扣繳稅款未超過 NT$2,000，免扣繳（外籍人士不適用），以供本公司做代繳稅及提供扣繳憑單使用。本公司統一於活動年之隔年寄發扣繳憑單給中獎人，以利中獎人申報之用。",[11,477,478],{},"本學院保留活動最終決定之權利。",[105,480,481],{"id":481},"評審機制",[84,483,86,484,86,487],{},[88,485,486],{"style":90},"初選：將由六角學院前端、UI 評審進行第一波篩選，並於 12\u002F5（一）公布初選佳作名單",[88,488,489],{"style":90},"決選：由三大企業針對該企業主題進行入圍獎最後篩選，並於 12\u002F23（五）公布企業得獎名單",[37,491,493],{"id":492},"前端ui-能量補給站","前端、UI 能量補給站",[11,495,496],{},"11\u002F3（四）～ 11\u002F24（四），每週四邀請資深開發者線上直播，為修煉者補充知識能量！",[37,498,499],{"id":499},"合作單位",[11,501,502],{},[14,503],{"alt":504,"src":505},"合作單位圖片","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F09%2F08%2Ft2.png?alt=media&token=438b5056-fed6-484f-8054-a3c56b259e94",[37,507,509],{"id":508},"_102日2100-線上說明會三大企業主題獎項一次告訴你","10\u002F2(日）21:00 線上說明會！三大企業主題、獎項一次告訴你",[511,512],"iframe",{"src":513,"title":514,"allow":515,"allowFullScreen":516,"style":517},"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002F2Qq_njJbGxY","YouTube video player","accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",true,"width: 100%; aspect-ratio: 16 \u002F 9; border: 0;",[37,519,520],{"id":520},"常見問答",[11,522,523],{},"Q：如果某一週不小心挑戰失敗，是否能再繼續挑戰後面關卡？\nA：可以，儘管那週挑戰失敗，之後您仍可以挑選喜歡的關卡進行挑戰，並在該關卡期限內繳交作品。",[11,525,526],{},"Q：大家都好強，我怕我做的東西沒有達到過關門檻，不敢登錄作品\nA：這個活動並非競爭性質，每個參賽者都是你的隊友，最大的敵人是你自己，因為你必須定期練功前端開發，讓自己能夠順利完賽。",[11,528,529],{},"Q：我不確定自己做的版型有沒有符合過關門檻，要寫到什麼程度才有到過關門檻？\nA：主辦單位其實不會去審核大家的程式碼，只要你認為當週你有針對主題有做到一定程度，就算是半完成品也請大方投稿，不用擔心。",[11,531,532],{},"Q：我已經寫到一半了，但時間快來不及，可以先投稿嗎？\nA：可以，有投稿表示你還會持續努力在這次活動上。",[105,534,536],{"id":535},"ui-設計師常見問題","【UI 設計師常見問題】",[11,538,539,540,544,545,548],{},"Q：到時投稿到平台是提供什麼呢？我也不像是工程師可以有 Codepen 上傳。\nA：其中投稿的欄位裡面會有一個「",[72,541,543],{"href":542,"target":75},"https:\u002F\u002Fxd.adobe.com\u002Fspec\u002F934efdb7-a7e4-47d5-572e-efece0914f62-e57f\u002F?fbclid=IwAR33R3WYRRNmN8tmmpKf4q43z6F6ftDbpx3eNbG1eJe1rC2BDxbyS0D5nTc","線上標示文件","」，像是 Adobe XD 便有提供該服務（",[72,546,547],{"href":542,"target":75},"範例連結","），屆時提供標示文件後，便可讓其他前端工程師採用你的設計稿來開發。",[11,550,551,552,77,554,556],{},"Q：投稿上去的 UI 作品，我知道需要授權讓前端工程師組做成 Web 介面，那授權部分可以設定嗎？\nA：會有的，屆時平台投稿流程上，會讓您的作品可以選擇 ",[72,553,76],{"href":74,"target":75},[72,555,81],{"href":80,"target":75}," 等授權，以保障您的 UI 作品權益。",[11,558,559,560,564],{},"Q：一定要上傳「線上標示文件」嗎？\nA：是的，因為這樣才有辦法讓其他前端工程師，能採用您的設計稿，將您的設計稿實作出網頁格式。如果您是使用 Sketch，也可使用 ",[72,561,563],{"href":562,"target":75},"https:\u002F\u002Fgithub.com\u002Futom\u002Fsketch-measure","Sketch Measure"," 編譯出來後，壓縮 ZIP 到雲端空間（Dropbox、Google Drive）。",[11,566,567],{},"Q：不能使用 PS、Illustrator 設計嗎？\nA：只要您能找到 PS 或 Illustrator 產出線上標示文件的方式就可以，因為前端工程師大部分皆比較少具有繪圖軟體，所以用線上標示文件將會減少許工程師協作上的溝通時間。",[11,569,570],{},"Q：當每週一題目出來後，我有一些設計進度也可以先投稿嗎？\nA：可以，團隊在協作過程中，一定也會先出些進度提供前端切版，有進度時您也可以先投稿，讓前端工程師可以先接手，之後再透過 FB 社團來溝通進度即可。",[105,572,574],{"id":573},"前端工程師常見問題","【前端工程師常見問題】",[11,576,577],{},"Q：我可以不依照設計稿，自己做版面嗎？因為我想多練習 JS \u002F 後端\nA：可以，The F2E 活動是希望讓大家人人有功練，所以依照你自己想投入的方向練功即可。CSS 也可以用框架，例如 Bootstrap。",[11,579,580],{},"Q：前端介面一定要長得一模一樣嗎？\nA：不用，依照自己的想法來開發也可以",[11,582,583],{},"Q：有現成的網頁靜態頁面嗎？我想只練習 JS \u002F 後端就好\nA：這段我們不會提供，畢竟每個人習慣的 Coding style 又不一樣，產出的 HTML、CSS 並非是自己習慣的 Layout 反而會更花時間。",[11,585,586],{},"Q：那我只想要練習 JS，HTML\u002FCSS 我用陽春版，不依照設計稿開發可以嗎？\nA：可以，你可以當做我們就是出一個主題，你依照那主題當作參考方向來開發即可。",[105,588,590],{"id":589},"團體組常見問題","【團體組常見問題】",[11,592,593],{},"Q：請問團體組最多幾人？\nA：最多 4 人，投稿作品時請派一位組長來投稿即可。",[11,595,596],{},"Q：我們團體組比較想做手機 APP，可以投稿並符合評審門檻嗎？\nA：您可以開發手機 APP，若有在期限前投稿也能獲得數位獎狀。但評審門檻僅限 Web 瀏覽器應用開發，Android、iOS APP 則不在評審範圍內，故不符合評審門檻。",[11,598,599],{},"Q：團體組的 UI 設計稿，可以讓「個人組 - 前端工程師」組別採用嗎？\nA：不能，預設是不能讓「個人組-前端工程師」採用。",{"title":601,"searchDepth":602,"depth":602,"links":603},"",2,[604,605,606,607,613,614,618,619,622,623,624,625],{"id":39,"depth":602,"text":39},{"id":54,"depth":602,"text":54},{"id":66,"depth":602,"text":67},{"id":100,"depth":602,"text":100,"children":608},[609,611,612],{"id":107,"depth":610,"text":108},3,{"id":117,"depth":610,"text":118},{"id":127,"depth":610,"text":128},{"id":155,"depth":602,"text":155},{"id":210,"depth":602,"text":210,"children":615},[616,617],{"id":216,"depth":610,"text":217},{"id":243,"depth":610,"text":244},{"id":324,"depth":602,"text":324},{"id":338,"depth":602,"text":338,"children":620},[621],{"id":481,"depth":610,"text":481},{"id":492,"depth":602,"text":493},{"id":499,"depth":602,"text":499},{"id":508,"depth":602,"text":509},{"id":520,"depth":602,"text":520,"children":626},[627,628,629],{"id":535,"depth":610,"text":536},{"id":573,"depth":610,"text":574},{"id":589,"depth":610,"text":590},null,"2022-09-08","嗨！各位前端、UI 設計好手們，歡迎你參加 The F2E 第四屆 前端 & UI 修煉精神時光屋！",false,"md",{},"\u002Fblog\u002F2022\u002F2022-09-09-the-f2e-4th-2022",{"title":5,"description":632},"blog\u002F2022\u002F2022-09-09-the-f2e-4th-2022",[640],"event","PVx9AM7yD4ktzEauFduOA1mRA4Q0qoalkNnl-gp8AsY",{"prev":643,"next":646,"related":649,"tags":660},{"title":644,"link":645},"轉職前端之路：當了助教讓我更成長！","\u002Fblog\u002F2022-09-27-wangshuan-growth",{"title":647,"link":648},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",[650,653,654,657],{"title":651,"link":652},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":647,"link":648},{"title":655,"link":656},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",{"title":658,"link":659},"2022 鐵人賽","\u002Fblog\u002F2022-08-08-ithome-2022ironman",[661,662,216,663,664,640,665,243,666,667,668],"UI design","course","css3","enterprise","interview","jobs","skilltree","software engineer",1790064291417]