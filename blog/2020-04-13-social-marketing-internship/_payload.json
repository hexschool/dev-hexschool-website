[{"data":1,"prerenderedAt":185},["ShallowReactive",2],{"blog:2020-04-13-social-marketing-internship":3,"blog:neighbors:2020-04-13-social-marketing-internship":154},{"id":4,"title":5,"author":6,"body":8,"categories":141,"date":142,"description":143,"draft":144,"extension":145,"meta":146,"navigation":147,"path":148,"seo":149,"stem":150,"tags":151,"thumbnail":17,"__hash__":153},"blog\u002Fblog\u002F2020\u002F2020-04-13-social-marketing-internship.md","【徵才】社群行銷實習生(已徵得)",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":131},"minimark",[11,18,23,26,29,42,45,59,62,71,76,87,91,99,103,122],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F05%2Fhex-hire-intern-fb.png?alt=media&token=dffc89f2-dc10-4e2f-ba74-e4c45697f692",[19,20,22],"h2",{"id":21},"社群經營實習生已徵得","【社群經營實習生】(已徵得)",[12,24,25],{},"社群，意即代表對某件事物有相同興趣的一群人。六角學院便是對「程式開發」有興趣的 TA 集結而成，我們希望您的加入，能夠活絡社群上的發展，說著彼此間了解的「共通語言」，讓我們的 TA 因您加入而提升社群的凝聚力。",[12,27,28],{},"工作內容：",[30,31,32,36,39],"ol",{},[33,34,35],"li",{},"社群營運相關工作",[33,37,38],{},"協助經營社群發展，目前經營管道有 FB 粉絲團、FB 社團、IG、Line@",[33,40,41],{},"協助規劃\u002F執行活動內容",[12,43,44],{},"加分條件：",[30,46,47,50,53,56],{},[33,48,49],{},"對文字敏銳度高，有經營自己的部落格",[33,51,52],{},"對程式開發有極大的興趣",[33,54,55],{},"熱愛接收新知和各類趨勢情報",[33,57,58],{},"有經營自己的社群服務，例 FB、IG、twitter",[12,60,61],{},"其它說明：",[63,64,65,68],"ul",{},[33,66,67],{},"歡迎各大專院校實習生",[33,69,70],{},"視工作表現成果可轉正職",[72,73,75],"h3",{"id":74},"薪資與福利","【薪資與福利】",[63,77,78,81,84],{},[33,79,80],{},"基本時薪",[33,82,83],{},"享勞健保",[33,85,86],{},"六角開的課程皆能免費參加",[72,88,90],{"id":89},"工作地點時間","【工作地點\u002F時間】",[63,92,93,96],{},[33,94,95],{},"地點：高雄鹽埕區",[33,97,98],{},"時間：一週最少兩天",[72,100,102],{"id":101},"投遞履歷管道","【投遞履歷管道】",[30,104,105,113,116,119],{},[33,106,107,108],{},"郵件地址：請 mail 到 ",[109,110,112],"a",{"href":111},"mailto:service@hexschool.com","service@hexschool.com",[33,114,115],{},"郵件標題：【應徵】社群行銷實習生_姓名",[33,117,118],{},"履歷版本：請提供 PDF 或線上履歷（請避免使用 104 履歷）",[33,120,121],{},"回覆問題：除履歷外，還請回覆以下兩個問題，好讓我們更加了解您",[12,123,124,128],{},[125,126,127],"b",{},"問題一：「您對於未來職涯的自己有什麼憧憬，這份工作能幫助您嗎？」",[125,129,130],{},"問題二：「承一，希望六角提供什麼資源，好讓您能盡快達成目標？」",{"title":132,"searchDepth":133,"depth":133,"links":134},"",2,[135],{"id":21,"depth":133,"text":22,"children":136},[137,139,140],{"id":74,"depth":138,"text":75},3,{"id":89,"depth":138,"text":90},{"id":101,"depth":138,"text":102},null,"2020-04-13","六角學院 是一所線上程式開發學習單位，目前已累積超過 20,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-04-13-social-marketing-internship",{"title":5,"description":143},"blog\u002F2020\u002F2020-04-13-social-marketing-internship",[152],"jobs","MGJU36Ikz69Qq_9MVU5jBMA_AzUBl4_6Rbm0hTsISrw",{"prev":155,"next":158,"related":161,"tags":174},{"title":156,"link":157},"【學員專屬徵才 - 第五波遠端助教】無工作經驗者優先錄取","\u002Fblog\u002F2020-05-28-remote-jobs-fifth",{"title":159,"link":160},"21 天英打鍛鍊武道大會","\u002Fblog\u002F2020-03-24-21days-keybr-game",[162,165,168,171],{"title":163,"link":164},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":166,"link":167},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":169,"link":170},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":172,"link":173},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[175,176,177,178,179,180,181,182,152,183,184],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064292153]