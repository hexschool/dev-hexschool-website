[{"data":1,"prerenderedAt":275},["ShallowReactive",2],{"blog:2020-01-03-2019-frontend-salary":3,"blog:neighbors:2020-01-03-2019-frontend-salary":244},{"id":4,"title":5,"author":6,"body":8,"categories":231,"date":232,"description":233,"draft":234,"extension":235,"meta":236,"navigation":237,"path":238,"seo":239,"stem":240,"tags":241,"thumbnail":21,"__hash__":243},"blog\u002Fblog\u002F2020\u002F2020-01-03-2019-frontend-salary.md","2019 年前端工程師薪資調查",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":214},"minimark",[11,15,22,25,33,37,42,45,48,53,75,78,83,86,89,94,101,108,112,117,125,129,134,141,145,150,157,161,166,169,172,175,178,200,203,206],[12,13,5],"h2",{"id":14},"_2019-年前端工程師薪資調查",[16,17,18],"p",{},[19,20],"img",{"alt":5,"src":21},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.001.png?alt=media&token=de6b720d-5468-4114-8d56-2d7eb13bccb7",[16,23,24],{},"大家好，我們是六角學院，至今已創校近四年，主要以線上程式影音課程，協助學員求職，成為前端工程師、網頁設計師。",[16,26,27,28,32],{},"相信您也會想了解現今工程師的薪資發展是否具有前景。此份薪資調查樣本皆來自於六角學院的學員所提供的回饋，實際回收數為 ",[29,30,31],"strong",{},"234 份","，有 60% 職稱為前端工程師、20% 網頁設計師，其他則為後端、全端工程師。以下我們就分享數據給各位參考：",[34,35,36],"h3",{"id":36},"地區分佈",[16,38,39],{},[19,40],{"alt":36,"src":41},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.004.png?alt=media&token=2c31c665-7d3f-4bfc-b88f-cebeedfd7385",[16,43,44],{},"從學員填表區間，可以反應台灣就業人才需求分布。其中以台北職缺佔多數，而中、南部則是佔 1\u002F3 左右，中部地區則比南部地區略多一些。",[34,46,47],{"id":47},"學校科系",[16,49,50],{},[19,51],{"alt":47,"src":52},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.002.png?alt=media&token=477e78fd-8828-4593-8a49-7fc640ecbadd",[16,54,55,56,61,62,61,66,61,70,74],{},"這也是許多人好奇的地方，大多人都認為要投入前端必須擁有相關就學背景，但以統計數據來看，將近三分之二的學員都是非本科系出身，像是我們目前就業的學長姐背景，就曾經有",[57,58,60],"a",{"href":59},"\u002Fblog\u002F2019-08-28-interview","歷史系","、",[57,63,65],{"href":64},"\u002Fblog\u002F2017-07-04-interview","視覺傳達",[57,67,69],{"href":68},"\u002Fblog\u002F2019-08-08-interview","媒體設計",[57,71,73],{"href":72},"\u002Fblog\u002F2018-12-04-interview","大眾傳播系","的學員。",[34,76,77],{"id":77},"工作年資人數統計",[16,79,80],{},[19,81],{"alt":77,"src":82},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.003.png?alt=media&token=fcef49b8-3e8b-4b2e-896b-68356e9480a1",[16,84,85],{},"以工作年資來說，1~2 年佔大多數，由於六角創立時間近 4 年，期間陸續培育前端人才，所以在比例權重上也符合學院的發展過程。",[34,87,88],{"id":88},"全部學員年薪統計",[16,90,91],{},[19,92],{"alt":88,"src":93},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.005.png?alt=media&token=90a2c6ca-973c-4299-a55e-c9ea1193b873",[16,95,96,97,100],{},"若是以中位數來說，全部學員的中位數是",[29,98,99],{},"年薪 60 萬","。然而目前年薪 35~59 萬佔多數也相當合理，因為六角學院是創校四年的教育單位，絕大部分學員皆偏向初級或中階的工程師。",[16,102,103,104,107],{},"但相信您應該會好奇，",[29,105,106],{},"年資是否會影響薪水區間"," ？接下來我們就來一探究竟。",[34,109,111],{"id":110},"_1-年以下經驗","1 年以下經驗",[16,113,114],{},[19,115],{"alt":111,"src":116},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.006.png?alt=media&token=6d4f1248-1f38-4078-9072-bdd3083533f8",[16,118,119,120,124],{},"在年薪來說，絕大平均值是座落在 35",[121,122,123],"del",{},"59 萬區間，若是有 1 個月年終的話，月薪則是平均在 3萬","4萬 左右。",[34,126,128],{"id":127},"_12-年經驗","1~2 年經驗",[16,130,131],{},[19,132],{"alt":128,"src":133},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.007.png?alt=media&token=979ed801-0bd8-4a77-88de-0d75ca6772ae",[16,135,136,137,140],{},"可以看出在 60",[121,138,139],{},"80 萬跟 80","99 萬區間有明顯成長，月薪推算也坐落在 5萬 ~ 6萬5千 之間。\n但在 35~59 萬比例仍然不少，為什麼呢？其實在工程師業界有個說法，就是工作時「切忌將一年經驗 repeat 十次」。儘管您帳面上有十年經驗，但假使會的技能深度仍停留在初入職場的程度，自然薪資也無法有所突破。\n另外一點就是除了公司提供給你的養分外，自己是否了解自身不足之處，並積極學習市場所需技術也是重要的一環。\n而這裡也會是未來六角想推進的方向，雖然我們學院的目標原本是以協助學員就業為主，但當我們將人才推出業界後，下一步我們也將推出適合他們的資源，幫助他們可以在更短的時間內，吸收到正確的養分，成為業界的搶手人才。",[34,142,144],{"id":143},"_23-年經驗","2~3 年經驗",[16,146,147],{},[19,148],{"alt":144,"src":149},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.008.png?alt=media&token=d4dcbf80-7679-4c85-bcca-d87dc03d2707",[16,151,152,153,156],{},"在這個區間，學員年薪已座落在 35萬",[121,154,155],{},"59萬以及60萬","80萬 的平均區間，而這也能看出工程師薪水幅度上的跳耀式提升。",[34,158,160],{"id":159},"_4-年以上經驗","4 年以上經驗",[16,162,163],{},[19,164],{"alt":160,"src":165},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.009.png?alt=media&token=58c1d4a5-58d4-45bc-a814-657b441ae099",[16,167,168],{},"在樣本數來說，有許多人才原本是做平面與 UI 設計或者是後端工程師，後來才轉往前端發展，所以在年資累積上有到 4 年以上。而在薪資分佈上，也看出其向上推移的顯著性。",[34,170,171],{"id":171},"樣本介紹",[16,173,174],{},"此樣本與其他差異在於，填表人數皆來自於六角學院學員，並非對外公開，對此可以定義為「有接觸到線上課程教育」的受測者會較為精準，但並不代表整個前端程式市場。",[34,176,177],{"id":177},"總結",[16,179,180,181,61,185,61,189,61,193,199],{},"為了讓學員能持續升級，六角也會不定時舉辦活動，例如每週的",[57,182,184],{"href":183},"\u002Fblog\u002F2018-08-07-how-to-join-zoom","線上問答",[57,186,188],{"href":187},"\u002Fblog\u002F2019-06-14-the_f2e","練功活動",[57,190,192],{"href":191},"\u002Fblog\u002F2018-08-27-interview","求職輔導",[57,194,198],{"href":195,"rel":196},"https:\u002F\u002Fwww.facebook.com\u002Fgroups\u002F110635703123103\u002F",[197],"nofollow","社團互動","，目的就是為了讓各階段的學員都能持續成長。",[16,201,202],{},"因為我們很清楚求職成功並非學員的終點，而是真正踏入產業的開始。對此六角學院也會依照學生的成長，來提供學員正確的養分，讓他們能夠追逐更高的薪水與工作品質。",[16,204,205],{},"如果你是初入前端及 UI 的新手，卻一直找不到合適的教學資源；\n如果你是工作一段時間的工程師，卻一直找不到方向前進；\n都歡迎你們加入六角學院的大家庭，讓我們陪您一起成長。",[16,207,208,209,213],{},"PS：如果你想多瞭解我們，歡迎加入我們的",[57,210,212],{"href":195,"rel":211},[197],"學員社團","，email 欄位填寫「洧杰校長部落格推薦」即可。",{"title":215,"searchDepth":216,"depth":216,"links":217},"",2,[218],{"id":14,"depth":216,"text":5,"children":219},[220,222,223,224,225,226,227,228,229,230],{"id":36,"depth":221,"text":36},3,{"id":47,"depth":221,"text":47},{"id":77,"depth":221,"text":77},{"id":88,"depth":221,"text":88},{"id":110,"depth":221,"text":111},{"id":127,"depth":221,"text":128},{"id":143,"depth":221,"text":144},{"id":159,"depth":221,"text":160},{"id":171,"depth":221,"text":171},{"id":177,"depth":221,"text":177},null,"2020-01-03","大家好，我們是六角學院，至今已創校近四年，主要以線上程式影音課程，協助學員求職，成為前端工程師、網頁設計師。相信您也會想了解現今工程師的薪資發展是否具有前景，此篇我們就分享數據給各位參考。",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-01-03-2019-frontend-salary",{"title":5,"description":233},"blog\u002F2020\u002F2020-01-03-2019-frontend-salary",[242],"event","l2nhJ07jysFWUsQOVyMh0lyADBSfO8Ru-9cxia-xBMs",{"prev":245,"next":248,"related":251,"tags":264},{"title":246,"link":247},"【學員專屬徵才 - 第四波遠端助教】無工作經驗者優先錄取","\u002Fblog\u002F2020-02-03-remote-jobs-fourth",{"title":249,"link":250},"w3HexSchool 鼠年全馬鐵人挑戰","\u002Fblog\u002F2019-11-14-w3hexschool-2020-challenge",[252,255,258,261],{"title":253,"link":254},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":256,"link":257},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":259,"link":260},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":262,"link":263},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[265,266,267,268,269,242,270,271,272,273,274],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292374]