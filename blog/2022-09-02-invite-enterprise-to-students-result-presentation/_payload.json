[{"data":1,"prerenderedAt":163},["ShallowReactive",2],{"blog:2022-09-02-invite-enterprise-to-students-result-presentation":3,"blog:neighbors:2022-09-02-invite-enterprise-to-students-result-presentation":136},{"id":4,"title":5,"author":6,"body":7,"categories":123,"date":124,"description":125,"draft":126,"extension":127,"meta":128,"navigation":129,"path":130,"seo":131,"stem":132,"tags":133,"thumbnail":17,"__hash__":135},"blog\u002Fblog\u002F2022\u002F2022-09-02-invite-enterprise-to-students-result-presentation.md","邀請：【企業交流】前端學員成果發表會",[],{"type":8,"value":9,"toc":113},"minimark",[10,18,21,26,32,41,44,49,52,55,76,81,84,92,96,99,102,105],[11,12,13],"p",{},[14,15],"img",{"alt":16,"src":17},"首圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F10%2F1024-02.png?alt=media&token=5ce3b31e-b807-4277-8245-9f733dc15ffa",[11,19,20],{},"六角學院是一所線上程式開發學習單位，目前已累積超過 30,000 名學員，鼓勵學員透過線上學習，擁有更好的職涯發展機會。除了一般影音課程，六角學院定期每季培訓班都會釋出結業人才，且人才涵蓋北中南部，如果您有交流需求歡迎參考本篇文章：",[22,23,25],"h2",{"id":24},"近期的招募時間","📌 近期的招募時間：",[11,27,28],{},[29,30,31],"b",{},"【開放填表中：3\u002F15（三）截止】",[33,34,35],"ul",{},[36,37,38],"li",{},[29,39,40],{},"2023\u002F3 Vue 作品實戰直播班：掌握 JavaScript 設計模式，設計美感與實力兼具網站",[11,42,43],{},"【表單尚未開放：預計 9 月開放填表】",[33,45,46],{},[36,47,48],{},"2023\u002F9 網頁切版直播班：強化 Bootstrap 5 與 Tailwind CSS 快速切版",[22,50,51],{"id":51},"申請企業交流流程",[11,53,54],{},"請 HR 填寫表單，每季培訓班結業時，六角學院將提供專屬連結，邀請您參與成果發表會",[56,57,58,64,70],"ol",{},[36,59,60,63],{},[29,61,62],{},"申請填表","：請填寫 Google 表單",[36,65,66,69],{},[29,67,68],{},"活動參與","：若審核通過，每季培訓班發表會前三天，六角會發信通知相關資訊",[36,71,72,75],{},[29,73,74],{},"廠商交流","：成果發表會後結束兩週內，會寄出人才交流資訊",[77,78,80],"h3",{"id":79},"時程舉例","⏰ 時程舉例：",[11,82,83],{},"3\u002F15（三）前填寫表單，進入審核 >> 3\u002F16（四）六角學院將發信提供專屬連結 >> 參加 3\u002F19（日）Vue 作品實戰直播班發表會 >> 3\u002F31（五）前寄出人才交流資訊",[11,85,86],{},[87,88,91],"a",{"href":89,"target":90},"https:\u002F\u002Fhexschool.tw\u002FXUlyX","_blank","點我填寫 Google 表單",[22,93,95],{"id":94},"常見-qa","常見 Q＆A",[11,97,98],{},"Q：請問有資深工程師的名單嗎？\nA：每梯次結業也會搜集歷年學長姐交流意願，所以每個結訓梯次也會提供有年資的工程師交流名單",[11,100,101],{},"Q：成果發表會後，我預期幾天後能拿到人才交流資訊？\nA：預期 5 個工作天會提供，還請填寫申請表，人才消息不漏接",[11,103,104],{},"Q：拿到學員結業名單後，公司可以獲得學員履歷嗎？\nA：可以，六角學院釋出履歷為學員同意授權，但還請注意：「本院提供的人才履歷，僅作為交流使用，不可外流，若有外流需承擔法律之責任」",[11,106,107,108,112],{},"Q：填表申請的過程中有問題可以到哪裡詢問？\nA：您可以私訊六角學院 FB 紛絲團、或寄信至 ",[87,109,111],{"href":110},"mailto:service@hexschool.com","service@hexschool.com","，會有專人為您解答",{"title":114,"searchDepth":115,"depth":115,"links":116},"",2,[117,118,122],{"id":24,"depth":115,"text":25},{"id":51,"depth":115,"text":51,"children":119},[120],{"id":79,"depth":121,"text":80},3,{"id":94,"depth":115,"text":95},null,"2022-09-02","六角學院是一所線上程式開發學習單位，目前已累積超過 30,000 名學員，鼓勵學員透過線上學習，擁有更好的職涯發展機會。除了一般影音課程，六角學院定期每季培訓班都會釋出結業人才，且人才涵蓋北中南部，如果您有交流需求歡迎參考本篇文章",false,"md",{},true,"\u002Fblog\u002F2022\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":5,"description":125},"blog\u002F2022\u002F2022-09-02-invite-enterprise-to-students-result-presentation",[134],"event","V-oU1Hp40SIx9Qn-wIgRjMyfS3DFoOeHZznrdVpg1Dg",{"prev":137,"next":140,"related":143,"tags":152},{"title":138,"link":139},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":141,"link":142},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[144,147,148,149],{"title":145,"link":146},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":138,"link":139},{"title":141,"link":142},{"title":150,"link":151},"2022 鐵人賽","\u002Fblog\u002F2022-08-08-ithome-2022ironman",[153,154,155,156,157,134,158,159,160,161,162],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064291433]