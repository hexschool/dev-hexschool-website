[{"data":1,"prerenderedAt":214},["ShallowReactive",2],{"blog:2021-10-25-bootstrap-intro":3,"blog:neighbors:2021-10-25-bootstrap-intro":183},{"id":4,"title":5,"author":6,"body":8,"categories":171,"date":172,"description":124,"draft":173,"extension":174,"meta":175,"navigation":176,"path":177,"seo":178,"stem":179,"tags":180,"thumbnail":17,"__hash__":182},"blog\u002Fblog\u002F2021\u002F2021-10-25-bootstrap-intro.md","Bootstrap 5 有什麼新特色!?",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":165},"minimark",[11,18,21,24,40,45,48,78,81,84,90,94,98,103,106,111,114,119,122,125,155,158,162],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F10%2F25%2Fog.png?alt=media&token=787ab669-10c4-4456-b8d1-9354814a43d4",[12,19,20],{},"大家好，我是卡斯伯老師～",[12,22,23],{},"請問你切版時，是用哪一個方式在進行呢？",[25,26,27,31,34,37],"ul",{},[28,29,30],"li",{},"手刻至上，不使用框架或任何工具",[28,32,33],{},"使用 Sass 等工具，透過相關方法優化結構",[28,35,36],{},"使用框架作為基底，並自行撰寫 CSS 調整樣式",[28,38,39],{},"使用框架搭配 Sass 進行整合，大幅加速開發速度",[41,42,44],"h2",{"id":43},"從純-css-轉至工具至上的開發型態","從純 CSS 轉至工具至上的開發型態",[12,46,47],{},"過去，我也是使用純 CSS 的方式在撰寫網頁，不過隨著工具越來越豐富，我也從純 CSS 慢慢轉變為 Sass 及 Bootstrap 整合的方式進行開發，明顯的差異點在於：",[25,49,50,57,72],{},[28,51,52,56],{},[53,54,55],"b",{},"CSS 行數大幅減少","：以前動輒上千行的 CSS，現在只需要調整變數就能完成，可以專注在新功能的開發",[28,58,59,62,63,67,68,71],{},[53,60,61],{},"協作更為容易","：每個人撰寫的習慣不同，就如 “按鈕” 有人習慣稱為 ",[64,65,66],"code",{},"button"," 有些人則習慣使用 ",[64,69,70],{},"btn"," ，甚至同一個人每個階段的撰寫方式都不一樣。透過框架命名、架構的習慣會更有一致性。",[28,73,74,77],{},[53,75,76],{},"不需要每次撰寫相同的模組","：同樣的按鈕每個網站都需要用到，如果每次都重新撰寫將會花去不少時間，就算是 copy & paste 都有可能出錯，與其如此不如就直接引入，快速又可減少錯誤～",[12,79,80],{},"許多細微的差異下，從過去一個網站需花費兩週，到現在只需要 1 ~ 2 天就可完成相同品質的網站，剩下的時間可以用來優化更進階的視覺效果，長時間累積下來自然能夠有超越其他人的表現。",[12,82,83],{},"來自一段學長姐的話：",[85,86,87],"blockquote",{},[12,88,89],{},"切版一定要快，如果連 CSS 都搞不定怎麼能做好專業的前端工程師呢？",[15,91],{"src":92,"alt":44,"style":93},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F10%2F25%2Fblock.jpg?alt=media&token=5bbcb44d-3982-4128-9452-6309c31c23b9","margin-left: auto; margin-right: auto; width: 60%",[41,95,97],{"id":96},"bootstrap-5-網頁開發整合術","Bootstrap 5 網頁開發整合術",[25,99,100],{},[28,101,102],{},"聽說 Bootstrap 都長一樣，怎麼可能符合每個網站的需求？",[12,104,105],{},"→ 實戰都會透過變數客製化，調整成符合每個網站樣式及需求啦",[25,107,108],{},[28,109,110],{},"Sass 環境好像很難搞，學的時間該不會就抵掉之後節省的時間？",[12,112,113],{},"→ 課程中只花 3 分鐘介紹如何安裝 Sass 環境，只要文字編輯器不須另外安裝工具，相信你用一次就上癮",[25,115,116],{},[28,117,118],{},"上述介紹了 Bootstrap 5 的一些特點，但這個工具真的有這麼好嗎？",[12,120,121],{},"→ 來參加活動，我現場示範給你看",[12,123,124],{},"接下來，我們預計在 10\u002F27 進行「 Bootstrap 5 網頁開發整合術」的課程介紹，歡迎你提前發問，我將在直播過程中一一回覆。",[25,126,127,136,143,146],{},[28,128,129],{},[130,131,135],"a",{"href":132,"rel":133},"https:\u002F\u002Fapp.sli.do\u002Fevent\u002Fkzvqzwew",[134],"nofollow","Slido 提前發問區",[28,137,138],{},[130,139,142],{"href":140,"rel":141},"https:\u002F\u002Fyoutu.be\u002FaOqpcbT99g8",[134],"直播連結",[28,144,145],{},"直播時間：10\u002F27 20:00",[28,147,148,149,154],{},"訂閱課程通知搶優惠（",[130,150,153],{"href":151,"rel":152},"https:\u002F\u002Fr.botbonnie.com\u002Fj4Pq6",[134],"LINE","）",[12,156,157],{},"想要即時收到 Bootstrap 5 課程活動訊息嗎？趕快訂閱起來！",[130,159,161],{"href":151,"target":160},"_blank"," 訂閱課程通知",[130,163,164],{"href":140,"target":160}," 準時看直播",{"title":166,"searchDepth":167,"depth":167,"links":168},"",2,[169,170],{"id":43,"depth":167,"text":44},{"id":96,"depth":167,"text":97},null,"2021-10-25",false,"md",{},true,"\u002Fblog\u002F2021\u002F2021-10-25-bootstrap-intro",{"title":5,"description":124},"blog\u002F2021\u002F2021-10-25-bootstrap-intro",[181],"event","spxU4GTsq7QIbw-Q8vF6A50YP7IO92E8uYFkcz0td2U",{"prev":184,"next":187,"related":190,"tags":203},{"title":185,"link":186},"前端工程師第一份工作平均起薪與採用技術調查","\u002Fblog\u002F2021-12-09-frontend-first-salary",{"title":188,"link":189},"The F2E 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2021-09-09-the-f2e-3-2021",[191,194,197,200],{"title":192,"link":193},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":195,"link":196},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":198,"link":199},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":201,"link":202},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[204,205,206,207,208,181,209,210,211,212,213],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292492]