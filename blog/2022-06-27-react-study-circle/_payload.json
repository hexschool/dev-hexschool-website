[{"data":1,"prerenderedAt":252},["ShallowReactive",2],{"blog:2022-06-27-react-study-circle":3,"blog:neighbors:2022-06-27-react-study-circle":221},{"id":4,"title":5,"author":6,"body":8,"categories":210,"date":211,"description":21,"draft":212,"extension":213,"meta":214,"navigation":192,"path":215,"seo":216,"stem":217,"tags":218,"thumbnail":18,"__hash__":220},"blog\u002Fblog\u002F2022\u002F2022-06-27-react-study-circle.md","React 新手讀書會",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":194},"minimark",[11,19,22,27,42,57,63,66,71,74,78,81,85,88,92,95,101,107,110,121,124,137,140,143,146,166,169,185],[12,13,14],"p",{},[15,16],"img",{"alt":17,"src":18},"首圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F06%2Freact%2FReact_0523.png?alt=media&token=2c21dc70-a5a5-4823-84f2-8a14f2d0bd93",[12,20,21],{},"現在前端所需技能越來越深，而三大框架雖然資源豐富，但對於新手來說卻也不知道如何入門，因此我們舉辦「React 新手讀書會」，讓更多的前端同好可以認識這門框架～",[23,24,26],"h2",{"id":25},"這個活動適合哪些人呢","這個活動適合哪些人呢？",[28,29,30,31,30,36,30,39],"ul",{},"\n  ",[32,33,35],"li",{"style":34},"font-size: 18px;","對於 JavaScript 有基礎掌握度",[32,37,38],{"style":34},"對於 React 或其它框架有基本認識，想學習 React 的開發者",[32,40,41],{"style":34},"想從基礎學習 React 的開發者",[12,43,44,45,51,52,56],{},"如果你不確定自己的基礎是否可以學習 React，可以先觀看此",[46,47,50],"a",{"href":48,"target":49},"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=FGdKdn_CnWo&ab_channel=%E5%85%AD%E8%A7%92%E5%AD%B8%E9%99%A2","_blank","變數影片","、",[46,53,55],{"href":54,"target":49},"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=_vFuDQ_6Xt8&ab_channel=%E5%85%AD%E8%A7%92%E5%AD%B8%E9%99%A2","陣列影片","，本影片內容是在直播介紹 JavaScript 中「ES6 Let 與 Const」的語法觀念，如果你能瞭解直播課程上所介紹的內容，將可來參與本次活動。",[12,58,59],{},[15,60],{"alt":61,"src":62},"影片截圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F06%2Freact%2Fvue3-camp-editor.png?alt=media&token=a395c3d2-d1b2-4c4d-9989-ad3eff659d0c",[23,64,65],{"id":65},"課程大綱",[67,68,70],"h3",{"id":69},"第一堂83-react-起手式從-hooks-開始入門","第一堂：8\u002F3 React 起手式，從 Hooks 開始入門",[12,72,73],{},"起手式中將帶大家認識 React 的基本運作，以及 JavaScript 中的常見基本知識，同時會以 Hooks 來講解 React 如何進行資料狀態處理",[67,75,77],{"id":76},"第二堂810-component-元件開發","第二堂：8\u002F10 Component 元件開發",[12,79,80],{},"掌握元件開發後，就能打造出複用性高的程式碼出來，在這堂讀書會將會使用 Create React App 帶您進入資料元件傳遞的殿堂。",[67,82,84],{"id":83},"第三堂817-react-router-設計","第三堂：8\u002F17 React Router 設計",[12,86,87],{},"做中大型架構時，頁面多就會變得難以管理，在此會開始瞭解元件如何搭配 React Router 來做統一管理。",[67,89,91],{"id":90},"第四堂824-todolist-全攻略","第四堂：8\u002F24 Todolist 全攻略",[12,93,94],{},"好不容易學會了，當然要把作品推上去！將搭配 React Hook Form 表單驗證，介接 JWT 登入註冊 API，部署到 GitHub Pages 上 ~",[12,96,97],{},[15,98],{"alt":99,"src":100},"API 截圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F06%2Freact%2F%E6%88%AA%E5%9C%96_2022-06-27_%E4%B8%8A%E5%8D%888.59.07.png?alt=media&token=3d4b1a7a-a4f0-4909-a6cf-875e98cf3908",[12,102,103],{},[15,104],{"alt":105,"src":106},"設計稿截圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F06%2Freact%2F%E6%88%AA%E5%9C%96_2022-06-27_%E4%B8%8A%E5%8D%889.00.06.png?alt=media&token=d1c27b3c-dfd8-41ce-a7ed-9ea00fd19207",[23,108,109],{"id":109},"服務範圍",[28,111,30,112,30,115,30,118],{},[32,113,114],{"style":34},"每週一場讀書會直播，8\u002F3 ~ 8\u002F24 每週三晚上 20:00 ~ 22:00，六角校長洧杰親自授課",[32,116,117],{"style":34},"每日任務 8\u002F3 ~ 8\u002F24 的週一到週五",[32,119,120],{"style":34},"最終證書作業",[23,122,123],{"id":123},"完課獎勵證書",[125,126,30,127,30,134],"ol",{},[32,128,129,130,133],{"style":34},"若有在 9\u002F4 前繳交",[131,132,120],"b",{},"，助教審核通過者，則可獲得完課獎勵證書。",[32,135,136],{"style":34},"若 9\u002F4 ~ 9\u002F23 期間助教審核失敗，則沒辦法再次提交批改獲得證書",[12,138,139],{},"備註一：若在活動期間被助教退件，可於 9\u002F4 前再次提交作業",[12,141,142],{},"備註二：最終證書作業審核門檻：需使用 React Router，會檢視功能是否都有正常運作，不會審核 Code，但會將寫得好的讀書會作品給予學生參考。",[23,144,145],{"id":145},"活動與報名時間",[28,147,30,148,30,151,30,154,30,157,30,160,30,163],{},[32,149,150],{"style":34},"報名時間：7\u002F21(四) 中午 12 點~7\u002F24(日)",[32,152,153],{"style":34},"直播教學開始時間：8\u002F3 ~ 8\u002F24，每週三晚上 20:00 ~ 22:00",[32,155,156],{"style":34},"最終證書作業繳交截止日：9\u002F4(日)",[32,158,159],{"style":34},"當週發送完課證書：9\u002F23(五)",[32,161,162],{"style":34},"影音觀看期限：直播錄影提供一年觀看，期限為 2023\u002F9\u002F23",[32,164,165],{"style":34},"課程資源：講義、每日任務將永久保存",[23,167,168],{"id":168},"我要報名",[28,170,30,171,30,174,30,179,30,182],{},[32,172,173],{"style":34},"本活動收取 799 元基本費用",[32,175,176],{"style":34},[131,177,178],{},"請 7\u002F21(四) 中午 12:00 再來到此頁面，將會多一顆註冊按鈕進行報名",[32,180,181],{"style":34},"報名隔天，會收到開通 Email，引導您進入程式勇者村 - 學習輔助平台",[32,183,184],{"style":34},"在系統課程介面上，就會教您如何開始上課！",[12,186,187],{},[46,188,193],{"className":189,"href":191,"disabled":192},[190],"disabled","#",true," 結束報名 ",{"title":195,"searchDepth":196,"depth":196,"links":197},"",2,[198,199,206,207,208,209],{"id":25,"depth":196,"text":26},{"id":65,"depth":196,"text":65,"children":200},[201,203,204,205],{"id":69,"depth":202,"text":70},3,{"id":76,"depth":202,"text":77},{"id":83,"depth":202,"text":84},{"id":90,"depth":202,"text":91},{"id":109,"depth":196,"text":109},{"id":123,"depth":196,"text":123},{"id":145,"depth":196,"text":145},{"id":168,"depth":196,"text":168},null,"2022-06-27",false,"md",{},"\u002Fblog\u002F2022\u002F2022-06-27-react-study-circle",{"title":5,"description":21},"blog\u002F2022\u002F2022-06-27-react-study-circle",[219],"event","aZvtjsFnZVYfJr1nnKqk4kxmPD30HAA9I1UQy8JLp5k",{"prev":222,"next":225,"related":228,"tags":241},{"title":223,"link":224},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":226,"link":227},"軟體工程師薪水","\u002Fblog\u002F2022-06-23-software-engineer-salary",[229,232,235,238],{"title":230,"link":231},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":233,"link":234},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":236,"link":237},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presenta