[{"data":1,"prerenderedAt":701},["ShallowReactive",2],{"blog:2022-07-25-software-engineer-restrict":3,"blog:neighbors:2022-07-25-software-engineer-restrict":676},{"id":4,"title":5,"author":6,"body":8,"categories":663,"date":664,"description":665,"draft":666,"extension":667,"meta":668,"navigation":669,"path":670,"seo":671,"stem":672,"tags":673,"thumbnail":18,"__hash__":675},"blog\u002Fblog\u002F2022\u002F2022-07-25-software-engineer-restrict.md","軟體工程師有年齡、學歷、背景限制嗎？",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":655},"minimark",[11,19,22,26,36,39,42,162,166,169,285,288,291,294,305,308,412,415,418,433,438,445,448,455,459,462,470,618,621,624,635,638,641,652],[12,13,14],"p",{},[15,16],"img",{"alt":17,"src":18},"首圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fengineer-limit%2FUntitled.png?alt=media&token=2376aa6d-bfe4-4691-adce-0e6a926c9701",[12,20,21],{},"相信每個人對於未來都會感到迷茫，尤其是想切換到另一個跑道更是如此，所以對於軟體工程師來說，會想知道的不外乎「這個行業是否可以長期做下去」、「入門會不會有很多限制」、「我現在加入會不會太晚」等等的問題。\n而本篇將從相對客觀的數據來分析，整體大環境下的開發者構成，認識一下這個領域的人們組成為何。",[23,24,25],"h2",{"id":25},"數據來源",[12,27,28,29,35],{},"本文分析的報告來自於 ",[30,31,34],"a",{"href":32,"target":33},"https:\u002F\u002Finsights.stackoverflow.com\u002Fsurvey\u002F2021","_blank","Stack Overflow"," ，Stack Overflow 是針對程式設計領域的問答網站，是目前全球最主流的該領域網站，每年 Stack Overflow 也都會針對開發者來進行調查，本篇文章將會針對 2021 年的數據來進行分析及分享想法。\n不過請特別注意，本調查的數據數量約 83,000 份，來源大多來自於 “白人”(58%) 及 “男性”(91%) 為主，雖然調查並沒有特別著重於特定區域、性別及人種，但這可能會與台灣現狀不符合，讀者可依據數據判斷是否接受此資訊。",[23,37,38],{"id":38},"用戶背景",[12,40,41],{},"這份報告的涵蓋年齡層相當廣，雖然程式語言已經出現相當久，但也是近二十年左右才越來越多人投入，而這份調查報告的年齡層涵蓋未滿 18 直至超過 65 歲皆有相關的數據（其實就是 Stack Overflow 的整體用戶分析），而主要的年齡層落在 25 至 34 歲之間，其次則是 18 ~ 24 歲及 35 ~ 44 歲之間。",[43,44,45,46],"div",{},"\n  ",[47,48,50,51,50,70,45],"table",{"style":49},"white-space: nowrap;","\n    ",[52,53,54,55,50],"thead",{},"\n      ",[56,57,58,59,58,64,58,67,54],"tr",{},"\n        ",[60,61,63],"th",{"style":62},"width: 30%;","年齡",[60,65,66],{},"數量",[60,68,69],{"style":62},"百分比",[71,72,54,73,54,85,54,96,54,107,54,118,54,129,54,140,54,151,50],"tbody",{},[56,74,58,75,58,79,58,82,54],{},[76,77,78],"td",{},"未滿 18 歲",[76,80,81],{},"5,373",[76,83,84],{},"6.52",[56,86,58,87,58,90,58,93,54],{},[76,88,89],{},"18 ~ 24 歲",[76,91,92],{},"20,993",[76,94,95],{},"25.47",[56,97,58,98,58,101,58,104,54],{},[76,99,100],{},"25 ~ 34 歲",[76,102,103],{},"32,568",[76,105,106],{},"39.52",[56,108,58,109,58,112,58,115,54],{},[76,110,111],{},"35 ~ 44 歲",[76,113,114],{},"15,183",[76,116,117],{},"18.42",[56,119,58,120,58,123,58,126,54],{},[76,121,122],{},"45 ~ 54 歲",[76,124,125],{},"5,472",[76,127,128],{},"6.64",[56,130,58,131,58,134,58,137,54],{},[76,132,133],{},"55 ~ 64 歲",[76,135,136],{},"1,819",[76,138,139],{},"2.21",[56,141,58,142,58,145,58,148,54],{},[76,143,144],{},"65 歲以上",[76,146,147],{},"421",[76,149,150],{},"0.51",[56,152,58,153,58,156,58,159,54],{},[76,154,155],{},"未提供",[76,157,158],{},"575",[76,160,161],{},"0.7",[163,164,165],"small",{},"年齡調查（82,407 個回應）",[12,167,168],{},"而上述的八萬多人以外，其中的約 70% 左右是專業的開發者或從事軟體開發工作的人員，就比例上來說年齡層稍微往上，更偏向 25 ~ 44 歲之間；所以整體 Stack Overflow 的用戶群涵蓋了許多「正在學習階段」的開發者，還不是真正投入開發工作的人員。",[43,170,45,171],{},[47,172,50,173,50,187,45],{"style":49},[52,174,54,175,50],{},[56,176,58,177,58,180,58,182,58,184,54],{},[60,178,63],{"style":179},"width: 25%;",[60,181,66],{"style":179},[60,183,69],{"style":179},[60,185,186],{"style":179},"所有回應的百分比",[71,188,54,189,54,201,54,213,54,225,54,237,54,249,54,261,54,273,50],{},[56,190,58,191,58,193,58,196,58,199,54],{},[76,192,78],{},[76,194,195],{},"322",[76,197,198],{},"0.56",[76,200,84],{},[56,202,58,203,58,205,58,208,58,211,54],{},[76,204,89],{},[76,206,207],{},"10,987",[76,209,210],{},"19.08",[76,212,95],{},[56,214,58,215,58,217,58,220,58,223,54],{},[76,216,100],{},[76,218,219],{},"27,874",[76,221,222],{},"48.42",[76,224,106],{},[56,226,58,227,58,229,58,232,58,235,54],{},[76,228,111],{},[76,230,231],{},"12,497",[76,233,234],{},"21.71",[76,236,117],{},[56,238,58,239,58,241,58,244,58,247,54],{},[76,240,122],{},[76,242,243],{},"4,210",[76,245,246],{},"7.31",[76,248,128],{},[56,250,58,251,58,253,58,256,58,259,54],{},[76,252,133],{},[76,254,255],{},"1,294",[76,257,258],{},"2.25",[76,260,139],{},[56,262,58,263,58,265,58,268,58,271,54],{},[76,264,144],{},[76,266,267],{},"201",[76,269,270],{},"0.35",[76,272,150],{},[56,274,58,275,58,277,58,280,58,283,54],{},[76,276,155],{},[76,278,279],{},"188",[76,281,282],{},"0.33",[76,284,161],{},[163,286,287],{},"專業開發者（57,573 個回應）",[23,289,290],{"id":290},"學歷以及如何學程式",[12,292,293],{},"這段相信對於許多人感興趣，大部分非本科想投入軟體開發領域來說，都會質疑：",[295,296,45,297,45,302],"ul",{},[298,299,301],"li",{"style":300},"font-size: 18px;","非本科真的能投入軟體開發嗎？",[298,303,304],{"style":300},"如果不從學校學習，大家是用什麼資源學習呢？",[12,306,307],{},"在此列出「所有受訪者」自學程式的方式，就數據上來說可以看到絕大部分學習都來自於各類線上資源（如：影音、Blog，而且是偏免費的類型）；其次則是 “學校” 佔超過 50% 的人填寫，或許看到這邊，會認為寫程式與學校教育有一定的關聯性，但請繼續往下看。",[43,309,45,310],{},[47,311,50,312,50,322,45],{"style":49},[52,313,54,314,50],{},[56,315,58,316,58,318,58,320,54],{},[60,317],{"style":62},[60,319,66],{},[60,321,69],{"style":62},[71,323,54,324,54,335,54,346,54,357,54,368,54,379,54,390,54,401,50],{},[56,325,58,326,58,329,58,332,54],{},[76,327,328],{},"線上資源（影音、Blog 等等）",[76,330,331],{},"49,392",[76,333,334],{},"59.53",[56,336,58,337,58,340,58,343,54],{},[76,338,339],{},"學校",[76,341,342],{},"44,462",[76,344,345],{},"53.59",[56,347,58,348,58,351,58,354,54],{},[76,349,350],{},"書籍\u002F實體資源",[76,352,353],{},"42,752",[76,355,356],{},"51.53",[56,358,58,359,58,362,58,365,54],{},[76,360,361],{},"線上課程",[76,363,364],{},"33,511",[76,366,367],{},"40.39",[56,369,58,370,58,373,58,376,54],{},[76,371,372],{},"線上論壇",[76,374,375],{},"26,229",[76,377,378],{},"31.62",[56,380,58,381,58,384,58,387,54],{},[76,382,383],{},"朋友或家人",[76,385,386],{},"15,162",[76,388,389],{},"18.28",[56,391,58,392,58,395,58,398,54],{},[76,393,394],{},"同事",[76,396,397],{},"14,225",[76,399,400],{},"17.15",[56,402,58,403,58,406,58,409,54],{},[76,404,405],{},"程式訓練營",[76,407,408],{},"8,496",[76,410,411],{},"10.24",[163,413,414],{},"如何自學程式（82,963 個回應）",[12,416,417],{},"此圖則是按照各年齡層來區分不同的學習方式，在此可以得到完全不同的結果，",[295,419,45,420,45,423,45,430],{},[298,421,422],{"style":300},"所有年齡層從學校學習程式約佔 20%，但依據年齡逐年縮小佔比，更多人是採用不同類型的方式自學程式。",[298,424,425,429],{"style":300},[426,427,428],"b",{},"線上資源趨向主流","，25 - 34 歲學習程式有近 50% 以上來自於各類線上資源。",[298,431,432],{"style":300},"從線上課程或認證資源學習逐年增長，有接近學校教育的趨勢。",[12,434,435],{},[15,436],{"alt":290,"src":437},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fengineer-limit%2FUntitled%201.png?alt=media&token=6e048e82-cd3a-4e97-9473-bce48374723a",[12,439,440,441,444],{},"這張圖其實說明了許多",[426,442,443],{},"開發者學習程式並不完全是來自於學校、學院的教育","，從年輕的一倍可以看出有越來愈多的人是透過自學的方式轉職為前端工程師。",[12,446,447],{},"當然，除了透過自學的形式以外，數據中也說明學習程式並非只有透過單一媒介，任何只要可以幫助成長都是一個好資源，如：線上影音、書籍、論壇等等，這類型的媒介易於取得，但也相對沒有任何強制力，並不會有人壓著工程師去看 Youtube、也不會有人強迫考試，這個心態是完全自發性的，只有持續學習才能不斷精進，而且是大多數的工程師認為這麼做是必要的。",[12,449,450,451,454],{},"所以具備",[426,452,453],{},"要求自我保持學習心態","對於軟體工程師是必要的，如果你對於此領域有興趣，但不打算精進自己、試圖尋找合適的學習資源、尋求如何突破當前現狀，會建議提早放棄軟體工程師這條路。",[23,456,458],{"id":457},"寫程式可以寫一輩子嗎","寫程式可以寫一輩子嗎？",[12,460,461],{},"如果願意學習、願意精進自己，寫程式可以寫多久呢？\n許多人轉職成為軟體工程師其實並非出自於興趣，而是發現自己的產業已經進入了夕陽階段，因此會希望接下來轉職的產業不要像前一個產業一樣落入夕陽。\n在以下的數據中，列出了「寫程式的經歷有多長」，其中主要的年資是落在 1 ~ 9 年之間，原因如下：",[295,463,45,464,45,467],{},[298,465,466],{"style":300},"軟體工程師在這幾年越來越多新血加入（15 年內的時間）",[298,468,469],{"style":300},"並非所有人適合軟體工程師，可能在蜜月期結束後就離開（在大學期間上完課發現志向不在此，因此約四年期間）",[43,471,45,472],{},[47,473,50,474,50,484,45],{"style":49},[52,475,54,476,50],{},[56,477,58,478,58,480,58,482,54],{},[60,479],{"style":62},[60,481,66],{},[60,483,69],{"style":62},[71,485,54,486,54,497,54,508,54,519,54,530,54,541,54,552,54,563,54,574,54,585,54,596,54,607,50],{},[56,487,58,488,58,491,58,494,54],{},[76,489,490],{},"不到一年",[76,492,493],{},"1,489",[76,495,496],{},"1.82",[56,498,58,499,58,502,58,505,54],{},[76,500,501],{},"1 ~ 4 年",[76,503,504],{},"14,535",[76,506,507],{},"17.8",[56,509,58,510,58,513,58,516,54],{},[76,511,512],{},"5 ~ 9 年",[76,514,515],{},"24,418",[76,517,518],{},"29.91",[56,520,58,521,58,524,58,527,54],{},[76,522,523],{},"10 ~ 14 年",[76,525,526],{},"15,428",[76,528,529],{},"18.9",[56,531,58,532,58,535,58,538,54],{},[76,533,534],{},"15 ~ 19 年",[76,536,537],{},"8,492",[76,539,540],{},"10.4",[56,542,58,543,58,546,58,549,54],{},[76,544,545],{},"20 ~ 24 年",[76,547,548],{},"6,673",[76,550,551],{},"8.17",[56,553,58,554,58,557,58,560,54],{},[76,555,556],{},"25 ~ 29 年",[76,558,559],{},"3,661",[76,561,562],{},"4.48",[56,564,58,565,58,568,58,571,54],{},[76,566,567],{},"30 ~ 34 年",[76,569,570],{},"2,787",[76,572,573],{},"3.41",[56,575,58,576,58,579,58,582,54],{},[76,577,578],{},"35 ~ 39 年",[76,580,581],{},"2,166",[76,583,584],{},"2.65",[56,586,58,587,58,590,58,593,54],{},[76,588,589],{},"40 ~ 44 年",[76,591,592],{},"1,426",[76,594,595],{},"1.75",[56,597,58,598,58,601,58,604,54],{},[76,599,600],{},"45 ~ 49 年",[76,602,603],{},"338",[76,605,606],{},"0.41",[56,608,58,609,58,612,58,615,54],{},[76,610,611],{},"50 年以上",[76,613,614],{},"228",[76,616,617],{},"0.28",[163,619,620],{},"寫程式的經歷有多長",[12,622,623],{},"撇除 15 年內的軟體開發者，那麼還會有多少人願意寫程式超過 15 年呢？就上方數據累加後可以得到以下的結果：",[295,625,45,626,45,629,45,632],{},[298,627,628],{"style":300},"寫程式超過 15 年以上：25,770 人佔 31.55%",[298,630,631],{"style":300},"寫程式超過 20 年以上：17,278 人佔 21.15%",[298,633,634],{"style":300},"寫程式超過 30 年以上：6,945 人佔 8.5%",[12,636,637],{},"就這數據來說，可以說明總體有 30% 人員寫程式經歷是超過 15 年的（如果在軟體開發者活動中，每 10 位就有 3 位開發者寫程式經歷超過 15 年），這是一個相對高的比例說明有許多人願意長期留存於軟體開發環境中；而以台灣的大學畢業市場來說，有超過 5 成的人並非從事原本在校所學的科系（來源：遠見雜誌），更別說還要持續相同的知識領域 15 年以上。",[12,639,640],{},"至於寫程式可以寫多久當然是因人而異，且所學習的程式語言也不一定在未來是存在的，在前端領域中還常常流傳一句笑話「每 18 個月前端技術困難一倍」，也因為如此會被認為工程師就是要不斷的追技術（也沒錯啦）；但反過來說也造就了軟體工程師會具備以下的特質：",[295,642,45,643,45,646,45,649],{},[298,644,645],{"style":300},"很強的學習能力 → 需要不斷的學習新技術",[298,647,648],{"style":300},"很快的閱讀速度 → 需要閱讀各式的文件",[298,650,651],{"style":300},"很精準的搜尋能力 → 需要面對各種新的問題",[12,653,654],{},"這些技能能夠讓軟體工程師很快的切換到不同身份，並且面對不同的職位問題，也因為如此軟體工程師在各行各業中都能看到身影，如果你接下來對這個領域有興趣，不妨先看看自己所接觸的事物，有多少是跟 “軟體” 是有關係的呢？",{"title":656,"searchDepth":657,"depth":657,"links":658},"",2,[659,660,661,662],{"id":25,"depth":657,"text":25},{"id":38,"depth":657,"text":38},{"id":290,"depth":657,"text":290},{"id":457,"depth":657,"text":458},null,"2022-07-25","相信每個人對於未來都會感到迷茫，尤其是想切換到另一個跑道更是如此，所以對於軟體工程師來說，會想知道的不外乎「這個行業是否可以長期做下去」、「入門會不會有很多限制」、「我會現在加入會不會太晚」等等的問題。而本篇將從相對客觀的數據來分析，整體大環境下的開發者構成，認識一下這個領域的人們組成為何。",false,"md",{},true,"\u002Fblog\u002F2022\u002F2022-07-25-software-engineer-restrict",{"title":5,"description":665},"blog\u002F2022\u002F2022-07-25-software-engineer-restrict",[674],"software engineer","zcc_CjX1k_spW4MI5TYSsgjXzZl9aX8Zdc17mhhn3VU",{"prev":677,"next":680,"related":683,"tags":690},{"title":678,"link":679},"【轉職前端之路】明明是學偏後端，卻走進前端的世界","\u002Fblog\u002F2022-08-01-start-from-backend-but-into-frontend",{"title":681,"link":682},"【前端工程師 Q＆A】找到自己的內在動機，從中獲取成就感","\u002Fblog\u002F2022-07-18-mai-find-inner-motivation",[684,687],{"title":685,"link":686},"軟體工程師薪水","\u002Fblog\u002F2022-06-23-software-engineer-salary",{"title":688,"link":689},"軟體工程師有哪些類別","\u002Fblog\u002F2022-05-30-software-engineer-category",[691,692,693,694,695,696,697,698,699,700,674],"UI design","course","css","css3","enterprise","event","interview","javascript","jobs","skilltree",1790064291654]