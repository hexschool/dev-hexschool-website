[{"data":1,"prerenderedAt":275},["ShallowReactive",2],{"blog:2022-12-16-7th-anniversary-thanks":3,"blog:neighbors:2022-12-16-7th-anniversary-thanks":247},{"id":4,"title":5,"author":6,"body":8,"categories":235,"date":236,"description":237,"draft":238,"extension":239,"meta":240,"navigation":175,"path":241,"seo":242,"stem":243,"tags":244,"thumbnail":18,"__hash__":246},"blog\u002Fblog\u002F2022\u002F2022-12-16-7th-anniversary-thanks.md","7 週年感謝祭優惠活動",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":217},"minimark",[11,19,27,32,36,40,43,53,56,60,75,78,81,101,105,111,115,124,128,137,141,148,151,157,160,167,170,177,180,185,194,199,203],[12,13,14],"p",{},[15,16],"img",{"alt":17,"src":18},"首圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2Fblog-banner.png?alt=media&token=be0a09e1-8608-4f93-b015-099530255699",[12,20,21,22,26],{},"讀者您好，我是六角學院校長洧杰，感謝各位支持，我們才能穩健走到第七年！\n平平都是影音課程，為什麼我們有辦法將一位位學生順利推到職場？\n因為我們程式作業量極大，你所寫的每一行程式碼，",[23,24,25],"b",{},"我們都會在線上把關品質","，確保你有達到專業水準。\n像是下圖就是我們其中一位助教的批改回饋：",[15,28],{"src":29,"alt":30,"style":31},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2F%25E6%2588%25AA%25E5%259C%2596_2022-11-28_%25E4%25B8%258A%25E5%258D%25889_54_08.png?alt=media&token=9e989b13-fc92-4bc0-8e36-1e393a47842b","回饋-1","width: 100%;",[15,33],{"src":34,"alt":35,"style":31},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2F%25E6%2588%25AA%25E5%259C%2596_2022-11-28_%25E4%25B8%258A%25E5%258D%25889.54.20.png?alt=media&token=bbd95d2d-a822-410a-b1ac-ad83e821d1dd","回饋-2",[15,37],{"src":38,"alt":39,"style":31},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2F%25E6%2588%25AA%25E5%259C%2596_2022-11-28_%25E4%25B8%258A%25E5%258D%25889.54.27.png?alt=media&token=1834c5d9-92bf-41e7-9b15-28d949f8bbbb","回饋-3",[12,41,42],{},"我相信你來到這裡之前，已經有接觸些 CSS、JavaScript，但總覺得自己缺少自信，覺得能力還不夠，無法發自內心說自己學會了網頁前端技能。\n那麼我們的影音課程就相當適合你，我們每門課程都有極大作業量，幫助你提升知識熟練度。到課程最後面，還會有最終作業，確保你吸收效果有到預期。\n我們提供的設計稿，都是請專業設計師繪製，讓你就算沒有美感，也能做出美美的網頁。",[12,44,45,49],{},[15,46],{"alt":47,"src":48},"設計稿內頁","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2F%25E6%2588%25AA%25E5%259C%2596_2022-11-28_%25E4%25B8%258A%25E5%258D%25889.52.09.png?alt=media&token=403ac1b2-acb6-48b0-9d1f-4eedefe30b01",[15,50],{"alt":51,"src":52},"設計稿所有頁面","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2F%25E6%2588%25AA%25E5%259C%2596_2022-11-28_%25E4%25B8%258A%25E5%258D%25889.52.23.png?alt=media&token=1eae642c-45e2-4c48-b33f-bdabc0a0333f",[12,54,55],{},"學會網頁前端的好處，除了起薪比一般職業高外，更棒的是它也是少數能在家工作的行業。如果您想在疫情期間把自己的基礎打好，六角學院將會全心全力幫助您。",[57,58,59],"h2",{"id":59},"每門課程皆含",[61,62,63,64,63,69,63,72],"ol",{},"\n  ",[65,66,68],"li",{"style":67},"font-size: 18px;","無限期觀看影音課程",[65,70,71],{"style":67},"無次數限制程式作業批改",[65,73,74],{"style":67},"最終作業能力檢定考試",[57,76,77],{"id":77},"買課程抽大獎",[12,79,80],{},"活動期間（2022\u002F12\u002F22 - 2023\u002F01\u002F15）內，透過六角官網金流，購買以下任一條件：\n共三個品項，每人最多可以獲得五張抽獎卷",[61,82,63,83,63,86,63,89,63,92],{},[65,84,85],{"style":67},"一張：React 影音課程",[65,87,88],{"style":67},"兩張：Vue3 作品實戰直播班（已截止報名）",[65,90,91],{"style":67},"一張：單次消費滿額 6000",[65,93,94,95],{"style":67},"一張：註冊前面任一方案，再填寫",[96,97,100],"a",{"href":98,"target":99},"https:\u002F\u002Fhexschool.tw\u002FTHeFJ","_blank","六角品牌調性問卷",[57,102,104],{"id":103},"方案一vue-3-作品實戰直播班符合二張抽獎券","方案一：Vue 3 作品實戰直播班（符合二張抽獎券）",[106,107,108],"ul",{},[65,109,110],{},"已截止報名",[57,112,114],{"id":113},"方案二newreact-影音課程符合一張抽獎券","方案二：NEW！React 影音課程（符合一張抽獎券）",[12,116,117],{},[96,118,120],{"href":119,"target":99},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002Freact.html",[15,121],{"src":122,"alt":123},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Ftutorials%2Freact%2Freact-og.png?alt=media&token=56f02407-d8a6-41da-969a-04f475532022","React 實戰影音課程",[57,125,127],{"id":126},"方案三自選影音組合單筆消費滿額-6000符合一張抽獎券","方案三：自選影音組合，單筆消費滿額 6000（符合一張抽獎券）",[12,129,130],{},[96,131,133],{"href":132,"target":99},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses",[15,134],{"src":135,"alt":136},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2F1.png?alt=media&token=a98e1c1b-9618-46da-9b90-bdc4ce484fa5","自選影音 Banner",[57,138,140],{"id":139},"申請前三方案再填寫品牌問卷調查再送一張抽獎券","申請前三方案，再填寫品牌問卷調查，再送一張抽獎券",[106,142,143],{},[65,144,145,146],{},"填寫 ",[96,147,100],{"href":98,"target":99},[57,149,150],{"id":150},"獎品列表",[12,152,153],{},[15,154],{"alt":155,"src":156},"獎品圖片","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2F12151.png?alt=media&token=e2276b06-cb33-4bc6-bf73-855a375e0372",[57,158,159],{"id":159},"一步驟查詢",[12,161,162,163],{},"輸入註冊信箱，查詢目前累積抽獎卷數，每人最多可獲得五張\n",[96,164,166],{"href":165,"target":99},"https:\u002F\u002Fhexschool-expedition-pass.herokuapp.com\u002Fevents\u002Fthanks-2022","前往查詢",[57,168,169],{"id":169},"感謝祭說明會",[171,172],"iframe",{"src":173,"title":169,"allow":174,"allowFullScreen":175,"style":176},"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FxbFThut-rOQ","accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",true,"width: 100%; aspect-ratio: 16 \u002F 9; border: 0;",[57,178,179],{"id":179},"抽獎規章",[181,182,184],"h3",{"id":183},"注意事項","注意事項：",[61,186,63,187],{},[65,188,189,190,193],{"style":67},"獎品以實物為準，如遇產品缺貨或其他不可抗力之事由，主辦單位得保留更換等值獎品之權利，不另行告知。本活動若因故無法進行時，主辦單位將於活動網頁上公告，並有權決定修改、暫停或取消本活動。本活動僅限於設籍於",[23,191,192],{},"台灣、金門、澎湖、馬祖地區者","參加，配送地址以中獎人所填資料之地址為準。",[12,195,196],{},[23,197,198],{},"抽獎活動期間為保障抽獎者的公平權益，因此僅有 14 天的退款期。",[181,200,202],{"id":201},"詳細注意事項","詳細注意事項：",[61,204,63,205,63,208,63,211,63,214],{},[65,206,207],{"style":67},"抽獎活動最後獲獎內容，依官網公佈為主，不得異議。獲得獎項無法要求轉讓、兌換現金。若不同意則視為得獎者自動棄權，不具得獎資格。",[65,209,210],{"style":67},"主辦單位將主動聯繫得獎者。若於公佈抽獎結果超過一個月無法取得連繫，則視為自動棄權，不具得獎資格。",[65,212,213],{"style":67},"依中華民國稅法規定，中獎價值在新台幣 1,000（含）元以上者，贈與物品的價值將併入中獎人個人綜合所得稅申報，請中獎人配合繳交身分證影印本作為申報依據。中獎金額超過 NT$20,000 元，中獎人應依稅法先行繳交相當於獎品價值 10% 機會中獎之稅金，以供本公司做代繳稅及提供扣繳憑單使用，本公司統一於活動年之隔年寄發扣繳憑單給中獎人，以利中獎人申報之用。若中獎人不願先行繳納本項稅金，視同放棄中獎資格，且不得異依個人資料保護法，參加本活動者視為瞭解及同意於抽獎行銷活動之需要進行蒐集、處理及利用其個人資料。",[65,215,216],{"style":67},"抽獎結果於 2023 年 2 月 10 日前公佈於「六角粉絲團」。",{"title":218,"searchDepth":219,"depth":219,"links":220},"",2,[221,222,223,224,225,226,227,228,229,230],{"id":59,"depth":219,"text":59},{"id":77,"depth":219,"text":77},{"id":103,"depth":219,"text":104},{"id":113,"depth":219,"text":114},{"id":126,"depth":219,"text":127},{"id":139,"depth":219,"text":140},{"id":150,"depth":219,"text":150},{"id":159,"depth":219,"text":159},{"id":169,"depth":219,"text":169},{"id":179,"depth":219,"text":179,"children":231},[232,234],{"id":183,"depth":233,"text":184},3,{"id":201,"depth":233,"text":202},null,"2022-12-16","讀者您好，我是六角學院校長洧杰，感謝各位支持，我們才能穩健走到第七年！",false,"md",{},"\u002Fblog\u002F2022\u002F2022-12-16-7th-anniversary-thanks",{"title":5,"description":237},"blog\u002F2022\u002F2022-12-16-7th-anniversary-thanks",[245],"event","5UTmsxwu5KzixBy_wa03gOzy9G2wQBFx003M33MLlSs",{"prev":-1,"next":248,"related":251,"tags":264},{"title":249,"link":250},"學習永無止盡，即使已是前端工程師還是要繼續學習！","\u002Fblog\u002F2022-11-29-learning-never-end",[252,255,258,261],{"title":253,"link":254},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":256,"link":257},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":259,"link":260},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",{"title":262,"link":263},"2022 鐵人賽","\u002Fblog\u002F2022-08-08-ithome-2022ironman",[265,266,26