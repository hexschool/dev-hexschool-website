[{"data":1,"prerenderedAt":294},["ShallowReactive",2],{"blog:2020-09-22-learning-activity":3,"blog:neighbors:2020-09-22-learning-activity":263},{"id":4,"title":5,"author":6,"body":8,"categories":250,"date":251,"description":252,"draft":253,"extension":254,"meta":255,"navigation":256,"path":257,"seo":258,"stem":259,"tags":260,"thumbnail":17,"__hash__":262},"blog\u002Fblog\u002F2020\u002F2020-09-22-learning-activity.md","【振學活動】 - 繳作業抽商品卡",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":238},"minimark",[11,18,31,34,39,45,65,70,73,76,79,82,85,88,91,95,98,112,115,118,135,138,204,207,225,229,232],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F09%2F%E6%8C%AF%E5%AD%B8%E6%B4%BB%E5%8B%95%E6%96%87%E7%AB%A0%E5%B0%81%E9%9D%A2%E5%9C%96.png?alt=media&token=e822b084-b5d8-443c-854c-2f5247ebd687",[19,20,21,25,28],"ul",{},[22,23,24],"li",{},"經常買了課程，但沒有開始學習及繳作業嗎？",[22,26,27],{},"買了六角課程，卻不知道一堆作業要繳嗎？",[22,29,30],{},"還是你今天就想學習，發現可以順便抽商品卡嗎？",[12,32,33],{},"九月開學季，邀請同學一起來學習～\n慵懶的暑假過去了，迎接到來新學年的開學日，新學期新目標，就從繳開始吧！",[35,36,38],"h2",{"id":37},"繳作業抽商品卡-活動說明","【繳作業抽商品卡 - 活動說明】",[12,40,41],{},[42,43,44],"strong",{},"只要於活動期間內，於「程式勇者村」中繳交任一特定課程的最終作業，就可符合抽獎資格。",[19,46,47,50,56,59,62],{},[22,48,49],{},"適用課程：HTML&CSS、jQuery、RWD、Bootstrap、JS、Vue",[22,51,52],{},[53,54,55],"b",{},"適用學員：新學員、老學員皆可參加",[22,57,58],{},"活動期間：2020\u002F09\u002F01 ～ 2020\u002F11\u002F01",[22,60,61],{},"獎項：500 元商品卡，共 25 張",[22,63,64],{},"公布得獎名單時間：2020\u002F11\u002F03 前於六角粉絲頁公開，並且會透過 Mail 及各種形式聯絡得獎人",[66,67,69],"h3",{"id":68},"常見問題","【常見問題】",[12,71,72],{},"Q: 我是新手，建議從哪一個課程開始做作業比較好呢？\nA: 建議從 HTML、CSS 開始投入，這門課程是設計給沒有任何基礎也能投入。",[12,74,75],{},"Q: 課程優惠期間加入，這樣來得及嗎？\nA: 以 HTML 課程來說，平均完成時間是 20 天，更有許多學員是在 10 天左右完課，認真投入絕對是沒有問題的。",[12,77,78],{},"Q: 我已經有課程的，是否可以參加此活動？\nA: 可以，只要繳交時間在 2020\u002F09\u002F01 ～ 2020\u002F11\u002F01 之間的都符合抽獎資格",[12,80,81],{},"Q: 活動內有提繳，但是還沒審核通過，可以符合抽獎資格嗎？\nA: 可以，只要是 \"完成的版本\"，就可以符合抽獎資格。",[12,83,84],{},"Q: 章節中的小作業可以算嗎？\nA: 不行，一定要課程的最終作業才算喔。",[12,86,87],{},"Q:我可以先提交，等到活動期間後再完成嗎？\nA: 當然不行，如果提交是未完成的版本，將不會獲得抽獎資格。",[89,90],"hr",{},[35,92,94],{"id":93},"程式勇者村-直播活動","【程式勇者村 - 直播活動】",[12,96,97],{},"六角學院經營至今，學員給我們的評價不外乎：",[19,99,100,103,106,109],{},[22,101,102],{},"有問必答",[22,104,105],{},"可以很快收到問題回饋",[22,107,108],{},"各個作業都很認真批改",[22,110,111],{},"除了助教回饋，還可以參考許多同學的作品",[12,113,114],{},"過去，每天約有 10 ~ 20 個問題，憑著講師、內部助教們的分配可以快速回覆所有人的問題；但隨著課程、學員數的成長，現在每天約有 60 至 100 個課程問題及作業，而這麼大的問題數光靠講師、內部助教是無法負荷的，加上現在增加了許多不同平台，整合上更是困難，因此我們開發了「程式勇者村」來解決我們的問題。",[12,116,117],{},"程式勇者村是六角學院開發的「教學輔助平台」，學員們可以在此平台繳交作業及收到助教們的回饋；而助教團隊可透過此平台分配不同的問題給予助教，讓學員們可以盡快收到問題的回饋。此平台到目前為止：",[19,119,120,123,126,129,132],{},[22,121,122],{},"超過 20,000 筆問題回覆",[22,124,125],{},"超過 3,000 份作業繳交",[22,127,128],{},"超過 3,000 名會員",[22,130,131],{},"將近 40 名助教使用此服務回覆學員問題",[22,133,134],{},"即將進入第 4 個直播班課程",[66,136,137],{"id":137},"課程繳交排行榜",[139,140,142,143,142,159],"table",{"style":141},"width: 50%;","\n  ",[144,145,146,147,142],"thead",{},"\n    ",[148,149,150,151,150,156,146],"tr",{},"\n      ",[152,153,155],"th",{"scope":154},"col","課程",[152,157,158],{"scope":154},"繳交量",[160,161,146,162,146,172,146,180,146,188,146,196,142],"tbody",{},[148,163,150,164,150,169,146],{},[165,166,168],"td",{"scope":167},"row","使用 HTML、CSS 開發一個網站",[165,170,171],{},"8320",[148,173,150,174,150,177,146],{},[165,175,176],{"scope":167},"Vue 出一個電商網站",[165,178,179],{},"4360",[148,181,150,182,150,185,146],{},[165,183,184],{"scope":167},"JavaScript 入門篇 - 學徒的試煉",[165,186,187],{},"4106",[148,189,150,190,150,193,146],{},[165,191,192],{"scope":167},"精通 Bootstrap 4 - 開發超強不解釋",[165,194,195],{},"2252",[148,197,150,198,150,201,146],{},[165,199,200],{"scope":167},"使用 jQuery 打造互動性網頁動畫效果",[165,202,203],{},"1870",[12,205,206],{},"除此之外，平台還整合了直播班、求職心得、RPG 系統等功能，如果你對於「程式勇者村」有興趣，歡迎來參加此直播活動：",[19,208,209,212,222],{},[22,210,211],{},"直播時間：9月 23日 (週三) 下午8點 – 下午9點",[22,213,214,215],{},"直播連結：",[216,217,221],"a",{"href":218,"rel":219},"https:\u002F\u002Fzoom.us\u002Fj\u002F96252418467",[220],"nofollow","ZOOM 連結",[22,223,224],{},"有獎徵答活動：711 商品卡",[35,226,228],{"id":227},"優惠活動","【優惠活動】",[12,230,231],{},"如果你還未加入六角學院，也可趁著活動期間加入，即日起至 2020\u002F10\u002F11 日，六角學院全課程七折。",[12,233,234],{},[216,235,237],{"href":236},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses"," 課程全面 7 折 ",{"title":239,"searchDepth":240,"depth":240,"links":241},"",2,[242,246,249],{"id":37,"depth":240,"text":38,"children":243},[244],{"id":68,"depth":245,"text":69},3,{"id":93,"depth":240,"text":94,"children":247},[248],{"id":137,"depth":245,"text":137},{"id":227,"depth":240,"text":228},null,"2020-09-22","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-09-22-learning-activity",{"title":5,"description":252},"blog\u002F2020\u002F2020-09-22-learning-activity",[261],"event","TaCDhM-CFWA1Kk3c6iHZ-2PH4J4NKoZ7e9k6BMTYJAw",{"prev":264,"next":267,"related":270,"tags":283},{"title":265,"link":266},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",{"title":268,"link":269},"【學員專屬徵才 - 第五波遠端助教】無工作經驗者優先錄取","\u002Fblog\u002F2020-05-28-remote-jobs-fifth",[271,274,277,280],{"title":272,"link":273},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":275,"link":276},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":278,"link":279},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":281,"link":282},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[284,285,286,287,288,261,289,290,291,292,293],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292352]