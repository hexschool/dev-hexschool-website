[{"data":1,"prerenderedAt":399},["ShallowReactive",2],{"blog:2019-04-17-god-and-hexschool":3,"blog:neighbors:2019-04-17-god-and-hexschool":368},{"id":4,"title":5,"author":6,"body":8,"categories":355,"date":356,"description":36,"draft":357,"extension":358,"meta":359,"navigation":360,"path":361,"seo":362,"stem":363,"tags":364,"thumbnail":366,"__hash__":367},"blog\u002Fblog\u002F2019\u002F2019-04-17-god-and-hexschool.md","【大神來六角】五月直播主題：後端開發",[7],"六角學院",{"type":9,"value":10,"toc":342},"minimark",[11,18,29,34,37,40,48,51,78,81,86,90,105,122,135,139,142,151,165,172,176,179,188,199,206,210,213,222,236,243,247,253,259,273,277,282,290,294,297,301,304,308,322,326,335],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F04%2F%E5%A4%A7%E7%A5%9E-calendar-may-u.png?alt=media&token=418007f4-cc8f-4612-abb7-088353da461d",[12,19,20,21,28],{},"同學您好，六角學院固定會在前一個月，釋出下個月的直播節目表到 Google 日曆，歡迎訂閱我們的",[22,23,27],"a",{"href":24,"rel":25},"https:\u002F\u002Fwww.hexschool.com\u002Fcalendar\u002F",[26],"nofollow","行事曆","，好方便追蹤您想聽的題目。",[30,31,33],"h2",{"id":32},"本月主題後端開發","本月主題：後端開發",[12,35,36],{},"後端語言五花八門，各語言都有它的優缺點，但要你真的去選擇一門來研究，是否常常無法決定？所以本月的主題，我們邀請到四位在各後端領域都有一定水準的工程師，來為各位進行分享。",[12,38,39],{},"考量到大家沒有後端基礎，六角在與各講師討論後，也決定在主題設計上，也有適合只會 HTML、CSS 網頁排版的初學者也能吸收的內容，以方便讓您能從中選擇適合自己的後端語言。",[12,41,42,43,47],{},"在演講內容比重中，都會請每位講師分享「",[44,45,46],"strong",{},"什麼是後端，與前端是如何溝通？","」，好讓初學者了解後端與前端的關係，進而依照自己所理解的脈絡來延伸學習，藉由每位講師大神的視角來詮釋，能更加瞭解前後端的溝通關係。",[12,49,50],{},"在這門主題中，您將會獲得的知識為：",[52,53,54,61],"ul",{},[55,56,57,60],"li",{},[44,58,59],{},"什麼是後端","，與前端是如何溝通？ (適合新手，將會在演講比例佔 30~50% 時間)",[55,62,63,64],{},"各後端語言的優缺點，四週講師主題分別為\n",[52,65,66,69,72,75],{},[55,67,68],{},"Node.js",[55,70,71],{},"PHP",[55,73,74],{},".Net",[55,76,77],{},"Ruby",[30,79,80],{"id":80},"講師介紹",[82,83,85],"h3",{"id":84},"第一週-nodejs","第一週 -  Node.js",[15,87],{"src":88,"width":89,"height":89,"alt":85},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F04%2F13139376_1023708654381237_7935553683397397403_n.png?alt=media&token=3a7b944e-d808-47aa-9603-ded2ae48f885",160,[12,91,92,93,98,99,104],{},"PJChender 是一位熱愛分享 JS 知識的開發者，目前也是 ALPHA Camp 的",[22,94,97],{"href":95,"rel":96},"https:\u002F\u002Ftw.alphacamp.co\u002Fcore-module",[26],"學期三 Node.js 講師","，許多 JS 開發者都曾從他的",[22,100,103],{"href":101,"rel":102},"https:\u002F\u002Fpjchender.blogspot.com\u002F",[26],"部落格","獲得 JS 知識，六角學院在兩年前也邀請他分享前端知識，在當時也是大受好評，藉由本月題目，很高興能夠再次邀請他來分享 Node.js 後端的主題！",[52,106,107,110,119],{},[55,108,109],{},"講座時間：2019\u002F5\u002F7 (二) 19:30~21:00",[55,111,112,113,118],{},"講者姓名：PJChender (",[22,114,117],{"href":115,"rel":116},"https:\u002F\u002Fwww.facebook.com\u002Fpjchender\u002F",[26],"粉絲團",")",[55,120,121],{},"講者介紹：PJChender 是一個關注網頁前端設計、技術，學習 know how 的社群分享平台，並且以開發者友善的概念為核心，提供開發者需要的訊息和內容。",[12,123,124],{},[22,125,131],{"href":126,"className":127,"title":130},"#addBlogEvent",[128,129],"btn-radius","mp-click","我要報名",[132,133,134],"span",{}," 我要報名 ",[82,136,138],{"id":137},"第二週-php","第二週 - PHP",[15,140],{"src":141,"width":89,"height":89,"alt":138},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F04%2FWeb-design-Instructor-Taker-Wu.jpg?alt=media&token=eae7efd7-cb42-4323-8a87-f4c2e5dfffbc",[12,143,144,145,150],{},"Taker 是",[22,146,149],{"href":147,"rel":148},"https:\u002F\u002Fwww.everyonecanwebsite.com\u002F",[26],"網頁基礎 15 天","的創辦人，從最基礎的 HTML、CSS 到後端都有實務的教學經驗，教過許多無經驗的新手到成為前後端工程師，也因為如此，Taker 深深了解新手在從前端切入後端，常常會面臨到的知識觀念問題。相信藉由他豐富的教學功力，能夠讓各位聽眾理解前後端溝通細節，以及 PHP 語言的魅力之處。",[52,152,153,156,159,162],{},[55,154,155],{},"講座時間： 2019\u002F5\u002F15 (三) 19:30~21:00",[55,157,158],{},"講者姓名：Taker Wu",[55,160,161],{},"講者經歷：網頁基礎 15 天 創辦人",[55,163,164],{},"講者介紹：自行接案、擔任網頁開發公司 Senior 網頁工程師，期間開發了許多網站、手機 APP、網路服務等，後因設計師朋友想學網頁相關的技能，遂開發【網頁基礎 15 天】等相關課程，以簡單易懂、貼近實際應用的訓練著稱。",[12,166,167],{},[22,168,170],{"href":126,"className":169,"title":130},[128,129],[132,171,134],{},[82,173,175],{"id":174},"第三週-net-developer-的前後端技能介紹和概觀","第三週 - .NET Developer 的前後端技能介紹和概觀",[15,177],{"src":178,"width":89,"height":89,"alt":175},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F04%2Fimage.jpg?alt=media&token=c85c744b-646f-4881-8144-70b15ad85f37",[12,180,181,182,187],{},"Kevin 目前在澳洲擔任軟體工程師，同時也是 ",[22,183,186],{"href":184,"rel":185},"https:\u002F\u002Fhiskio.com\u002Fteachers\u002F10338",[26],"HiSKIO"," 線上課程特約講師，是少數具備實務經驗，又同時有線上課程錄製經驗的專業講師之一。在課程規劃上也是以一門銜接一門的扎實打底，好幫助新手能協接學習，藉由他的豐富經驗，好讓各位能夠一窺 .NET 殿堂。",[52,189,190,193,196],{},[55,191,192],{},"講座時間：2019\u002F5\u002F21 (二) 19:30~21:00",[55,194,195],{},"講者姓名：Kevin Lin",[55,197,198],{},"講者介紹：技術移民到澳洲的.NET Developer，對於.NET領域的相關技術與各式開發方式、多種前後端框架與工具、版控系統，皆有深入的研究。畢業於澳洲多個大學，其中2所全校第1名畢業，最高學歷為碩士。現任 HiSKIO 線上課程特約講師，以及 IT 工具人學院創辦人。以一門銜接一門的扎實打底學程，幫助許多想成為 .NET Developer 的朋友們，繞過彎路，快速學習。",[12,200,201],{},[22,202,204],{"href":126,"className":203,"title":130},[128,129],[132,205,134],{},[82,207,209],{"id":208},"第四週-ruby","第四週 - Ruby",[15,211],{"src":212,"width":89,"height":89,"alt":209},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F04%2Feddiekao.jpg?alt=media&token=48aa8b0e-5172-42dd-bba5-edbd8cee3a3a",[12,214,215,216,221],{},"高見龍是五倍紅寶石的共同創辦人，在台灣推廣 Ruby 程式語言多年，學生已累積超過 1,000 人以上，目前經營 ",[22,217,220],{"href":218,"rel":219},"https:\u002F\u002Fiamcoding.tw\u002F",[26],"I’m coding it! 微痛轉職工程師"," 線上課程，具備極為豐富的線上與線下的教學經驗，由他來替各位會眾分享 Ruby 優雅之處，實在再好不過！",[52,223,224,227,230,233],{},[55,225,226],{},"講座時間： 2019\u002F5\u002F30 (四) 19:30~21:00",[55,228,229],{},"講者姓名：高見龍",[55,231,232],{},"講者經歷：五倍紅寶石共同創辦人",[55,234,235],{},"講者介紹：雖非資訊本科系出身，但喜歡寫程式而且希望可以寫一輩子程式的電腦阿宅。喜歡辦活動，是不少台灣大型技術研討會(如 PHPConf、WebConf、RubyConf Taiwan 等)及社群活動(Rails Girls Taipei、Taipei.rb)的發起人或主辦人。喜愛與人分享，曾在許多國內、外技術研討會分享心得。四次創業經驗，雖然其中有兩次是失敗經驗但仍樂此不疲。目前為五倍紅寶石共同創辦人及負責人。",[12,237,238],{},[22,239,241],{"href":126,"className":240,"title":130},[128,129],[132,242,134],{},[244,245],"div",{"id":246},"addBlogEvent",[12,248,249],{},[15,250],{"alt":251,"src":252},"第四週 - Ruby（2）","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F03%2F%E5%A4%A7%E7%A5%9E%E4%BE%86%E5%85%AD%E8%A7%92-%E8%B3%BC%E8%B2%B7%E6%B5%81%E7%A8%8B.png?alt=media&token=e94fb1bc-7a8a-4564-911a-14675442b7ee",[12,254,255],{},[15,256],{"alt":257,"src":258},"第四週 - Ruby（3）","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F03%2F%E5%A4%A7%E7%A5%9E%E4%BE%86%E5%85%AD%E8%A7%92-compare.png?alt=media&token=68979e8e-87a4-4490-923b-e7cbfa9833bc",[244,260,262,263],{"style":261},"text-align: center;","\n  ",[22,264,269,270,269],{"href":265,"className":266,"title":268},"#",[128,129,267],"disabled","部落格購票"," ",[132,271,272],{}," 活動已到期 ",[82,274,276],{"id":275},"qa","Q&A",[278,279,281],"h4",{"id":280},"q如果來不及參加可以退費嗎","Q：如果來不及參加，可以退費嗎？",[12,283,284,285,289],{},"A：單場活動可在 ",[286,287,288],"em",{},"活動前三天申請"," 享全額退費，但就無法獲得錄影。月票活動可在前月底申請，同樣可全額退費。",[278,291,293],{"id":292},"q我常需要加班都不能參加但又想要錄影的影片的話該怎辦","Q：我常需要加班，都不能參加，但又想要錄影的影片的話該怎辦？",[12,295,296],{},"A：可以任意選單場票，就可獲得單月所有直播課程影片，如四月總計四部。",[278,298,300],{"id":299},"q真假只要買單場票就能獲得全部錄影","Q：真假，只要買單場票，就能獲得全部錄影？",[12,302,303],{},"A：你沒看錯，是真的，我們會固定在第二場結束後與月底，提供錄影連結 mail 給您。",[278,305,307],{"id":306},"q我選了其中一場的單場票但又想臨時換場次可以嗎","Q：我選了其中一場的單場票，但又想臨時換場次可以嗎？",[12,309,310,311,315,316,321],{},"A：可以，請前三天透過",[22,312,117],{"href":313,"rel":314},"https:\u002F\u002Fhex.school\u002FP12UP",[26],"或 ",[22,317,320],{"href":318,"rel":319},"https:\u002F\u002Fhex.school\u002FqgbMS",[26],"Line@"," 敲小幫手來進行更換手續",[278,323,325],{"id":324},"q買了單場票之後還想要改成月票可以嗎","Q：買了單場票，之後還想要改成月票可以嗎？",[12,327,328,329,315,332,321],{},"A：可以，請敲",[22,330,117],{"href":313,"rel":331},[26],[22,333,320],{"href":318,"rel":334},[26],[244,336,262,337],{"style":261},[22,338,269,340,269],{"href":265,"