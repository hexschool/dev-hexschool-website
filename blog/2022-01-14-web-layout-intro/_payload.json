[{"data":1,"prerenderedAt":345},["ShallowReactive",2],{"blog:2022-01-14-web-layout-intro":3,"blog:neighbors:2022-01-14-web-layout-intro":317},{"id":4,"title":5,"author":6,"body":8,"categories":305,"date":306,"description":20,"draft":307,"extension":308,"meta":309,"navigation":310,"path":311,"seo":312,"stem":313,"tags":314,"thumbnail":17,"__hash__":316},"blog\u002Fblog\u002F2022\u002F2022-01-14-web-layout-intro.md","網頁設計組合包介紹",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":288},"minimark",[11,18,21,26,39,43,57,60,76,79,83,91,95,98,126,129,132,140,143,152,155,158,172,176,181,188,193,213,217,224,228,236,240,244,247,250,264,267,272,284],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2023%2F03%2FFB1200-628.png?alt=media&token=90d29806-d299-412b-b366-5d0539f2b219",[12,19,20],{},"我們是六角學院，到了現在已經培育出許多網頁開發者並成功進入業界，「網頁設計組合」特別推薦給對於網頁開發有興趣的新人。",[22,23,25],"h2",{"id":24},"誰適合這組合","誰適合這組合？",[27,28,29,33,36],"ul",{},[30,31,32],"li",{},"還沒有開發經驗，但想試著投入的新人",[30,34,35],{},"想要轉網頁設計師的平面設計師",[30,37,38],{},"有些許經驗，但網頁基礎還不夠熟練的同學",[22,40,42],{"id":41},"這組合需要什麼設備","這組合需要什麼設備？",[44,45,49,50,49,54],"figure",{"className":46},[47,48],"post-figure","post-figure--w75","\n  ",[15,51],{"src":52,"alt":53},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2Feditor-and-broswer.png?alt=media&token=3b02771d-72fa-425a-9ee1-60c263f81b08","只要有瀏覽器與編輯器就可以了！",[55,56,53],"figcaption",{},[12,58,59],{},"六角學院主要是經營線上課程，相較於其他實體課程來說具有更多的彈性，且在上課程僅需要一台電腦即可開始上課，課程中會提供許多額外的軟體及教材，這些都是免費的，且課程中會介紹該如何運用這些免費工具提高個人的價值。",[27,61,62],{},[30,63,64,65],{},"一台電腦\n",[27,66,67,70,73],{},[30,68,69],{},"Windows 或 Mac OS 作業系統皆可",[30,71,72],{},"可以運行 Chrome 瀏覽器的電腦",[30,74,75],{},"可播放影片順暢的網路",[12,77,78],{},"本課程使用的軟體皆是免費的，講義及範例也都附在課程內，不需要額外購買。",[22,80,82],{"id":81},"這組合合適的職缺","這組合合適的職缺？",[27,84,85,88],{},[30,86,87],{},"網頁設計師",[30,89,90],{},"前端設計師",[22,92,94],{"id":93},"這組合課程如何做學習","這組合課程如何做學習？",[12,96,97],{},"組合包內包含不同的課程內容，「網頁設計組合包」包含以下課程：",[27,99,100,108,114,120],{},[30,101,102],{},[103,104,107],"a",{"href":105,"target":106},"\u002Fcourses\u002Fhtml_css","_blank","使用 HTML、CSS 開發一個網站",[30,109,110],{},[103,111,113],{"href":112,"target":106},"\u002Fcourses\u002Fjquery_ani","jQuery 打造互動性網頁動畫效果",[30,115,116],{},[103,117,119],{"href":118,"target":106},"\u002Fcourses\u002Fresponsive","一變應萬變響應式網頁設計 (RWD)",[30,121,122],{},[103,123,125],{"href":124,"target":106},"\u002Fcourses\u002Fbootstrap5","Bootstrap 5 網頁切版整合術",[12,127,128],{},"為了確保學習狀況，每個課程皆有多個章節及作業，請遵循課程內容，完成各章節作業，並且課程最後都有最終作業，完成這些最終作業將具有求職的最佳作品！",[12,130,131],{},"學習的過程中一定會遇到許多的問題，課程平台下方均有問答工具：",[27,133,134,137],{},[30,135,136],{},"我們助教都非常熱心，請盡可能地提出你的問題，助教將會盡快回覆你的問題！",[30,138,139],{},"章節或最終作業如果遇到問題，你的問題或許其他人也有遇過，可在問答區中尋找其它同學的開發過程，挑戰並完成它吧。",[12,141,142],{},"補充：六角學院具有強大的助教系統，至今已經具有超過萬筆的問答紀錄，每日都有二三十份新的問題提出，所以請別吝嗇提出你的問題～",[44,144,49,146,49,150],{"className":145},[47],[15,147],{"src":148,"alt":149},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2Fweb-many-qus-lastest.png?alt=media&token=f29c71ac-7bd5-4ef4-a91d-ae408ff598be","超過萬筆，有問必答！",[55,151,149],{},[22,153,154],{"id":154},"這組合課程可以學到什麼程度",[12,156,157],{},"本組合包含多個課程，依序可掌握以下技能：",[27,159,160,163,166,169],{},[30,161,162],{},"HTML 及 CSS 的切版能力",[30,164,165],{},"開發多頁式的網站",[30,167,168],{},"具有開發響應式網頁的能力（RWD）",[30,170,171],{},"具有活用 Bootstrap 的開發能力",[22,173,175],{"id":174},"這組合課程會有什麼成品","這組合課程會有什麼成品？",[177,178,180],"h3",{"id":179},"bootstrap-最終作業","Bootstrap 最終作業",[44,182,49,185],{"className":183},[47,184],"post-figure--w50",[15,186],{"src":187,"alt":180},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2F%E3%81%AE%E3%82%8D%E3%81%97%E9%BA%B5%E5%B1%8B_-_%E9%A6%96%E9%A0%81.png?alt=media&token=ab41fe70-dd0d-4fd4-bd44-eeeb917b64f6",[189,190,192],"h4",{"id":191},"bootstrap-學員作品","Bootstrap 學員作品：",[27,194,195,203,210],{},[30,196,197],{},[103,198,202],{"href":199,"rel":200},"https:\u002F\u002Fdearbunny.github.io\u002Fnoroshi\u002Findex.html",[201],"nofollow","麵屋",[30,204,205],{},[103,206,209],{"href":207,"rel":208},"https:\u002F\u002Fgretema.github.io\u002FShimazuV2\u002F#\u002F",[201],"島津燒肉",[30,211,212],{},"來點多肉吧",[177,214,216],{"id":215},"rwd-最終作業","RWD 最終作業",[44,218,49,220],{"className":219},[47,184],[15,221],{"src":222,"alt":223},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2Fhex-restaurant.png?alt=media&token=ec6ae034-f65a-479f-aaf9-b643b155ccc4","RWD Homework",[22,225,227],{"id":226},"接下來還可以投入哪個方向","接下來還可以投入哪個方向？",[27,229,230,233],{},[30,231,232],{},"學習 JavaScript 成為專業的前端工程師",[30,234,235],{},"學習 UI ，培養美感設計出具有價值的網頁",[22,237,239],{"id":238},"報名這組合課程包含哪些服務","報名這組合課程，包含哪些服務？",[15,241],{"src":242,"alt":243},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-courses.appspot.com\u002Fo\u002Fhex-website%2Fblog%2F1718158333143-compare.png?alt=media&token=b87be11a-7ce4-44b4-96a9-a5e10dc2136f","實體課程、其他線上課程與六角學院比較表：無限次觀看的教學內容、更新也無需另外付費、完善的助教與講師回覆系統、不定期線上研討會、輔導就業，六角學院五項皆勝",[12,245,246],{},"大多線上課程僅有提供教學影音，並無提供完善的助教、講師回覆系統，因此在學習上有任何問題都無從發問，甚至發問後一個月才收到講師簡短的回覆，來回的過程中將浪費許多寶貴時間，且無法真正的掌握技能。",[12,248,249],{},"六角學院除了提供影音課程外，完善的學習輔助系統，確保你的每一分投入都發揮最大的效益！",[27,251,252,255,258,261],{},[30,253,254],{},"影音課程保證觀看期限一年：六角每多營運一年，你就獲得多一年的觀看期，課程更新也無需另外付費",[30,256,257],{},"完善的助教、講師回覆系統，確保學習狀況",[30,259,260],{},"不定期免費參加線上研討會 - 大神來六角、線上問答",[30,262,263],{},"完成所有最終作業可免費職缺推薦",[22,265,266],{"id":266},"上過此組合的回饋",[268,269],"blog-testimonial-carousel",{":items":270,"label":271},"[{\"name\":\"張絨美\",\"text\":\"觀念講解非常細緻清楚，循序漸進幫助學員快速上手，課程中藉由不斷提醒加深印象，並利用練習不同例子來熟悉如何使用Bootstrap所提供之相關元件與核心概念。\"},{\"name\":\"凱澤\",\"text\":\"老師介紹的內容非常詳細，也會有讓人想一直聽下去的感覺，可能出現的問題也會事先說明清楚\"},{\"name\":\"Chi-Tung\",\"text\":\"教法淺顯易懂、有圖形說明、直接教業界實用的觀念、十分有用\"},{\"name\":\"Stephen\",\"text\":\"很高興上了這門課, 這門課開啟了我的眼界, 以前每次看到渲染一個組件要寫落落長的 CSS  代碼就讓我心生畏懼, 甚至卻步. 現在學習了 Bootstrap 後頓時覺得海闊天空, 現在可以很輕鬆的製作出 UI, 覺得非常高興. 講師教學巡序漸進, 解講清楚又詳細, 都會提示重點和應注意事項, 讓學習變得事半功倍. 這門課是唯一專門教授 Bootstrap 的中文線上課程, 同時也可以當作資訊科系學習網頁 UI 的教學資料. 學會了使用 Bootstrap, 接觸其他的 UI 框架就不會感到陌生, 因為使用方式和工作原理是一樣的. 除了加速網頁的開發, 可以將更多時間用在後端功能的開發上. 真的很讚. 這門課我給 10 顆星 !!!\"},{\"name\":\"董翠峰\",\"text\":\"教學詳細，講師有條理邏輯清晰！學到很多之前不知道的技巧。\"},{\"name\":\"Momo\",\"text\":\"簡單易懂，每個章節都不會一口氣塞太多東西，方便小部分學習理解完畢後再學習新的章節\"},{\"name\":\"薛德豪\",\"text\":\"王志誠老師講課觀念清晰，而且重點處都會特地標示，或著補充說明，我覺得這對於吸收課程很有幫助。\"},{\"name\":\"志鈞\",\"text\":\"循序漸進, 很棒!\"}]","學員回饋",[273,274],"blog-bundle-price-card",{":courses":275,":installmentNote":276,":originPrice":277,":pay":278,":price":279,"description":280,"heading":281,"worksHref":282,"worksImage":283},"[{\"name\":\"使用 HTML、CSS 開發一個網站\",\"href\":\"\u002Fcourses\u002Fhtml_css\"},{\"name\":\"jQuery 網頁互動效果\",\"href\":\"\u002Fcourses\u002Fjquery_ani\"},{\"name\":\"RWD 響應式網頁設計\",\"href\":\"\u002Fcourses\u002Fresponsive\"},{\"name\":\"Bootstrap 5 網頁切版整合術\",\"href\":\"\u002Fcourses\u002Fbootstrap5\"}]","[\"課程享信用卡、銀角零卡 6 期零利率\",\"無卡可分 12 期，每月最低只需 $588\"]","8600","{\"path\":\"\u002Fcarts?order=1772518378200_58k00rul0&sales_channel_code=official\",\"coupon\":\"COUPON_HEX_ORIGIN_PRICE\",\"productId\":\"z_bs4_html_jquery_rwd\",\"productName\":\"網頁設計組合 (HTML + jQuery + RWD + BS5)\"}","6880","新手設計包，帶你學會網頁排版，讓你上架網頁在伺服器上。","我想學網頁設計","https:\u002F\u002Fwcc723.github.io\u002FF2E-PK\u002F","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fversion_2019%2Fimg-bundle-web.jpg?alt=media&token=4fb47030-ef51-4179-a314-04d4e00c5562",[285,286,287],"style",{},"\n.post-figure {\n  margin: 16px 0;\n}\n\n.post-figure--w75 {\n  width: 75%;\n}\n\n.post-figure--w50 {\n  width: 50%;\n}\n\n.post-figure img {\n  box-shadow: 5px 5px 10px lightgray;\n}\n",{"title":289,"searchDepth":290,"depth":290,"links":291},"",2,[292,293,294,295,296,297,302,303,304],{"id":24,"depth":290,"text":25},{"id":41,"depth":290,"text":42},{"id":81,"depth":290,"text":82},{"id":93,"depth":290,"text":94},{"id":154,"depth":290,"text":154},{"id":174,"depth":290,"text":175,"children":298},[299,301],{"id":179,"depth":300,"text":180},3,{"id":215,"depth":300,"text":216},{"id":226,"depth":290,"text":227},{"id":238,"depth":290,"text":239},{"id":266,"depth":290,"text":266},null,"2022-01-14",false,"md",{},true,"\u002Fblog\u002F2022\u002F2022-01-14-web-layout-intro",{"title":5,"description":20},"blog\u002F2022\u002F2022-01-14-web-layout-intro",[315],"course","4__7h0cycn2uC4Wr62Cn40f3FiClYVc3decrpikEal8",{"prev":318,"next":321,"related":324,"tags":334},{"title":319,"link":320},"JavaScript 組合包介紹","\u002Fblog\u002F2022-01-14-js-course-intro",{"title":322,"link":323},"想要轉職前端工程師？業務背景也能轉職成前端工程師！","\u002Fblog\u002F2022-01-05-sales-to-frontend",[325,328,331,332],{"title":326,"link":327},"JavaScript 程式解題組合包","\u002Fblog\u002F2022-04-15-js-solving-combined",{"title":329,"link":330},"【4月開班】Node.js 後端工程師養成直播班","\u002Fblog\u002F2022-02-17-node-training-intro",{"title":319,"link":320},{"title":319,"link":333},"\u002Fblog\u002F2020-04-15-js-course-intro",[335,315,336,337,338,339,340,341,342,343,344],"UI design","css","css3","enterprise","event","interview","javascript","jobs","skilltree","software engineer",1791348121903]