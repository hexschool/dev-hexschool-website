[{"data":1,"prerenderedAt":98},["ShallowReactive",2],{"blog:archive:event:4":3},{"posts":4,"total":86,"tags":87,"tag":13},[5,14,22,30,38,46,54,62,70,78],{"title":6,"link":7,"date":8,"dateTime":9,"description":10,"thumbnail":11,"tags":12},"【大神來六角】四月直播主題：計算機網路！","\u002Fblog\u002F2019-03-07-interview","2019\u002F03\u002F07","2019-03-07","在前端工程師在處理後端 API 串接時，當發生各種異常狀況，會不曉得該如何抽絲剝繭查出問題所在，本月主題希望藉此來介紹，「發出網路請求時，網路底層過程中會發生哪些事？」，以下直播將會帶你\u002F妳學會以下內容。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F03%2F%E5%A4%A7%E7%A5%9E%E4%BE%86%E5%85%AD%E8%A7%92-%E4%B8%BB%E9%A1%8C.png?alt=media&token=3d0ec578-4118-4b65-9bd4-42b8198da79a",[13],"event",{"title":15,"link":16,"date":17,"dateTime":18,"description":19,"thumbnail":20,"tags":21},"【Adobe XD-Plugins】超快一鍵匯入真實資料","\u002Fblog\u002F2018-10-31-adobe-plugins","2018\u002F10\u002F31","2018-10-31","Adobe XD 最近更新加入了 Plugins 功能（插件），開發者們也摩拳擦掌的加入各種好用功能，讓設計師們可以輕鬆活用這些 Plugins。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F10%2Fxd-plugin-cover_GoogleSheets.png?alt=media&token=72bb302b-89eb-47ba-8a7b-17cbc64c238b",[13],{"title":23,"link":24,"date":25,"dateTime":26,"description":27,"thumbnail":28,"tags":29},"【挑戰活動】網頁切版 PK 戰","\u002Fblog\u002F2018-09-13-hexschool-challenge","2018\u002F09\u002F13","2018-09-13","網頁切版，是身為網頁設計師、前端工程師第一步會學到的基本功，但學到一身切版功夫，卻苦無找不到對手，豈不就太過孤獨？這次六角學院將派出五位精銳，向各位切磋切磋！ (拱手行禮","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F09%2Fpk-character_og-image.png?alt=media&token=bf3fb8f8-f52c-4053-bfe0-39c7018dbee6",[13],{"title":31,"link":32,"date":33,"dateTime":34,"description":35,"thumbnail":36,"tags":37},"如何參加線上問答會","\u002Fblog\u002F2018-08-07-how-to-join-zoom","2018\u002F08\u002F07","2018-08-07","六角學院線上問答會是額外的服務，凡購買主要課程者都可以免費參加。線上問答會期間，講師會透過直播的方式與大家介紹特定主題，除此之外，學員也可以即時的詢問老師相關問題，至今已經超過 120 場線上問答會囉。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F08%2F%E5%A6%82%E4%BD%95%E5%8F%83%E5%8A%A0%E7%B7%9A%E4%B8%8A%E5%95%8F%E7%AD%94%E6%9C%83_0807.png?alt=media&token=81607ce9-1630-40af-a15b-9918b4edce23",[13],{"title":39,"link":40,"date":41,"dateTime":42,"description":43,"thumbnail":44,"tags":45},"線上講座 - 簡報力就是你的說服力","\u002Fblog\u002F2018-04-11-keynote-king","2018\u002F04\u002F11","2018-04-11","工作、面試、報告中絕對免不了簡報，好的簡報不僅賞心悅目、提高內容的說服力，並且還能時時提醒自己接下來要介紹的內容，絕對是會議中的一等一神器。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F01%2Fkeynote_cover.png?alt=media&token=bd37bf3b-dc9f-4ec5-8f01-31e01cfc743f",[13],{"title":47,"link":48,"date":49,"dateTime":50,"description":51,"thumbnail":52,"tags":53},"線上講座 - Node.js 的各種運用","\u002Fblog\u002F2018-01-16-jan-node","2018\u002F01\u002F16","2018-01-16","Node.js 課程中老師介紹了許多基礎的概念，但其實 Node.js 可以運用的層面非常的廣，光只靠老師的一堂課無法涵蓋所有的內容，因此我們從各地尋找優秀的講者，讓同學接觸更多不同的 Node.js 應用概念。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F01%2Fjan_cover.png?alt=media&token=d3bc0edf-1044-434f-962a-92f9a0c71a88",[13],{"title":55,"link":56,"date":57,"dateTime":58,"description":59,"thumbnail":60,"tags":61},"賣場服務生躍進前端工程師，「學習運用現有資源，解決當前問題！」 -- Joseph","\u002Fblog\u002F2017-12-19-interview","2017\u002F12\u002F19","2017-12-19","Joseph 政治系，未來將走上與本科系相關的工作，在所學領域發光發熱；然而出現了些問題，打亂他的人生規劃，過往工作經歷皆是各式賣場服務業。這讓他決定停下來思考，未來該如何規劃？","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2017%2F12%2Finterview_Joseph.jpg?alt=media&token=514f85f4-5e49-4982-840b-eb9c601e7676",[13],{"title":63,"link":64,"date":65,"dateTime":66,"description":67,"thumbnail":68,"tags":69},"【獎品贈送】參加 ITHome 鐵人賽即贈送實體商品","\u002Fblog\u002F2017-11-30-hexschool-and-ironman","2017\u002F11\u002F30","2017-11-30","ITHome 鐵人賽又開始囉，和老師一起參加鐵人賽，完賽者即贈送六角專屬紀念品～","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fcasper-de5d5.appspot.com\u002Fo\u002Fimages%2Fblog%2Fironman.png?alt=media&token=84ea9c98-3c70-48b8-90b8-c97273dac570",[13],{"title":71,"link":72,"date":73,"dateTime":74,"description":75,"thumbnail":76,"tags":77},"【直播預告】 Bootstrap 4 超狂額外講座，讓你收穫滿滿一整月","\u002Fblog\u002F2017-09-27-sep-bs","2017\u002F09\u002F27","2017-09-27","Bootstrap 4 額外線上問答，強化同學的 Flex、元件運用、切版要領、Sass 編譯技巧，一同參與百人的線上講座吧！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2017%2F09%2Fbs4_onlinetalk.png?alt=media&token=80945c5f-d838-4e28-aef9-071e0f9926b4",[13],{"title":79,"link":80,"date":81,"dateTime":82,"description":83,"thumbnail":84,"tags":85},"Bootstrap 4 繁體中文手冊","\u002Fblog\u002F2017-08-13-bootstrap4-zh-tw","2017\u002F08\u002F13","2017-08-13","Bootstrap 是目前最主流的 CSS 框架，由於他包含了大量的元件以及具有良好的架構，在實際運用及擴增也都是非常容易，如今第四版 Beta (Bootstrap 4 Beta) 也釋出，我們先來看看他有什麼樣的改變吧！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2017%2F08%2Fbootstrap4.png?alt=media&token=0b014ac6-b99b-46e7-8336-3fbfda1da3c2",[13],44,[88,89,90,91,92,13,93,94,95,96,97],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292347]