[{"data":1,"prerenderedAt":98},["ShallowReactive",2],{"blog:archive:event:3":3},{"posts":4,"total":86,"tags":87,"tag":13},[5,14,22,30,38,46,54,62,70,78],{"title":6,"link":7,"date":8,"dateTime":9,"description":10,"thumbnail":11,"tags":12},"【振學活動】 - 繳作業抽商品卡","\u002Fblog\u002F2020-09-22-learning-activity","2020\u002F09\u002F22","2020-09-22","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F09%2F%E6%8C%AF%E5%AD%B8%E6%B4%BB%E5%8B%95%E6%96%87%E7%AB%A0%E5%B0%81%E9%9D%A2%E5%9C%96.png?alt=media&token=e822b084-b5d8-443c-854c-2f5247ebd687",[13],"event",{"title":15,"link":16,"date":17,"dateTime":18,"description":19,"thumbnail":20,"tags":21},"21 天英打鍛鍊武道大會","\u002Fblog\u002F2020-03-24-21days-keybr-game","2020\u002F03\u002F24","2020-03-24","你常因為技術單字拼錯，害你 Debug 了一個下午嗎？你開始學程式，才進而接觸英打嗎？那就來參加 21 天英打武道大會！藉由天天鍛鍊、天天堅持，讓自己成為英打神人！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F03%2F21days.png?alt=media&token=0d60500b-1c6f-4dca-8d20-e9d1dc01b90a",[13],{"title":23,"link":24,"date":25,"dateTime":26,"description":27,"thumbnail":28,"tags":29},"2019 年前端工程師薪資調查","\u002Fblog\u002F2020-01-03-2019-frontend-salary","2020\u002F01\u002F03","2020-01-03","大家好，我們是六角學院，至今已創校近四年，主要以線上程式影音課程，協助學員求職，成為前端工程師、網頁設計師。相信您也會想了解現今工程師的薪資發展是否具有前景，此篇我們就分享數據給各位參考。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F01%2F20191203_%E6%84%9F%E8%AC%9D%E7%A5%AD.001.png?alt=media&token=de6b720d-5468-4114-8d56-2d7eb13bccb7",[13],{"title":31,"link":32,"date":33,"dateTime":34,"description":35,"thumbnail":36,"tags":37},"w3HexSchool 鼠年全馬鐵人挑戰","\u002Fblog\u002F2019-11-14-w3hexschool-2020-challenge","2019\u002F11\u002F14","2019-11-14","這是由六角學院所推出的 w3HexSchool 活動，活動期限為一年，也就是 53 週，有如全馬挑戰一般，是屬於常態且長期性寫文活動，透過此活動進而推動自我成長及創造品牌形象！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F11%2Fw3HS%E9%90%B5%E4%BA%BA%E8%B3%BDbanner.png?alt=media&token=3f0ef8fd-6285-47ac-a159-83ff3fb3972e",[13],{"title":39,"link":40,"date":41,"dateTime":42,"description":43,"thumbnail":44,"tags":45},"【大神來六角】十月直播主題：遠端接案","\u002Fblog\u002F2019-09-24-god-and-hexschool","2019\u002F09\u002F24","2019-09-24","遠端工作是這年來相當夯的題目之一，可以不進公司上班，也是許多人的夢想，尤其是工程師只要有電腦跟網路，到哪裡都可以工作。但是到底該如何踏出下一步呢？可能留在自己家鄉，遠端國內外的正職工作嗎？假使要遠端接案，該注意哪些細節呢？","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F09%2F%E5%A4%A7%E7%A5%9E-topic-oct.png?alt=media&token=bfaa0f5a-a924-499a-9190-5165cdaa7be9",[13],{"title":47,"link":48,"date":49,"dateTime":50,"description":51,"thumbnail":52,"tags":53},"【大神來六角】九月直播主題：程式編輯器","\u002Fblog\u002F2019-08-22-god-and-hexschoo","2019\u002F08\u002F22","2019-08-22","正所謂工欲善其事，必先利其器，雖然您懂得許多前端語法，但如果沒有好的工具輔助，效率自然無法再往上提升。本月主題將分享各種 Edit 編輯器上的套件與設定介紹。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F08%2F%E5%A4%A7%E7%A5%9E-topic-sep.png?alt=media&token=2554a323-b3cd-41b1-a7fc-52970e5fd744",[13],{"title":55,"link":56,"date":57,"dateTime":58,"description":59,"thumbnail":60,"tags":61},"2019 IT 鐵人邦有獎徵文活動","\u002Fblog\u002F2019-08-20-ithelp-2020ironman","2019\u002F08\u002F20","2019-08-20","學歷輸別人，經歷也完敗，如何履歷海中殺出一條血路？工作一段時間，但總是覺得成長幅度有限？那就來寫技術文，提升個人品牌辨識度，讓自己再升級！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F08%2Fithelp-2020Ironman.png?alt=media&token=4fd488a7-6a99-48dd-a6b8-7f950e7475a7",[13],{"title":63,"link":64,"date":65,"dateTime":66,"description":67,"thumbnail":68,"tags":69},"【大神來六角】七月直播主題：資料庫","\u002Fblog\u002F2019-06-21-god-and-hexschool","2019\u002F06\u002F21","2019-06-21","你有想過一個大型購物網站，裡面的會員、產品、訂單資訊都被存放到哪裡了呢？你可能大概知道資訊都被存放在資料庫，但資料庫種類五花八門，多到讓您眼花撩亂，到底該如何有系統性地了解資料庫呢？","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F06%2F%E5%A4%A7%E7%A5%9E-topic-july.png?alt=media&token=26730eec-f598-4d92-92c0-7aa6c2669721",[13],{"title":71,"link":72,"date":73,"dateTime":74,"description":75,"thumbnail":76,"tags":77},"【大神來六角】六月直播主題：檔案傳輸","\u002Fblog\u002F2019-05-22-god-and-hexschool","2019\u002F05\u002F22","2019-05-22","身為軟體工程師，最常打交道就是「檔案」，舉凡是圖片、壓縮檔、office 文件都是能透過網際網路進行傳輸，其代表性的雲服務為 AWS S3 、Google Cloud Storage、Firebase Storage，本月直播的主題將會對檔案進行深入探討。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F05%2F%E5%A4%A7%E7%A5%9E-topic-june.png?alt=media&token=f7b42442-6f42-4e10-920c-4896fe2fb455",[13],{"title":79,"link":80,"date":81,"dateTime":82,"description":83,"thumbnail":84,"tags":85},"【大神來六角】五月直播主題：後端開發","\u002Fblog\u002F2019-04-17-god-and-hexschool","2019\u002F04\u002F17","2019-04-17","後端語言五花八門，各語言都有它的優缺點，但要你真的去選擇一門來研究，是否常常無法決定？所以本月的主題，我們邀請到四位在各後端領域都有一定水準的工程師，來為各位進行分享。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F04%2F%E5%A4%A7%E7%A5%9E-topic-may.png?alt=media&token=57390c12-1a08-44d3-9eaa-4b9784d4b382",[13],44,[88,89,90,91,92,13,93,94,95,96,97],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064291506]