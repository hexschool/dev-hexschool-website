[{"data":1,"prerenderedAt":98},["ShallowReactive",2],{"blog:archive:event:1":3},{"posts":4,"total":86,"tags":87,"tag":13},[5,14,22,30,38,46,54,62,70,78],{"title":6,"link":7,"date":8,"dateTime":9,"description":10,"thumbnail":11,"tags":12},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks","2022\u002F12\u002F16","2022-12-16","讀者您好，我是六角學院校長洧杰，感謝各位支持，我們才能穩健走到第七年！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F12%2Fthanks%2Fblog-banner.png?alt=media&token=be0a09e1-8608-4f93-b015-099530255699",[13],"event",{"title":15,"link":16,"date":17,"dateTime":18,"description":19,"thumbnail":20,"tags":21},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022","2022\u002F09\u002F08","2022-09-08","嗨！各位前端、UI 設計好手們，歡迎你參加 The F2E 第四屆 前端 & UI 修煉精神時光屋！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F09%2F08%2Fthe_t2f_og.png?alt=media&token=3cb815d0-6da6-4fc4-81dc-d93d5c8667e2",[13],{"title":23,"link":24,"date":25,"dateTime":26,"description":27,"thumbnail":28,"tags":29},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation","2022\u002F09\u002F02","2022-09-02","六角學院是一所線上程式開發學習單位，目前已累積超過 30,000 名學員，鼓勵學員透過線上學習，擁有更好的職涯發展機會。除了一般影音課程，六角學院定期每季培訓班都會釋出結業人才，且人才涵蓋北中南部，如果您有交流需求歡迎參考本篇文章","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F10%2F1024-02.png?alt=media&token=5ce3b31e-b807-4277-8245-9f733dc15ffa",[13],{"title":31,"link":32,"date":33,"dateTime":34,"description":35,"thumbnail":36,"tags":37},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback","2022\u002F08\u002F29","2022-08-29","六角學院首次與 ShopBack 合作加碼大優惠，除了全館課程 75 折，更另外再加碼 6% 現金回饋，要趁著開學季回饋給同學們（大期待～太幸福了😍","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F08%2F23%2Funknown.png?alt=media&token=f62ff257-0cc3-45db-9a98-247e0ba50e5e",[13],{"title":39,"link":40,"date":41,"dateTime":42,"description":43,"thumbnail":44,"tags":45},"2022 鐵人賽","\u002Fblog\u002F2022-08-08-ithome-2022ironman","2022\u002F08\u002F08","2022-08-08","不是只有想當作家才寫文章！六角學院誠摯邀請各位前端工程師一起加入 iThome 鐵人賽！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F08%2F04%2F%25E9%2590%25B5%25E4%25BA%25BA%25E8%25B3%25BD_(1).jpg?alt=media&token=4a677a77-75a9-419f-96d8-8156a4a31f60",[13],{"title":47,"link":48,"date":49,"dateTime":50,"description":51,"thumbnail":52,"tags":53},"React 新手讀書會","\u002Fblog\u002F2022-06-27-react-study-circle","2022\u002F06\u002F27","2022-06-27","現在前端所需技能越來越深，而三大框架雖然資源豐富，但對於新手來說卻也不知道如何入門，因此我們舉辦「React 新手讀書會」，讓更多的前端同好可以認識這門框架～","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F06%2Freact%2FReact_0523.png?alt=media&token=2c21dc70-a5a5-4823-84f2-8a14f2d0bd93",[13],{"title":55,"link":56,"date":57,"dateTime":58,"description":59,"thumbnail":60,"tags":61},"【公益程式體驗營】擺脫動亂學前端， 掌握技能保平安","\u002Fblog\u002F2022-03-18-global-welfare","2022\u002F03\u002F18","2022-03-18","2022 年台灣仍飽受疫情影響，再加上國際動亂，許多家庭的生計因此大受影響，為此我們決定釋出學習資源，舉辦 【公益程式體驗營】 擺脫動亂學前端， 掌握技能保平安，讓大家藉由 30 天程式體驗營的特訓，探索自己是否適合成為工程師。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F03%2F18%2Fog.jpeg?alt=media&token=8e97d6d6-898c-46bc-a2d0-8e879599ae1e",[13],{"title":63,"link":64,"date":65,"dateTime":66,"description":67,"thumbnail":68,"tags":69},"六角 Discord 討論王","\u002Fblog\u002F2022-02-22-hex-discord-king","2022\u002F02\u002F22","2022-02-22","在 Discord 的討論頻道中，同學可以針對課程中的任何資源及知識進行討論，甚至也會不藏私地把自己的心得筆記分享給大家，在六角 Discord 頻道中，你可以透過「發言」的方式提升等級，每當升級時系統會給予提示，並給予額外的獎勵稱號。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F02%2F22%2FUntitled.png?alt=media&token=f18d1462-348b-44cd-8d74-bc3c631ff640",[13],{"title":71,"link":72,"date":73,"dateTime":74,"description":75,"thumbnail":76,"tags":77},"註冊六角課程，到底包含了哪些福利","\u002Fblog\u002F2021-12-21-hex-service","2021\u002F12\u002F21","2021-12-21","六角經營至今已經有上萬人加入，隨著時間前進我們也不斷地加入新的內容，這篇來重新介紹六角的課程到底有哪些額外的延伸內容吧！","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fversion_2019%2F2023%2Flanding-2023-list.png?alt=media&token=aad511ea-50b9-4074-a5b8-5e4dd1f4a016",[13],{"title":79,"link":80,"date":81,"dateTime":82,"description":83,"thumbnail":84,"tags":85},"免費 25 小時前端教學資源","\u002Fblog\u002F2021-12-16-free-25","2021\u002F12\u002F16","2021-12-16","這篇文章我們規劃了適合「前端工程師」的學習地圖，讓新進的學生了解如何選擇課程，內容將一一介紹主要課程包含哪些內容囉。","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F12%2F12%2Ffree-25%2F%E5%85%8D%E8%B2%BB%E8%A9%A6%E8%81%BD-01.png?alt=media&token=b11f69bf-95af-4624-ab28-6904131c1165",[13],44,[88,89,90,91,92,13,93,94,95,96,97],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064291113]