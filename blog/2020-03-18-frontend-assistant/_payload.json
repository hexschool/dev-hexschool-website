[{"data":1,"prerenderedAt":212},["ShallowReactive",2],{"blog:2020-03-18-frontend-assistant":3,"blog:neighbors:2020-03-18-frontend-assistant":181},{"id":4,"title":5,"author":6,"body":8,"categories":168,"date":169,"description":170,"draft":171,"extension":172,"meta":173,"navigation":174,"path":175,"seo":176,"stem":177,"tags":178,"thumbnail":17,"__hash__":180},"blog\u002Fblog\u002F2020\u002F2020-03-18-frontend-assistant.md","【徵才】前端學期助教",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":157},"minimark",[11,18,21,24,29,46,50,59,63,95,99,107,111,122,126,137,141],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F03%2Fhex-hire-%E5%AD%B8%E6%9C%9F%E5%8A%A9%E6%95%99.png?alt=media&token=98cc09c6-217f-45ca-a6a2-a43ba3d1f2e0",[12,19,20],{},"有許多學員有經濟上的壓力，不便投入全部的時間進行轉職，或者希望在工作的過程中，亦可同時掌握未來所需的必要能力；因此，我們推出「學期助教」讓你可以在學習及工作中取得平衡。",[12,22,23],{},"本工作會提供課程所需的技能訓練，待能力掌握以後透過回覆學員問題來精進能力。",[25,26,28],"h2",{"id":27},"這份工作的優點","【這份工作的優點】",[30,31,32,40],"ul",{},[33,34,35,39],"li",{},[36,37,38],"strong",{},"知識再吸收","：藉由教學講解，能夠有效幫助自己的知識能夠重新收納整理，讓觀念更加穩固",[33,41,42,45],{},[36,43,44],{},"信心建立","：讓您藉由知識傳承，讓自己技術能夠再往上一個層次，並有足夠的信心挑戰更好的工作機會。",[25,47,49],{"id":48},"工作內容","【工作內容】",[51,52,53,56],"ol",{},[33,54,55],{},"學習課程內容",[33,57,58],{},"協助課程問題回覆",[25,60,62],{"id":61},"工作流程","【工作流程】",[30,64,65,71,77,83,89],{},[33,66,67,70],{},[36,68,69],{},"前期教育訓練","：將會提供教育訓練影片，不論在回覆口吻、書寫習慣、聚焦問題上，六角皆有一套 SOP ，以幫助助教快速了解其流程。",[33,72,73,76],{},[36,74,75],{},"模擬演練","：學期助教在初期都會配置一位助教長協助，問題在發出前都必須獲得助教長審核過後，才可代表六角助教回覆。藉由此機制，幫助學員能夠在此工作上能逐漸掌握訣竅。",[33,78,79,82],{},[36,80,81],{},"獨當一面","：我們會有不定期的審核機制，若審核成功，就可獨立運作來回覆學員問題。",[33,84,85,88],{},[36,86,87],{},"知識傳承","：當您對工作業務駕輕就熟後，也將成為未來新人的教練，以進行教育傳承。",[33,90,91,94],{},[36,92,93],{},"協助就業","：待學期結束後，我們將依據學習助教的意願輔導求職，並協助推薦至合適的廠商。",[25,96,98],{"id":97},"條件","【條件】",[51,100,101,104],{},[33,102,103],{},"必須有耐心、細心",[33,105,106],{},"六角學員優先",[25,108,110],{"id":109},"薪資與福利","【薪資與福利】",[30,112,113,116,119],{},[33,114,115],{},"基本薪資",[33,117,118],{},"享勞健保",[33,120,121],{},"六角開的課程皆能免費參加",[25,123,125],{"id":124},"工作地點時間","【工作地點\u002F時間】",[30,127,128,131,134],{},[33,129,130],{},"地點：高雄鹽埕區",[33,132,133],{},"時間：一週五天",[33,135,136],{},"預期一期為半年，期滿將協助轉職",[25,138,140],{"id":139},"投遞履歷管道","【投遞履歷管道】",[51,142,143,151,154],{},[33,144,145,146],{},"郵件地址：請 mail 到 ",[147,148,150],"a",{"href":149},"mailto:service@hexschool.com","service@hexschool.com",[33,152,153],{},"郵件標題：【應徵】學期助教_姓名",[33,155,156],{},"履歷版本：請提供 PDF 或線上履歷並說明目前的學習狀態",{"title":158,"searchDepth":159,"depth":159,"links":160},"",2,[161,162,163,164,165,166,167],{"id":27,"depth":159,"text":28},{"id":48,"depth":159,"text":49},{"id":61,"depth":159,"text":62},{"id":97,"depth":159,"text":98},{"id":109,"depth":159,"text":110},{"id":124,"depth":159,"text":125},{"id":139,"depth":159,"text":140},null,"2020-03-18","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，讓更多人藉由線上學習在職涯規劃上有更多的選擇是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-03-18-frontend-assistant",{"title":5,"description":170},"blog\u002F2020\u002F2020-03-18-frontend-assistant",[179],"jobs","Ltl9l0m6u1M-Q8uu-RgilLIqzde7EY4lC5NvnbT8Bbg",{"prev":182,"next":185,"related":188,"tags":201},{"title":183,"link":184},"21 天英打鍛鍊武道大會","\u002Fblog\u002F2020-03-24-21days-keybr-game",{"title":186,"link":187},"【學員專屬徵才 - 第四波遠端助教】無工作經驗者優先錄取","\u002Fblog\u002F2020-02-03-remote-jobs-fourth",[189,192,195,198],{"title":190,"link":191},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":193,"link":194},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":196,"link":197},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":199,"link":200},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[202,203,204,205,206,207,208,209,179,210,211],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064292159]