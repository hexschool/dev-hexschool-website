[{"data":1,"prerenderedAt":262},["ShallowReactive",2],{"blog:2019-11-14-w3hexschool-2020-challenge":3,"blog:neighbors:2019-11-14-w3hexschool-2020-challenge":231},{"id":4,"title":5,"author":6,"body":8,"categories":218,"date":219,"description":220,"draft":221,"extension":222,"meta":223,"navigation":224,"path":225,"seo":226,"stem":227,"tags":228,"thumbnail":17,"__hash__":230},"blog\u002Fblog\u002F2019\u002F2019-11-14-w3Hexschool-2020-challenge.md","w3HexSchool 鼠年全馬鐵人挑戰",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":204},"minimark",[11,18,22,35,39,42,45,52,55,58,75,78,81,92,95,100,103,108,111,114,118,148,151,168,171],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F11%2Fw3HS%E9%90%B5%E4%BA%BA%E8%B3%BDbanner.png?alt=media&token=3f0ef8fd-6285-47ac-a159-83ff3fb3972e",[19,20,21],"h2",{"id":21},"活動宗旨",[23,24,25,29,32],"ul",{},[26,27,28],"li",{},"寫出技術力",[26,30,31],{},"寫出成長紀錄",[26,33,34],{},"寫出品牌形象",[19,36,38],{"id":37},"為什麼會有這個活動","為什麼會有這個活動？",[12,40,41],{},"全馬這兩個字最常聽到是在馬拉松比賽上，全馬馬拉松最大特點就是在挑戰身體代謝的極限點而 w3HexSchool 也是一樣，挑戰著各位撰寫技術力的腦力代謝極限點，通過這個持續寫文的力量，您可以養成持續寫文的好習慣以及建立品牌形象進而大幅度成長。",[19,43,44],{"id":44},"活動說明",[12,46,47,51],{},[48,49,50],"strong",{},"本活動將長達到 2020 年底的寫文挑戰賽，參賽期間需每週撰寫 1 篇文章","，開賽期間可自行調整寫文頻率 (ex: 第一週有寫文，第二週沒有寫文，第三週再寫文以此類推)。",[19,53,54],{"id":54},"寫文範圍",[12,56,57],{},"此外本次活動可選擇以下分類：",[23,59,60,65],{},[26,61,62],{},[48,63,64],{},"技能研究",[26,66,67,70],{},[48,68,69],{},"心情抒發(文章數不可超過 20%)",[23,71,72],{},[26,73,74],{},"寫文章除了技術外，也可分享個人非學習類型的生活敘事，或統整自己的學習脈絡。",[12,76,77],{},"Q：技術研究的類別，除了 IT 技術外，也能包含其他技能嗎？\nA：可以，除了 IT 外，您也能寫其他技能，例如英文、簡報、重機駕照等等。畢竟每個人在各階段想學的領域都不一樣。",[19,79,80],{"id":80},"如何參賽",[12,82,83,84,91],{},"填寫該 ",[85,86,90],"a",{"href":87,"rel":88},"https:\u002F\u002Fforms.gle\u002F7xqJNytfunk6zReK6",[89],"nofollow","Google 表單"," 即可完成報名。",[19,93,94],{"id":94},"報名期限",[23,96,97],{},[26,98,99],{},"108\u002F11\u002F12 ~ 109\u002F06\u002F30 。",[19,101,102],{"id":102},"開賽時間",[23,104,105],{},[26,106,107],{},"開賽時間為 109\u002F02\u002F03。",[19,109,110],{"id":110},"獎項說明",[12,112,113],{},"完賽者將會提供實體獎盃。",[15,115],{"src":116,"alt":110,"width":117},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F11%2F%E7%8D%8E%E7%9B%83w3HS.png?alt=media&token=0ed4b5a5-6d5c-46eb-90c7-efcb7e41fba7",300,[23,119,120,130,140],{},[26,121,122,125],{},[48,123,124],{},"金角獎 (實體獎座)",[23,126,127],{},[26,128,129],{},"成功撰寫滿 40 週者均可獲得。",[26,131,132,135],{},[48,133,134],{},"銀角獎 (實體獎座)",[23,136,137],{},[26,138,139],{},"成功撰寫滿 25 週者均可獲得。",[26,141,142,143],{},"銅角獎 (數位獎狀)\n",[23,144,145],{},[26,146,147],{},"成功撰寫滿 10 週者均可獲得。",[19,149,150],{"id":150},"活動規範",[23,152,153,156,159,165],{},[26,154,155],{},"參賽者需依規定於每撰寫一篇文章並發佈至相對應平台，其內容不得有「待補」、「草稿」等內容代替，凡是以此內容發表之參賽者，主辦單位將有權取消參賽資格。",[26,157,158],{},"參賽者文章內容不得有謾罵、汙言穢語之內容，若經主辦單位判定嚴重者將取消參賽資格。",[26,160,161,162,164],{},"參賽者需依照",[48,163,54],{},"相關之內容，若發表內容無關或不符合主題，主辦單位將有權取消參賽資格。",[26,166,167],{},"刪除文章者將取消完賽與得獎資格。",[19,169,170],{"id":170},"常見問答",[172,173,174,181,187,193],"ol",{},[26,175,176,177,180],{},"Q: 我一週可以寫兩篇以上嗎？",[178,179],"br",{},"A: 可以，但一週的額度只算一篇，目的是希望您藉由本活動培養寫文的好習慣。",[26,182,183,184,186],{},"Q: 我是不是每週都一定要寫一篇文章？",[178,185],{},"A: 不用，你可以依照自己的節奏寫文，除非您想要拿到金角獎，則需每週寫文。",[26,188,189,190,192],{},"Q：2\u002F2 後還可以報名嗎？",[178,191],{},"A：可以，如果你目標是銅角獎與銀角獎，那麼在 4 ~ 5 月報名也可以獲得該獎項，報名日期最後截止為 6\u002F30。",[26,194,195,196,198,199],{},"Q：主辦單位要怎麼確認我有投稿？",[178,197],{},"每週您寫完文章後，請直接到報名表單來進行投稿即可，此表單可以進行編輯。\n",[85,200,203],{"href":201,"rel":202},"https:\u002F\u002Fforms.gle\u002FMvufZiucPir4yhHb6",[89],"報名與投稿表單連結",{"title":205,"searchDepth":206,"depth":206,"links":207},"",2,[208,209,210,211,212,213,214,215,216,217],{"id":21,"depth":206,"text":21},{"id":37,"depth":206,"text":38},{"id":44,"depth":206,"text":44},{"id":54,"depth":206,"text":54},{"id":80,"depth":206,"text":80},{"id":94,"depth":206,"text":94},{"id":102,"depth":206,"text":102},{"id":110,"depth":206,"text":110},{"id":150,"depth":206,"text":150},{"id":170,"depth":206,"text":170},null,"2019-11-14","這是由六角學院所推出的 w3HexSchool 活動，活動期限為一年，也就是 53 週，有如全馬挑戰一般，是屬於常態且長期性寫文活動，透過此活動進而推動自我成長及創造品牌形象！",false,"md",{},true,"\u002Fblog\u002F2019\u002F2019-11-14-w3hexschool-2020-challenge",{"title":5,"description":220},"blog\u002F2019\u002F2019-11-14-w3Hexschool-2020-challenge",[229],"event","1UtYDwU4n2Qf5rihjRMlDFmzFptVHc2geD3c8L9h2Mk",{"prev":232,"next":235,"related":238,"tags":251},{"title":233,"link":234},"2019 年前端工程師薪資調查","\u002Fblog\u002F2020-01-03-2019-frontend-salary",{"title":236,"link":237},"【學員專屬徵才 - 第三波遠端助教】無工作經驗者優先錄取","\u002Fblog\u002F2019-11-05-remote-jobs-third",[239,242,245,248],{"title":240,"link":241},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":243,"link":244},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":246,"link":247},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":249,"link":250},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[252,253,254,255,256,229,257,258,259,260,261],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292377]