[{"data":1,"prerenderedAt":412},["ShallowReactive",2],{"blog:2021-09-03-figma-camp-2021":3,"blog:neighbors:2021-09-03-figma-camp-2021":381},{"id":4,"title":5,"author":6,"body":8,"categories":369,"date":370,"description":371,"draft":372,"extension":373,"meta":374,"navigation":53,"path":375,"seo":376,"stem":377,"tags":378,"thumbnail":17,"__hash__":380},"blog\u002Fblog\u002F2021\u002F2021-09-03-figma-camp-2021.md","Figma 設計體驗營",[7],"六角學院",{"type":9,"value":10,"toc":342},"minimark",[11,18,22,25,30,33,39,43,46,54,57,61,64,69,73,76,80,89,111,115,123,134,136,139,143,158,166,170,197,201,205,233,235,237,240,242,245,249,252,256,259,263,266,270,277,281,284,288,291,295,298,316],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F09%2Ffigma-bootcamp-cover2x.png?alt=media&token=a3630eb7-b256-42b9-bab4-d9baf828f2f2",[19,20,21],"h2",{"id":21},"前言",[12,23,24],{},"大家好，我是六角學院的設計師俊儀 ⚡\nFigma 是現在討論度很高的介面設計工具，試著摸索了一陣子之後，發現果然有它火熱的道理；許多方便的功能讓設計變得更有效率，也有非常活絡的社群資源，因此想要舉辦一個小型的體驗營來為想要一探究竟的大家稍作介紹 Figma 的魅力所在。",[26,27,29],"h3",{"id":28},"體驗營的兩大重點介紹交流","體驗營的兩大重點：介紹＆交流",[12,31,32],{},"這次的 Figma 體驗營將會介紹像是 Auto Layout 等核心功能，讓你能夠初步了解 Figma 能做到的事情，最後還會再引導大家用 Figma 做出專屬於你的自介小卡（如下圖），會提供一個地方讓大家能夠貼上自己的小卡，讓彼此可以互相交流，互粉互讚。最棒的是，我們還有一個抽獎活動！ 🎁",[34,35,36],"blockquote",{},[12,37,38],{},"小卡上想要放入什麼資訊可以自行斟酌（鼓勵交流但不勉強）",[12,40,42],{"style":41},"background: rgba(251, 228, 228, 0.5);"," 🚫 唯一禁止的是在小卡上加上仇恨、色情、歧視等不當內容、或非本人的真實資料",[12,44,45],{},"▼ 操作小提示：hashtag 可以滑動、社群連結也都可以點擊",[47,48],"iframe",{"style":49,"width":50,"height":51,"src":52,"allowFullScreen":53},"border: 1px solid rgba(0, 0, 0, 0.1);","100%",750,"https:\u002F\u002Fwww.figma.com\u002Fembed?embed_host=share&url=https%3A%2F%2Fwww.figma.com%2Fproto%2Fjql6OFYkyR13S9hclNwyAB%2FFigma-Bootcamp%3Fkind%3D%26node-id%3D288%253A132%26page-id%3D288%253A78%26scaling%3Dscale-down%26viewport%3D241%252C48%252C1.03",true,[12,55,56],{},"想要跟同樣對 Figma 有興趣的人們交個朋友嗎？\n馬上看看下面的報名資訊吧！",[58,59],"div",{"style":60},"border-bottom-color: #f2f2f2 !important;",[19,62,63],{"id":63},"時程",[34,65,66],{},[12,67,68],{},"體驗營的直播將會分成兩階段來進行：下午功能介紹、晚上分享會",[12,70,72],{"style":71},"background: rgba(235, 236, 237, 0.3);"," 🗓 日期：2021.9.25（六)",[12,74,75],{"style":71}," 🕑 Figma 介紹：14:00 - 17:00 ｜ 分享會： 21:00 - 22:00",[26,77,79],{"id":78},"功能介紹1400-1700","功能介紹（14:00 - 17:00）",[34,81,82],{},[12,83,84,85,88],{},"介紹 Figma 的重點功能，目標是能自己做出範例的卡片",[86,87],"br",{},"\n體驗營也會提供模板讓初學者也能輕鬆體驗",[90,91,92,96,99,102,105,108],"ul",{},[93,94,95],"li",{},"Figma 基本介面",[93,97,98],{},"Frame",[93,100,101],{},"Auto Layout",[93,103,104],{},"Components",[93,106,107],{},"Prototype",[93,109,110],{},"Plugins",[26,112,114],{"id":113},"分享會2100-2200","分享會（21:00 - 22:00）",[34,116,117],{},[12,118,119,120,122],{},"大家把做好的小卡自行貼在同一份 FigJam 檔案裡",[86,121],{},"\n會分成幾個象限讓大家貼在適合的位置上",[90,124,125,128,131],{},[93,126,127],{},"導覽大家的自介小卡",[93,129,130],{},"介紹 FigJam（白板協作檔案）",[93,132,133],{},"抽獎",[58,135],{"style":60},[19,137,138],{"id":138},"報名流程",[26,140,142],{"id":141},"報名","① 報名：",[90,144,145,155],{},[93,146,147,148],{},"請填寫這份 ",[149,150,154],"a",{"href":151,"rel":152},"https:\u002F\u002Fdocs.google.com\u002Fforms\u002Fd\u002F1EuIrOagBzsvEI2m6QJdwcHtUPHE9DlzB6g9Frr64utM\u002Fedit",[153],"nofollow","Figma 設計體驗營-報名表單",[93,156,157],{},"填寫完畢之後，報名表單上就會有加入專屬 Discord 頻道的連結",[34,159,160],{},[12,161,162,163,165],{},"報名截止期限：9\u002F24（五）17:00 ",[86,164],{},"\n時間到會關閉報名表單",[26,167,169],{"id":168},"加入-discord-並自我介紹","② 加入 Discord 並自我介紹：",[171,172,173,182,194],"ol",{},[93,174,175,176,181],{},"參考 ",[149,177,180],{"href":178,"rel":179},"https:\u002F\u002Fhackmd.io\u002FknsHc23zSKubeMFWcxwO8Q",[153],"Discord 說明文件"," 加入到六角學院 Discord（加入連結由上一步的報名表單取得）",[93,183,184,185,189,190,193],{},"加入 ",[186,187,188],"code",{},"設計新村"," ，關於體驗營的相關討論與資訊都會統一在 ",[186,191,192],{},"Figma設計體驗營"," 這個子頻道",[93,195,196],{},"在指定的討論串（Thread）自我介紹一下，讓其他參與者認識你吧",[12,198,200],{"style":199},"background: rgba(235, 236, 237, 0.3); font-size: 14px","\n📢 大家好，我是 Junior，雖然現在是工程師，但對設計很有興趣，想要參加這個體驗營來玩玩看 Figma 到底有多厲害。",[26,202,204],{"id":203},"figma-前置安裝","③ Figma 前置安裝：",[171,206,207,216,224],{},[93,208,209,210,215],{},"從官網下載 ",[149,211,214],{"href":212,"rel":213},"https:\u002F\u002Fwww.figma.com\u002Fdownloads\u002F",[153],"Desktop App","（也有網頁版可以使用，介紹都會以桌面版為主）",[93,217,218,219,223],{},"下載字型外掛 ",[149,220,222],{"href":212,"rel":221},[153],"Font installer","（讓網頁版可以使用本機字型，用桌面版其實不需要但可以先裝著）",[93,225,226,227,232],{},"免費註冊帳號，可以先登入桌面版\na. 如果你還是學生，可以選擇去驗證 ",[149,228,231],{"href":229,"rel":230},"https:\u002F\u002Fwww.figma.com\u002Feducation\u002F",[153],"教育帳號","（用含 edu 的帳號都可以），這樣就可以使用到全部的功能（每兩年要驗證一次）\nb. 體驗營介紹的主要功能免費版都有支援，不用擔心",[58,234],{"style":60},[19,236,133],{"id":133},[12,238,239],{},"為了鼓勵大家貼出自己的自介小卡來交流，我們也將會在體驗營當晚的分享會抽出一位符合條件的朋友贈與一份神秘小禮物！後續會在 Figma 體驗營專屬的 Discord 頻道公布相關規則，敬請期待 ✨",[58,241],{"style":60},[19,243,244],{"id":244},"常見問題",[26,246,248],{"id":247},"ｑ如果從來沒有碰過設計軟體可以參加這次的-figma-設計體驗營嗎","Ｑ、如果從來沒有碰過設計軟體可以參加這次的 Figma 設計體驗營嗎？",[12,250,251],{},"當然可以！這次的體驗營就是為了讓更多人認識 Figma 這個設計工具，有操作過其他類似軟體當然會上手得更快（e.g. Sketch、Xd），只是體驗營的內容都會從最基礎的部分開始講起，別擔心！",[26,253,255],{"id":254},"ｑ參加-figma-設計體驗營會需要付費嗎","Ｑ、參加 Figma 設計體驗營會需要付費嗎？",[12,257,258],{},"這次的體驗營完全免費！請大力分享給身邊有興趣的朋友們 ʕ •ᴥ•ʔ",[26,260,262],{"id":261},"ｑ如果這次的時間剛好沒辦法參加之後會有加開的場次嗎","Ｑ、如果這次的時間剛好沒辦法參加，之後會有加開的場次嗎？",[12,264,265],{},"目前還沒有特別規劃，如果反應不錯會考慮再加開，可以持續關注六角學院的最新消息。",[26,267,269],{"id":268},"ｑ參加-figma-設計體驗營需要準備什麼","Ｑ、參加 Figma 設計體驗營需要準備什麼？",[12,271,272,273,276],{},"需要先安裝 Figma、加入專屬 Discord 頻道。\n詳細步驟請參照上方的",[149,274,138],{"href":275},"#%E5%A0%B1%E5%90%8D%E6%B5%81%E7%A8%8B","，且放心，這邊都不會再額外收費。",[26,278,280],{"id":279},"ｑ一定要加入-discord-群組嗎","Ｑ、一定要加入 Discord 群組嗎？",[12,282,283],{},"重要的文件、直播的連結、以及額外的獎勵等都會放在 Discord 的專屬群組，加入後可以即時取得。",[26,285,287],{"id":286},"ｑ這次-figma-設計體驗營的直播內容會留存影片嗎","Ｑ、這次 Figma 設計體驗營的直播內容會留存影片嗎？",[12,289,290],{},"會視情況公開到六角學院的 Youtube 頻道上。\n只是參加體驗營才能與講師和同學們互動，甚至還有獲得額外小禮物的機會喔！",[26,292,294],{"id":293},"ｑ參加完這個-figma-設計體驗營就能轉職成為-ui-設計師了嗎","Ｑ、參加完這個 Figma 設計體驗營就能轉職成為 UI 設計師了嗎？",[12,296,297],{},"很遺憾的沒辦法（笑）\n在這個體驗營更著重在軟體的介紹與交流，你將會了解到 Figma 有哪些功能跟基礎操作方式，但關於設計的專業知識並不會提到太多。如果對 UI 設計有興趣的話，可以考慮：",[90,299,300,308],{},[93,301,302,303],{},"自己分配學習時間的「影音課程」：",[149,304,307],{"href":305,"target":306},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002Fui.html","_blank","UI 設計入門影音課程",[93,309,310,311,315],{},"短時間內密集訓練的「直播課程」：",[149,312,314],{"href":313,"target":306},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002Fui-training.html","UI 設計觀念必修直播班","（預約中：11～12 月開班）",[12,317,318],{},[149,319,325,326,330,331,325,338,341],{"href":320,"target":306,"className":321,"style":324},"https:\u002F\u002Fr.botbonnie.com\u002FLAFZG",[322,323],"btn-ui-training","btn-ui-notice","border-radius: 0.5rem;"," ",[327,328,329],"span",{}," ⚡ ⚡ ⚡ ⚡ "," ⚡ ",[327,332,333,334,337],{}," 點我預約 UI 設計",[327,335,336],{},"觀念必修","直播班 (2021 冬季)",[327,339,340],{},"⚡ ⚡ ⚡ ⚡ "," ⚡  ",{"title":343,"searchDepth":344,"depth":344,"links":345},"",2,[346,350,354,359,360],{"id":21,"depth":344,"text":21,"children":347},[348],{"id":28,"depth":349,"text":29},3,{"id":63,"depth":344,"text":63,"children":351},[352,353],{"id":78,"depth":349,"text":79},{"id":113,"depth":349,"text":114},{"id":138,"depth":344,"text":138,"children":355},[356,357,358],{"id":141,"depth":349,"text":142},{"id":168,"depth":349,"text":169},{"id":203,"depth":349,"text":204},{"id":133,"depth":344,"text":133},{"id":244,"depth":344,"text":244,"children":361},[362,363,364,365,366,367,368],{"id":247,"depth":349,"text":248},{"id":254,"depth":349,"text":255},{"id":261,"depth":349,"text":262},{"id":268,"depth":349,"text":269},{"id":279,"depth":349,"text":280},{"id":286,"depth":349,"text":287},{"id":293,"depth":349,"text":294},null,"2021-09-03","Figma 有許多方便的功能讓設計變得更有效率，也有非常活絡的社群資源，因此想要舉辦一個小型的體驗營來為想要一探究竟的大家稍作介紹 Figma 的魅力所在。",false,"md",{},"\u002Fblog\u002F2021\u002F2021-09-03-figma-camp-2021",{"title":5,"description":371},"blog\u002F2021\u002F2021-09-03-figma-camp-2021",[379],"event","3rqQoT_S-i_C4d3LxEEIx2Hy7sjXgthpbhRQeiOB8iE",{"prev":382,"next":38