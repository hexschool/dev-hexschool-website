[{"data":1,"prerenderedAt":323},["ShallowReactive",2],{"blog:2022-06-01-block-studio-interview":3,"blog:neighbors:2022-06-01-block-studio-interview":292},{"id":4,"title":5,"author":6,"body":8,"categories":279,"date":280,"description":281,"draft":282,"extension":283,"meta":284,"navigation":285,"path":286,"seo":287,"stem":288,"tags":289,"thumbnail":18,"__hash__":291},"blog\u002Fblog\u002F2022\u002F2022-06-01-block-studio-interview.md","【現在就走！前進企業帶你看】版塊設計的隱藏福利？版塊人都喜歡？",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":274},"minimark",[11,19,22,25,30,40,44,47,51,61,67,71,74,78,81,85,88,93,99,104,107,115,126,133,148,155,158,161,164,181,185,192,195,215,222,233,237,240,243,246,271],[12,13,14],"p",{},[15,16],"img",{"alt":17,"src":18},"首圖","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2F%E7%89%88%E5%A1%8A.png?alt=media&token=c8c5da00-a236-456c-804b-d9a56f77f97b",[12,20,21],{},"各 位 觀 眾！六角的全新採訪企劃 來了！\n嗨嗨我是Ｚ編，【現在就走！前進企業帶你看】將會由洧杰、卡斯伯，兩位老師前進前端、設計相關公司，替大家一探究竟 👀",[12,23,24],{},"新企劃，首先打頭陣的就是位於台北市的「版塊設計」",[15,26],{"src":27,"alt":28,"style":29},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2F%E7%9B%B4%E5%BC%8F.png?alt=media&token=b9de4917-4a88-4f14-a966-87bba72060ad","版塊 logo","margin-left: auto; margin-right: auto; width: 300px; height: 200px; object-fit: cover;",[31,32,33],"blockquote",{},[12,34,35,36,39],{},"版塊設計 Block Studio 小檔案",[37,38],"br",{},"位於台北市，主力於「網站設計」與「品牌識別規劃」，設計風格以視覺特效為主、使用為輔，持續 Follow 全世界厲害的網站做法，不斷在各個案子中嘗試新的可能。",[15,41],{"src":42,"alt":43},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2Ffix%2F%E5%8D%A1%E6%96%AF%E4%BC%AF_fix.jpg?alt=media&token=6468eec4-f1e4-4a44-96a1-d6554a8de6f2","圖一",[12,45,46],{},"go go！ 前進版塊設計",[15,48],{"src":49,"alt":50},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2Ffix%2F%E8%BE%A6%E5%85%AC%E5%AE%A4_fix.jpg?alt=media&token=6058fde2-343a-4c9b-aad3-7b783034bd31","圖二",[12,52,53],{},[54,55,56,57],"small",{},"沒有隔間的辦公空間看起來好舒服，",[58,59,60],"del",{},"聊天、傳遞零食好方便",[12,62,63,64,66],{},"原來版塊的辦公室長這樣啊",[37,65],{},"請問設計師 Luju 在哪裡～（左看右看",[15,68],{"src":69,"alt":70},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2Ffix%2F%E5%AD%B8%E5%93%A1%E5%90%88%E7%85%A7_fix.jpg?alt=media&token=ad4162be-4157-4318-9b33-ebbf3dbc9467","圖三",[12,72,73],{},"！竟然捕捉到野生六角學員",[15,75],{"src":76,"alt":77},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2Ffix%2F%E5%9B%9E%E9%A0%AD_fix.jpg?alt=media&token=ce8b7469-9f73-4a83-9347-db0c410eff5a","圖四",[12,79,80],{},"內個... 不好意思打擾了，Luju 你還記得我們今天要訪談嗎",[15,82],{"src":83,"alt":84},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2Ffix%2F%E6%8E%A1%E8%A8%AA%E9%81%8E%E7%A8%8B_fix.jpg?alt=media&token=0195c8fa-a21e-45c5-8bdc-f4501ae726e5","圖五",[12,86,87],{},"那天和版塊創辦人李明、設計師 Luju 聊了很多，謝謝你們的分享，還有蘋果汁",[15,89],{"src":90,"alt":91,"style":92},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2Ffix%2F%E5%90%88%E7%85%A7_fix.jpg?alt=media&token=508c5e55-fab2-45c5-965c-5ed7888e89b0","圖六","width: 500px",[12,94,95,96],{},"最後來張合照，今天很開心來到版塊設計，",[58,97,98],{},"下次再來喝蘋果汁",[100,101,103],"h2",{"id":102},"版塊設計-ｑａ","版塊設計 Ｑ＆Ａ",[12,105,106],{},"Q：想請問當初為什麼會想成立「版塊設計」？",[12,108,109,110,114],{},"A：因為我們在想：「",[111,112,113],"b",{},"台灣的公部門網站真的好難用，應該可以做得更好吧？","」",[116,117,118,119,118,123],"ul",{},"\n  ",[120,121,122],"li",{},"2010 年時，台灣的網站動態還在 Flash 的階段，互動特效的發展尚未成熟，發覺這塊可能還是一片藍海。且時常在瀏覽公部門網站時，總覺得很痛苦，應該可以做得更好吧？",[120,124,125],{},"故在後續開始結合動畫思維應用在網站上，從小型的網站開始玩一些動態特效，像是 9m88 的唱片宣傳官網，用簡單的視差動態加上光影就能有很特別的展現，到後期更多中小企業看到版塊，做了更多有別公版的形象官網，也觸碰到公部門的案子，像是高雄流行音樂中心、台北流行音樂中心、設計研究院等等，也算是達成了原本的初衷！",[12,127,128,129,132],{},"Q：那版塊的",[111,130,131],{},"業務","有包含哪些呢？",[134,135,118,136,118,139],"div",{},[12,137,138],{},"A：",[116,140,141,142,141,145,118],{},"\n    ",[120,143,144],{},"從品牌視覺到數位載體上的呈現",[120,146,147],{},"依據客戶需求，協助策略品牌展現方式，細節內容包含品牌識別設計、指標系統、網站介面設計、AR 等",[12,149,150,151,154],{},"Q：版塊",[111,152,153],{},"未來的願景","，你們期許 ...？",[12,156,157],{},"A：以數位化建構品牌體驗，不斷設計出令人驚嘆的作品，並且在亞洲成為代表性的創意設計公司。",[12,159,160],{},"Q：版塊的辦公室，好像和一般辦公空間不太一樣，可以簡單和我們分享一下嗎？",[12,162,163],{},"A：我們的辦公室整體結構有「會議室」、「老闆辦公處」跟「各部門辦公處」、「茶水間」、「男\u002F女廁\u002F版班的廁所」、「印務室」",[116,165,118,166,118,169,118,172,118,175,118,178],{},[120,167,168],{},"「會議室」最特別之處在於中間的拉門，可以視會議規模用拉門製造出隔間（然後每次開會到一半貓就一定會跑進來，然後再跑出去，我進來了、我又出去了....）",[120,170,171],{},"「老闆辦公處」神聖之地（不是），從自己的座位走到老闆辦公桌是世界上最遠的距離，團隊通常會帶著敬畏的心聚集在此聆聽任務指令",[120,173,174],{},"「各部門辦公處」分別區分為專案管理、品牌視覺部、網站開發部、網站設計部，每個部門的辦公桌都有自己的個性，可能很空、可能塞滿療癒小物、設計雜誌等等",[120,176,177],{},"「茶水間」可以喝水、吃零食、喝酒（？）、蒸便當、發呆、聊八卦（或試著站在那邊 2 分鐘，版班就會爆衝過來）（要小心別讓版班跑進牠的食物間，他會不想出來）",[120,179,180],{},"「印務室」就是可以印東西的地方（然後在裡面偷睡覺應該不會有人發現）",[15,182],{"src":183,"alt":184},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2F版塊辦公室平面圖_工作區域_1_複本.jpg?alt=media&token=540bfd1d-844e-4b3f-9a44-8e3a15b16bc6","辦公室平面圖",[12,186,187,188,191],{},"Q：那來版塊上班的夥伴，可以享有什麼",[111,189,190],{},"福利","呢？",[12,193,194],{},"A：我們的福利有：",[116,196,118,197,118,200,118,203,118,206,118,209,118,212],{},[120,198,199],{},"「遠端工作」每週 1 天可以在任何喜歡的地方工作。",[120,201,202],{},"「學習補助」提供買書、課程預算補助計畫。",[120,204,205],{},"「生日會」每月壽星生日會。",[120,207,208],{},"「員工旅遊」年度旅遊補助計畫。",[120,210,211],{},"「零食」不定期零食填補。",[120,213,214],{},"「聚餐」不定期聚餐。",[12,216,218,219],{"style":217},"text-indent: 16px;","當然，不只這樣，還有",[111,220,221],{},"加碼隱藏福利：",[116,223,118,224,118,227,118,230],{},[120,225,226],{},"每天第一個到公司的可以享受版班的寵幸（對就是那隻貓）",[120,228,229],{},"不定時在茶水間的吧台上會出現各地區土產，大家很樂於分享放假後的美好（特休隨便休，買土產回來提醒你也該放假）",[120,231,232],{},"不定期會有神秘的校外教學，看到什麼有興趣的展覽都可以提出來！！（過往團隊一起參觀過新竹設計展、TeamLab 互動藝術展、平面設計展 「D&AD、極瑞士」",[15,234],{"src":235,"alt":236},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F05%2Fblock-studio%2FS__12025870.jpg?alt=media&token=c01a5a1d-bc6b-4bae-94dc-db3c308e2ffe","版班",[12,238,239],{},"版班：喵嗚～",[12,241,242],{},"Q：身為版塊人，你喜歡...？",[12,244,245],{},"A：可以分為兩個方面來說：",[116,247,118,248,118,260],{},[120,249,250,251,118],{},"\n    物理上：\n    ",[116,252,253,254,253,257,141],{},"\n      ",[120,255,256],{},"最喜歡版塊的辦公環境，沒有無聊的座位隔間，從充分的日光到綠葉點綴（植物還會不定期換新，絕對不是死了？（是真的），還有各個有設計感的辦公物件，都讓人工作感覺非常舒心～",[120,258,259],{},"茶水間的置物櫃到冰箱，零食會一直自動填滿，在工作到頭痛的時候，隨時都可以補充一下能量！",[120,261,262,263,118],{},"\n    心理上：\n    ",[116,264,253,265,253,268,141],{},[120,266,267],{},"在版塊總是可以接觸到非常多元的專案，規模也越來越大，充滿挑戰性！每一次的專案執行，都是讓自己不斷升級的過程。",[120,269,270],{},"版塊的團隊對於產出都相當有要求，且具備高度美感，很享受與團隊構思創意的過程！在這裡可以很開放的討論任何可能～",[12,272,273],{},"以上，就是我們【現在就走！前進企業帶你看】第一集！\n大家喜歡這樣的分享方式嗎？\n未來我們也將去探索更多公司，發掘更多大家想了解的內容唷～",{"title":275,"searchDepth":276,"depth":276,"links":277},"",2,[278],{"id":102,"depth":276,"text":103},null,"2022-06-01","各 位 觀 眾！六角的全新採訪企劃 來了！嗨嗨我是Ｚ編，【現在就走！前進企業帶你看】將會由洧杰、卡斯伯，兩位老師前進前端、設計相關公司，替大家一探究竟 👀",false,"md",{},true,"\u002Fblog\u002F2022\u002F2022-06-01-block-studio-interview",{"title":5,"description":281},"blog\u002F2022\u002F2022-06-01-block-studio-interview",[290],"enterprise","zx5F8Y0vHUoQHf1AHzUNBMESwAZCUKiXYTxYafS__z8",{"prev":293,"next":296,"related":299,"tags":312},{"title":294,"link":295},"【全職爸爸轉前端】把握任何能讓自己變強的機會或是方式！內附小彩蛋","\u002Fblog\u002F2022-06-10-tim-full-time-learning",{"title":297,"link":298},"軟體工程師有哪些類別","\u002Fblog\u002F2022-05-30-software-engineer-category",[300,303,306,309],{"title":301,"link":302},"【企業開箱】敏捷指標企業鈦坦科技落地高雄！一探究竟內部樣貌！","\u002Fblog\u002F2022-11-22-titansoft-interview",{"title":304,"link":305},"找到心之所向，保持學習動力－專訪 凱鈿行動科技 資深前端工程師 沈慧慈","\u002Fblog\u002F2022-11-15-kdan-follow-your-heart",{"title":307,"link":308},"【企業開箱文】緯創資通前後端使用的技能？輔導員機制？","\u002Fblog\u002F2022-10-11-wistron-interview",{"title":310,"link":311},"【現在就走！前進企業帶你看】成為 Kdan 人必看 Q&A！新人剛進工作會有前輩帶領嗎？","\u002Fblog\u002F2022-07-11-kdan-mobile-interview",[313,314,315,316,290,317,318,319,320,321,322],"UI design","course","css","css3","event","interview","javascript","jobs","skilltree","software engineer",1790064291780]