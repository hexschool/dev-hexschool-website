[{"data":1,"prerenderedAt":379},["ShallowReactive",2],{"blog:2021-12-21-hex-service":3,"blog:neighbors:2021-12-21-hex-service":350},{"id":4,"title":5,"author":6,"body":8,"categories":337,"date":338,"description":339,"draft":340,"extension":341,"meta":342,"navigation":343,"path":344,"seo":345,"stem":346,"tags":347,"thumbnail":17,"__hash__":349},"blog\u002Fblog\u002F2021\u002F2021-12-21-hex-service.md","註冊六角課程，到底包含了哪些福利",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":324},"minimark",[11,18,21,24,28,47,50,53,56,62,65,71,88,90,97,129,132,137,145,149,160,163,166,169,175,178,182,193,195,198,206,214,220,224,232,235,238,276,282,288,292,300,303,306,313,321],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fversion_2019%2F2023%2Flanding-2023-list.png?alt=media&token=aad511ea-50b9-4074-a5b8-5e4dd1f4a016",[12,19,20],{},"六角經營至今已經有上萬人加入，隨著時間前進我們也不斷地加入新的內容，這些新的內容當然不只新的學員，其實就連老師們也常常搞得頭昏腦脹。",[12,22,23],{},"因此，這邊我們就來重新介紹六角的課程到底有哪些額外的延伸內容吧！",[25,26,27],"h2",{"id":27},"可以獲得的項目",[29,30,31,35,38,41,44],"ul",{},[32,33,34],"li",{},"助教批改服務",[32,36,37],{},"不定期線上技術研討會",[32,39,40],{},"Discord 共學頻道",[32,42,43],{},"輔導就業",[32,45,46],{},"各項第一手的挑戰活動",[48,49,34],"h3",{"id":34},[12,51,52],{},"買了課程害怕自己學不會嗎？\n不清楚自己寫的 Code 是否正確？\n有些觀念沒搞懂，想找人再次確認？",[12,54,55],{},"別擔心，六角學院什麼不多就是助教最多，我們每門課程約配置 3 ~ 5 位的專屬助教，每天在線回覆學員的所有問題。只要你敢問，助教就會想盡辦法給你最好的答覆。",[12,57,58],{},[15,59],{"alt":60,"src":61},"Teachable 問答區","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F12%2F12%2Fhex-service%2Fteachable.png?alt=media&token=d311bdea-1d28-4a80-b7c5-d02d71950998",[12,63,64],{},"在影音課程的下方會看到問答區，你可以在此「提出新問題」詢問該章節所遇到的問題或者是繳交章節作業；當然歡迎查看其他同學的問題或作業，畢竟寫程式不是只有自學，多看、多問通常能獲得更好的學習成效喔。",[12,66,67],{},[68,69,70],"b",{},"補充重點：",[72,73,74],"blockquote",{},[12,75,76,77,83,84,87],{},"適用課程：所有主要",[78,79,82],"a",{"href":80,"target":81},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002F","_blank","影音課程","（ \"所有課程\" 列表內的課程）\n",[85,86],"br",{},"回覆等待時間：上班時間，通常一天內可獲得解答",[48,89,37],{"id":37},[12,91,92,93,96],{},"只要你是六角的學員，我們都歡迎你",[68,94,95],{},"免費","來參加「線上研討會」，線上研討會的內容大多技術相關的延伸內容，除了六角的講師以外，同時也會邀請業界的大神來分享，主題內容涵蓋了：",[29,98,99,102,105,108,111,114,117,120,123,126],{},[32,100,101],{},"HTML, CSS, JavaScript 等前端內容",[32,103,104],{},"React, Angular, Vue 主題介紹",[32,106,107],{},"Node.js, PHP, .NET, Python 等不同後端知識",[32,109,110],{},"JavaScript 設計模式",[32,112,113],{},"Webpack",[32,115,116],{},"Unit Test",[32,118,119],{},"UI\u002FUX",[32,121,122],{},"區塊鏈",[32,124,125],{},"GCP、AWS 等不同雲服務",[32,127,128],{},"轉職、學習、管理等職場軟知識",[12,130,131],{},"... 過去已累積超過 50 種不同技術議題",[12,133,134],{},[15,135],{"alt":37,"src":136},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F12%2F20%2Fblog-1.png?alt=media&token=8758c29c-7ac8-49f7-b5bf-5a2c682e9b93",[12,138,139,140,144],{},"只要註冊任一六角學院的課程，無論是在 Udemy、Teachable 都可以收到當週的直播資訊，如果你深怕遺漏自己所想聽的直播，也可以先訂閱「",[78,141,143],{"href":142,"target":81},"https:\u002F\u002Fwww.hexschool.com\u002Fcalendar\u002F","六角行事曆","」，我們會先將下一個月的直播內容加入，就可以避免遺漏掉研討會資訊喔～",[12,146,147],{},[68,148,70],{},[72,150,151,154,157],{},[12,152,153],{},"費用：免費，僅需要註冊任一門六角課程",[12,155,156],{},"時間：當天的 20:00 開始，約為 1.5 小時（詳細時間以信件通知為主）",[12,158,159],{},"講師：六角講師或各方技術大神",[48,161,162],{"id":162},"多人共學頻道",[12,164,165],{},"自學很困難，不僅要騰出學習時間，還要克制自己的各種娛樂慾望，如果只有自己一個人真的很難達到。",[12,167,168],{},"因此，我們提供了共學頻道（目前轉以 Discord 為主），讓加入的學員不是只有面對冷冰冰的螢幕進行學習，還同時可以知道其他學員在做什麼、有什麼新知識、甚至是互相勉勵及堅持～",[12,170,171],{},[15,172],{"alt":173,"src":174},"Discord","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F12%2F12%2Fhex-service%2Fdiscord.png?alt=media&token=c0a03f11-0a1b-4bfc-8cd5-37d9b4b761b1",[12,176,177],{},"在這個頻道中，你可以與同學分享今天要學的內容，也可以詢問近期在業界上所遇到的問題。也跟你分享，在六角所經營的社群中，也有同學一拍即合一同經營創業經營接案公司喔～",[12,179,180],{},[68,181,70],{},[72,183,184,187,190],{},[12,185,186],{},"主要聊天工具：Discord（先前使用 Slack、目前開始轉往 Discord）",[12,188,189],{},"相關頻道：聊天大廳、作業求助、學習分享、活動頻道、學院公告",[12,191,192],{},"人數：超過 3,000 人",[48,194,43],{"id":43},[12,196,197],{},"你學習程式是為了什麼呢？相信有許多人只因為興趣，更多是為了生計。",[12,199,200,201,205],{},"相對與許多產業來說，Coding 已經是一門顯學，且任何人只要有心都可以投入學習，並且轉職成為前端工程師，在我們 2021 年所做的「",[78,202,204],{"href":203,"target":81},"\u002Fblog\u002F2021-12-09-2021-frontend-salary","薪資調查","」來說，就算是一年以下的工程師平均年薪都超過全台受僱員工的前 50%，甚至 3~5 年以上的工程師，更是擠進全台受僱員工的前 80%。",[12,207,208,209,213],{},"我們很樂意為學員進行輔導就業，但相對的也需要符合基本的條件，只要完成「",[78,210,212],{"href":211,"target":81},"https:\u002F\u002Fwww.hexschool.com\u002Fqa\u002F#%E9%97%9C%E6%96%BC%E8%BC%94%E5%B0%8E%E5%B0%B1%E6%A5%AD%E5%A6%82%E4%BD%95%E9%80%B2%E8%A1%8C","特定的課程的最終挑戰","」就可以與課程助教索取「求職輔導表單」，接下來講師就會主動與您聯絡，帶您一起面對接下來的求職挑戰！",[12,215,216],{},[15,217],{"alt":218,"src":219},"slack 對話","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F12%2F12%2Fhex-service%2Ffeedback.png?alt=media&token=3eb467e7-854f-4980-b795-31422bb24107",[12,221,222],{},[68,223,70],{},[72,225,226,229],{},[12,227,228],{},"基本條件：完成特定課程最終挑戰",[12,230,231],{},"輔導項目：履歷健檢、求職建議、職涯規劃",[48,233,234],{"id":234},"挑戰活動",[12,236,237],{},"想要變強，單靠特定的課程是相當有限的，所以六角本身也是舉辦非常多的挑戰活動讓學員或是業界人士一同參加，其中包含了：",[29,239,240,248,255,262,269],{},[32,241,242,243,247],{},"不只學前端，還要學設計：「",[78,244,246],{"href":245,"target":81},"\u002Fblog\u002F2021-09-03-figma-camp-2021","Figma 設計體驗營","」",[32,249,250,251,247],{},"JS 框架到底是什麼概念：「",[78,252,254],{"href":253,"target":81},"\u002Fblog\u002F2021-07-07-vue3-summer-camp","Vue 夏令營",[32,256,257,258,247],{},"缺作品？不如來一起挑戰！「",[78,259,261],{"href":260,"target":81},"\u002Fblog\u002F2021-09-09-the-f2e-3-2021","The F2E 前端 & UI 修煉精神時光屋",[32,263,264,265,247],{},"疫情在家，想找資源學習嗎：「",[78,266,268],{"href":267,"target":81},"\u002Fblog\u002F2021-05-20-covid-public-welfare","勤奮在家學前端，戰勝疫情救台灣",[32,270,271,272,247],{},"學習不是只有輸入，更同時要輸出：「",[78,273,275],{"href":274,"target":81},"\u002Fblog\u002F2021-07-22-js-writing","六角筆記王：寫作吧！用文字喚醒你的前端魂！",[12,277,278],{},[15,279],{"alt":280,"src":281},"THE F2E 作品列表","https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F12%2F12%2Fhex-service%2Fthef2e.png?alt=media&token=08cf7b38-3612-49b0-934a-85eba4312a8b",[12,283,284,285,287],{},"以「",[78,286,261],{"href":260,"target":81},"」來說，就有上千組業界個人、團體報名參加，在這活動不只挑戰了個人的能力，同時能欣賞各方高手的設計模式、原始碼架構等知識，讓挑戰者只需要用一個月的時間更能超越一季的自學！",[12,289,290],{},[68,291,70],{},[72,293,294,297],{},[12,295,296],{},"目的：課程是具連貫性的學習內容，透過活動更能面對實戰情境",[12,298,299],{},"活動：六角一年約舉辦 4 ~ 6 場活動，任何人均可免費參加，學員會先收到第一手資訊",[25,301,302],{"id":302},"最多免費活動的教學單位",[12,304,305],{},"看到這邊，是否對於我們的服務感到興趣呢？",[12,307,308,309,312],{},"如果你想要學習網頁開發、UI 設計，都可以參考我們的",[78,310,311],{"href":80,"target":81},"線上課程","，只要註冊任何一門都可以享用以上所有的服務。",[12,314,315,316,320],{},"或者，你已經想加入我們線上課程，但不知道如何做選擇，則可以參考「",[78,317,319],{"href":318,"target":81},"\u002Fblog\u002F2021-12-16-free-25","免費 25 小時前端教學資源","」，其中包含了 \"主要課程說明\" 及 \"免費試聽\"。",[12,322,323],{},"當然，還是有任何問題也都可以直接與我們「小幫手」進行聯絡，我們很樂意解答你在學習上的各種問題喔 :D",{"title":325,"searchDepth":326,"depth":326,"links":327},"",2,[328,336],{"id":27,"depth":326,"text":27,"children":329},[330,332,333,334,335],{"id":34,"depth":331,"text":34},3,{"id":37,"depth":331,"text":37},{"id":162,"depth":331,"text":162},{"id":43,"depth":331,"text":43},{"id":234,"depth":331,"text":234},{"id":302,"depth":326,"text":302},null,"2021-12-21","六角經營至今已經有上萬人加入，隨著時間前進我們也不斷地加入新的內容，這篇來重新介紹六角的課程到底有哪些額外的延伸內容吧！",false,"md",{},true,"\u002Fblog\u002F2021\u002F2021-12-21-hex-service",{"title":5,"description":339},"blog\u002F2021\u002F2021-12-21-hex-service",[348],"event","zUFfzgl-2Bx3082ZIIf--RNq0iL2SV0epWXRybx-2bg",{"prev":351,"next":354,"related":355,"tags":368},{"title":352,"link":353},"【轉職前端工程師】學習前端，年齡不是問題","\u002Fblog\u002F2021-12-22-every-age-learn-frontend",{"title":319,"link":318},[356,359,362,365],{"title":357,"link":358},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":360,"link":361},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":363,"link":364},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":366,"link":367},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[369,370,371,372,373,348,374,375,376,377,378],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064291586]