[{"data":1,"prerenderedAt":180},["ShallowReactive",2],{"blog:2018-08-27-interview":3,"blog:neighbors:2018-08-27-interview":149},{"id":4,"title":5,"author":6,"body":8,"categories":137,"date":138,"description":20,"draft":139,"extension":140,"meta":141,"navigation":142,"path":143,"seo":144,"stem":145,"tags":146,"thumbnail":17,"__hash__":148},"blog\u002Fblog\u002F2018\u002F2018-08-27-interview.md","【公開】如何在線上幫助學員找到前端工作",[7],"六角學院",{"type":9,"value":10,"toc":127},"minimark",[11,18,21,24,29,32,35,39,42,45,50,53,56,59,64,68,71,74,79,82,85,90,93,96,99,110,119,122],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F08%2Fofferget_fb.png?alt=media&token=d69db149-1486-4785-bcd4-0f4078d6a20f",[12,19,20],{},"各位好，我是六角學院的校長，洧杰，創校兩年來，我們在線上已協助超過 100 位學員錄取網頁設計師、前端工程師職缺。",[12,22,23],{},"為什麼老師們在線上就能協助學生就業？這裡也分享我們的方法。",[25,26,28],"h2",{"id":27},"瞭解學員背景訂定適當的投入目標","瞭解學員背景，訂定適當的投入目標",[12,30,31],{},"我們在協助學員就業前，都會親自在線上與他們聊背景與學習狀況，最後再一起訂立每個階段的投入目標。當每個個小目標都逐一攻略升級後，自然就有足夠的裝備挑戰大魔王，也就是尋找第一份前端工作，最後再協助寫履歷、模擬面試。",[12,33,34],{},"在這裡分享近期老師們與學員在線上協助就業的歷程，也鼓勵在線上的你\u002F妳也能找到自己的求職方向。",[25,36,38],{"id":37},"努力投入-3-個月獲得-40k-薪水","努力投入 3 個月，獲得 40K 薪水",[12,40,41],{},"這位學員在一開始加入六角後，就相當積極在投入前端上，每天一早起來，就能在發問區看到他問好幾個問題。有很多線上課程都會限制問題只侷限在課程範圍內，但我們並未限制，讓學員問各種職涯、學習方向，好讓他們在學習路上不會走歪，能順利地朝夢想前進。",[12,43,44],{},"從下面截圖你也看到他拿到 40K 薪水絕非偶然，公司都會希望員工保有對程式的高度熱情，也因為該主管喜歡他的人格特質，所以願意錄取他。",[12,46,47],{},[15,48],{"alt":38,"src":49},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F08%2Fchen.png?alt=media&token=97fcf113-3d29-4c01-82c1-a6bb47f006ce",[25,51,52],{"id":52},"歷史系轉外商前端",[12,54,55],{},"這位學生是台北人，原本住在台中，由於對前端網頁有興趣，開始投入前端。在網頁排版投入還 ok，但開始在 JS 邏輯上開始碰壁，而他也清楚自己需要大量的練習才有辦法突破，所以也跟著六角學院舉辦的 The F2E 練功活動實做各種作品。",[12,57,58],{},"投入半年後，最後也如願在台北找到前端工作。",[12,60,61],{},[15,62],{"alt":52,"src":63},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F08%2Fone.png?alt=media&token=84bfccae-f390-41b1-81ec-5c92f8f4379c",[25,65,67],{"id":66},"大學時期努力投入畢業後無縫轉職","大學時期努力投入，畢業後無縫轉職",[12,69,70],{},"這位學員在他還沒開始找工作時，就對他印象深刻，原因是每週三的線上問答會都不錯過，且非常好學，在學校上是視覺傳達科系。",[12,72,73],{},"所以當他畢業後準備求職時，我看他手邊的作品也已經相當足夠，也如願在台中找到網頁設計師工作。",[12,75,76],{},[15,77],{"alt":67,"src":78},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F08%2Ftai.png?alt=media&token=5b5bd13a-4088-456e-a4f9-0d743126cec9",[25,80,81],{"id":81},"第二份前端工作獲得更好的收入與環境",[12,83,84],{},"這位學員一開始也是在六角學員學習，在 2017 年也如願找到第一份，但由於工作內容到後期相當乏味，且練不到像是 SPA 框架、介接 API 等功能，\n當他與我表明辭職意願後，我也與他共同檢視履歷與手邊上的資源，最終他也拿到更好的職缺。",[12,86,87],{},[15,88],{"alt":81,"src":89},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F08%2Fshiao.png?alt=media&token=7b8e4356-7ac2-425c-9622-370f26eed328",[25,91,92],{"id":92},"總結",[12,94,95],{},"線上課程的好處，就是我們能夠隨時線上給予協助，你也可以從上頭的截圖看出，求職絕非一蹴可幾，但只要你有夢想，有目標，六角的老師們都可以在線上與你一同規劃職涯。當寫程式找不到問題時，也能在線上給予方向。當傷心寂寞覺得冷時，也都會在線上傾聽你的處境，讓你有足夠的自信挑戰難關。",[12,97,98],{},"在工作上遇到困難，不懂職場環境時，六角目前也有凝聚力高的線上社群，已經就業的學長姐也能一同給予你建議與陪伴。我們會做到如此，就是希望大家都能成為「好」的工程師，未來學員們也能擁有足夠能量回饋台灣技術圈，讓大氛圍越來越好。",[12,100,101,102,109],{},"只要你有註冊任何一門主要付費課程，並完成最終作業，我們就願意協助你成為網頁設計師、前端工程師，同時也附上",[103,104,108],"a",{"href":105,"rel":106},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002F",[107],"nofollow","課程列表","。",[12,111,112,113,118],{},"如果你不曉得如何選課程，也可以點此 ",[103,114,117],{"href":115,"rel":116},"https:\u002F\u002Fhex.school\u002FP12UP",[107],"FB 訊息","線上與我們諮詢，希望也有機會讓你\u002F妳成為六角學生，以上經驗分享共勉之。",[12,120,121],{},"2018\u002F8\u002F27 洧杰筆",[12,123,124],{},[15,125],{"alt":92,"src":126},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F08%2Fhexschool_student.png?alt=media&token=a63ff28f-90b8-44be-8ea4-2f88114bba7a",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[131,132,133,134,135,136],{"id":27,"depth":129,"text":28},{"id":37,"depth":129,"text":38},{"id":52,"depth":129,"text":52},{"id":66,"depth":129,"text":67},{"id":81,"depth":129,"text":81},{"id":92,"depth":129,"text":92},null,"2018-08-27",false,"md",{},true,"\u002Fblog\u002F2018\u002F2018-08-27-interview",{"title":5,"description":20},"blog\u002F2018\u002F2018-08-27-interview",[147],"interview","0xK72yOOi4rVKZqktCWU18wHhhNJZBs1rTdh1UIOGAU",{"prev":150,"next":153,"related":156,"tags":169},{"title":151,"link":152},"【挑戰活動】網頁切版 PK 戰","\u002Fblog\u002F2018-09-13-hexschool-challenge",{"title":154,"link":155},"如何參加線上問答會","\u002Fblog\u002F2018-08-07-how-to-join-zoom",[157,160,163,166],{"title":158,"link":159},"學習永無止盡，即使已是前端工程師還是要繼續學習！","\u002Fblog\u002F2022-11-29-learning-never-end",{"title":161,"link":162},"【前端工程師之路】近兩年年資的怡真，持續往中階工程師發展！","\u002Fblog\u002F2022-10-25-dare-to-try",{"title":164,"link":165},"轉職前端之路：當了助教讓我更成長！","\u002Fblog\u002F2022-09-27-wangshuan-growth",{"title":167,"link":168},"【轉職前端工程師】我跟你一樣零基礎，不要怕，你也可以成功！","\u002Fblog\u002F2022-08-15-learn-from-zero",[170,171,172,173,174,175,147,176,177,178,179],"UI design","course","css","css3","enterprise","event","javascript","jobs","skilltree","software engineer",1790064292829]