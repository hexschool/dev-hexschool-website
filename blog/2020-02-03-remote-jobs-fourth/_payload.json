[{"data":1,"prerenderedAt":357},["ShallowReactive",2],{"blog:2020-02-03-remote-jobs-fourth":3,"blog:neighbors:2020-02-03-remote-jobs-fourth":326},{"id":4,"title":5,"author":6,"body":8,"categories":313,"date":314,"description":315,"draft":316,"extension":317,"meta":318,"navigation":319,"path":320,"seo":321,"stem":322,"tags":323,"thumbnail":17,"__hash__":325},"blog\u002Fblog\u002F2020\u002F2020-02-03-remote-jobs-fourth.md","【學員專屬徵才 - 第四波遠端助教】無工作經驗者優先錄取",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":298},"minimark",[11,18,31,34,38,47,50,54,57,60,67,70,73,79,88,91,94,97,117,120,131,134,163,167,175,178,210,213,221,224,227,255,258,261],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2020%2F02%2Fhex-hire-TA-fb-4th.png?alt=media&token=89ce6151-fbb6-4463-87fd-363e0e5440b9",[19,20,21,25,28],"ul",{},[22,23,24],"li",{},"你想要轉職工程師，但怕全職投入，卻沒有收入養活自己？",[22,26,27],{},"你想要成為工程師，但是對自己的技能沒有信心？",[22,29,30],{},"你希望學會程式後，也希望有機會一展長才？",[12,32,33],{},"如果以上列表，你的答案是 Yes，同時又是六角學員的話，我們要的就是你！",[35,36,37],"h2",{"id":37},"徵才職缺與門檻",[19,39,40],{},[22,41,42,46],{},[43,44,45],"strong",{},"網頁開發助教"," - 需有完成 CSS、JQ、RWD、BS4、JS 最終作業，並 CSS 與 RWD 皆有達到優的成績。",[12,48,49],{},"另外，我們會提供一個問題表單給您，以確保您對課程內容是否有足夠的理解。",[35,51,53],{"id":52},"門檻-qa","門檻 Q&A",[12,55,56],{},"Q：我如果只有註冊 RWD > BS4，沒註冊 CSS 與 jQ ，但也相當熟悉可以申請嗎？\nA：不行，必須四門課都有註冊，且做完最終作業，才可申請。",[12,58,59],{},"Q：我如果只有完成 CSS, jQ, RWD, BS4，但沒有完成 JS 可以申請嗎？\nA：不行，必須五門課都有做完最終作業，才可申請。",[12,61,62,63,66],{},"Q：如果我 CSS、RWD 其中一個作業沒有達優，是否就不能申請這一波申請？\nA：",[43,64,65],{},"只要你有在 2\u002F16 前提交作業便可申請，申請期限是到 3\u002F1","，但若沒獲得優選則不符合門檻*。*您可以等下波我們徵召前，提供修改後的作業，以達到優的成績後再行申請。",[12,68,69],{},"Q：如果我 CSS、RWD 成績是 A，但有給老師再次檢視，且老師也回信給我說改得都 ok，只差沒給我更新過後的「優」評價的話，可以申請嗎？\nA：可以，申請時提供 email 給我們確認即可。",[35,71,72],{"id":72},"評選機制",[12,74,75,78],{},[43,76,77],{},"所有符合上述門檻的學員，皆不會落選，此評選機制完全不看您的學歷","，但有優先順序，我們會依照以下機制，將條件優先提供給最需要這份工作的學員。",[80,81,82,85],"ol",{},[22,83,84],{},"全職準備且沒有工作收入者，優先入選",[22,86,87],{},"完全沒有程式工作經驗者，優先入選",[12,89,90],{},"若您尚未被選上，也會提供排隊編號給您，待前面學員工作結束後，便會透過 email 提供到職通知。",[12,92,93],{},"PS：此評選機制是希望真正有意成為工程師的學員可以透過此機制，能夠提早獲得程式工作經驗，有足夠的信心以協接業界。",[35,95,96],{"id":96},"這份工作的優點",[19,98,99,105,111],{},[22,100,101,104],{},[43,102,103],{},"知識再吸收","：藉由教學講解，能夠有效幫助自己的知識能夠重新收納整理，讓觀念更加穩固",[22,106,107,110],{},[43,108,109],{},"信心建立","：讓您藉由知識傳承，讓自己技術能夠再往上一個層次，並有足夠的信心挑戰更好的工作機會。",[22,112,113,116],{},[43,114,115],{},"工作彈性","：一週可以隨意選擇時數來工作，時間自主性高。",[35,118,119],{"id":119},"工作內容",[19,121,122,125,128],{},[22,123,124],{},"回覆學員程式問題",[22,126,127],{},"批改學員程式碼 (小節作業、最終作業)",[22,129,130],{},"協助評估課程流暢度，讓課程更臻完善。",[35,132,133],{"id":133},"工作時間",[19,135,136,144],{},[22,137,138,139],{},"每位應徵者工作長度如下",[19,140,141],{},[22,142,143],{},"網頁開發助教：3 個月",[22,145,146,147],{},"工作時段，有兩個時段可以挑選",[19,148,149,157],{},[22,150,151,152,156],{},"週一",[153,154,155],"del",{},"週五的早上 09:00","11:00 ，六日請任選一天(時段相同)，總計六天",[22,158,151,159,162],{},[153,160,161],{},"週五的下午 13:00","15:00，六日請任選一天(時段相同)，總計六天",[35,164,166],{"id":165},"舉例","舉例：",[19,168,169,172],{},[22,170,171],{},"小明：有 12 小時實習時間，時段為週一到週五的下午 1~3 點，週日的早上 9-11 點",[22,173,174],{},"小花：有 12 小時實習時間：時段為週一到週五的早上 9~11 點，週六的早上 9-11 點",[35,176,177],{"id":177},"工作流程",[19,179,180,186,192,198,204],{},[22,181,182,185],{},[43,183,184],{},"前期教育訓練","：將會提供教育訓練影片，不論在回覆口吻、書寫習慣、聚焦問題上，六角皆有一套 SOP ，以幫助助教快速了解其流程。",[22,187,188,191],{},[43,189,190],{},"模擬演練","：每一位遠端助教在初期都會配置一位助教長，初期在回覆問題前，都必須獲得助教長審核過後，才可代表六角助教回覆。藉由此機制，幫助學員能夠在此工作上能逐漸掌握訣竅。",[22,193,194,197],{},[43,195,196],{},"獨當一面","：我們會有不定期的審核機制，若審核成功，往後您就可獨立運作來回覆學員問題。",[22,199,200,203],{},[43,201,202],{},"知識傳承","：當您對工作業務駕輕就熟後，就能升級為助教長，成為未來新人的教練，以進行教育傳承。",[22,205,206,209],{},[43,207,208],{},"協助就業","：我們正在規劃官網提供學員履歷刊登服務，將會讓畢業的遠端助教優先進行人才曝光，協助企業媒合。",[35,211,212],{"id":212},"薪水福利",[19,214,215,218],{},[22,216,217],{},"158\u002Fhr",[22,219,220],{},"無勞健保，此工作內容為執行業務、非常態性工作，故視為勞務外包。",[35,222,223],{"id":223},"應徵辦法",[12,225,226],{},"請依照以下兩步驟進行申請：",[80,228,229,243],{},[22,230,231,234,235,242],{},[43,232,233],{},"能力判定","：我們挑出了些學員問題，請您盡量試著回覆該問題內容，在 excel 上填寫你的答案後，再將 Google excel 表單提供給我們檢視，",[236,237,241],"a",{"href":238,"rel":239},"https:\u002F\u002Fdocs.google.com\u002Fspreadsheets\u002Fd\u002F1pt2K92O396tjNLUhipKkeqe8iy7q7zHgV7JA9AK5fOw\u002Fedit#gid=1902149847",[240],"nofollow","網頁開發問題表單","。",[22,244,245,248,249,254],{},[43,246,247],{},"申請表單","：請填寫此",[236,250,253],{"href":251,"rel":252},"https:\u002F\u002Fforms.gle\u002FMXAsDYtVxwS5HTAU7",[240],"表單","進行應徵流程，3\u002F1 晚上 23:59 分停止收件。將會等此批助教都畢業後才會進行下一波徵召。",[12,256,257],{},"同時會在停止收件後，陸續審核發錄取通知信給第四波助教名單。",[35,259,260],{"id":260},"遠端助教工作心得",[19,262,263,270,277,284,291],{},[22,264,265],{},[236,266,269],{"href":267,"rel":268},"https:\u002F\u002Fayugioh2003.github.io\u002F2019\u002F07\u002Fhexschool-TA-experience\u002F",[240],"小麥 - 兩個月來擔任六角遠端切版助教的心得",[22,271,272],{},[236,273,276],{"href":274,"rel":275},"https:\u002F\u002Fmedium.com\u002F@boy80314\u002F0-%E5%89%8D%E7%AB%AF%E5%8A%A9%E6%95%99%E5%BF%83%E8%B7%AF%E6%AD%B7%E7%A8%8B-f6ae02543738",[240],"RTING LOU - 前端助教心路歷程",[22,278,279],{},[236,280,283],{"href":281,"rel":282},"https:\u002F\u002Fpvt5r486.github.io\u002Fnote\u002F20190524\u002F3138494786\u002F",[240],"宇軒 - 擔任六角遠端助教的那一段日子",[22,285,286],{},[236,287,290],{"href":288,"rel":289},"https:\u002F\u002Fmedium.com\u002F@bryanchu10\u002F%E5%85%AD%E8%A7%92%E5%AD%B8%E9%99%A2%E7%B6%B2%E9%A0%81%E6%8E%92%E7%89%88%E5%8A%A9%E6%95%99%E4%B9%8B%E6%97%85-89c82f6ac26b",[240],"冠穎 - 六角學院網頁排版助教之旅",[22,292,293],{},[236,294,297],{"href":295,"rel":296},"https:\u002F\u002Fmedium.com\u002Fjust-article\u002F%E5%85%AD%E8%A7%92%E5%AD%B8%E9%99%A2-js-%E9%81%A0%E7%AB%AF%E5%8A%A9%E6%95%99%E5%BF%83%E5%BE%97-16831a00df59",[240],"Yuko - 六角學院 JS 遠端助教心得",{"title":299,"searchDepth":300,"depth":300,"links":301},"",2,[302,303,304,305,306,307,308,309,310,311,312],{"id":37,"depth":300,"text":37},{"id":52,"depth":300,"text":53},{"id":72,"depth":300,"text":72},{"id":96,"depth":300,"text":96},{"id":119,"depth":300,"text":119},{"id":133,"depth":300,"text":133},{"id":165,"depth":300,"text":166},{"id":177,"depth":300,"text":177},{"id":212,"depth":300,"text":212},{"id":223,"depth":300,"text":223},{"id":260,"depth":300,"text":260},null,"2020-02-03","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2020\u002F2020-02-03-remote-jobs-fourth",{"title":5,"description":315},"blog\u002F2020\u002F2020-02-03-remote-jobs-fourth",[324],"jobs","sghsM6kuhOzZLRsToAdGpDrxsOwQpxjpIg5raJO6Deg",{"prev":327,"next":330,"related":333,"tags":346},{"title":328,"link":329},"【徵才】前端學期助教","\u002Fblog\u002F2020-03-18-frontend-assistant",{"title":331,"link":332},"2019 年前端工程師薪資調查","\u002Fblog\u002F2020-01-03-2019-frontend-salary",[334,337,340,343],{"title":335,"link":336},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":338,"link":339},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":341,"link":342},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":344,"link":345},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[347,348,349,350,351,352,353,354,324,355,356],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064292170]