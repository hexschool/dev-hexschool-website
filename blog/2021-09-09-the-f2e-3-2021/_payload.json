"https:\u002F\u002Fcreativecommons.org\u002Fpublicdomain\u002Fzero\u002F1.0\u002Fdeed.zh_TW",[40],"CC0","、",[36,62,65],{"href":63,"rel":64},"https:\u002F\u002Fcreativecommons.org\u002Flicenses\u002Fby\u002F3.0\u002Ftw\u002F",[40],"CC BY"," 格式，方便挑戰者重製成自己的 side project 與作品，授權範圍含：",[68,69,70,73,76],"ul",{},[29,71,72],{},"User story (使用者故事)",[29,74,75],{},"Functional Map (功能架構規劃)",[29,77,78],{},"Mockup (設計稿)",[22,80,81],{"id":81},"報名組別",[12,83,84],{},"請依照自己想投入的部分，額外選擇下面三條修練方向。",[86,87,89],"h3",{"id":88},"a個人組-ui-設計師","A.個人組-UI 設計師",[12,91,92,96],{},[93,94,95],"b",{},"設計 UI 介面","：每道修練主題我們都會提供 User story (使用者故事)，你可以依此使用 UI 繪圖軟體來設計 Mockup，以加強自己對 Web UI 的掌握度。",[86,98,100],{"id":99},"b個人組-前端工程師","B.個人組-前端工程師",[12,102,103,106],{},[93,104,105],{},"JS 開發 & 介接 API","：在開發中大型介面時，一個網頁上可能會有許多第三方介接的資料，例如後端的 RESTful API、Google Map、BaaS 等等，您可以思考我們所提供的修練主題，試著導入服務進去。",[86,108,110],{"id":109},"c團體組","C.團體組",[12,112,113],{},"欲報名團體組，請符合以下條件",[26,115,116,119,122],{},[29,117,118],{},"最少 2 人，最多限制為 4 人",[29,120,121],{},"建議至少 1 位前端工程師與 1 位 UI 設計師，但非強制，全部都為工程師也可以，但仍需要由組內成員完成 UI 設計稿。",[29,123,124],{},"UI 設計稿與程式開發需由組內成員共同完成。",[126,127,128],"blockquote",{},[12,129,130],{},"注意：一個帳號不可同時報團體組跟個人組",[12,132,133],{},[15,134],{"alt":110,"src":135},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F09%2F09%2F%E9%83%A8%E8%90%BD%E6%A0%BC%E5%9C%96%E7%89%87_%E5%B7%A5%E4%BD%9C%E5%8D%80%E5%9F%9F%201%20%E8%A4%87%E6%9C%AC.png?alt=media&token=e93ee7cc-d8a0-4c51-b07c-6fc22f6fa316",[22,137,138],{"id":138},"報名與參賽方式",[12,140,141,144,145,148,149,154,155,158,159,162],{},[93,142,143],{},"報名時間","：10\u002F14(四) 11:00 AM ~ 11\u002F7(日)\n",[93,146,147],{},"報名方式","：10\u002F14(四) 當天，請重新來到此頁面，即可透過",[36,150,153],{"target":151,"href":152},"_blank","https:\u002F\u002F2021.thef2e.com\u002F","連結","，前往全新的 The F2E 平台報名。\n",[93,156,157],{},"開賽規則","：每週一中午 12 點開放新題目投稿，隔週一中午 12 點前將作品投稿到平台。\n",[93,160,161],{},"投稿作品","：開賽後的每週登錄作品請投稿到 The F2E 平台，當週才算挑戰成功",[68,164,165,168],{},[29,166,167],{},"UI 、團體組開賽時間：11\u002F1(一)",[29,169,170],{},"前端組開賽時間：11\u002F8(一)",[12,172,173],{},"Q：為什麼 UI 跟團體組的開賽時間，比前端組提前一週？\nA：因為必須由 UI 設計師花一週時間設計完後，再交棒給前端組認領 UI 設計稿，並實做出來",[12,175,176],{},[15,177],{"alt":138,"src":178},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2021%2F09%2F09%2F%E9%83%A8%E8%90%BD%E6%A0%BC%E5%9C%96%E7%89%87_%E5%B7%A5%E4%BD%9C%E5%8D%80%E5%9F%9F%201.png?alt=media&token=2f29856d-d496-4140-b7dc-31cd018eec19",[22,180,181],{"id":181},"前端工程師修練方向",[12,183,184],{},"你可以依照我們提供的修練主題，主動練習自己想投入的新技術。為了確保每週都能挑戰功能，會建議 70% 用自己會的技術，30% 使用剛學會的新技術，以避免挑戰曲線不會過高。",[12,186,187],{},"以 CSS、JavaScript 為例，你可投入：",[86,189,191],{"id":190},"css","CSS",[68,193,194,197,200,203,206,209,212],{},[29,195,196],{},"會使用 float 排版時，可以嘗試使用 flexbox、grid 排版",[29,198,199],{},"思考響應式排版的實做方式，並在 iPad、mobile 有極好的使用者體驗",[29,201,202],{},"transition、animation、transform 動畫效果，提升網頁動線",[29,204,205],{},"能使用 CSS 實做出來的效果，就不要使用 JavaScript",[29,207,208],{},"預處理器 (SCSS、LESS) 與 PostCSS",[29,210,211],{},"CSS 框架 (Bootstrap、Pure)",[29,213,214],{},"設計模式 (SMACSS、OOCSS、BEM、MVCSS)",[86,216,218],{"id":217},"javascript","JavaScript",[68,220,221,241,247,253,259,265,271,277,283,289],{},[29,222,223,226,227],{},[93,224,225],{},"JS 基礎","：使用一個你不曾用過的 JS 技巧，例如\n",[68,228,229,232,235,238],{},[29,230,231],{},"array map 、filter、reduce",[29,233,234],{},"閉包、遞迴、物件導向",[29,236,237],{},"JSON 資料、字串處理",[29,239,240],{},"正規表達式 (Regular Expression)",[29,242,243,246],{},[93,244,245],{},"模組管理","：使用任務管理工具 (grunt、gulp)、模組打包工具 (webpack)",[29,248,249,252],{},[93,250,251],{},"ECMAScript","：ES 6、7 、8，並使用 Babel 兼容網頁瀏覽器。",[29,254,255,258],{},[93,256,257],{},"HTML5 API","：LocalStorage、Geolocation、File API",[29,260,261,264],{},[93,262,263],{},"介接第三方服務 API","： social login、weater、open data、自建 API",[29,266,267,270],{},[93,268,269],{},"導入 SPA 框架","： Vue、React、Angular",[29,272,273,276],{},[93,274,275],{},"工具框架","：lodash、Underscore",[29,278,279,282],{},[93,280,281],{},"2、3D 動畫開發","：使用 SVG、canvas、WebGL 設計動畫效果，例如 D3.js、three.js",[29,284,285,288],{},[93,286,287],{},"Node.js","：NPM 、後端框架 (koa、express)、API 設計、測試(Mocha、Nightwatch)",[29,290,291,294],{},[93,292,293],{},"程式檢查","：ESLint、JSHint",[22,296,297],{"id":297},"獎勵機制",[68,299,300,303,306],{},[29,301,302],{},"完成一道關卡：授予銅級數位勳章，並記錄在戰績榜上。",[29,304,305],{},"完成二道關卡：授予銀級數位勳章，並記錄在戰績榜上。",[29,307,308],{},"完成三道關卡：授予金級數位勳章，並記錄在戰績榜上。",[22,310,311],{"id":311},"評審獎項",[12,313,314,315,318],{},"為提升活動趣味性，本活動將針對第三道主題 - ",[93,316,317],{},"全台公車動態時刻查詢應用服務","，邀請評審來審核獎項。（一個人僅限領一個獎項）",[26,320,321,324,327,330,333],{},[29,322,323],{},"團體組評審獎 (1名)：獎金 8,500",[29,325,326],{},"個人組 - 前端工程師評審獎 (1名)：獎金 3,500",[29,328,329],{},"UI 組 - 前端工程師評審獎 (1名)：獎金 3,500",[29,331,332],{},"入圍獎 (共12名)：獎金 1,500",[29,334,335],{},"佳作獎 (共15名)：一式數位獎狀",[12,337,338],{},"詳細參賽得獎規定：",[26,340,341,349],{},[29,342,343,344,348],{},"比賽結果將於 110\u002F12\u002F16 (四) 公佈得獎名單，並公告於「",[36,345,347],{"href":152,"rel":346},[40],"活動官網","」同時主辦單位也會透過 Email 聯絡得獎者。",[29,350,351],{},"依中華民國稅法規定，中獎金額在新台幣 1,000(含)元以上者，所得將併入中獎人個人綜合所得稅申報，請中獎人配合繳交身分證影印本作為申報依據，中獎金額超過 NT$20,000 元，中獎人應依稅法先行繳交相當於獎品價值 10%機會中獎之稅金；非中華民國國境內居住之國人(即在中華民國境內居住未達 183 天之本國人及外國人)不論得獎者所得之金額，須就中獎所得扣繳20%機會中獎稅，扣繳稅款未超過 NT$2,000，免扣繳 (外籍人士不適用)，以供本公司做代繳稅及提供扣繳憑單使用。本公司統一於活動年之隔年寄發扣繳憑單給中獎人，以利中獎人申報之用。",[12,353,354],{},"本學院保留活動最終決定之權利。",[86,356,357],{"id":357},"評審門檻",[26,359,360,363],{},[29,361,362],{},"僅限 Web 瀏覽器應用來開發， Android、iOS APP 不在本活動評審範圍內。",[29,364,365,366,370],{},"有使用到 ",[36,367,369],{"href":38,"rel":368},[40],"TDX API","  的 API 服務",[86,372,373],{"id":373},"評審機制",[26,375,376,379],{},[29,377,378],{},"初選：將由六角學院前端、UI 評審 進行第一波篩選，並於  12\u002F3(五) 公布佳作、入圍名單",[29,380,381],{},"決選：由外部評審針對入圍獎進行最後篩選，並直播分享評審講名單！並於 12\u002F16(四) 公布名單",[86,383,384],{"id":384},"評審",[386,387,390,391,422,423,422,440,422,457,422,476,422,493],"div",{"className":388},[389],"card-grid","\n    ",[386,392,393,394,390],{},"\n        ",[386,395,397,398,397,404,397,408,393],{"style":396},"text-align: center;","\n            ",[15,399],{"src":400,"alt":401,"width":402,"