[{"data":1,"prerenderedAt":363},["ShallowReactive",2],{"blog:2019-09-24-god-and-hexschool":3,"blog:neighbors:2019-09-24-god-and-hexschool":332},{"id":4,"title":5,"author":6,"body":8,"categories":318,"date":319,"description":320,"draft":321,"extension":322,"meta":323,"navigation":324,"path":325,"seo":326,"stem":327,"tags":328,"thumbnail":330,"__hash__":331},"blog\u002Fblog\u002F2019\u002F2019-09-24-god-and-hexschool.md","【大神來六角】十月直播主題：遠端接案",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":306},"minimark",[11,18,23,26,29,32,37,41,50,63,76,80,84,87,104,111,115,118,128,150,157,161,164,173,200,207,211,217,223,236,240,245,253,257,260,264,267,271,286,290,299],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F09%2F%E5%A4%A7%E7%A5%9E-calendar-oct.png?alt=media&token=9c0516f8-cefb-4fc8-b9f9-a89979aa772b",[19,20,22],"h2",{"id":21},"本月主題遠端接案","本月主題：遠端接案",[12,24,25],{},"遠端工作是這年來相當夯的題目之一，可以不進公司上班，也是許多人的夢想，尤其是工程師只要有電腦跟網路，到哪裡都可以工作。\n但是到底該如何踏出下一步呢？可能留在自己家鄉，遠端國內外的正職工作嗎？假使要遠端接案，該注意哪些細節呢？",[12,27,28],{},"這次主題，我們特別找來四位具有豐富遠端實務的講者，來為大家指點迷津！",[19,30,31],{"id":31},"講師介紹",[33,34,36],"h3",{"id":35},"第一週-電商前端遠距開發者","第一週 - 電商前端遠距開發者",[15,38],{"src":39,"width":40,"height":40,"alt":36},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F09%2Feden.jpg?alt=media&token=4f451d64-050a-4814-b222-e42693cdc25c",160,[12,42,43,44,49],{},"Eden 目前是 Gabor 的軟體工程師，同時也是是六角學院的",[45,46,48],"a",{"href":47},"\u002Fblog\u002F2017-03-15-interview","學長","，公司型態皆是遠端協作為主，擁有兩年前端遠端開發經驗的他，將為大家分享遠端經驗談",[51,52,53,57,60],"ul",{},[54,55,56],"li",{},"講座時間： 2019\u002F10\u002F8 (二) 19:30~21:00",[54,58,59],{},"講者姓名：Eden",[54,61,62],{},"講者經歷：Gabor 軟體工程師",[12,64,65],{},[45,66,72],{"href":67,"className":68,"title":71},"#addBlogEvent",[69,70],"btn-radius","mp-click","我要報名",[73,74,75],"span",{}," 我要報名 ",[33,77,79],{"id":78},"第二週-客戶成功經理聊遠端","第二週 - 客戶成功經理聊遠端",[15,81],{"src":82,"width":83,"height":40,"alt":79},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fweb%2Fcase%2F575556_143462065790388_637676307_n.jpg?alt=media&token=8945d396-8c06-43d5-aa34-e98b8ac4639f","",[12,85,86],{},"Fable 公司專注於產品開發管理，幫助了許多具有營運能量、業務資源、但缺乏技術開發經驗的公司將產品做上線。六角學院目前也有許多學員與他們遠端協作開發。這次我們特別邀請到他們的 蔡嘉豪，來分享他們是如何與工程師們遠端協作。",[51,88,89,92,95,98,101],{},[54,90,91],{},"講座時間： 2019\u002F10\u002F15 (二) 19:30~21:00",[54,93,94],{},"講者姓名：蔡嘉豪",[54,96,97],{},"講者背景：商學院背景，誤打誤撞闖進軟體世界。現於寓意科技擔任Client Success Manager一職，致力於協助客戶一同解決問題，並持續尋找更好的產品定位和方向。",[54,99,100],{},"講者職稱：Client Success Manager",[54,102,103],{},"講者公司名稱：Fable Technology 寓意科技",[12,105,106],{},[45,107,109],{"href":67,"className":108,"title":71},[69,70],[73,110,75],{},[33,112,114],{"id":113},"第三週-remote-taiwan-主理人談遠端發展","第三週 - Remote Taiwan 主理人談遠端發展",[15,116],{"src":117,"width":40,"height":83,"alt":114},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F09%2FAndrew%20Yeh.jpg?alt=media&token=3068d560-1dd7-4dff-8eaf-2096d84a3853",[12,119,120,121,127],{},"Andrew 是 ",[45,122,126],{"href":123,"rel":124},"https:\u002F\u002Fwww.facebook.com\u002Fgroups\u002Fremotetaiwan\u002F",[125],"nofollow","Remote Taiwan"," 的主理人，擅長領域為 WOM 口碑分析師\u002FSocial Listening\u002F策略規劃\u002FKOL行銷操作合作。六角校長洧杰也曾經與他暢談遠端協作，他本身也是一位遠端工作者，這次也將邀請他來分享遠端工作者的經驗談！",[51,129,130,133,136],{},[54,131,132],{},"講座時間： 2019\u002F10\u002F22 (二) 19:30~21:00",[54,134,135],{},"講者姓名：葉濬慈 ( Andrew Yeh )",[54,137,138,139],{},"講者經歷：\n",[51,140,141,147],{},[54,142,143,146],{},[45,144,126],{"href":123,"rel":145},[125]," 主理人",[54,148,149],{},"Notion Taiwan 社群大使",[12,151,152],{},[45,153,155],{"href":67,"className":154,"title":71},[69,70],[73,156,75],{},[33,158,160],{"id":159},"第四週-多年遠距後端開發經驗","第四週 - 多年遠距後端開發經驗",[15,162],{"src":163,"width":83,"height":40,"alt":160},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexs