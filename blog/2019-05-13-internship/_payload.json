[{"data":1,"prerenderedAt":299},["ShallowReactive",2],{"blog:2019-05-13-internship":3,"blog:neighbors:2019-05-13-internship":268},{"id":4,"title":5,"author":6,"body":8,"categories":255,"date":256,"description":257,"draft":258,"extension":259,"meta":260,"navigation":261,"path":262,"seo":263,"stem":264,"tags":265,"thumbnail":17,"__hash__":267},"blog\u002Fblog\u002F2019\u002F2019-05-13-internship.md","【徵人】【高雄】實習生 1~3 名",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":244},"minimark",[11,18,26,29,32,37,40,43,56,59,73,77,80,83,94,97,105,109,112,114,122,125,133,136,160,164,167,169,180,182,196,199,203,214,218,221,225,234,239],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F05%2Fhex-hire-intern-fb.png?alt=media&token=dffc89f2-dc10-4e2f-ba74-e4c45697f692",[12,19,20,21,25],{},"六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，",[22,23,24],"strong",{},"讓更多人藉由線上學習在職涯規劃上有更多的選擇","是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",[12,27,28],{},"我們將深入了解您想發展的領域，每位實習生我們都會量身打造專屬於您的舞台，並讓您實際瞭解公司營運 Know how。",[12,30,31],{},"如果以下職缺沒有適合您的，歡迎您毛遂自薦自己的長才，為自己找份適合的職缺，我們歡迎肯主動掌握機會的你\u002F妳。",[33,34,36],"h2",{"id":35},"社群經營實習生","【社群經營實習生】",[12,38,39],{},"社群，意即代表對某件事物有相同興趣的一群人。六角學院便是對「程式開發」有興趣的 TA 集結而成，我們希望您的加入，能夠活絡社群上的發展，說著彼此間了解的「共通語言」，讓我們的 TA 因您加入而提升社群的凝聚力。",[12,41,42],{},"工作內容：",[44,45,46,50,53],"ol",{},[47,48,49],"li",{},"社群營運相關工作",[47,51,52],{},"協助經營社群發展，目前經營管道有 FB 粉絲團、FB 社團、IG、Line@",[47,54,55],{},"協助規劃\u002F執行活動內容",[12,57,58],{},"加分條件：",[44,60,61,64,67,70],{},[47,62,63],{},"對文字敏銳度高，有經營自己的部落格",[47,65,66],{},"對程式開發有極大的興趣",[47,68,69],{},"熱愛接收新知和各類趨勢情報",[47,71,72],{},"有經營自己的社群服務，例 FB、IG、twitter",[33,74,76],{"id":75},"電商數位行銷實習生","【電商數位行銷實習生】",[12,78,79],{},"如何用正確的起手式，讓潛在客戶能夠透過數位傳播工具認識公司產品，是每間公司絕對要會的必備技能，我們會親自帶領您深入戰場，了解何謂「電商數位行銷」。",[12,81,82],{},"工作內容",[44,84,85,88,91],{},[47,86,87],{},"操作數位廣告工具，嘗試用各種行銷文案與素材優化廣告內容",[47,89,90],{},"深入理解六角產品開發精神，並協助擬定產品行銷方針",[47,92,93],{},"與社群經營實習生共同規劃\u002F執行活內容",[12,95,96],{},"加分條件",[44,98,99,102],{},[47,100,101],{},"熟悉 FB\u002FGoogle Ads 廣告工具操作，理解如何批次修改\u002F上傳廣告素材",[47,103,104],{},"在專題 \u002F 工作經驗中有進行數據分析的相關經驗",[33,106,108],{"id":107},"前端與後端實習生","【前端與後端實習生】",[12,110,111],{},"今年，我們將有許多平台開發等待被落實，您將有機會與我們共同開發各種新產品，與共同創辦人們同心協力，打造出讓全亞洲都會使用到的六角平台。",[12,113,82],{},[44,115,116,119],{},[47,117,118],{},"協助公司既有產品營運",[47,120,121],{},"新產品前後端開發",[12,123,124],{},"必備條件",[44,126,127,130],{},[47,128,129],{},"必須對其中一端(前端、後端)有足夠的了解",[47,131,132],{},"履歷上需附上作品，以展示您的技術能力",[12,134,135],{},"目前六角使用技術，期待您的加入，提昇我們的開發能量",[137,138,139,142,145,148,151,154,157],"ul",{},[47,140,141],{},"後端與資料庫：Node.js、PHP",[47,143,144],{},"前端語言：Vue.js",[47,146,147],{},"版控工具： Github Private Repository",[47,149,150],{},"溝通工具：Slack",[47,152,153],{},"協作工具：GitHub issue、Trello、quip",[47,155,156],{},"伺服器技術：Heroku、Cloudflare",[47,158,159],{},"輔助技能：Hexo、Gulp、Webpack",[33,161,163],{"id":162},"視覺設計實習生","【視覺設計實習生】",[12,165,166],{},"在六角學院，包共創辦人，就有一半以上的職員都具備設計背景，就足以了解「設計」對我們來說有多麽重要，我們希望由您的加入，為我們的品牌增添豐富色彩。",[12,168,82],{},[44,170,171,174,177],{},[47,172,173],{},"六角學院形象設計",[47,175,176],{},"配合課程設計網頁素材、課程素材、宣傳品",[47,178,179],{},"各式平面設計需求",[12,181,96],{},[44,183,184,187,190,193],{},[47,185,186],{},"插畫技能",[47,188,189],{},"影片剪接",[47,191,192],{},"UI 設計",[47,194,195],{},"使用 Mac, Sketch 軟體",[197,198],"hr",{},[33,200,202],{"id":201},"薪資與福利","【薪資與福利】",[137,204,205,208,211],{},[47,206,207],{},"基本薪資",[47,209,210],{},"享勞健保",[47,212,213],{},"六角開的課程皆能免費參加",[33,215,217],{"id":216},"工作地點時間","【工作地點\u002F時間】",[12,219,220],{},"地點：高雄鹽埕區\n時間：一週最少兩天",[33,222,224],{"id":223},"投遞履歷管道","【投遞履歷管道】",[12,226,227,228,233],{},"1.郵件地址：請 mail 到 ",[229,230,232],"a",{"href":231},"mailto:service@hexschool.com","service@hexschool.com","\n2.郵件標題：【應徵】XX 實習生_姓名 (XX 請自行代入要應徵的職缺)\n3.履歷版本：請提供 PDF 或線上履歷\n4.回覆問題：除履歷外，還請回覆以下兩個問題，好讓我們更加了解您",[12,235,236],{},[22,237,238],{},"問題一：「您對於未來職涯的自己有什麼憧憬，這份工作能幫助您嗎？」",[12,240,241],{},[22,242,243],{},"問題二：「承一，希望六角提供什麼資源，好讓您能盡快達成目標？」",{"title":245,"searchDepth":246,"depth":246,"links":247},"",2,[248,249,250,251,252,253,254],{"id":35,"depth":246,"text":36},{"id":75,"depth":246,"text":76},{"id":107,"depth":246,"text":108},{"id":162,"depth":246,"text":163},{"id":201,"depth":246,"text":202},{"id":216,"depth":246,"text":217},{"id":223,"depth":246,"text":224},null,"2019-05-13","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2019\u002F2019-05-13-internship",{"title":5,"description":257},"blog\u002F2019\u002F2019-05-13-internship",[266],"jobs","IztM9-AMS7tgAZjZI05Qbp_SFjuECgzWliWOA4bsRjg",{"prev":269,"next":272,"related":275,"tags":288},{"title":270,"link":271},"【大神來六角】六月直播主題：檔案傳輸","\u002Fblog\u002F2019-05-22-god-and-hexschool",{"title":273,"link":274},"【學員專屬徵才 - 遠端助教】無程式工作經驗者優先錄取","\u002Fblog\u002F2019-05-13-remote-jobs",[276,279,282,285],{"title":277,"link":278},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":280,"link":281},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":283,"link":284},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":286,"link":287},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[289,290,291,292,293,294,295,296,266,297,298],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064293070]