[{"data":1,"prerenderedAt":187},["ShallowReactive",2],{"blog:2018-04-11-keynote-king":3,"blog:neighbors:2018-04-11-keynote-king":156},{"id":4,"title":5,"author":6,"body":8,"categories":144,"date":145,"description":20,"draft":146,"extension":147,"meta":148,"navigation":149,"path":150,"seo":151,"stem":152,"tags":153,"thumbnail":17,"__hash__":155},"blog\u002Fblog\u002F2018\u002F2018-04-11-keynote-king.md","線上講座 - 簡報力就是你的說服力",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":135},"minimark",[11,18,21,29,33,52,55,68,71,74,77,80,91,114,125,128],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2018%2F01%2Fkeynote_cover.png?alt=media&token=bd37bf3b-dc9f-4ec5-8f01-31e01cfc743f",[12,19,20],{},"工作、面試、報告中絕對免不了簡報，好的簡報不僅賞心悅目、提高內容的說服力，並且還能時時提醒自己接下來要介紹的內容，絕對是會議中的一等一神器。",[12,22,23,24,28],{},"我們課程中已經介紹許許多多關於開發相關主題，但除了程式開發外，我們也需要具備市場上許多通用技能，如：寫作、美感、行銷、會話等，這些都會無形的增加開發者在市場上的價值。這次我們特別邀請數千人追蹤、簡報模板超過萬人次下載的簡報高高手「黃祺浩」來和我們分享 \"",[25,26,27],"strong",{},"決勝簡報力","\"！成就學員在市場上的千萬競爭力！",[30,31,32],"h2",{"id":32},"黃祺浩個人簡介",[12,34,35,36,39,40,43,44,47,48,51],{},"黃祺浩，熱衷簡報設計，喜歡閱讀勝於旅遊。原是人力銀行業務主管，在轉職過程中，因簡報作品而獲得出書與簡報設計工作的機會。設計過高達兩千六百多次分享的簡報及",[25,37,38],{},"破萬人次下載的簡報模版","，也曾參與製作 ",[25,41,42],{},"Mercedes-Benz"," 與 ",[25,45,46],{},"Dell"," 發表會的簡報，並著有《",[25,49,50],{},"Keynote 關鍵報告","》一書。",[30,53,54],{"id":54},"主題內容",[56,57,58,62,65],"ul",{},[59,60,61],"li",{},"美感與靈感",[59,63,64],{},"簡報設計規則與圖文配置",[59,66,67],{},"簡報中的心法分享",[12,69,70],{},"課程大綱可能會略有調整，講師會特別調配出適合六角學員的課程內容喔。",[30,72,73],{"id":73},"課程時間",[12,75,76],{},"課程會安排在線上問答 (4\u002F25 週三晚上 7:30)：",[30,78,79],{"id":79},"報名辦法",[12,81,82,83,86,87,90],{},"凡 ",[25,84,85],{},"有註冊六角學院主要課程學員","，在 Udemy 信箱每週都能收到課程通知(記得收信喔)，課程內容將無須額外付費，",[25,88,89],{},"主要課程列表"," 如下：",[56,92,93,96,99,102,105,108,111],{},[59,94,95],{},"使用 HTML、CSS 開發一個網站",[59,97,98],{},"jQuery 網頁互動效果",[59,100,101],{},"JavaScript - 學徒的試煉",[59,103,104],{},"RWD 響應式網頁設計",[59,106,107],{},"一頁式金流商務網頁",[59,109,110],{},"Bootstrap 4",[59,112,113],{},"Node.js 前後端開發實戰",[12,115,116],{},[25,117,118],{},[119,120,124],"a",{"href":121,"rel":122},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002F",[123],"nofollow",">> 進入課程列表 \u003C\u003C",[30,126,127],{"id":127},"注意事項",[56,129,130],{},[59,131,132],{},[25,133,134],{},"課程內容不一定會錄影，請同學盡量踴躍參加",{"title":136,"searchDepth":137,"depth":137,"links":138},"",2,[139,140,141,142,143],{"id":32,"depth":137,"text":32},{"id":54,"depth":137,"text":54},{"id":73,"depth":137,"text":73},{"id":79,"depth":137,"text":79},{"id":127,"depth":137,"text":127},null,"2018-04-11",false,"md",{},true,"\u002Fblog\u002F2018\u002F2018-04-11-keynote-king",{"title":5,"description":20},"blog\u002F2018\u002F2018-04-11-keynote-king",[154],"event","pSBrvPeqnvdP29TVdqn0ZVQ38fALHR-giWgy-09w6bY",{"prev":157,"next":160,"related":163,"tags":176},{"title":158,"link":159},"2018 前端開發者學習地圖！","\u002Fblog\u002F2018-04-16-skill_tree",{"title":161,"link":162},"線上講座 - Node.js 的各種運用","\u002Fblog\u002F2018-01-16-jan-node",[164,167,170,173],{"title":165,"link":166},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":168,"link":169},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":171,"link":172},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":174,"link":175},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[177,178,179,180,181,154,182,183,184,185,186],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064292974]