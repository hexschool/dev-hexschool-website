[{"data":1,"prerenderedAt":441},["ShallowReactive",2],{"blog:2022-02-22-hex-discord-king":3,"blog:neighbors:2022-02-22-hex-discord-king":410},{"id":4,"title":5,"author":6,"body":8,"categories":397,"date":398,"description":399,"draft":400,"extension":401,"meta":402,"navigation":403,"path":404,"seo":405,"stem":406,"tags":407,"thumbnail":17,"__hash__":409},"blog\u002Fblog\u002F2022\u002F2022-02-22-hex-discord-king.md","六角 Discord 討論王",[7],"六角學院\u002F卡斯伯",{"type":9,"value":10,"toc":381},"minimark",[11,18,23,26,39,42,47,50,64,67,71,77,81,84,100,104,113,121,126,129,135,163,167,170,174,179,182,186,197,200,211,214,217,220,237,240,243,251,254,257,271,277,281,287,312,323,334,342,353,363,366,369,377],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F02%2F22%2FUntitled.png?alt=media&token=f18d1462-348b-44cd-8d74-bc3c631ff640",[19,20,22],"h2",{"id":21},"在自學的時候","在自學的時候...",[12,24,25],{},"你在自學的時候，是否會覺得...",[27,28,29,33,36],"ul",{},[30,31,32],"li",{},"雞毛蒜皮的小事，覺得到「問答區」發問，有點太小題大作了",[30,34,35],{},"線上課程的優點就是沒有時間、空間限制，缺點就是沒有同學共學的感覺",[30,37,38],{},"除了課程問題以外，還想跟人一起聊聊開發的事情，但卻不知如何開始",[12,40,41],{},"求學的過程中，除了老師在台上解說以外，同學們的互動一樣是學習的一環，而我們把這個概念加入到直播課程中有非常好的效果。",[12,43,44],{},[15,45],{"alt":22,"src":46},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F02%2F22%2F%E8%B2%BC%E4%B8%8A%E7%9A%84%E5%BD%B1%E5%83%8F_2022_1_22_%E4%B8%8B%E5%8D%885_33.png?alt=media&token=5cfd1da1-3718-4adc-936e-09e54b45a36a",[12,48,49],{},"在 Discord 的討論頻道中，同學可以針對課程中的任何資源及知識進行討論，甚至也會不藏私地把自己的心得筆記分享給大家，下圖是其中一門直播班的部分討論，透過學員討論可以...",[27,51,52,55,58,61],{},[30,53,54],{},"更快釐清自己不熟的地方",[30,56,57],{},"與多人互動，學習不孤單",[30,59,60],{},"透過幫助他人來增加自己的除錯能力",[30,62,63],{},"同學的建議，有可能比助教、講師更貼近自己要的答案",[12,65,66],{},"因此，我們想把這個討論氛圍延伸至所有的學員，鼓勵大家在頻道中進行學習及討論。",[19,68,70],{"id":69},"加入discord討論頻道提升等級","加入「Discord」討論頻道提升等級",[12,72,73,74],{},"提升等級？是 RPG 的感覺嗎？\n沒錯，接下來在六角 Discord 頻道中，你可以透過「發言」的方式提升等級，每當升級時系統會給予提示，並給予額外的獎勵稱號。\n",[15,75],{"alt":70,"src":76},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F02%2F22%2F%E8%B2%BC%E4%B8%8A%E7%9A%84%E5%BD%B1%E5%83%8F_2022_1_23_%E4%B8%8A%E5%8D%8810_01.png?alt=media&token=e5f6a883-eb3d-443c-8a4e-e62ee85c8567",[78,79,80],"h3",{"id":80},"升級獎勵",[12,82,83],{},"除此之外，在活動期間（即日起至 2022\u002F3\u002F31）之間，我們將會準備額外獎項給予最高等級的「獎勵稱號」以及額外獎品，相關內容包含：\n獎勵獎項：",[27,85,86,97],{},[30,87,88,89,96],{},"前 1 ~ 3 名均獲得：Discord Nitro Classic 一個月（可使用自訂表情等",[90,91,95],"a",{"href":92,"rel":93},"https:\u002F\u002Fsupport.discord.com\u002Fhc\u002Fzh-tw\u002Farticles\u002F115000435108-Discord-Nitro-Classic-Nitro",[94],"nofollow","額外功能","）",[30,98,99],{},"前 20 名獎勵稱號：「始祖六角發言王」",[19,101,103],{"id":102},"活動一參與影音課程討論","活動一：參與影音課程討論",[12,105,106,107,112],{},"我們希望影音課程也有相同的討論氛圍，因此凡註冊「",[90,108,111],{"href":109,"rel":110},"https:\u002F\u002Fwww.hexschool.com\u002Fcourses\u002F",[94],"六角學院 - 影音課程","」皆可加入相關討論頻道，頻道主要區分為：",[27,114,115,118],{},[30,116,117],{},"切版課程討論，包含：HTML、jQuery、響應式網頁(RWD)、Bootstrap",[30,119,120],{},"JS 課程討論，包含：JavaScript 必修、JavaScript 核心、Vue 實戰影音",[12,122,123],{},[15,124],{"alt":103,"src":125},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F02%2F22%2FUntitled%201.png?alt=media&token=cec00c6f-0aae-4759-8c08-60da935dd272",[12,127,128],{},"在頻道中你可以盡情地發問學習中遇到的問題，接下來當有同學回覆你的問題，請給予幫助的同學、助教最大的感謝，在無償的回覆中，你的感謝將會勝過一切。",[12,130,131],{},[132,133,134],"b",{},"參加辦法：",[136,137,138,147,150,153,160],"ol",{},[30,139,140,141,146],{},"加入六角 Discord（可參考 ",[90,142,145],{"href":143,"target":144},"https:\u002F\u002Fhex.school\u002FtJJJO","_blank","六角 Discord 引導教學"," ）",[30,148,149],{},"領取「切版系列課程村民」、「JS 系列課程村民」對應課程身份組",[30,151,152],{},"在「切版系列課程」、「JS系列課程」提交你的問題",[30,154,155,156,96],{},"開啟討論串，並與同學討論。（請參照 ",[90,157,159],{"href":158,"target":144},"https:\u002F\u002Fhex.school\u002FTo5JF"," 發問範例",[30,161,162],{},"記得，要給予同學正向的感謝喔～",[19,164,166],{"id":165},"活動二學習加速頻道","活動二：學習加速頻道",[12,168,169],{},"常常懶癌發作沒辦法按照計畫學習嗎？或者訂了計畫，但常常三天打魚，兩天曬網的心態導致無疾而終呢？\n在過去我們有提供 Slack「軟體工程師求職特訓班」，每天早上我們會精神喊話，請同學們說出自己的學習目標，並在下午回報自己的學習進度。透過說出自己的計畫，更能確實完成目標，反覆幾天以後，就會養成自動前來報道的習慣。",[12,171,173],{"style":172},"background: rgba(235, 236, 237, 0.3);","成功的沒有特別的技巧，只要持續「堅持」",[12,175,176],{},[15,177],{"alt":166,"src":178},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2022%2F02%2F22%2F%E8%B2%BC%E4%B8%8A%E7%9A%84%E5%BD%B1%E5%83%8F_2022_1_23_%E4%B8%8A%E5%8D%8810_37.png?alt=media&token=1de408d7-0b54-4202-bc69-d287565cdffb",[12,180,181],{},"在這簡單的流程中，已經有許多學員求職成功。因此，我們在 Discord 中也會加入「💪 軟體工程師求職特訓班」，邀請你一同大聲說出「學習計畫」。",[12,183,184],{},[132,185,134],{},[136,187,188,191,194],{},[30,189,190],{},"加入六角 Discord",[30,192,193],{},"每天早上 9:00、下午 6:00 均會發佈公告",[30,195,196],{},"接下來在頻道內說明你的學習計畫",[12,198,199],{},"範例貼文：",[201,202,208],"pre",{"className":203,"code":205,"language":206,"meta":207},[204],"language-text","今天投入第 30 天，預計學習：\n- 上午：Vue 作品實戰班，第一週作業\n- 下午：複習 JavaScript 核心篇「運算子、型別與文法」\n\n昨天學習心得：\n- 安排太多的內容，導致無法達到目標，接下來預期每天安排六小時進度，預留兩小時作為緩衝\n","text","",[209,210,205],"code",{"__ignoreMap":207},[19,212,213],{"id":213},"活動相關說明",[78,215,216],{"id":216},"活動頻道",[12,218,219],{},"本次活動限制在以下頻道發言才可升級，包含：",[27,221,222,225,228,231,234],{},[30,223,224],{},"『綜』閒聊大廳",[30,226,227],{},"『綜』作業求助",[30,229,230],{},"切版課程討論區",[30,232,233],{},"JS課程討論區",[30,235,236],{},"軟體工程師求職特訓班",[12,238,239],{},"相關直播班並沒有在本次的活動範圍內，因此發言討論將不具有升級資格。",[78,241,242],{"id":242},"升級規則",[27,244,245,248],{},[30,246,247],{},"須在限制的頻道內才可獲得經驗值",[30,249,250],{},"每次發言會有冷卻時間，冷卻時間內連續發言無法再次獲得經驗值",[78,252,253],{"id":253},"限制行為",[12,255,256],{},"我們鼓勵學員在 Discord 中進行「提問」、「回覆」甚至是「閒聊」，在合理的使用範圍內我們均不會給予太多的限制，但如果有以下行為，我們將會重置等級並失去本次活動獲獎資格：",[27,258,259,262,265,268],{},[30,260,261],{},"惡意洗頻",[30,263,264],{},"使用無意義的文字刷等級",[30,266,267],{},"發表攻擊、騷擾的言論並屢勸不聽",[30,269,270],{},"發表族群仇恨、政治敏感、詐騙並屢勸不聽",[12,272,273],{},[90,274,276],{"href":275,"target":144},"https:\u002F\u002Fdiscord.gg\u002F822N5Ycttt","六角學院 Discord 連結",[19,278,280],{"id":279},"問與答","問與答：",[12,282,283,286],{},[132,284,285],{},"Ｑ：我還沒使用過 Discord，該如何開始呢？","\n你可以參考以下三個步驟，加入 Discord 開始參與本次活動！",[136,288,289,296,304],{},[30,290,291,292],{},"加入 Discord：",[90,293,295],{"href":143,"rel":294},[94],"引導教學",[30,297,298,299],{},"在 聊天大廳 進行報到：",[90,300,303],{"href":301,"rel":302},"https:\u002F\u002Fhex.school\u002FDpiUI",[94],"開始報到",[30,305,306,307,311],{},"提出你學習上的問題吧！（",[90,308,310],{"href":158,"rel":309},[94],"發問技巧","說明）",[12,313,314,322],{},[132,315,316,317,321],{},"Ｑ：我是",[318,319,320],"span",{},"新手","，如何升級呢？","\n如果你剛接觸程式不久、學習上有些問題、擔心自己學習不正確，可以使用以下方式來提升等級：",[136,324,325,328,331],{},[30,326,327],{},"在「作業求助、切版課程、js課程」等討論區進行發問",[30,329,330],{},"在「軟體工程師求職特訓班」提出自己的學習計畫",[30,332,333],{},"在「閒聊大廳」詢問自己學習的狀況",[12,335,336,341],{},[132,337,316,338,321],{},[318,339,340],{},"老手","\n如果你已經接觸程式一段時間，想透過回覆問題、幫助他人來改善自己學習的盲點，甚至從中獲得成就感，你可以透過以下方式升級：",[136,343,344,347,350],{},[30,345,346],{},"回覆「作業求助、切版課程、js課程」等同學們的問題",[30,348,349],{},"在「閒聊大廳」分享最新的技術現況",[30,351,352],{},"在「軟體工程師求職特訓班」提出更進階的學習計畫",[12,354,355,358,359,362],{},[132,356,357],{},"Ｑ：發問一定會有人回覆嗎？這個跟問答區有什麼樣的不同呢？","\n因為問答區的回覆是由專門的助教給予回饋，而每位助教的回覆不一定適合每個同學的學習狀況，在我們的經驗中，",[132,360,361],{},"學習經歷接近的同學","給予的回覆更容易被理解。",[12,364,365],{},"因此我們開立「六角 Discord 討論頻道」，鼓勵不管你的程度為何，只要遇過的問題都能試著回覆並給予意見，有時你的小小經驗，反而是解決同學疑惑的關鍵。",[12,367,368],{},"所以問題都會是以同學們的回覆為主，並非助教、講師進行回饋，回覆率自然不會是 100%。",[27,370,371,374],{},[30,372,373],{},"如果你想盡快獲得答案、想與同學們交流深度問題，可以透過 Discord 發問",[30,375,376],{},"如果你想要獲得 100% 回覆的課程問題，可以透過課程的問答區",[12,378,379],{},[90,380,276],{"href":275,"target":144},{"title":207,"searchDepth":382,"depth":382,"links":383},2,[384,385,389,390,391,396],{"id":21,"depth":382,"text":22},{"id":69,"depth":382,"text":70,"children":386},[387],{"id":80,"depth":388,"text":80},3,{"id":102,"depth":382,"text":103},{"id":165,"depth":382,"text":166},{"id":213,"depth":382,"text":213,"children":392},[393,394,395],{"id":216,"depth":388,"text":216},{"id":242,"depth":388,"text":242},{"id":253,"depth":388,"text":253},{"id":279,"depth":382,"text":280},null,"2022-02-22","在 Discord 的討論頻道中，同學可以針對課程中的任何資源及知識進行討論，甚至也會不藏私地把自己的心得筆記分享給大家，在六角 Discord 頻道中，你可以透過「發言」的方式提升等級，每當升級時系統會給予提示，並給予額外的獎勵稱號。",false,"md",{},true,"\u002Fblog\u002F2022\u002F2022-02-22-hex-discord-king",{"title":5,"description":399},"blog\u002F2022\u002F2022-02-22-hex-discord-king",[408],"event","1Nuu_nAe1VPNGMAbYlqKRUUOVFkciFgYauwU3lOQ6AE",{"prev":411,"next":414,"related":417,"tags":430},{"title":412,"link":413},"【公益程式體驗營】擺脫動亂學前端， 掌握技能保平安","\u002Fblog\u002F2022-03-18-global-welfare",{"title":415,"link":416},"【4月開班】Node.js 後端工程師養成直播班","\u002Fblog\u002F2022-02-17-node-training-intro",[418,421,424,427],{"title":419,"link":420},"7 週年感謝祭優惠活動","\u002Fblog\u002F2022-12-16-7th-anniversary-thanks",{"title":422,"link":423},"The F2E 4th 前端 & UI 修煉精神時光屋","\u002Fblog\u002F2022-09-09-the-f2e-4th-2022",{"title":425,"link":426},"邀請：【企業交流】前端學員成果發表會","\u002Fblog\u002F2022-09-02-invite-enterprise-to-students-result-presentation",{"title":428,"link":429},"全館 75 折，額外加碼 6% 現金回饋！趁優惠學前端最划算！","\u002Fblog\u002F2022-08-29-hexschool-shopback",[431,432,433,434,435,408,436,437,438,439,440],"UI design","course","css","css3","enterprise","interview","javascript","jobs","skilltree","software engineer",1790064291578]