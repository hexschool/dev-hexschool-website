[{"data":1,"prerenderedAt":295},["ShallowReactive",2],{"blog:2019-05-13-remote-jobs":3,"blog:neighbors:2019-05-13-remote-jobs":264},{"id":4,"title":5,"author":6,"body":8,"categories":251,"date":252,"description":253,"draft":254,"extension":255,"meta":256,"navigation":257,"path":258,"seo":259,"stem":260,"tags":261,"thumbnail":17,"__hash__":263},"blog\u002Fblog\u002F2019\u002F2019-05-13-remote-jobs.md","【學員專屬徵才 - 遠端助教】無程式工作經驗者優先錄取",[7],"六角學院\u002F廖洧杰",{"type":9,"value":10,"toc":237},"minimark",[11,18,31,34,38,53,57,60,63,66,69,75,84,87,90,93,113,116,127,130,154,158,174,177,209,212,220,223,234],[12,13,14],"p",{},[15,16],"img",{"alt":5,"src":17},"https:\u002F\u002Ffirebasestorage.googleapis.com\u002Fv0\u002Fb\u002Fhexschool-api.appspot.com\u002Fo\u002Fblog%2F2019%2F05%2Fhex-hire-TA-fb.png?alt=media&token=de1fb813-9419-4620-bdee-67cae3c686a9",[19,20,21,25,28],"ul",{},[22,23,24],"li",{},"你想要轉職工程師，但怕全職投入，卻沒有收入養活自己？",[22,26,27],{},"你想要成為工程師，但是對自己的技能沒有信心？",[22,29,30],{},"你希望學會程式後，也希望有機會一展長才？",[12,32,33],{},"如果以上列表，你的答案是 Yes，同時又是六角學員的話，我們要的就是你！",[35,36,37],"h2",{"id":37},"徵才職缺與門檻",[19,39,40,47],{},[22,41,42,46],{},[43,44,45],"strong",{},"網頁排版助教"," - 需有完成 CSS、JQ、RWD、BS4 最終作業，並 CSS 與 RWD 皆有達到優的成績。",[22,48,49,52],{},[43,50,51],{},"JS 助教"," - 需有完成 JS、Vue 最終作業",[35,54,56],{"id":55},"門檻-qa","門檻 Q&A",[12,58,59],{},"Q：我如果只有註冊 RWD > BS4，沒註冊 CSS 與 jQ ，但也相當熟悉可以申請嗎？\nA：不行，必須四門課都有註冊，且做完最終作業，才可申請。",[12,61,62],{},"Q：申請JS 或網頁排版助教，如果我 CSS、RWD 其中一個作業沒有達優，是否就不能申請這一波申請？\nA：*是的，若您在本週再次繳交，則不符門檻。*您可以等下波我們徵召前，提供修改後的作業，以達到優的成績後再行申請。",[12,64,65],{},"Q：如果我 CSS、RWD 成績是A，但有給老師再次檢視，且老師也回信給我說改得都 ok，只差沒給我更新過後的「優」評價的話，可以申請嗎？\nA：可以，申請時提供 email 給我們確認即可。",[35,67,68],{"id":68},"評選機制",[12,70,71,74],{},[43,72,73],{},"所有符合上述門檻的學員，皆不會落選，此評選機制完全不看您的學歷","，但有優先順序，我們會依照以下機制，將條件優先提供給最需要這份工作的學員。",[76,77,78,81],"ol",{},[22,79,80],{},"全職準備且沒有工作收入者，優先入選",[22,82,83],{},"完全沒有程式工作經驗者，優先入選",[12,85,86],{},"若您尚未被選上，也會提供排隊編號給您，待前面學員工作結束後，便會透過 email 提供到職通知。",[12,88,89],{},"PS：此評選機制是希望真正有意成為工程師的學員可以透過此機制，能夠提早獲得程式工作經驗，有足夠的信心以協接業界。",[35,91,92],{"id":92},"這份工作的優點",[19,94,95,101,107],{},[22,96,97,100],{},[43,98,99],{},"知識再吸收","：藉由教學講解，能夠有效幫助自己的知識能夠重新收納整理，讓觀念更加穩固",[22,102,103,106],{},[43,104,105],{},"信心建立","：讓您藉由知識傳承，讓自己技術能夠再往上一個層次，並有足夠的信心挑戰更好的工作機會。",[22,108,109,112],{},[43,110,111],{},"工作彈性","：一週可以隨意選擇時數來工作，時間自主性高。",[35,114,115],{"id":115},"工作內容",[19,117,118,121,124],{},[22,119,120],{},"回覆學員程式問題",[22,122,123],{},"批改學員程式碼 (小節作業、最終作業)",[22,125,126],{},"協助評估課程流暢度，讓課程更臻完善。",[35,128,129],{"id":129},"工作時間",[19,131,132,143,146],{},[22,133,134,135],{},"每位應徵者工作長度如下\n",[19,136,137,140],{},[22,138,139],{},"網頁排版助教：2個月",[22,141,142],{},"JS助教：3個月",[22,144,145],{},"每週至少三天要在線上，每天工作 2 小時",[22,147,148,149,153],{},"工作時間可自由彈性選擇週一",[150,151,152],"del",{},"週日時段的 09:00 ~ 11:00、15:00","17:00 的兩個時段",[35,155,157],{"id":156},"舉例","舉例：",[19,159,160,167],{},[22,161,162,163,166],{},"小明：有 14 小時實習時間，時段為週一",[150,164,165],{},"週日的下午 3","5 點",[22,168,169,170,173],{},"小花：有 10 小時實習時間：時段為週一",[150,171,172],{},"五的早上 9","11 點",[35,175,176],{"id":176},"工作流程",[19,178,179,185,191,197,203],{},[22,180,181,184],{},[43,182,183],{},"前期教育訓練","：將會提供教育訓練影片，不論在回覆口吻、書寫習慣、聚焦問題上，六角皆有一套 SOP ，以幫助助教快速了解其流程。",[22,186,187,190],{},[43,188,189],{},"模擬演練","：每一位遠端助教在初期都會配置一位助教長，初期在回覆問題前，都必須獲得助教長審核過後，才可代表六角助教回覆。藉由此機制，幫助學員能夠在此工作上能逐漸掌握訣竅。",[22,192,193,196],{},[43,194,195],{},"獨當一面","：我們會有不定期的審核機制，若審核成功，往後您就可獨立運作來回覆學員問題。",[22,198,199,202],{},[43,200,201],{},"知識傳承","：當您對工作業務駕輕就熟後，就能升級為助教長，成為未來新人的教練，以進行教育傳承。",[22,204,205,208],{},[43,206,207],{},"協助就業","：我們正在規劃官網提供學員履歷刊登服務，將會讓畢業的遠端助教優先進行人才曝光，協助企業媒合。",[35,210,211],{"id":211},"薪水福利",[19,213,214,217],{},[22,215,216],{},"150\u002Fhr",[22,218,219],{},"無勞健保，此工作內容為執行業務、非常態性工作，故視為勞務外包。",[35,221,222],{"id":222},"應徵辦法",[12,224,225,226,233],{},"請填寫此 ",[227,228,232],"a",{"href":229,"rel":230},"https:\u002F\u002Fforms.gle\u002FH2SbXMxsQjWpqEuYA",[231],"nofollow","表單"," 進行應徵流程，5\u002F17 中午 12 點停止收件。將會等此批助教都畢業後才會進行下一波徵召。",[12,235,236],{},"並將於 5\u002F27 發錄取通知信給第一波助教名單。",{"title":238,"searchDepth":239,"depth":239,"links":240},"",2,[241,242,243,244,245,246,247,248,249,250],{"id":37,"depth":239,"text":37},{"id":55,"depth":239,"text":56},{"id":68,"depth":239,"text":68},{"id":92,"depth":239,"text":92},{"id":115,"depth":239,"text":115},{"id":129,"depth":239,"text":129},{"id":156,"depth":239,"text":157},{"id":176,"depth":239,"text":176},{"id":211,"depth":239,"text":211},{"id":222,"depth":239,"text":222},null,"2019-05-13","六角學院 是一所線上程式開發學習單位，目前已累積超過 15,000 名學員，**讓更多人藉由線上學習在職涯規劃上有更多的選擇**是我們的使命是，如果您贊同我們的理念，歡迎加入六角。",false,"md",{},true,"\u002Fblog\u002F2019\u002F2019-05-13-remote-jobs",{"title":5,"description":253},"blog\u002F2019\u002F2019-05-13-remote-jobs",[262],"jobs","DJJSZEJdKHiEQrxOo9LEUziqLyhLd3TI-1iASM1NUus",{"prev":265,"next":268,"related":271,"tags":284},{"title":266,"link":267},"【徵人】【高雄】實習生 1~3 名","\u002Fblog\u002F2019-05-13-internship",{"title":269,"link":270},"【大神來六角】五月直播主題：後端開發","\u002Fblog\u002F2019-04-17-god-and-hexschool",[272,275,278,281],{"title":273,"link":274},"【六角學院徵才 - 高雄】網路活動企劃","\u002Fblog\u002F2022-07-05-social-marketing-hiring",{"title":276,"link":277},"【徵才】視覺設計 實習生","\u002Fblog\u002F2022-05-16-design-internship",{"title":279,"link":280},"【徵才】Node.js 後端工程師","\u002Fblog\u002F2020-12-02-we-need-backend",{"title":282,"link":283},"【徵才】社群行銷實習生","\u002Fblog\u002F2020-11-03-social-marketing-internship",[285,286,287,288,289,290,291,292,262,293,294],"UI design","course","css","css3","enterprise","event","interview","javascript","skilltree","software engineer",1790064293074]